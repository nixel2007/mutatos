#Использовать asserts
#Использовать ".."

// Тесты намеренно неполные: они проверяют не всё поведение калькулятора.
// Мутационное тестирование должно это показать - часть мутантов выживет.

Перем Калькулятор;

&ПередКаждым
Процедура СоздатьКалькулятор() Экспорт

	Калькулятор = Новый Калькулятор();

КонецПроцедуры

&Тест
Процедура СложениеСкладывает() Экспорт

	Ожидаем.Что(Калькулятор.Сложить(2, 3), "Сумма")
		.Равно(5);

КонецПроцедуры

&Тест
Процедура УмножениеУмножает() Экспорт

	Ожидаем.Что(Калькулятор.Умножить(2, 3), "Произведение")
		.Равно(6);

КонецПроцедуры

&Тест
Процедура МаксимумНаходитБольшее() Экспорт

	// проверяется только один порядок аргументов: граница равенства не проверена

	Ожидаем.Что(Калькулятор.Максимум(5, 3), "Максимум")
		.Равно(5);

КонецПроцедуры

&Тест
Процедура ЧислоВнутриДиапазонаПринимается() Экспорт

	// проверяется только середина диапазона: границы не проверены

	Ожидаем.Что(Калькулятор.ВходитВДиапазон(5, 1, 10), "Число внутри диапазона")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СкидкаСчитаетсяОтСуммы() Экспорт

	// предельная скидка не достигается: ограничение сверху не проверено

	Ожидаем.Что(Калькулятор.РассчитатьСкидку(100, 50), "Скидка")
		.Равно(10);

КонецПроцедуры
