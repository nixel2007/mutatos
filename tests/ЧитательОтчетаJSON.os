#Использовать asserts
#Использовать tempfiles
#Использовать "../src/core"

// Отчёт должен пережить запись в JSON и чтение обратно: иначе перерисовать его
// без сорокаминутного прогона не выйдет.

Перем _ВременныеФайлы;

// Собственный менеджер временных файлов, а не общий: поднятие поделки стирает всё,
// что создано через общий модуль ВременныеФайлы - autumn-logos делает это при инициализации.
Функция ВременныеФайлы()

	Если _ВременныеФайлы = Неопределено Тогда
		_ВременныеФайлы = Новый МенеджерВременныхФайлов();
	КонецЕсли;

	Возврат _ВременныеФайлы;

КонецФункции

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт

	ВременныеФайлы().Удалить();

КонецПроцедуры

Функция ФайлИсходника()

	Путь = ВременныеФайлы().НовоеИмяФайла("os");

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку("Функция Максимум(А, Б)");
	Запись.ЗаписатьСтроку("	Возврат ?(А > Б, А, Б);");
	Запись.ЗаписатьСтроку("КонецФункции");
	Запись.Закрыть();

	Возврат Путь;

КонецФункции

Функция ПозицияСимвола(Знач Файл, Знач Подстрока)

	Чтение = Новый ЧтениеТекста(Файл, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат СтрНайти(Текст, Подстрока);

КонецФункции

Функция ИсходныйОтчет(Знач Файл)

	Отчет = Новый ОтчетПрогона();

	Убитый = Новый ОписаниеМутации("Арифметика", "+ заменено на -", 1, 1, "-", 1);
	Убитый.УстановитьИмяМетода("Максимум");
	Отчет.Добавить(Новый РезультатМутанта(Убитый, Файл, СостоянияМутанта.Убит(), 120));

	Выживший = Новый ОписаниеМутации("Условия", "> заменено на >=", ПозицияСимвола(Файл, "> Б"), 1, ">=", 2);
	Выживший.УстановитьИмяМетода("Максимум");
	Отчет.Добавить(Новый РезультатМутанта(Выживший, Файл, СостоянияМутанта.Выжил(), 130));

	Непокрытый = Новый ОписаниеМутации("Возврат", "возвращаемое значение заменено", 1, 1, "Неопределено", 3);
	Отчет.Добавить(Новый РезультатМутанта(Непокрытый, Файл, СостоянияМутанта.БезПокрытия()));

	Возврат Отчет;

КонецФункции

Функция ПрочитанныйОтчет(Знач Файл)

	Путь = ВременныеФайлы().НовоеИмяФайла("json");

	Репортер = Новый РепортерJSON();
	Репортер.Сформировать(ИсходныйОтчет(Файл), Путь);

	Читатель = Новый ЧитательОтчетаJSON();

	Возврат Читатель.Прочитать(Путь);

КонецФункции

&Тест
Процедура СводкаПереживаетЗаписьИЧтение() Экспорт

	// Когда

	Отчет = ПрочитанныйОтчет(ФайлИсходника());

	// Тогда

	Ожидаем.Что(Отчет.ВсегоМутантов(), "Всего мутантов").Равно(3);
	Ожидаем.Что(Отчет.Убито(), "Убито").Равно(1);
	Ожидаем.Что(Отчет.Выжило(), "Выжило").Равно(1);
	Ожидаем.Что(Отчет.БезПокрытия(), "Без покрытия").Равно(1);
	Ожидаем.Что(Отчет.ИндексМутаций(), "Индекс мутаций").Равно(50);

КонецПроцедуры

&Тест
Процедура МутацияПереживаетЗаписьИЧтение() Экспорт

	// Когда

	Мутант = ПрочитанныйОтчет(ФайлИсходника()).Выжившие()[0];

	// Тогда

	Ожидаем.Что(Мутант.Мутация().Мутатор(), "Мутатор").Равно("Условия");
	Ожидаем.Что(Мутант.Мутация().Описание(), "Описание").Равно("> заменено на >=");
	Ожидаем.Что(Мутант.Мутация().НомерСтроки(), "Номер строки").Равно(2);
	Ожидаем.Что(Мутант.Мутация().Текст(), "Замена").Равно(">=");
	Ожидаем.Что(Мутант.Длительность(), "Длительность").Равно(130);

КонецПроцедуры

&Тест
Процедура ИмяМетодаПереживаетЗаписьИЧтение() Экспорт

	// Имени метода в схеме нет, оно пишется своим полем. Без него перерисованный
	// отчёт отличался бы от свежего

	// Когда

	Мутант = ПрочитанныйОтчет(ФайлИсходника()).Выжившие()[0];

	// Тогда

	Ожидаем.Что(Мутант.Мутация().ИмяМетода(), "Имя метода").Равно("Максимум");

КонецПроцедуры

&Тест
Процедура СмещениеВосстанавливаетсяПоИсходнику() Экспорт

	// Схема хранит строку и колонку, мутатору нужно смещение. Восстановить его
	// можно только по исходнику - он в отчёте и лежит

	// Дано

	Файл = ФайлИсходника();

	// Когда

	Мутант = ПрочитанныйОтчет(Файл).Выжившие()[0];

	// Тогда

	Ожидаем.Что(Мутант.Мутация().Позиция(), "Позиция мутации")
		.Равно(ПозицияСимвола(Файл, "> Б"));

	Ожидаем.Что(Мутант.Мутация().Длина(), "Длина мутации")
		.Равно(1);

КонецПроцедуры

&Тест
Процедура ИсходникБеретсяИзОтчета() Экспорт

	// Перерисовывать отчёт можно там, где проекта нет вовсе - исходники в нём есть

	// Когда

	Отчет = ПрочитанныйОтчет(ФайлИсходника());

	// Тогда

	Ожидаем.Что(СтрНайти(Отчет.Исходник(Отчет.Результаты()[0].Файл()), "КонецФункции"), "Исходник в отчёте")
		.Больше(0);

КонецПроцедуры

&Тест
Процедура ЧужойФайлНеЧитаетсяКакОтчет() Экспорт

	// Дано

	Путь = ВременныеФайлы().НовоеИмяФайла("json");

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать("{""это"": ""не отчёт""}");
	Запись.Закрыть();

	// Тогда

	Ожидаем.Что(Новый ЧитательОтчетаJSON())
		.Метод("Прочитать", ЗначенияПараметров(Путь))
		.ВыбрасываетИсключение();

КонецПроцедуры

&Тест
Процедура НесуществующийФайлНеЧитается() Экспорт

	// Тогда

	Ожидаем.Что(Новый ЧитательОтчетаJSON())
		.Метод("Прочитать", ЗначенияПараметров("совсем/нет/такого.json"))
		.ВыбрасываетИсключение();

КонецПроцедуры

Функция ЗначенияПараметров(Знач Первый)

	Параметры = Новый Массив();
	Параметры.Добавить(Первый);

	Возврат Параметры;

КонецФункции
