#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать autumn-logos
#Использовать "../src/core"

// Проверяется отбор мутантов: что уходит на прогон, а что отсекается по покрытию,
// какими тестами проверяется мутант и сколько времени ему отводится.
// Сам прогон замокан - он проверяется отдельно, в тестах исполнителя.

Перем _ФайлИсходника;
Перем _ВременныеФайлы;
// Задания, дошедшие до исполнителя: мок отдаёт результаты, а сами задания
// перехватываются ответом - проверять надо именно их состав
Перем _Задания;
Перем _ОбщийТаймаут;

// Собственный менеджер временных файлов: поднятие поделки стирает всё, что создано
// через общий модуль ВременныеФайлы - autumn-logos делает это при инициализации.
Функция ВременныеФайлы()

	Если _ВременныеФайлы = Неопределено Тогда
		_ВременныеФайлы = Новый МенеджерВременныхФайлов();
	КонецЕсли;

	Возврат _ВременныеФайлы;

КонецФункции

&ПередКаждым
Процедура ЗабытьПрошлыйПрогон() Экспорт

	_Задания      = Новый Массив();
	_ОбщийТаймаут = 0;

КонецПроцедуры

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт

	ВременныеФайлы().Удалить();

КонецПроцедуры

Функция ФайлИсходника()

	Если _ФайлИсходника = Неопределено Тогда

		_ФайлИсходника = ВременныеФайлы().НовоеИмяФайла("os");

		Запись = Новый ЗаписьТекста(_ФайлИсходника, КодировкаТекста.UTF8);
		Запись.Записать("Сумма = А + Б;");
		Запись.Закрыть();

	КонецЕсли;

	Возврат _ФайлИсходника;

КонецФункции

Функция Мутация(Знач НомерСтроки)

	Возврат Новый ОписаниеМутации("Арифметика", "+ заменено на -", 11, 1, "-", НомерСтроки);

КонецФункции

Функция ГенераторСМутациями(Знач НомераСтрок)

	Мутации = Новый Массив();
	Для Каждого НомерСтроки Из НомераСтрок Цикл
		Мутации.Добавить(Мутация(НомерСтроки));
	КонецЦикла;

	Генератор = Мок.Получить(Тип("ГенераторМутантов"));
	Генератор.Когда().НайтиМутации(Матчеры.ЛюбаяСтрока(), Матчеры.ЛюбоеЗначение()).ТогдаВозвращает(Мутации);

	Возврат Генератор;

КонецФункции

// Перехватывает задания, дошедшие до исполнителя, и отвечает на каждое заданным
// состоянием мутанта: менеджеру важно, что он получил результат на каждое задание.
Функция ЗапомнитьЗадания(ИнформацияОВызове) Экспорт

	Параметры = ИнформацияОВызове.Параметры();

	_Задания      = Параметры[1];
	_ОбщийТаймаут = Параметры[2];

	Результаты = Новый Массив();

	Для Каждого Задание Из _Задания Цикл
		Результаты.Добавить(Новый РезультатМутанта(Задание.Мутация, Задание.Файл, СостоянияМутанта.Убит(), 10));
	КонецЦикла;

	Возврат Результаты;

КонецФункции

Функция Исполнитель()

	Исполнитель = Мок.Получить(Тип("ИсполнительМутантов"));

	Исполнитель.Когда().ПроверитьМутантов(
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗапомнитьЗадания"));

	Возврат Исполнитель;

КонецФункции

// Исходный прогон менеджеру отдаёт либо сборщик карты, либо анализатор покрытия -
// смотря включён отбор тестов или нет. Отвечают они одинаково, поэтому тест говорит
// только про покрытие, а не про то, кто его принёс.
Функция Менеджер(Генератор, Покрытие, Исполнитель, Карта = Неопределено,
	ПрогонУспешен = Истина, Длительность = 1000)

	Возврат МенеджерСоСборщиком(
		Генератор,
		Покрытие,
		Исполнитель,
		Сборщик(Покрытие, Карта, ПрогонУспешен, Длительность),
		ПрогонУспешен,
		Длительность);

КонецФункции

Функция МенеджерСоСборщиком(Генератор, Покрытие, Исполнитель, Сборщик,
	ПрогонУспешен = Истина, Длительность = 1000)

	Возврат Новый МенеджерМутационногоТестирования(
		Генератор,
		Исполнитель,
		Анализатор(Покрытие, ПрогонУспешен, Длительность),
		Сборщик,
		Запускатель(),
		Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

КонецФункции

Функция Сборщик(Покрытие = Неопределено, Карта = Неопределено, ПрогонУспешен = Истина, Длительность = 1000)

	Сборщик = Мок.Получить(Тип("СборщикКартыТестов"));

	Сборщик.Когда().Собрать(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаВозвращает(Новый Структура("Карта, Покрытие, Прогон",
			?(Карта = Неопределено, Новый КартаТестов(), Карта),
			?(Покрытие = Неопределено, Новый КартаПокрытия(), Покрытие),
			Прогон(ПрогонУспешен, Длительность)));

	Возврат Сборщик;

КонецФункции

Функция Анализатор(Покрытие = Неопределено, ПрогонУспешен = Истина, Длительность = 1000)

	Анализатор = Мок.Получить(Тип("АнализаторПокрытия"));

	Анализатор.Когда().СобратьПокрытие(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаВозвращает(Новый Структура("Прогон, Покрытие",
			Прогон(ПрогонУспешен, Длительность),
			?(Покрытие = Неопределено, Новый КартаПокрытия(), Покрытие)));

	Возврат Анализатор;

КонецФункции

Функция Запускатель()

	Запускатель = Мок.Получить(Тип("ЗапускательТестовЯдро"));
	Запускатель.Когда().КаталогЯдраПроекта(Матчеры.ЛюбоеЗначение()).ТогдаВозвращает("ядро");

	Возврат Запускатель;

КонецФункции

Функция Прогон(Знач Успешен, Знач Длительность)

	Возврат Новый РезультатПрогона(Успешен, ?(Успешен, 0, 1), Длительность, "");

КонецФункции

Функция СписокФайлов()

	Файлы = Новый Массив();
	Файлы.Добавить(ФайлИсходника());

	Возврат Файлы;

КонецФункции

Функция НомераСтрок(Знач Первый, Знач Второй = Неопределено)

	Результат = Новый Массив();
	Результат.Добавить(Первый);
	Если Второй <> Неопределено Тогда
		Результат.Добавить(Второй);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Тесты, которыми должно проверяться задание с указанным номером.
Функция ТестыЗадания(Знач Номер = 0)
	Возврат _Задания[Номер].Тесты;
КонецФункции

&Тест
Процедура МутантВНепокрытойСтрокеНеПрогоняется() Экспорт

	// Дано

	Покрытие = Новый КартаПокрытия();
	Покрытие.ОтметитьФайл(ФайлИсходника());

	// Когда

	Отчет = Менеджер(ГенераторСМутациями(НомераСтрок(1)), Покрытие, Исполнитель())
		.Проверить(ТекущийКаталог(), СписокФайлов());

	// Тогда

	Ожидаем.Что(Отчет.БезПокрытия(), "Мутантов без покрытия")
		.Равно(1);

	Ожидаем.Что(_Задания.Количество(), "Заданий дошло до прогона")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура МутантВПокрытойСтрокеПрогоняется() Экспорт

	// Дано

	Покрытие = Новый КартаПокрытия();
	Покрытие.Отметить(ФайлИсходника(), 1);

	// Когда

	Отчет = Менеджер(ГенераторСМутациями(НомераСтрок(1)), Покрытие, Исполнитель())
		.Проверить(ТекущийКаталог(), СписокФайлов());

	// Тогда

	Ожидаем.Что(Отчет.Убито(), "Убито")
		.Равно(1);

	Ожидаем.Что(Отчет.БезПокрытия(), "Мутантов без покрытия")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура БезПокрытияВовсеМутантПрогоняется() Экспорт

	// покрытие не собиралось - судить не о чем, мутанта надо проверять

	// Когда

	Отчет = Менеджер(ГенераторСМутациями(НомераСтрок(1)), Новый КартаПокрытия(), Исполнитель())
		.Проверить(ТекущийКаталог(), СписокФайлов());

	// Тогда

	Ожидаем.Что(Отчет.Убито(), "Убито")
		.Равно(1);

КонецПроцедуры

&Тест
Процедура ФайлВнеОтчетаОПокрытииСчитаетсяНепокрытым() Экспорт

	// Файла нет в непустом отчёте - значит его не загружал ни один тест: статистика
	// выполнения знает все скомпилированные файлы. Убить такого мутанта нечем

	// Дано

	Покрытие = Новый КартаПокрытия();
	Покрытие.Отметить("совсем/другой/файл.os", 1);

	// Когда

	Отчет = Менеджер(ГенераторСМутациями(НомераСтрок(1)), Покрытие, Исполнитель())
		.Проверить(ТекущийКаталог(), СписокФайлов());

	// Тогда

	Ожидаем.Что(Отчет.БезПокрытия(), "Мутантов без покрытия")
		.Равно(1);

КонецПроцедуры

&Тест
Процедура ПокрытыеИНепокрытыеМутацииРазделяются() Экспорт

	// Дано

	Покрытие = Новый КартаПокрытия();
	Покрытие.Отметить(ФайлИсходника(), 1);

	// Когда

	Отчет = Менеджер(ГенераторСМутациями(НомераСтрок(1, 7)), Покрытие, Исполнитель())
		.Проверить(ТекущийКаталог(), СписокФайлов());

	// Тогда

	Ожидаем.Что(Отчет.БезПокрытия(), "Мутантов без покрытия")
		.Равно(1);

	Ожидаем.Что(_Задания.Количество(), "Заданий дошло до прогона")
		.Равно(1);

КонецПроцедуры

&Тест
Процедура МутантПроверяетсяТолькоПокрывающимиЕгоТестами() Экспорт

	// Дано

	Покрытие = Новый КартаПокрытия();
	Покрытие.Отметить(ФайлИсходника(), 1);

	Карта = Новый КартаТестов();
	Карта.Отметить("tests/Сложение.os", "Складывает", ФайлИсходника(), 1);
	Карта.Отметить("tests/Прочее.os", "Прочее", ФайлИсходника(), 7);

	// Когда

	Менеджер(ГенераторСМутациями(НомераСтрок(1)), Покрытие, Исполнитель(), Карта)
		.Проверить(ТекущийКаталог(), СписокФайлов());

	// Тогда

	Тесты = ТестыЗадания();

	Ожидаем.Что(Тесты.Количество(), "Тестов для проверки мутанта")
		.Равно(1);

	Ожидаем.Что(Тесты[0].Набор, "Набор")
		.Равно("tests/Сложение.os");

	Ожидаем.Что(Тесты[0].Метод, "Метод")
		.Равно("Складывает");

КонецПроцедуры

&Тест
Процедура СтрокаБезЗаписиВКартеПроверяетсяВсемиТестами() Экспорт

	// Пустой список тестов означает "всеми тестами". Так честнее: тест, потерянный
	// в карте, превратил бы убитого мутанта в выжившего

	// Дано

	Покрытие = Новый КартаПокрытия();
	Покрытие.Отметить(ФайлИсходника(), 1);

	Карта = Новый КартаТестов();
	Карта.Отметить("tests/Прочее.os", "Прочее", ФайлИсходника(), 7);

	// Когда

	Менеджер(ГенераторСМутациями(НомераСтрок(1)), Покрытие, Исполнитель(), Карта)
		.Проверить(ТекущийКаталог(), СписокФайлов());

	// Тогда

	Ожидаем.Что(ТестыЗадания().Количество(), "Тестов для проверки мутанта")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ОбщийТаймаутСчитаетсяОтИсходногоПрогона() Экспорт

	// Мутанту дают больше времени, чем шёл исходный прогон: он делает ту же работу,
	// только на изменённом коде. Во сколько раз больше - настройка прогона

	// Дано

	Покрытие = Новый КартаПокрытия();
	Покрытие.Отметить(ФайлИсходника(), 1);

	Параметры = Новый ПараметрыПрогона();
	Параметры.КоэффициентТаймаута = 4;

	// Когда

	Менеджер(ГенераторСМутациями(НомераСтрок(1)), Покрытие, Исполнитель(), Неопределено, Истина, 2500)
		.Проверить(ТекущийКаталог(), СписокФайлов(), Параметры);

	// Тогда

	Ожидаем.Что(_ОбщийТаймаут, "Общий таймаут")
		.Равно(10000);

КонецПроцедуры

&Тест
Процедура ТаймаутСчитаетсяПоТестамМутанта() Экспорт

	// Зациклившая мутация иначе висит до общего таймаута, а он считается от прогона
	// всеми тестами - времени, которого у мутанта с отбором нет

	// Дано

	Покрытие = Новый КартаПокрытия();
	Покрытие.Отметить(ФайлИсходника(), 1);

	Карта = Новый КартаТестов();
	Карта.Отметить("tests/Сложение.os", "Складывает", ФайлИсходника(), 1);
	Карта.ОтметитьСтоимостьСтарта(3000);
	Карта.ОтметитьДлительность("tests/Сложение.os", "Складывает", 1000);

	Параметры = Новый ПараметрыПрогона();
	Параметры.КоэффициентТаймаута = 3;

	// Когда

	Менеджер(ГенераторСМутациями(НомераСтрок(1)), Покрытие, Исполнитель(), Карта)
		.Проверить(ТекущийКаталог(), СписокФайлов(), Параметры);

	// Тогда

	// старт три секунды плюс секунда теста, коэффициент три
	Ожидаем.Что(_Задания[0].Таймаут, "Таймаут мутанта")
		.Равно(12000);

КонецПроцедуры

&Тест
Процедура БезОценкиТаймаутОстаетсяОбщим() Экспорт

	// про мутанта, который идёт всеми тестами, карта ничего не знает

	// Дано

	Покрытие = Новый КартаПокрытия();
	Покрытие.Отметить(ФайлИсходника(), 1);

	// Когда

	Менеджер(ГенераторСМутациями(НомераСтрок(1)), Покрытие, Исполнитель())
		.Проверить(ТекущийКаталог(), СписокФайлов());

	// Тогда

	Ожидаем.Что(_Задания[0].Таймаут, "Таймаут мутанта")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура БезОтбораКартаНеСобирается() Экспорт

	// Карта стоит сессии сбора статистики на каждый тест. Платить за неё, чтобы
	// выбросить результат, незачем - без отбора исходный прогон идёт обычным способом

	// Дано

	Покрытие = Новый КартаПокрытия();
	Покрытие.Отметить(ФайлИсходника(), 1);

	// обращение к сборщику - это и есть падение теста: карту собирать не должны
	Сборщик = Мок.Получить(Тип("СборщикКартыТестов"));
	Сборщик.Когда().Собрать(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаВыбрасываетИсключение("Карту собирать не просили");

	Параметры = Новый ПараметрыПрогона();
	Параметры.ОтбиратьТесты = Ложь;

	// Когда

	МенеджерСоСборщиком(ГенераторСМутациями(НомераСтрок(1)), Покрытие, Исполнитель(), Сборщик)
		.Проверить(ТекущийКаталог(), СписокФайлов(), Параметры);

	// Тогда

	Ожидаем.Что(_Задания.Количество(), "Заданий дошло до прогона")
		.Равно(1);

КонецПроцедуры

&Тест
Процедура НаКрасныхТестахПрогонНеНачинается() Экспорт

	// иначе убитого мутанта не отличить от изначально сломанного проекта

	// Дано

	МенеджерПрогона = Менеджер(
		ГенераторСМутациями(НомераСтрок(1)),
		Новый КартаПокрытия(),
		Исполнитель(),
		Неопределено,
		Ложь);

	Параметры = Новый Массив();
	Параметры.Добавить(ТекущийКаталог());
	Параметры.Добавить(СписокФайлов());

	// Тогда

	Ожидаем.Что(МенеджерПрогона)
		.Метод("Проверить", Параметры)
		.ВыбрасываетИсключение();

КонецПроцедуры
