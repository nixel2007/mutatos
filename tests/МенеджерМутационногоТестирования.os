#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать autumn-logos
#Использовать "../src/core"

// Проверяется отбор мутантов: что уходит на прогон, а что отсекается по покрытию.
// Сам прогон подменён моком - он проверяется отдельно, в тестах исполнителя.

Перем _ФайлИсходника;

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

Функция ФайлИсходника()

	Если _ФайлИсходника = Неопределено Тогда

		_ФайлИсходника = ВременныеФайлы.НовоеИмяФайла("os");

		Запись = Новый ЗаписьТекста(_ФайлИсходника, КодировкаТекста.UTF8);
		Запись.Записать("Сумма = А + Б;");
		Запись.Закрыть();

	КонецЕсли;

	Возврат _ФайлИсходника;

КонецФункции

Функция Мутация(Знач НомерСтроки)

	Возврат Новый ОписаниеМутации("Арифметика", "+ заменено на -", 11, 1, "-", НомерСтроки);

КонецФункции

Функция ГенераторСМутациями(Знач НомераСтрок)

	Мутации = Новый Массив();
	Для Каждого НомерСтроки Из НомераСтрок Цикл
		Мутации.Добавить(Мутация(НомерСтроки));
	КонецЦикла;

	Генератор = Мок.Получить(Тип("ГенераторМутантов"));
	Генератор.Когда().НайтиМутации(Матчеры.ЛюбаяСтрока()).ТогдаВозвращает(Мутации);

	Возврат Генератор;

КонецФункции

Функция АнализаторСПокрытием(Покрытие, Знач ПрогонУспешен = Истина)

	Прогон = Новый РезультатПрогона(ПрогонУспешен, ?(ПрогонУспешен, 0, 1), 1000, "");

	Анализатор = Мок.Получить(Тип("АнализаторПокрытия"));
	Анализатор.Когда().СобратьПокрытие(Матчеры.ЛюбаяСтрока())
		.ТогдаВозвращает(Новый Структура("Прогон, Покрытие", Прогон, Покрытие));

	Возврат Анализатор;

КонецФункции

Функция ИсполнительУбивающийВсех()

	Исполнитель = Мок.Получить(Тип("ИсполнительМутантов"));
	Исполнитель.Когда().ПроверитьМутанта(
			Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаВозвращает(Новый РезультатМутанта(Мутация(1), ФайлИсходника(), СостоянияМутанта.Убит(), 10));

	Возврат Исполнитель;

КонецФункции

Функция Менеджер(Генератор, Анализатор, Исполнитель)

	Возврат Новый МенеджерМутационногоТестирования(
		Генератор,
		Исполнитель,
		Анализатор,
		Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

КонецФункции

Функция СписокФайлов()

	Файлы = Новый Массив();
	Файлы.Добавить(ФайлИсходника());

	Возврат Файлы;

КонецФункции

Функция НомераСтрок(Знач Первый, Знач Второй = Неопределено)

	Результат = Новый Массив();
	Результат.Добавить(Первый);
	Если Второй <> Неопределено Тогда
		Результат.Добавить(Второй);
	КонецЕсли;

	Возврат Результат;

КонецФункции

&Тест
Процедура МутантВНепокрытойСтрокеНеПрогоняется() Экспорт

	// Дано

	Покрытие = Новый КартаПокрытия();
	Покрытие.ОтметитьФайл(ФайлИсходника());

	Исполнитель = ИсполнительУбивающийВсех();

	// Когда

	Отчет = Менеджер(ГенераторСМутациями(НомераСтрок(1)), АнализаторСПокрытием(Покрытие), Исполнитель)
		.Проверить(ТекущийКаталог(), СписокФайлов());

	// Тогда

	Ожидаем.Что(Отчет.БезПокрытия(), "Мутантов без покрытия")
		.Равно(1);

	Ожидаем.Что(Отчет.Убито(), "Убито")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура МутантВПокрытойСтрокеПрогоняется() Экспорт

	// Дано

	Покрытие = Новый КартаПокрытия();
	Покрытие.Отметить(ФайлИсходника(), 1);

	// Когда

	Отчет = Менеджер(ГенераторСМутациями(НомераСтрок(1)), АнализаторСПокрытием(Покрытие), ИсполнительУбивающийВсех())
		.Проверить(ТекущийКаталог(), СписокФайлов());

	// Тогда

	Ожидаем.Что(Отчет.Убито(), "Убито")
		.Равно(1);

	Ожидаем.Что(Отчет.БезПокрытия(), "Мутантов без покрытия")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура БезДанныхОПокрытииМутантПрогоняется() Экспорт

	// про файл, которого нет в отчёте о покрытии, судить нельзя

	// Дано

	Покрытие = Новый КартаПокрытия();

	// Когда

	Отчет = Менеджер(ГенераторСМутациями(НомераСтрок(1)), АнализаторСПокрытием(Покрытие), ИсполнительУбивающийВсех())
		.Проверить(ТекущийКаталог(), СписокФайлов());

	// Тогда

	Ожидаем.Что(Отчет.Убито(), "Убито")
		.Равно(1);

КонецПроцедуры

&Тест
Процедура ПокрытыеИНепокрытыеМутантыРазделяются() Экспорт

	// Дано

	Покрытие = Новый КартаПокрытия();
	Покрытие.Отметить(ФайлИсходника(), 1);

	// Когда

	Отчет = Менеджер(ГенераторСМутациями(НомераСтрок(1, 2)), АнализаторСПокрытием(Покрытие), ИсполнительУбивающийВсех())
		.Проверить(ТекущийКаталог(), СписокФайлов());

	// Тогда

	Ожидаем.Что(Отчет.ВсегоМутантов(), "Всего мутантов")
		.Равно(2);

	Ожидаем.Что(Отчет.Убито(), "Убито")
		.Равно(1);

	Ожидаем.Что(Отчет.БезПокрытия(), "Мутантов без покрытия")
		.Равно(1);

КонецПроцедуры

&Тест
Процедура НаКрасныхТестахПрогонНеНачинается() Экспорт

	// иначе убитого мутанта не отличить от изначально сломанного проекта

	// Дано

	Анализатор = АнализаторСПокрытием(Новый КартаПокрытия(), Ложь);
	МенеджерПрогона = Менеджер(ГенераторСМутациями(НомераСтрок(1)), Анализатор, ИсполнительУбивающийВсех());

	Параметры = Новый Массив();
	Параметры.Добавить(ТекущийКаталог());
	Параметры.Добавить(СписокФайлов());

	// Тогда

	Ожидаем.Что(МенеджерПрогона)
		.Метод("Проверить", Параметры)
		.ВыбрасываетИсключение();

КонецПроцедуры
