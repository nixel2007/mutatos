#Использовать asserts
#Использовать "../src/core"

Функция РезультатСоСостоянием(Знач Состояние)

	Мутация = Новый ОписаниеМутации("Арифметика", "+ заменено на -", 1, 1, "-", 1);

	Возврат Новый РезультатМутанта(Мутация, "Файл.os", Состояние);

КонецФункции

Функция ОтчетИзСостояний(Знач Состояния)

	Отчет = Новый ОтчетПрогона();

	Для Каждого Состояние Из Состояния Цикл
		Отчет.Добавить(РезультатСоСостоянием(Состояние));
	КонецЦикла;

	Возврат Отчет;

КонецФункции

Функция Состояния(Знач Убито, Знач Выжило, Знач БезПокрытия = 0, Знач Ошибок = 0, Знач Таймаутов = 0)

	Результат = Новый Массив();

	Для Сч = 1 По Убито Цикл
		Результат.Добавить(СостоянияМутанта.Убит());
	КонецЦикла;
	Для Сч = 1 По Выжило Цикл
		Результат.Добавить(СостоянияМутанта.Выжил());
	КонецЦикла;
	Для Сч = 1 По БезПокрытия Цикл
		Результат.Добавить(СостоянияМутанта.БезПокрытия());
	КонецЦикла;
	Для Сч = 1 По Ошибок Цикл
		Результат.Добавить(СостоянияМутанта.Ошибка());
	КонецЦикла;
	Для Сч = 1 По Таймаутов Цикл
		Результат.Добавить(СостоянияМутанта.Таймаут());
	КонецЦикла;

	Возврат Результат;

КонецФункции

&Тест
Процедура ПустойОтчетИмеетНулевойИндекс() Экспорт

	Отчет = Новый ОтчетПрогона();

	Ожидаем.Что(Отчет.ВсегоМутантов(), "Всего мутантов")
		.Равно(0);

	Ожидаем.Что(Отчет.ИндексМутаций(), "Индекс мутаций")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ИндексСчитаетсяКакДоляУбитых() Экспорт

	Отчет = ОтчетИзСостояний(Состояния(3, 1));

	Ожидаем.Что(Отчет.ИндексМутаций(), "Индекс мутаций")
		.Равно(75);

КонецПроцедуры

&Тест
Процедура ТаймаутСчитаетсяУбийством() Экспорт

	Отчет = ОтчетИзСостояний(Состояния(1, 0, 0, 0, 1));

	Ожидаем.Что(Отчет.Убито(), "Убито")
		.Равно(2);

	Ожидаем.Что(Отчет.ИндексМутаций(), "Индекс мутаций")
		.Равно(100);

КонецПроцедуры

&Тест
Процедура МутантыБезПокрытияНеВлияютНаИндекс() Экспорт

	// мутант в непокрытом коде говорит об отсутствии тестов, а не об их качестве

	Отчет = ОтчетИзСостояний(Состояния(1, 1, 8));

	Ожидаем.Что(Отчет.БезПокрытия(), "Без покрытия")
		.Равно(8);

	Ожидаем.Что(Отчет.ИндексМутаций(), "Индекс мутаций")
		.Равно(50);

КонецПроцедуры

&Тест
Процедура ОшибочныеМутантыНеВлияютНаИндекс() Экспорт

	Отчет = ОтчетИзСостояний(Состояния(1, 1, 0, 5));

	Ожидаем.Что(Отчет.Ошибок(), "Ошибок")
		.Равно(5);

	Ожидаем.Что(Отчет.ИндексМутаций(), "Индекс мутаций")
		.Равно(50);

КонецПроцедуры

&Тест
Процедура ВыжившиеОтдаютсяСписком() Экспорт

	Отчет = ОтчетИзСостояний(Состояния(2, 3));

	Ожидаем.Что(Отчет.Выжившие().Количество(), "Количество выживших")
		.Равно(3);

	Ожидаем.Что(Отчет.Выжившие()[0].Состояние(), "Состояние выжившего")
		.Равно(СостоянияМутанта.Выжил());

КонецПроцедуры

&Тест
Процедура ИндексОкругляетсяДоДесятых() Экспорт

	Отчет = ОтчетИзСостояний(Состояния(1, 2));

	Ожидаем.Что(Отчет.ИндексМутаций(), "Индекс мутаций")
		.Равно(33.3);

КонецПроцедуры

&Тест
Процедура РезультатыУпорядоченыПоФайлуИСтроке() Экспорт

	// Мутанты возвращаются из прогона в порядке завершения - в разном при каждом
	// запуске. Отчёты по такому порядку нечитаемы и несравнимы между прогонами

	// Дано

	Отчет = Новый ОтчетПрогона();
	Отчет.Добавить(Результат("src/Яблоко.os", 30));
	Отчет.Добавить(Результат("src/Апельсин.os", 20));
	Отчет.Добавить(Результат("src/Яблоко.os", 7));
	Отчет.Добавить(Результат("src/Апельсин.os", 5));

	// Когда

	Результаты = Отчет.Результаты();

	// Тогда

	Ожидаем.Что(Представление(Результаты[0]), "Первый").Равно("src/Апельсин.os:5");
	Ожидаем.Что(Представление(Результаты[1]), "Второй").Равно("src/Апельсин.os:20");
	Ожидаем.Что(Представление(Результаты[2]), "Третий").Равно("src/Яблоко.os:7");
	Ожидаем.Что(Представление(Результаты[3]), "Четвёртый").Равно("src/Яблоко.os:30");

КонецПроцедуры

Функция Результат(Знач Файл, Знач НомерСтроки)

	Мутация = Новый ОписаниеМутации("Арифметика", "+ заменено на -", 1, 1, "-", НомерСтроки);

	Возврат Новый РезультатМутанта(Мутация, Файл, СостоянияМутанта.Выжил());

КонецФункции

Функция Представление(Результат)

	Возврат СтрШаблон("%1:%2", Результат.Файл(), Формат(Результат.Мутация().НомерСтроки(), "ЧГ=0"));

КонецФункции
