#Использовать asserts
#Использовать tempfiles
#Использовать "../src/core"

// Ценность HTML-отчёта - мутант, показанный на своём месте в коде,
// поэтому проверяется в первую очередь связка исходника с мутациями.

Перем _ВременныеФайлы;

// Собственный менеджер временных файлов, а не общий: поднятие поделки стирает всё,
// что создано через общий модуль ВременныеФайлы - autumn-logos делает это при инициализации.
Функция ВременныеФайлы()

	Если _ВременныеФайлы = Неопределено Тогда
		_ВременныеФайлы = Новый МенеджерВременныхФайлов();
	КонецЕсли;

	Возврат _ВременныеФайлы;

КонецФункции

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт

	ВременныеФайлы().Удалить();

КонецПроцедуры

Функция ФайлИсходника()

	Путь = ВременныеФайлы().НовоеИмяФайла("os");

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку("Функция Максимум(А, Б)");
	Запись.ЗаписатьСтроку("	Возврат ?(А > Б, А, Б);");
	Запись.ЗаписатьСтроку("КонецФункции");
	Запись.Закрыть();

	Возврат Путь;

КонецФункции

Функция ОтчетСМутантами(Знач Файл)

	Отчет = Новый ОтчетПрогона();

	Убитый = Новый ОписаниеМутации("Арифметика", "+ заменено на -", 10, 1, "-", 1);
	Убитый.УстановитьИмяМетода("Максимум");
	Отчет.Добавить(Новый РезультатМутанта(Убитый, Файл, СостоянияМутанта.Убит(), 120));

	Выживший = Новый ОписаниеМутации("Условия", "> заменено на >=", 20, 1, ">=", 2);
	Выживший.УстановитьИмяМетода("Максимум");
	Отчет.Добавить(Новый РезультатМутанта(Выживший, Файл, СостоянияМутанта.Выжил(), 130));

	Возврат Отчет;

КонецФункции

Функция СформироватьОтчет(Знач Файл)

	Путь = ВременныеФайлы().НовоеИмяФайла("html");

	Репортер = Новый РепортерHTML();
	Репортер.Сформировать(ОтчетСМутантами(Файл), Путь);

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат Текст;

КонецФункции

&Тест
Процедура ОтчетСодержитСтатистику() Экспорт

	// Когда

	Текст = СформироватьОтчет(ФайлИсходника());

	// Тогда

	Ожидаем.Что(СтрНайти(Текст, "Индекс мутаций"), "Заголовок индекса")
		.Больше(0);

	Ожидаем.Что(СтрНайти(Текст, ">50%<"), "Значение индекса")
		.Больше(0);

КонецПроцедуры

&Тест
Процедура ОтчетПоказываетИсходникСМутациями() Экспорт

	// Когда

	Текст = СформироватьОтчет(ФайлИсходника());

	// Тогда

	Ожидаем.Что(СтрНайти(Текст, "КонецФункции"), "Строка исходника")
		.Больше(0);

	Ожидаем.Что(СтрНайти(Текст, "&gt; заменено на &gt;="), "Описание мутации")
		.Больше(0);

	Ожидаем.Что(СтрНайти(Текст, "class=""survived"""), "Подсветка выжившего мутанта")
		.Больше(0);

КонецПроцедуры

&Тест
Процедура ИсходникЭкранируется() Экспорт

	// Символы разметки в коде встречаются постоянно: сравнения, кавычки, амперсанды
	// аннотаций. Без экранирования отчёт по такому файлу превратился бы в кашу

	// Когда

	Текст = СформироватьОтчет(ФайлИсходника());

	// Тогда

	Ожидаем.Что(СтрНайти(Текст, "?(А &gt; Б, А, Б)"), "Экранированный исходник")
		.Больше(0);

	Ожидаем.Что(СтрНайти(Текст, "?(А > Б, А, Б)"), "Неэкранированный исходник")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура БезИсходникаОтчетВсеРавноФормируется() Экспорт

	// файл мог быть удалён или переименован после прогона

	// Когда

	Текст = СформироватьОтчет(ОбъединитьПути(ВременныеФайлы().СоздатьКаталог(), "нет.os"));

	// Тогда

	Ожидаем.Что(СтрНайти(Текст, "Исходный файл недоступен"), "Пояснение вместо исходника")
		.Больше(0);

	Ожидаем.Что(СтрНайти(Текст, "&gt; заменено на &gt;="), "Описание мутации")
		.Больше(0);

КонецПроцедуры

&Тест
Процедура ФайлыИдутПоПорядку() Экспорт

	// Мутанты возвращаются из прогона в порядке завершения. В отчёте файлы должны
	// стоять по имени, иначе его не пролистать глазами и не сличить с прошлым прогоном

	// Дано

	Каталог = ВременныеФайлы().СоздатьКаталог();

	Отчет = Новый ОтчетПрогона();
	Отчет.Добавить(Новый РезультатМутанта(
		Новый ОписаниеМутации("Условия", "> заменено на >=", 1, 1, ">=", 2),
		ОбъединитьПути(Каталог, "Яблоко.os"),
		СостоянияМутанта.Выжил()));
	Отчет.Добавить(Новый РезультатМутанта(
		Новый ОписаниеМутации("Условия", "> заменено на >=", 1, 1, ">=", 2),
		ОбъединитьПути(Каталог, "Апельсин.os"),
		СостоянияМутанта.Убит()));

	Путь = ВременныеФайлы().НовоеИмяФайла("html");

	// Когда

	Репортер = Новый РепортерHTML();
	Репортер.Сформировать(Отчет, Путь);

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	// Тогда

	Ожидаем.Что(СтрНайти(Текст, "Апельсин.os"), "Позиция первого файла")
		.Меньше(СтрНайти(Текст, "Яблоко.os"));

КонецПроцедуры

&Тест
Процедура ФайлыСобираютсяВПакеты() Экспорт

	// Пакетов в языке нет, но раскладка проектов о них говорит: каталог либо сам
	// содержит "Классы" и "Модули", либо лежит внутри них. В отчёте нужны обе конвенции

	// Дано

	Каталог = ВременныеФайлы().СоздатьКаталог();

	Отчет = Новый ОтчетПрогона();
	Отчет.Добавить(Мутант(ОбъединитьПути(Каталог, "Классы/Коллекции/Списки/СписокМассив.os")));
	Отчет.Добавить(Мутант(ОбъединитьПути(Каталог, "Классы/Коллекции/Списки/ФиксированныйСписок.os")));
	Отчет.Добавить(Мутант(ОбъединитьПути(Каталог, "Ядро/Классы/Ресурс.os")));
	Отчет.Добавить(Мутант(ОбъединитьПути(Каталог, "Модули/Массивы.os")));

	// Когда

	Текст = Сформировать(Отчет);

	// Тогда

	Ожидаем.Что(СтрНайти(Текст, ">Коллекции/Списки<"), "Пакет из подкаталога Классы")
		.Больше(0);

	Ожидаем.Что(СтрНайти(Текст, ">Ядро<"), "Пакет с Классы внутри")
		.Больше(0);

	Ожидаем.Что(СтрНайти(Текст, ">(корень)<"), "Файл прямо в Модули")
		.Больше(0);

	// два файла одного пакета - одна строка в таблице пакетов
	Ожидаем.Что(СтрЧислоВхождений(Текст, ">Коллекции/Списки<"), "Строк пакета в отчёте")
		.Равно(2);

КонецПроцедуры

&Тест
Процедура ИсходникПодсвечивается() Экспорт

	// Подсветку делает Shiki уже в браузере, а находит она исходники по data-lang:
	// список мутантов без исходника подсвечивать нечем

	// Когда

	Текст = СформироватьОтчет(ФайлИсходника());

	// Тогда

	Ожидаем.Что(СтрНайти(Текст, "<table class=""source"" data-lang=""bsl"">"), "Таблица исходника помечена")
		.Больше(0);

	Ожидаем.Что(СтрНайти(Текст, "@shikijs/langs@3/bsl"), "Грамматика OneScript")
		.Больше(0);

КонецПроцедуры

&Тест
Процедура ТемаПереключаетсяБезСценариев() Экспорт

	// Тема по умолчанию системная, а переключатель её перебивает - тоже
	// на радиокнопках и CSS, как и переключатель вида

	// Когда

	Текст = СформироватьОтчет(ФайлИсходника());

	// Тогда

	Ожидаем.Что(СтрНайти(Текст, "id=""theme-dark"""), "Переключатель темы")
		.Больше(0);

	Ожидаем.Что(СтрНайти(Текст, "@media (prefers-color-scheme: dark)"), "Системная тема")
		.Больше(0);

	Ожидаем.Что(СтрНайти(Текст, ":root:has(#theme-dark:checked)"), "Правило тёмной темы")
		.Больше(0);

	// светлая выбрана явно - системная тёмная её не перебивает
	Ожидаем.Что(СтрНайти(Текст, ":root:not(:has(#theme-light:checked))"), "Явный выбор светлой")
		.Больше(0);

КонецПроцедуры

&Тест
Процедура ПодсветкаЗнаетОбеТемы() Экспорт

	// Shiki кладёт в токен обе темы переменными, а какую взять - решает CSS:
	// иначе при переключении пришлось бы перекрашивать разметку заново

	// Когда

	Текст = СформироватьОтчет(ФайлИсходника());

	// Тогда

	Ожидаем.Что(СтрНайти(Текст, "@shikijs/themes@3/github-dark"), "Тёмная тема подсветки")
		.Больше(0);

	Ожидаем.Что(СтрНайти(Текст, "defaultColor: false"), "Обе темы переменными")
		.Больше(0);

	Ожидаем.Что(СтрНайти(Текст, "--code: var(--shiki-dark)"), "Выбор цвета кода темой")
		.Больше(0);

КонецПроцедуры

&Тест
Процедура БезПодсветкиИсходникОстаетсяЧитаемым() Экспорт

	// Подсветка - украшение поверх готового отчёта: она только перекрашивает
	// то, что уже лежит в таблице обычным текстом. Без сети, сценариев или
	// со старым браузером отчёт остаётся прежним

	// Когда

	Текст = СформироватьОтчет(ФайлИсходника());

	// Тогда

	Ожидаем.Что(СтрНайти(Текст, "Возврат ?(А &gt; Б, А, Б);"), "Строка исходника в тексте отчёта")
		.Больше(0);

КонецПроцедуры

&Тест
Процедура ВидПереключаетсяБезСценариев() Экспорт

	// Отчёт открывают из письма и из артефактов сборки, где сценарии могут
	// не работать вовсе. Переключатель поэтому на радиокнопках и CSS -
	// единственный сценарий отчёта занят подсветкой и ни на что не влияет

	// Когда

	Текст = СформироватьОтчет(ФайлИсходника());

	// Тогда

	Ожидаем.Что(СтрНайти(Текст, "id=""view-packages"""), "Переключатель вида")
		.Больше(0);

	Ожидаем.Что(СтрНайти(Текст, "#view-files:checked ~ table.packages"), "Правило переключения")
		.Больше(0);

	Ожидаем.Что(ЧислоВхождений(Текст, "<script"), "Сценариев в отчёте")
		.Равно(1);

КонецПроцедуры

Функция Мутант(Знач Файл)

	Возврат Новый РезультатМутанта(
		Новый ОписаниеМутации("Условия", "> заменено на >=", 1, 1, ">=", 2),
		Файл,
		СостоянияМутанта.Убит());

КонецФункции

Функция Сформировать(Отчет)

	Путь = ВременныеФайлы().НовоеИмяФайла("html");

	Репортер = Новый РепортерHTML();
	Репортер.Сформировать(Отчет, Путь);

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат Текст;

КонецФункции

&Тест
Процедура ИмяБезКаталогаПишетсяРядом() Экспорт

	// mutatos run --html out.html: каталога в пути нет, создавать нечего.
	// Раньше отчёт на этом падал в ФС.ОбеспечитьКаталог с пустым путём

	// Дано

	ИсходныйКаталог = ТекущийКаталог();
	УстановитьТекущийКаталог(ВременныеФайлы().СоздатьКаталог());

	// Когда

	Попытка

		Репортер = Новый РепортерHTML();
		Репортер.Сформировать(ОтчетСМутантами(ФайлИсходника()), "отчёт.html");

	Исключение
		УстановитьТекущийКаталог(ИсходныйКаталог);
		ВызватьИсключение;
	КонецПопытки;

	Существует = Новый Файл(ОбъединитьПути(ТекущийКаталог(), "отчёт.html")).Существует();

	УстановитьТекущийКаталог(ИсходныйКаталог);

	// Тогда

	Ожидаем.Что(Существует, "Отчёт рядом с собой")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура БезПутиОтчетНеФормируется() Экспорт

	// Тогда

	Ожидаем.Что(Новый РепортерHTML())
		.Метод("Сформировать", ЗначенияПараметров(ОтчетСМутантами(ФайлИсходника()), ""))
		.ВыбрасываетИсключение();

КонецПроцедуры

Функция ЧислоВхождений(Знач Текст, Знач Подстрока)

	Возврат СтрЧислоВхождений(Текст, Подстрока);

КонецФункции

Функция ЗначенияПараметров(Знач Первый, Знач Второй)

	Параметры = Новый Массив();
	Параметры.Добавить(Первый);
	Параметры.Добавить(Второй);

	Возврат Параметры;

КонецФункции
