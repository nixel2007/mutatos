#Использовать asserts
#Использовать fs
#Использовать tempfiles
#Использовать autumn-logos
#Использовать "../src/core"

// Исполнитель проверяется на настоящем проекте с тестами: прогон идёт дочерними
// процессами, подменить их моком нельзя, да и проверять здесь надо именно то,
// что мутант доезжает до прогона в неизменном виде.

Перем _Исполнитель;
Перем _ВременныеФайлы;

// Собственный менеджер временных файлов: поднятие поделки стирает всё, что создано
// через общий модуль ВременныеФайлы - autumn-logos делает это при инициализации.
Функция ВременныеФайлы()

	Если _ВременныеФайлы = Неопределено Тогда
		_ВременныеФайлы = Новый МенеджерВременныхФайлов();
	КонецЕсли;

	Возврат _ВременныеФайлы;

КонецФункции

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт

	ВременныеФайлы().Удалить();

КонецПроцедуры

Функция Исполнитель()

	Если _Исполнитель = Неопределено Тогда

		Поделка = Новый Поделка();
		Поделка.ЗапуститьПриложение();

		_Исполнитель = Поделка.НайтиЖелудь("ИсполнительМутантов");

	КонецЕсли;

	Возврат _Исполнитель;

КонецФункции

// Проект с одним классом и тестом, который проверяет только сложение.
Функция ПодопытныйПроект()

	Проект = ВременныеФайлы().СоздатьКаталог();

	ЗаписатьФайл(ОбъединитьПути(Проект, "src/Классы/Считалка.os"), "
		|Функция Сложить(Знач Первое, Знач Второе) Экспорт
		|	Возврат Первое + Второе;
		|КонецФункции
		|
		|Функция Умножить(Знач Первое, Знач Второе) Экспорт
		|	Возврат Первое * Второе;
		|КонецФункции");

	ЗаписатьФайл(ОбъединитьПути(Проект, "tests/Считалка.os"), "
		|#Использовать asserts
		|#Использовать ""..""
		|
		|&Тест
		|Процедура СложениеСкладывает() Экспорт
		|	Ожидаем.Что(Новый Считалка().Сложить(2, 3)).Равно(5);
		|КонецПроцедуры");

	Возврат Проект;

КонецФункции

Процедура ЗаписатьФайл(Знач Путь, Знач Текст)

	ФС.ОбеспечитьКаталог(Новый Файл(Путь).Путь);

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();

КонецПроцедуры

Функция Задание(Проект, Знач Позиция, Знач Длина, Знач Текст, Знач НомерСтроки, Знач Файл = "src/Классы/Считалка.os")

	Мутация = Новый ОписаниеМутации("Тестовый", "тестовая мутация", Позиция, Длина, Текст, НомерСтроки);

	Возврат Новый Структура("Файл, Мутация",
		ОбъединитьПути(Проект, Файл),
		Мутация);

КонецФункции

Функция ПозицияОперации(Проект, Знач Операция)

	Чтение = Новый ЧтениеТекста(ОбъединитьПути(Проект, "src/Классы/Считалка.os"), КодировкаТекста.UTF8);
	Исходник = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат СтрНайти(Исходник, Операция);

КонецФункции

&Тест
Процедура ЗамеченнаяМутацияУбиваетМутанта() Экспорт

	// Дано

	Проект = ПодопытныйПроект();

	Задания = Новый Массив();
	Задания.Добавить(Задание(Проект, ПозицияОперации(Проект, "Первое + Второе") + 7, 1, "-", 2));

	// Когда

	Результаты = Исполнитель().ПроверитьМутантов(Проект, Задания);

	// Тогда

	Ожидаем.Что(Результаты[0].Состояние(), "Состояние мутанта")
		.Равно(СостоянияМутанта.Убит());

КонецПроцедуры

&Тест
Процедура НезамеченнаяМутацияОставляетМутантаЖивым() Экспорт

	// умножение тестами не проверяется

	// Дано

	Проект = ПодопытныйПроект();

	Задания = Новый Массив();
	Задания.Добавить(Задание(Проект, ПозицияОперации(Проект, "Первое * Второе") + 7, 1, "/", 6));

	// Когда

	Результаты = Исполнитель().ПроверитьМутантов(Проект, Задания);

	// Тогда

	Ожидаем.Что(Результаты[0].Состояние(), "Состояние мутанта")
		.Равно(СостоянияМутанта.Выжил());

КонецПроцедуры

&Тест
Процедура ОригиналПроектаНеИзменяется() Экспорт

	// мутанты живут в рабочих копиях, поэтому прерванный прогон
	// не оставляет проект в изменённом состоянии

	// Дано

	Проект = ПодопытныйПроект();
	ПутьКФайлу = ОбъединитьПути(Проект, "src/Классы/Считалка.os");

	Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ИсходноеСодержимое = Чтение.Прочитать();
	Чтение.Закрыть();

	Задания = Новый Массив();
	Задания.Добавить(Задание(Проект, ПозицияОперации(Проект, "Первое + Второе") + 7, 1, "-", 2));

	// Когда

	Исполнитель().ПроверитьМутантов(Проект, Задания);

	// Тогда

	Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	СодержимоеПослеПрогона = Чтение.Прочитать();
	Чтение.Закрыть();

	Ожидаем.Что(СодержимоеПослеПрогона, "Содержимое файла после прогона")
		.Равно(ИсходноеСодержимое);

КонецПроцедуры

&Тест
Процедура МутацииНеНакапливаютсяМеждуМутантами() Экспорт

	// Копии переиспользуются под следующего мутанта. Если исходник брать из копии,
	// второй мутант получит обе мутации сразу и результат станет неверным.

	// Дано

	Проект = ПодопытныйПроект();

	// обе мутации в непроверяемом умножении: по одной каждая должна выжить
	ПозицияУмножения = ПозицияОперации(Проект, "Первое * Второе");

	Задания = Новый Массив();
	Задания.Добавить(Задание(Проект, ПозицияУмножения + 7, 1, "/", 6));
	Задания.Добавить(Задание(Проект, ПозицияУмножения + 7, 1, "-", 6));

	// Когда

	// один поток, чтобы обоих мутантов проверила одна и та же копия
	Параметры = Новый ПараметрыПрогона();
	Параметры.ЧислоПотоков = 1;

	Результаты = Исполнитель().ПроверитьМутантов(Проект, Задания, 0, "", Параметры);

	// Тогда

	Ожидаем.Что(Результаты.Количество(), "Количество результатов")
		.Равно(2);

	Для Каждого Результат Из Результаты Цикл
		Ожидаем.Что(Результат.Состояние(), "Состояние мутанта")
			.Равно(СостоянияМутанта.Выжил());
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура МутацииРазныхФайловНеНакапливаются() Экспорт

	// Одна копия проверяет мутантов разных файлов подряд. Если прошлую мутацию
	// не вернуть на место, копия понесёт сразу две, и прогон будет судить не о том
	// мутанте, которого проверяет: первая мутация уронит тесты за вторую.

	// Дано

	Проект = ПодопытныйПроект();
	ДобавитьВторойФайл(Проект);

	Задания = Новый Массив();

	// убиваемая мутация в первом файле - тесты её замечают
	Задания.Добавить(Задание(Проект, ПозицияОперации(Проект, "Первое + Второе") + 7, 1, "-", 2));

	// мутация во втором файле, которую тесты не проверяют - она должна выжить
	Задания.Добавить(Задание(
		Проект,
		ПозицияВФайле(Проект, "src/Классы/Делилка.os", "Первое / Второе") + 7,
		1,
		"*",
		2,
		"src/Классы/Делилка.os"));

	// Когда

	// один поток, чтобы обоих мутантов проверила одна и та же копия
	Параметры = Новый ПараметрыПрогона();
	Параметры.ЧислоПотоков = 1;

	Результаты = Исполнитель().ПроверитьМутантов(Проект, Задания, 0, "", Параметры);

	// Тогда

	Ожидаем.Что(Результаты[0].Состояние(), "Состояние мутанта первого файла")
		.Равно(СостоянияМутанта.Убит());

	Ожидаем.Что(Результаты[1].Состояние(), "Состояние мутанта второго файла")
		.Равно(СостоянияМутанта.Выжил());

КонецПроцедуры

Процедура ДобавитьВторойФайл(Проект)

	ЗаписатьФайл(ОбъединитьПути(Проект, "src/Классы/Делилка.os"), "
		|Функция Разделить(Знач Первое, Знач Второе) Экспорт
		|	Возврат Первое / Второе;
		|КонецФункции");

КонецПроцедуры

Функция ПозицияВФайле(Проект, Знач ОтносительныйПуть, Знач Подстрока)

	Чтение = Новый ЧтениеТекста(ОбъединитьПути(Проект, ОтносительныйПуть), КодировкаТекста.UTF8);
	Исходник = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат СтрНайти(Исходник, Подстрока);

КонецФункции

&Тест
Процедура БезЗаданийПрогонНеЗапускается() Экспорт

	// Когда

	Результаты = Исполнитель().ПроверитьМутантов(ВременныеФайлы().СоздатьКаталог(), Новый Массив());

	// Тогда

	Ожидаем.Что(Результаты.Количество(), "Количество результатов")
		.Равно(0);

КонецПроцедуры
