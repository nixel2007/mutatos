#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать autumn-logos
#Использовать "../src/core"

// Юнит-тесты исполнителя мутантов. Проверяется только его собственная работа:
// сколько копий он попросит, в каком порядке отдаст задания пулу, что вернёт
// и что уберёт за собой. Что при этом делают копия, пул и процесс - забота
// их собственных тестов.

Перем _ВременныеФайлы;
Перем _ОтданныеЗадания;
// Отбор, доставшийся точке входа копии: наборы и методы
Перем _ОтборНаборов;
Перем _ОтборМетодов;

// Ответ мока пула: запоминает, в каком порядке исполнитель отдал задания.
Функция ЗапомнитьЗадания(ИнформацияОВызове) Экспорт

	_ОтданныеЗадания = ИнформацияОВызове.Параметры()[1];

	Возврат Новый Массив();

КонецФункции

Функция ВременныеФайлы()

	Если _ВременныеФайлы = Неопределено Тогда
		_ВременныеФайлы = Новый МенеджерВременныхФайлов();
	КонецЕсли;

	Возврат _ВременныеФайлы;

КонецФункции

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт

	ВременныеФайлы().Удалить();

КонецПроцедуры

Функция Исполнитель(Копии, Пул, Процессы = Неопределено, Знач ЧислоПотоков = 4)

	Фабрика = Мок.Получить(Тип("ФабрикаКопий"));
	Фабрика.Когда().ЧислоПотоков(Матчеры.ЛюбоеЗначение()).ТогдаВозвращает(ЧислоПотоков);
	Фабрика.Когда().СоздатьКопии(
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение())
		.ТогдаВозвращает(Копии);

	Генератор = Мок.Получить(Тип("ГенераторМутантов"));
	Генератор.Когда().СоздатьМутанта(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаВозвращает("текст мутанта");

	Возврат Новый ИсполнительМутантов(
		Генератор,
		Мок.Получить(Тип("ПрогрессПрогона")),
		Фабрика,
		Пул,
		?(Процессы = Неопределено, Мок.Получить(Тип("ЗапускательПроцессов")), Процессы),
		Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

КонецФункции

Функция Пул(Результаты = Неопределено)

	Пул = Мок.Получить(Тип("ПулПрогонов"));

	Пул.Когда().Прогнать(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаВозвращает(?(Результаты = Неопределено, Новый Массив(), Результаты));

	Возврат Пул;

КонецФункции

Функция Задание(Знач Тесты = Неопределено, Знач Таймаут = 0)

	Задание = Новый Структура("Файл, Мутация, Тесты, Таймаут",
		"/проект/Класс.os",
		Новый ОписаниеМутации("Арифметика", "+ на -", 10, 1, "-", 1),
		Тесты,
		Таймаут);

	Возврат Задание;

КонецФункции

// Тесты одного набора: отбор задания это пары «набор - метод».
Функция ТестыНабора(Знач Набор, Знач Метод = "Тест")

	Тесты = Новый Массив();
	Тесты.Добавить(Новый Структура("Набор, Метод", Набор, Метод));

	Возврат Тесты;

КонецФункции

Функция Задания(Знач Сколько)

	Результат = Новый Массив();

	Для Сч = 1 По Сколько Цикл
		Результат.Добавить(Задание());
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Копии(Знач Сколько)

	Результат = Новый Массив();

	Для Сч = 1 По Сколько Цикл
		Результат.Добавить(Мок.Получить(Тип("РабочаяКопия")));
	КонецЦикла;

	Возврат Результат;

КонецФункции

&Тест
Процедура БезЗаданийПрогонНеЗапускается() Экспорт

	// Дано

	Пул = Пул();

	// Когда

	Результаты = Исполнитель(Копии(1), Пул).ПроверитьМутантов("/проект", Новый Массив());

	// Тогда

	Ожидаем.Что(Результаты, "Результаты").ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура КопийНеБольшеЧемЗаданий() Экспорт

	// Копия стоит копирования проекта: заводить их больше, чем мутантов,
	// значит платить за то, чем никто не воспользуется

	// Дано

	Фабрика = Мок.Получить(Тип("ФабрикаКопий"));
	Фабрика.Когда().ЧислоПотоков(Матчеры.ЛюбоеЗначение()).ТогдаВозвращает(8);
	Фабрика.Когда().СоздатьКопии(
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение())
		.ТогдаВозвращает(Копии(2));

	Исполнитель = Новый ИсполнительМутантов(
		Мок.Получить(Тип("ГенераторМутантов")),
		Мок.Получить(Тип("ПрогрессПрогона")),
		Фабрика,
		Пул(),
		Мок.Получить(Тип("ЗапускательПроцессов")),
		Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

	// Когда

	Исполнитель.ПроверитьМутантов("/проект", Задания(2));

	// Тогда

	Фабрика.ПроверитьЧтоВызывалсяМетод().СоздатьКопии(
		"/проект",
		2,
		Матчеры.ЛюбоеЗначение(),
		Матчеры.ЛюбоеЗначение(),
		Матчеры.ЛюбоеЗначение());

КонецПроцедуры

&Тест
Процедура РезультатыПулаВозвращаютсяКакЕсть() Экспорт

	// Исполнитель не пересчитывает то, что собрал пул

	// Дано

	Ожидаемые = Новый Массив();
	Ожидаемые.Добавить("первый");
	Ожидаемые.Добавить("второй");

	// Когда

	Результаты = Исполнитель(Копии(1), Пул(Ожидаемые)).ПроверитьМутантов("/проект", Задания(2));

	// Тогда

	Ожидаем.Что(Результаты).РавноМассиву(Ожидаемые);

КонецПроцедуры

&Тест
Процедура ЗаданияОдинаковымОтборомИдутПодряд() Экспорт

	// Точка входа копии пересобирается на смену отбора тестов, поэтому задания
	// одной группы отдаются пулу подряд - иначе пересборка на каждого мутанта

	// Дано

	Первый  = Задание(ТестыНабора("НаборА"));
	Второй  = Задание(ТестыНабора("НаборБ"));
	Третий  = Задание(ТестыНабора("НаборА"));

	Задания = Новый Массив();
	Задания.Добавить(Первый);
	Задания.Добавить(Второй);
	Задания.Добавить(Третий);

	// Что именно отдали пулу, ловится ответом: он получает информацию о вызове
	Пул = Мок.Получить(Тип("ПулПрогонов"));
	Пул.Когда().Прогнать(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗапомнитьЗадания"));

	// Когда

	Исполнитель(Копии(1), Пул).ПроверитьМутантов("/проект", Задания);

	// Тогда

	Ожидаем.Что(_ОтданныеЗадания[0].Тесты[0].Набор, "Первое задание").Равно("НаборА");
	Ожидаем.Что(_ОтданныеЗадания[1].Тесты[0].Набор, "Второе задание").Равно("НаборА");
	Ожидаем.Что(_ОтданныеЗадания[2].Тесты[0].Набор, "Третье задание").Равно("НаборБ");

КонецПроцедуры

&Тест
Процедура КопииУдаляютсяПослеПрогона() Экспорт

	// Копия - это копия всего проекта: оставлять её во временном каталоге нельзя

	// Дано

	Копии = Копии(1);

	Фабрика = Мок.Получить(Тип("ФабрикаКопий"));
	Фабрика.Когда().ЧислоПотоков(Матчеры.ЛюбоеЗначение()).ТогдаВозвращает(1);
	Фабрика.Когда().СоздатьКопии(
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение())
		.ТогдаВозвращает(Копии);

	Исполнитель = Новый ИсполнительМутантов(
		Мок.Получить(Тип("ГенераторМутантов")),
		Мок.Получить(Тип("ПрогрессПрогона")),
		Фабрика,
		Пул(),
		Мок.Получить(Тип("ЗапускательПроцессов")),
		Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

	// Когда

	Исполнитель.ПроверитьМутантов("/проект", Задания(1));

	// Тогда

	Фабрика.ПроверитьЧтоВызывалсяМетод().УдалитьКопии(Копии);

КонецПроцедуры

&Тест
Процедура СорвавшийсяПрогонВсеРавноУбираетКопии() Экспорт

	// Дано

	Копии = Копии(1);

	Фабрика = Мок.Получить(Тип("ФабрикаКопий"));
	Фабрика.Когда().ЧислоПотоков(Матчеры.ЛюбоеЗначение()).ТогдаВозвращает(1);
	Фабрика.Когда().СоздатьКопии(
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение())
		.ТогдаВозвращает(Копии);

	Пул = Мок.Получить(Тип("ПулПрогонов"));
	Пул.Когда().Прогнать(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаВыбрасываетИсключение("Прогон сорвался");

	Исполнитель = Новый ИсполнительМутантов(
		Мок.Получить(Тип("ГенераторМутантов")),
		Мок.Получить(Тип("ПрогрессПрогона")),
		Фабрика,
		Пул,
		Мок.Получить(Тип("ЗапускательПроцессов")),
		Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

	// Когда

	Попытка
		Исполнитель.ПроверитьМутантов("/проект", Задания(1));
	Исключение
		// исключение пробрасывается дальше, здесь проверяется уборка
	КонецПопытки;

	// Тогда

	Фабрика.ПроверитьЧтоВызывалсяМетод().УдалитьКопии(Копии);

КонецПроцедуры

&Тест
Процедура ОтборЗаданияПереноситсяВТочкуВходаКопии() Экспорт

	// Карта называет тесты парами «набор - метод», а точка входа хочет их порознь:
	// файлы наборов и имена методов. Одинаковые наборы при этом не дублируются -
	// два теста одного файла означают один файл, а не два

	// Дано

	Копия = КопияСПереводомПутей();

	Тесты = Новый Массив();
	Тесты.Добавить(Новый Структура("Набор, Метод", "/проект/tests/Набор.os", "Складывает"));
	Тесты.Добавить(Новый Структура("Набор, Метод", "/проект/tests/Набор.os", "Вычитает"));

	// Когда

	Исполнитель(Копии(1), Пул()).Запустить(Копия, ЗаданиеСТестами(Тесты));

	// Тогда

	Ожидаем.Что(_ОтборНаборов, "Наборы отбора").РавноМассиву(СтрРазделить("/копия/tests/Набор.os", ","));
	Ожидаем.Что(_ОтборМетодов, "Методы отбора").РавноМассиву(СтрРазделить("Складывает,Вычитает", ","));

КонецПроцедуры

&Тест
Процедура НаборЦеликомМетодыНеОтбирает() Экспорт

	// Пустой метод означает «весь набор». Если оставить методы соседей по отбору,
	// набор обрежется до них, и мутанта проверит не то, что должно

	// Дано

	Копия = КопияСПереводомПутей();

	Тесты = Новый Массив();
	Тесты.Добавить(Новый Структура("Набор, Метод", "/проект/tests/Набор.os", "Складывает"));
	Тесты.Добавить(Новый Структура("Набор, Метод", "/проект/tests/Другой.os", ""));

	// Когда

	Исполнитель(Копии(1), Пул()).Запустить(Копия, ЗаданиеСТестами(Тесты));

	// Тогда

	Ожидаем.Что(_ОтборНаборов, "Наборы отбора").ИмеетДлину(2);
	Ожидаем.Что(_ОтборМетодов, "Методы отбора").ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура БезОтбораТочкаВходаПолучаетПустыеСписки() Экспорт

	// Пустой отбор означает «всеми тестами проекта»: так выходит без карты
	// и на строке, которой в карте не оказалось

	// Дано

	Копия = КопияСПереводомПутей();

	// Когда

	Исполнитель(Копии(1), Пул()).Запустить(Копия, ЗаданиеСТестами(Новый Массив()));

	// Тогда

	Ожидаем.Что(_ОтборНаборов, "Наборы отбора").ИмеетДлину(0);
	Ожидаем.Что(_ОтборМетодов, "Методы отбора").ИмеетДлину(0);

КонецПроцедуры

// Копия, переводящая пути проекта в пути копии: без перевода точка входа искала бы
// наборы там, где их нет. Заодно запоминает отбор - проверять надо именно его состав.
Функция КопияСПереводомПутей()

	Копия = Мок.Получить(Тип("РабочаяКопия"));

	Копия.Когда().ТочкаВхода().ТогдаВозвращает("/копия/точка.os");
	Копия.Когда().Каталог().ТогдаВозвращает("/копия");
	Копия.Когда().ПутьВКопии(Матчеры.ЛюбоеЗначение()).ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ВКопию"));
	Копия.Когда().ПерестроитьТочкуВхода(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗапомнитьОтбор"));

	Возврат Копия;

КонецФункции

Функция ВКопию(ИнформацияОВызове) Экспорт

	Возврат СтрЗаменить(ИнформацияОВызове.Параметры()[0], "/проект/", "/копия/");

КонецФункции

Функция ЗапомнитьОтбор(ИнформацияОВызове) Экспорт

	Параметры = ИнформацияОВызове.Параметры();

	_ОтборНаборов = Параметры[0];
	_ОтборМетодов = Параметры[1];

	Возврат Неопределено;

КонецФункции

Функция ЗаданиеСТестами(Знач Тесты)

	Файл = ВременныеФайлы().НовоеИмяФайла("os");

	Запись = Новый ЗаписьТекста(Файл, КодировкаТекста.UTF8);
	Запись.Записать("Функция Сложить() Экспорт КонецФункции");
	Запись.Закрыть();

	Задание = Задание(Тесты);
	Задание.Файл = Файл;

	Возврат Задание;

КонецФункции

&Тест
Процедура ЗапускОтдаетПроцессуТочкуВходаКопии() Экспорт

	// Дано

	Файл = ВременныеФайлы().НовоеИмяФайла("os");
	Запись = Новый ЗаписьТекста(Файл, КодировкаТекста.UTF8);
	Запись.Записать("Функция Сложить() Экспорт КонецФункции");
	Запись.Закрыть();

	Копия = Мок.Получить(Тип("РабочаяКопия"));
	Копия.Когда().ТочкаВхода().ТогдаВозвращает("/копия/точка.os");
	Копия.Когда().Каталог().ТогдаВозвращает("/копия");

	Процессы = Мок.Получить(Тип("ЗапускательПроцессов"));

	Задание = Задание();
	Задание.Файл = Файл;

	// Когда

	Исполнитель(Копии(1), Пул(), Процессы).Запустить(Копия, Задание);

	// Тогда

	Процессы.ПроверитьЧтоВызывалсяМетод().Запустить("oscript ""/копия/точка.os""", "/копия");

КонецПроцедуры

&Тест
Процедура СобственныйТаймаутЗаданияПеревешивает() Экспорт

	// Мутант с отбором гоняет не все тесты проекта, и мерить его терпение
	// полным прогоном значит ждать впустую

	// Дано

	Исполнитель = Исполнитель(Копии(1), Пул());

	// Когда

	Исполнитель.ПроверитьМутантов("/проект", Задания(1));

	// Тогда

	Ожидаем.Что(Исполнитель.Таймаут(Задание(Неопределено, 500)), "Свой таймаут").Равно(500);

КонецПроцедуры

&Тест
Процедура БезСвоегоТаймаутаБеретсяОбщий() Экспорт

	// Дано

	Исполнитель = Исполнитель(Копии(1), Пул());

	// Когда

	Исполнитель.ПроверитьМутантов("/проект", Задания(1), 900);

	// Тогда

	Ожидаем.Что(Исполнитель.Таймаут(Задание()), "Общий таймаут").Равно(900);

КонецПроцедуры

&Тест
Процедура НулевойКодВозвратаОставляетМутантаЖивым() Экспорт

	// Тесты прошли - значит мутацию никто не заметил

	// Когда

	Результат = Исполнитель(Копии(1), Пул()).Завершено(Задание(), 0, 120, "");

	// Тогда

	Ожидаем.Что(Результат.Состояние(), "Состояние мутанта").Равно(СостоянияМутанта.Выжил());

КонецПроцедуры

&Тест
Процедура НенулевойКодВозвратаУбиваетМутанта() Экспорт

	// Когда

	Результат = Исполнитель(Копии(1), Пул()).Завершено(Задание(), 1, 120, "");

	// Тогда

	Ожидаем.Что(Результат.Состояние(), "Состояние мутанта").Равно(СостоянияМутанта.Убит());

КонецПроцедуры

&Тест
Процедура ПрерванныйПрогонСчитаетсяТаймаутом() Экспорт

	// Мутация могла зациклить выполнение - такой мутант тоже замечен

	// Когда

	Результат = Исполнитель(Копии(1), Пул()).Прервано(Задание(), 5000, "");

	// Тогда

	Ожидаем.Что(Результат.Состояние(), "Состояние мутанта").Равно(СостоянияМутанта.Таймаут());

КонецПроцедуры
