#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать autumn-logos
#Использовать "../src/core"
#Использовать "./fixtures"

// Исполнитель проверяется без настоящего прогона тестов: запускатель подменён моком,
// иначе каждый тест ждал бы несколько секунд.

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

// Каталог, который исполнитель получает как рабочий. Прогон подменён моком,
// поэтому каталог нужен только как значение параметра.
Функция РабочийКаталог()

	Возврат ТекущийКаталог();

КонецФункции

Функция ФайлСИсходником(Знач Исходник)

	Путь = ВременныеФайлы.НовоеИмяФайла("os");

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Исходник);
	Запись.Закрыть();

	Возврат Путь;

КонецФункции

Функция ПрочитатьФайл(Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат Текст;

КонецФункции

Функция Мутация()

	Возврат Новый ОписаниеМутации("Арифметика", "+ заменено на -", 11, 1, "-", 1);

КонецФункции

Функция ЗапускательСРезультатом(Знач Успешно, Знач КодВозврата, Знач Таймаут = Ложь)

	Прогон = Новый РезультатПрогона(Успешно, КодВозврата, 100, "вывод прогона", Таймаут);

	Запускатель = Мок.Получить(Тип("ЗапускательТестовOneUnit"));
	Запускатель.Когда().Прогнать(Матчеры.ЛюбаяСтрока(), Матчеры.ЛюбоеЗначение()).ТогдаВозвращает(Прогон);

	Возврат Запускатель;

КонецФункции

Функция ИсполнительСЗапускателем(Запускатель)

	Генератор = Новый ГенераторМутантов(Неопределено);
	Лог = Логирование.ПолучитьЛог("oscript.lib.mutatos.tests");

	Возврат Новый ИсполнительМутантов(Генератор, Запускатель, Лог);

КонецФункции

&Тест
Процедура УпавшиеТестыУбиваютМутанта() Экспорт

	// Дано

	Исполнитель = ИсполнительСЗапускателем(ЗапускательСРезультатом(Ложь, 1));
	Путь = ФайлСИсходником("Сумма = А + Б;");

	// Когда

	Результат = Исполнитель.ПроверитьМутанта(РабочийКаталог(), Путь, Мутация());

	// Тогда

	Ожидаем.Что(Результат.Состояние(), "Состояние мутанта")
		.Равно(СостоянияМутанта.Убит());

КонецПроцедуры

&Тест
Процедура ЗеленыеТестыОставляютМутантаЖивым() Экспорт

	// Дано

	Исполнитель = ИсполнительСЗапускателем(ЗапускательСРезультатом(Истина, 0));
	Путь = ФайлСИсходником("Сумма = А + Б;");

	// Когда

	Результат = Исполнитель.ПроверитьМутанта(РабочийКаталог(), Путь, Мутация());

	// Тогда

	Ожидаем.Что(Результат.Состояние(), "Состояние мутанта")
		.Равно(СостоянияМутанта.Выжил());

КонецПроцедуры

&Тест
Процедура ПрерванныйПоВремениПрогонСчитаетсяУбийством() Экспорт

	// Дано

	Исполнитель = ИсполнительСЗапускателем(ЗапускательСРезультатом(Ложь, 1, Истина));
	Путь = ФайлСИсходником("Сумма = А + Б;");

	// Когда

	Результат = Исполнитель.ПроверитьМутанта(РабочийКаталог(), Путь, Мутация());

	// Тогда

	Ожидаем.Что(Результат.Состояние(), "Состояние мутанта")
		.Равно(СостоянияМутанта.Таймаут());

	Ожидаем.Что(СостоянияМутанта.ЭтоУбийство(Результат.Состояние()), "Таймаут - это убийство")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НештатноЗавершенныйПрогонДаетОшибку() Экспорт

	// Дано

	Исполнитель = ИсполнительСЗапускателем(ЗапускательСРезультатом(Ложь, -1));
	Путь = ФайлСИсходником("Сумма = А + Б;");

	// Когда

	Результат = Исполнитель.ПроверитьМутанта(РабочийКаталог(), Путь, Мутация());

	// Тогда

	Ожидаем.Что(Результат.Состояние(), "Состояние мутанта")
		.Равно(СостоянияМутанта.Ошибка());

КонецПроцедуры

&Тест
Процедура ФайлВосстанавливаетсяПослеПрогона() Экспорт

	// Дано

	Исходник = "Сумма = А + Б;";
	Исполнитель = ИсполнительСЗапускателем(ЗапускательСРезультатом(Ложь, 1));
	Путь = ФайлСИсходником(Исходник);

	// Когда

	Исполнитель.ПроверитьМутанта(РабочийКаталог(), Путь, Мутация());

	// Тогда

	Ожидаем.Что(ПрочитатьФайл(Путь), "Содержимое файла после прогона")
		.Равно(Исходник);

КонецПроцедуры

&Тест
Процедура ФайлВосстанавливаетсяДажеПриИсключенииВПрогоне() Экспорт

	// Дано

	Исходник = "Сумма = А + Б;";

	Запускатель = Мок.Получить(Тип("ЗапускательТестовOneUnit"));
	Запускатель.Когда().Прогнать(Матчеры.ЛюбаяСтрока(), Матчеры.ЛюбоеЗначение())
		.ТогдаВыбрасываетИсключение(Новый ИнформацияОбОшибке("Прогон сорвался", Новый Структура));

	Исполнитель = ИсполнительСЗапускателем(Запускатель);
	Путь = ФайлСИсходником(Исходник);

	// Когда

	Попытка
		Исполнитель.ПроверитьМутанта(РабочийКаталог(), Путь, Мутация());
	Исключение
		// исключение пробрасывается наружу, это ожидаемо
	КонецПопытки;

	// Тогда

	Ожидаем.Что(ПрочитатьФайл(Путь), "Содержимое файла после сорванного прогона")
		.Равно(Исходник);

КонецПроцедуры

&Тест
Процедура ВоВремяПрогонаФайлСодержитМутанта() Экспорт

	// Дано

	Исходник = "Сумма = А + Б;";
	Путь = ФайлСИсходником(Исходник);

	// запускатель, который читает файл в момент прогона
	Запускатель = Новый ЧитающийЗапускатель(Путь);
	Исполнитель = ИсполнительСЗапускателем(Запускатель);

	// Когда

	Исполнитель.ПроверитьМутанта(РабочийКаталог(), Путь, Мутация());

	// Тогда

	Ожидаем.Что(Запускатель.ПрочитанныйИсходник(), "Исходник в момент прогона")
		.Равно("Сумма = А - Б;");

КонецПроцедуры

&Тест
Процедура РезультатЗнаетМутациюИФайл() Экспорт

	// Дано

	Исполнитель = ИсполнительСЗапускателем(ЗапускательСРезультатом(Ложь, 1));
	Путь = ФайлСИсходником("Сумма = А + Б;");

	// Когда

	Результат = Исполнитель.ПроверитьМутанта(РабочийКаталог(), Путь, Мутация());

	// Тогда

	Ожидаем.Что(Результат.Файл(), "Файл")
		.Равно(Путь);

	Ожидаем.Что(Результат.Мутация().Мутатор(), "Мутатор")
		.Равно("Арифметика");

	Ожидаем.Что(Результат.Длительность(), "Длительность")
		.Равно(100);

КонецПроцедуры
