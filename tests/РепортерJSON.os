#Использовать asserts
#Использовать json
#Использовать tempfiles
#Использовать "../src/core"

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

Функция ОтчетСМутантами()

	Отчет = Новый ОтчетПрогона();

	Убитый = Новый ОписаниеМутации("Арифметика", "+ заменено на -", 10, 1, "-", 7);
	Убитый.УстановитьИмяМетода("Сложить");
	Отчет.Добавить(Новый РезультатМутанта(Убитый, "Калькулятор.os", СостоянияМутанта.Убит(), 120));

	Выживший = Новый ОписаниеМутации("Условия", "> заменено на >=", 20, 1, ">=", 17);
	Выживший.УстановитьИмяМетода("Максимум");
	Отчет.Добавить(Новый РезультатМутанта(Выживший, "Калькулятор.os", СостоянияМутанта.Выжил(), 130));

	Возврат Отчет;

КонецФункции

Функция ПрочитатьОтчет(Знач Путь)

	Чтение = Новый ЧтениеJSON();
	Чтение.ОткрытьФайл(Путь);
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Возврат Данные;

КонецФункции

Функция СформироватьОтчет()

	Путь = ВременныеФайлы.НовоеИмяФайла("json");

	Репортер = Новый РепортерJSON();
	Репортер.Сформировать(ОтчетСМутантами(), Путь);

	Возврат ПрочитатьОтчет(Путь);

КонецФункции

&Тест
Процедура ОтчетСодержитСтатистику() Экспорт

	// Когда

	Данные = СформироватьОтчет();

	// Тогда

	Ожидаем.Что(Данные["статистика"]["всего"], "Всего мутантов")
		.Равно(2);

	Ожидаем.Что(Данные["статистика"]["убито"], "Убито")
		.Равно(1);

	Ожидаем.Что(Данные["статистика"]["индекс_мутаций"], "Индекс мутаций")
		.Равно(50);

КонецПроцедуры

&Тест
Процедура ОтчетСодержитКаждогоМутанта() Экспорт

	// Когда

	Данные = СформироватьОтчет();

	// Тогда

	Ожидаем.Что(Данные["мутанты"].Количество(), "Количество мутантов в отчёте")
		.Равно(2);

КонецПроцедуры

&Тест
Процедура МутантОписанПолностью() Экспорт

	// Когда

	Мутант = СформироватьОтчет()["мутанты"][1];

	// Тогда

	Ожидаем.Что(Мутант["состояние"], "Состояние")
		.Равно("Выжил");

	Ожидаем.Что(Мутант["мутатор"], "Мутатор")
		.Равно("Условия");

	Ожидаем.Что(Мутант["строка"], "Строка")
		.Равно(17);

	Ожидаем.Что(Мутант["метод"], "Метод")
		.Равно("Максимум");

	Ожидаем.Что(Мутант["длительность_мс"], "Длительность")
		.Равно(130);

КонецПроцедуры

&Тест
Процедура БезПутиОтчетНеФормируется() Экспорт

	// Тогда

	Ожидаем.Что(Новый РепортерJSON())
		.Метод("Сформировать", ЗначенияПараметров(ОтчетСМутантами(), ""))
		.ВыбрасываетИсключение();

КонецПроцедуры

Функция ЗначенияПараметров(Знач Первый, Знач Второй)

	Параметры = Новый Массив();
	Параметры.Добавить(Первый);
	Параметры.Добавить(Второй);

	Возврат Параметры;

КонецФункции
