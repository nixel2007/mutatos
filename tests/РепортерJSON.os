#Использовать asserts
#Использовать json
#Использовать tempfiles
#Использовать "../src/core"

// Отчёт пишется по схеме mutation-testing-elements: её понимают чужие инструменты,
// поэтому проверяются именно её имена и значения, а не удобство чтения.

Перем _ВременныеФайлы;

// Собственный менеджер временных файлов, а не общий: поднятие поделки стирает всё,
// что создано через общий модуль ВременныеФайлы - autumn-logos делает это при инициализации.
Функция ВременныеФайлы()

	Если _ВременныеФайлы = Неопределено Тогда
		_ВременныеФайлы = Новый МенеджерВременныхФайлов();
	КонецЕсли;

	Возврат _ВременныеФайлы;

КонецФункции

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт

	ВременныеФайлы().Удалить();

КонецПроцедуры

Функция ФайлИсходника()

	Путь = ВременныеФайлы().НовоеИмяФайла("os");

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку("Функция Максимум(А, Б)");
	Запись.ЗаписатьСтроку("	Возврат ?(А > Б, А, Б);");
	Запись.ЗаписатьСтроку("КонецФункции");
	Запись.Закрыть();

	Возврат Путь;

КонецФункции

// Смещение символа в файле - его-то и знает мутатор.
Функция ПозицияСимвола(Знач Файл, Знач Подстрока)

	Чтение = Новый ЧтениеТекста(Файл, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат СтрНайти(Текст, Подстрока);

КонецФункции

// Мутация ">" на ">=" во второй строке исходника: "	Возврат ?(А > Б, А, Б);".
// Сравнение стоит в 14-й колонке - на неё и должно указывать смещение после пересчёта.
Функция ОтчетСМутантами(Знач Файл)

	Отчет = Новый ОтчетПрогона();

	Убитый = Новый ОписаниеМутации("Арифметика", "+ заменено на -", 1, 1, "-", 1);
	Убитый.УстановитьИмяМетода("Максимум");
	Отчет.Добавить(Новый РезультатМутанта(Убитый, Файл, СостоянияМутанта.Убит(), 120));

	Выживший = Новый ОписаниеМутации("Условия", "> заменено на >=", ПозицияСимвола(Файл, "> Б"), 1, ">=", 2);
	Выживший.УстановитьИмяМетода("Максимум");
	Отчет.Добавить(Новый РезультатМутанта(Выживший, Файл, СостоянияМутанта.Выжил(), 130));

	Возврат Отчет;

КонецФункции

Функция СформироватьОтчет(Знач Файл)

	Путь = ВременныеФайлы().НовоеИмяФайла("json");

	Репортер = Новый РепортерJSON();
	Репортер.Сформировать(ОтчетСМутантами(Файл), Путь);

	Чтение = Новый ЧтениеJSON();
	Чтение.ОткрытьФайл(Путь);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Данные;

КонецФункции

Функция ЕдинственныйФайл(Данные)

	Для Каждого Элемент Из Данные.Получить("files") Цикл
		Возврат Элемент.Значение;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&Тест
Процедура ОтчетСоответствуетСхеме() Экспорт

	// Когда

	Данные = СформироватьОтчет(ФайлИсходника());

	// Тогда

	Ожидаем.Что(Данные.Получить("schemaVersion"), "Версия схемы")
		.Заполнено();

	Ожидаем.Что(Данные.Получить("files").Количество(), "Файлов в отчёте")
		.Равно(1);

КонецПроцедуры

&Тест
Процедура ФайлНесетИсходникИМутантов() Экспорт

	// просмотрщику схемы нужен исходник целиком: мутанты показываются прямо в коде

	// Когда

	ДанныеФайла = ЕдинственныйФайл(СформироватьОтчет(ФайлИсходника()));

	// Тогда

	Ожидаем.Что(СтрНайти(ДанныеФайла.Получить("source"), "КонецФункции"), "Исходник файла")
		.Больше(0);

	Ожидаем.Что(ДанныеФайла.Получить("mutants").Количество(), "Мутантов в файле")
		.Равно(2);

КонецПроцедуры

&Тест
Процедура МутантОписанПоСхеме() Экспорт

	// Когда

	Мутант = ЕдинственныйФайл(СформироватьОтчет(ФайлИсходника())).Получить("mutants")[1];

	// Тогда

	Ожидаем.Что(Мутант.Получить("mutatorName"), "Имя мутатора")
		.Равно("Условия");

	Ожидаем.Что(Мутант.Получить("replacement"), "Замена")
		.Равно(">=");

	Ожидаем.Что(Мутант.Получить("status"), "Состояние")
		.Равно("Survived");

	Ожидаем.Что(Мутант.Получить("duration"), "Длительность")
		.Равно(130);

КонецПроцедуры

&Тест
Процедура СмещениеПревращаетсяВСтрокуИКолонку() Экспорт

	// Схема адресует мутацию строкой и колонкой, а мутатор знает только смещение в тексте.
	// Ошибка в пересчёте молча увела бы мутанта на чужую строку

	// Когда

	Мутант = ЕдинственныйФайл(СформироватьОтчет(ФайлИсходника())).Получить("mutants")[1];

	// Тогда

	Начало = Мутант.Получить("location").Получить("start");

	Ожидаем.Что(Начало.Получить("line"), "Строка мутации")
		.Равно(2);

	Ожидаем.Что(Начало.Получить("column"), "Колонка мутации")
		.Равно(14);

	Ожидаем.Что(Мутант.Получить("location").Получить("end").Получить("column"), "Колонка конца мутации")
		.Равно(15);

КонецПроцедуры

&Тест
Процедура СостоянияПереводятсяВИменаСхемы() Экспорт

	// Дано

	Файл = ФайлИсходника();
	Отчет = Новый ОтчетПрогона();
	Мутация = Новый ОписаниеМутации("Условия", "> заменено на >=", ПозицияСимвола(Файл, "> Б"), 1, ">=", 2);
	Отчет.Добавить(Новый РезультатМутанта(Мутация, Файл, СостоянияМутанта.БезПокрытия()));

	Путь = ВременныеФайлы().НовоеИмяФайла("json");

	// Когда

	Репортер = Новый РепортерJSON();
	Репортер.Сформировать(Отчет, Путь);

	Чтение = Новый ЧтениеJSON();
	Чтение.ОткрытьФайл(Путь);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	// Тогда

	Ожидаем.Что(ЕдинственныйФайл(Данные).Получить("mutants")[0].Получить("status"), "Состояние")
		.Равно("NoCoverage");

КонецПроцедуры

&Тест
Процедура БезПутиОтчетНеФормируется() Экспорт

	// Тогда

	Ожидаем.Что(Новый РепортерJSON())
		.Метод("Сформировать", ЗначенияПараметров(ОтчетСМутантами(ФайлИсходника()), ""))
		.ВыбрасываетИсключение();

КонецПроцедуры

Функция ЗначенияПараметров(Знач Первый, Знач Второй)

	Параметры = Новый Массив();
	Параметры.Добавить(Первый);
	Параметры.Добавить(Второй);

	Возврат Параметры;

КонецФункции
