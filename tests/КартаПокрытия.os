#Использовать asserts
#Использовать "../src/core"

&Тест
Процедура ОтмеченнаяСтрокаСчитаетсяПокрытой() Экспорт

	// Дано

	Карта = Новый КартаПокрытия();
	Карта.Отметить("/проект/Класс.os", 10);

	// Тогда

	Ожидаем.Что(Карта.Покрыта("/проект/Класс.os", 10), "Отмеченная строка")
		.ЭтоИстина();

	Ожидаем.Что(Карта.Покрыта("/проект/Класс.os", 11), "Соседняя строка")
		.ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПутиСравниваютсяБезУчетаРазделителей() Экспорт

	// пути из отчёта о покрытии и пути мутируемых файлов приходят из разных источников

	// Дано

	Карта = Новый КартаПокрытия();
	Карта.Отметить("C:\проект\Класс.os", 5);

	// Тогда

	Ожидаем.Что(Карта.Покрыта("C:/проект/Класс.os", 5), "Тот же путь с другими разделителями")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПутиСравниваютсяБезУчетаРегистра() Экспорт

	// Дано

	Карта = Новый КартаПокрытия();
	Карта.Отметить("/Проект/Класс.os", 5);

	// Тогда

	Ожидаем.Что(Карта.Покрыта("/проект/класс.os", 5), "Тот же путь в другом регистре")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ФайлБезДанныхОтличаетсяОтФайлаБезПокрытия() Экспорт

	// про файл, которого нет в отчёте, ничего не известно;
	// про файл с непокрытыми строками известно, что тесты его не выполняют

	// Дано

	Карта = Новый КартаПокрытия();
	Карта.ОтметитьФайл("/проект/НепокрытыйКласс.os");

	// Тогда

	Ожидаем.Что(Карта.ЕстьДанные("/проект/НепокрытыйКласс.os"), "Данные о файле из отчёта")
		.ЭтоИстина();

	Ожидаем.Что(Карта.ЕстьДанные("/проект/ДругойКласс.os"), "Данные о файле вне отчёта")
		.ЭтоЛожь();

	Ожидаем.Что(Карта.Покрыта("/проект/НепокрытыйКласс.os", 1), "Строка непокрытого файла")
		.ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПустаяКартаНичегоНеЗнает() Экспорт

	// Дано

	Карта = Новый КартаПокрытия();

	// Тогда

	Ожидаем.Что(Карта.КоличествоПокрытыхСтрок(), "Количество покрытых строк")
		.Равно(0);

	Ожидаем.Что(Карта.ЕстьДанные("/проект/Класс.os"), "Данные о файле")
		.ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СтрокиРазныхФайловНеПутаются() Экспорт

	// Дано

	Карта = Новый КартаПокрытия();
	Карта.Отметить("/проект/Первый.os", 7);

	// Тогда

	Ожидаем.Что(Карта.Покрыта("/проект/Второй.os", 7), "Та же строка другого файла")
		.ЭтоЛожь();

КонецПроцедуры
