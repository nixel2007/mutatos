#Использовать asserts
#Использовать moskito
#Использовать autumn-logos
#Использовать "../src/core"

// Проверяется выбор способа запуска: прямой запуск ядра OneUnit или его командная строка.
// Кто именно прогнал тесты, видно по выводу прогона - его и отдают моки.

Функция Запускатель(Знач ЯдроДоступно, Знач Способ = "ядро")

	Возврат Новый ЗапускательТестов(
		ЧерезЯдро(ЯдроДоступно),
		ЧерезКоманднуюСтроку(),
		Способ,
		Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

КонецФункции

Функция ЧерезЯдро(Знач Доступно)

	Запускатель = Мок.Получить(Тип("ЗапускательТестовЯдро"));

	Запускатель.Когда().Доступен(Матчеры.ЛюбоеЗначение()).ТогдаВозвращает(Доступно);
	НастроитьПрогон(Запускатель, "ядро");

	Возврат Запускатель;

КонецФункции

Функция ЧерезКоманднуюСтроку()

	Запускатель = Мок.Получить(Тип("ЗапускательТестовOneUnit"));

	НастроитьПрогон(Запускатель, "командная строка");

	Возврат Запускатель;

КонецФункции

Процедура НастроитьПрогон(Запускатель, Знач Имя)

	Запускатель.Когда()
		.Прогнать(
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение())
		.ТогдаВозвращает(Новый РезультатПрогона(Истина, 0, 100, Имя));

КонецПроцедуры

&Тест
Процедура ПриДоступномЯдреЗапускаетсяЯдро() Экспорт

	// прямой запуск ядра вдвое быстрее: командная строка порождает дочерний процесс

	// Когда

	Прогон = Запускатель(Истина).Прогнать("/проект");

	// Тогда

	Ожидаем.Что(Прогон.Вывод(), "Кто выполнил прогон")
		.Равно("ядро");

КонецПроцедуры

&Тест
Процедура БезЯдраЗапускаетсяКоманднаяСтрока() Экспорт

	// Когда

	Прогон = Запускатель(Ложь).Прогнать("/проект");

	// Тогда

	Ожидаем.Что(Прогон.Вывод(), "Кто выполнил прогон")
		.Равно("командная строка");

КонецПроцедуры

&Тест
Процедура СпособМожноЗадатьЯвно() Экспорт

	// Когда

	Прогон = Запускатель(Истина, "cli").Прогнать("/проект");

	// Тогда

	Ожидаем.Что(Прогон.Вывод(), "Кто выполнил прогон")
		.Равно("командная строка");

КонецПроцедуры
