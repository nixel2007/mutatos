#Использовать asserts
#Использовать "../src/core"

// Карта решает, какими тестами проверять мутанта. Ошибка здесь не замедляет прогон,
// а искажает его итог: потерянный набор превращает убитого мутанта в выжившего.

Функция Карта()

	Карта = Новый КартаТестов();
	Карта.Отметить("tests/Сложение.os", "src/Калькулятор.os", 7);
	Карта.Отметить("tests/Округление.os", "src/Калькулятор.os", 7);
	Карта.Отметить("tests/Округление.os", "src/Калькулятор.os", 12);

	Возврат Карта;

КонецФункции

&Тест
Процедура СтрокуВозвращаютВсеПокрывшиеЕеНаборы() Экспорт

	// Когда

	Наборы = Карта().НаборыСтроки("src/Калькулятор.os", 7);

	// Тогда

	Ожидаем.Что(Наборы.Количество(), "Наборов на строке")
		.Равно(2);

	Ожидаем.Что(Наборы).Содержит("tests/Сложение.os");
	Ожидаем.Что(Наборы).Содержит("tests/Округление.os");

КонецПроцедуры

&Тест
Процедура НаборыВозвращаютсяВУстойчивомПорядке() Экспорт

	// По списку наборов задания собираются в группы, а группа - это одна пересборка
	// точки входа. Плавающий порядок дробил бы группы на пустом месте

	// Когда

	Наборы = Карта().НаборыСтроки("src/Калькулятор.os", 7);

	// Тогда

	Ожидаем.Что(Наборы[0], "Первый набор")
		.Равно("tests/Округление.os");

	Ожидаем.Что(Наборы[1], "Второй набор")
		.Равно("tests/Сложение.os");

КонецПроцедуры

&Тест
Процедура НепокрытаяСтрокаНеДаетНаборов() Экспорт

	// Когда

	Наборы = Карта().НаборыСтроки("src/Калькулятор.os", 99);

	// Тогда

	Ожидаем.Что(Наборы.Количество(), "Наборов на строке")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ПутиСравниваютсяБезОглядкиНаРазделителиИРегистр() Экспорт

	// пути мутируемых файлов и пути из статистики выполнения приходят из разных мест

	// Когда

	Наборы = Карта().НаборыСтроки("SRC\Калькулятор.os", 7);

	// Тогда

	Ожидаем.Что(Наборы.Количество(), "Наборов на строке")
		.Равно(2);

КонецПроцедуры

&Тест
Процедура ПустаяКартаНеЗаполнена() Экспорт

	// Тогда

	Ожидаем.Что(Новый КартаТестов().Заполнена(), "Пустая карта заполнена")
		.ЭтоЛожь();

	Ожидаем.Что(Карта().Заполнена(), "Карта с наборами заполнена")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПокрытиеНабораПереноситсяЦеликом() Экспорт

	// Дано

	Покрытие = Новый КартаПокрытия();
	Покрытие.Отметить("src/Калькулятор.os", 3);
	Покрытие.Отметить("src/Калькулятор.os", 4);

	Карта = Новый КартаТестов();

	// Когда

	Карта.ОтметитьПокрытие("tests/Сложение.os", Покрытие);

	// Тогда

	Ожидаем.Что(Карта.КоличествоНаборов(), "Наборов в карте")
		.Равно(1);

	Ожидаем.Что(Карта.НаборыСтроки("src/Калькулятор.os", 4).Количество(), "Наборов на строке")
		.Равно(1);

КонецПроцедуры
