#Использовать asserts
#Использовать "../src/core"

// Карта решает, какими тестами проверять мутанта. Ошибка здесь не замедляет прогон,
// а искажает его итог: потерянный тест превращает убитого мутанта в выжившего.

Функция Карта()

	Карта = Новый КартаТестов();
	Карта.Отметить("tests/Сложение.os", "Складывает", "src/Калькулятор.os", 7);
	Карта.Отметить("tests/Округление.os", "Округляет", "src/Калькулятор.os", 7);
	Карта.Отметить("tests/Округление.os", "Округляет", "src/Калькулятор.os", 12);

	Возврат Карта;

КонецФункции

&Тест
Процедура СтрокуВозвращаютВсеПокрывшиеЕеТесты() Экспорт

	// Когда

	Тесты = Карта().ТестыСтроки("src/Калькулятор.os", 7);

	// Тогда

	Ожидаем.Что(Тесты.Количество(), "Тестов на строке")
		.Равно(2);

	Ожидаем.Что(Имена(Тесты)).Содержит("tests/Сложение.os#Складывает");
	Ожидаем.Что(Имена(Тесты)).Содержит("tests/Округление.os#Округляет");

КонецПроцедуры

&Тест
Процедура ОдинНаборРазнымиТестамиДаетРазныеЗаписи() Экспорт

	// Отбор идёт по тестам, а не по файлам: два теста одного набора покрывают разное,
	// и мутанту нужен тот, что действительно выполняет его строку

	// Дано

	Карта = Новый КартаТестов();
	Карта.Отметить("tests/Калькулятор.os", "Складывает", "src/Калькулятор.os", 7);
	Карта.Отметить("tests/Калькулятор.os", "Вычитает", "src/Калькулятор.os", 12);

	// Тогда

	Ожидаем.Что(Карта.ТестыСтроки("src/Калькулятор.os", 7).Количество(), "Тестов на строке 7")
		.Равно(1);

	Ожидаем.Что(Карта.ТестыСтроки("src/Калькулятор.os", 7)[0].Метод, "Метод строки 7")
		.Равно("Складывает");

	Ожидаем.Что(Карта.КоличествоТестов(), "Тестов в карте")
		.Равно(2);

КонецПроцедуры

&Тест
Процедура СтрокиФайлаОтмечаютсяОдинаковоСПострочнымиОтметками() Экспорт

	// Строки файла отмечаются пачкой ради цены: имя теста и нормализованный путь
	// для них одни и те же. Считать иначе, чем построчный вариант, она не должна

	// Дано

	Пачкой = Новый КартаТестов();
	Пачкой.ОтметитьСтрокиФайла("tests/Набор.os", "Складывает", "SRC\Калькулятор.os", Строки(7, 12));

	Построчно = Новый КартаТестов();
	Построчно.Отметить("tests/Набор.os", "Складывает", "SRC\Калькулятор.os", 7);
	Построчно.Отметить("tests/Набор.os", "Складывает", "SRC\Калькулятор.os", 12);

	// Тогда

	Ожидаем.Что(Имена(Пачкой.ТестыСтроки("src/Калькулятор.os", 7)), "Тесты строки 7")
		.РавноМассиву(Имена(Построчно.ТестыСтроки("src/Калькулятор.os", 7)));

	Ожидаем.Что(Имена(Пачкой.ТестыСтроки("src/Калькулятор.os", 12)), "Тесты строки 12")
		.РавноМассиву(Имена(Построчно.ТестыСтроки("src/Калькулятор.os", 12)));

	Ожидаем.Что(Пачкой.КоличествоТестов(), "Тестов в карте").Равно(1);

КонецПроцедуры

Функция Строки(Знач Первая, Знач Вторая)

	Строки = Новый Массив();
	Строки.Добавить(Первая);
	Строки.Добавить(Вторая);

	Возврат Строки;

КонецФункции

&Тест
Процедура ТестыВозвращаютсяВУстойчивомПорядке() Экспорт

	// По списку тестов задания собираются в группы, а группа - это одна пересборка
	// точки входа. Плавающий порядок дробил бы группы на пустом месте

	// Когда

	Тесты = Карта().ТестыСтроки("src/Калькулятор.os", 7);

	// Тогда

	Ожидаем.Что(Тесты[0].Набор, "Первый набор")
		.Равно("tests/Округление.os");

	Ожидаем.Что(Тесты[1].Набор, "Второй набор")
		.Равно("tests/Сложение.os");

КонецПроцедуры

&Тест
Процедура НепокрытаяСтрокаНеДаетТестов() Экспорт

	// Когда

	Тесты = Карта().ТестыСтроки("src/Калькулятор.os", 99);

	// Тогда

	Ожидаем.Что(Тесты.Количество(), "Тестов на строке")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ПутиСравниваютсяБезОглядкиНаРазделителиИРегистр() Экспорт

	// пути мутируемых файлов и пути из статистики выполнения приходят из разных мест

	// Когда

	Тесты = Карта().ТестыСтроки("SRC\Калькулятор.os", 7);

	// Тогда

	Ожидаем.Что(Тесты.Количество(), "Тестов на строке")
		.Равно(2);

КонецПроцедуры

&Тест
Процедура ПустаяКартаНеЗаполнена() Экспорт

	// Тогда

	Ожидаем.Что(Новый КартаТестов().Заполнена(), "Пустая карта заполнена")
		.ЭтоЛожь();

	Ожидаем.Что(Карта().Заполнена(), "Карта с тестами заполнена")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОценкаСкладываетТестыИДобавляетСтарт() Экспорт

	// Тесты мутанта идут одним процессом, и почти всё время в нём - старт движка
	// с компиляцией проекта. Он платится один раз, сколько бы тестов ни досталось,
	// поэтому в оценке он стоит отдельно от их суммы

	// Дано

	Карта = Новый КартаТестов();
	Карта.ОтметитьСтоимостьСтарта(20000);
	Карта.ОтметитьДлительность("tests/Набор.os", "Дешевый", 100);
	Карта.ОтметитьДлительность("tests/Набор.os", "Дорогой", 300);

	// Когда

	Оценка = Карта.ОценкаПрогона(Тесты(Тест("tests/Набор.os", "Дешевый"), Тест("tests/Набор.os", "Дорогой")));

	// Тогда

	Ожидаем.Что(Оценка, "Оценка прогона")
		.Равно(20400);

КонецПроцедуры

&Тест
Процедура ОценкаОдногоТестаЭтоСтартПлюсОнСам() Экспорт

	// Дано

	Карта = Новый КартаТестов();
	Карта.ОтметитьСтоимостьСтарта(20000);
	Карта.ОтметитьДлительность("tests/Набор.os", "Дорогой", 300);

	// Тогда

	Ожидаем.Что(Карта.ОценкаПрогона(Тесты(Тест("tests/Набор.os", "Дорогой"))), "Оценка теста")
		.Равно(20300);

КонецПроцедуры

&Тест
Процедура НеизвестныйТестОценкуОбнуляет() Экспорт

	// Длительности нет - значит, оценивать нечем, и предел времени мутанту
	// достанется общий. Считать неизвестный тест бесплатным нельзя: мутанта
	// оборвали бы раньше, чем он успел бы умереть

	// Дано

	Карта = Новый КартаТестов();
	Карта.ОтметитьСтоимостьСтарта(20000);
	Карта.ОтметитьДлительность("tests/Набор.os", "Известный", 300);

	// Тогда

	Ожидаем.Что(
			Карта.ОценкаПрогона(Тесты(Тест("tests/Набор.os", "Известный"), Тест("tests/Набор.os", "Чужой"))),
			"Оценка прогона")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ПараметризованныйТестСтоитВсехСвоихПрогонов() Экспорт

	// Отбирается он целиком, одним именем метода, и выполняется по разу на каждый
	// набор параметров. Оценка по последнему прогону обрывала бы его на первом же

	// Дано

	Карта = Новый КартаТестов();
	Карта.ОтметитьДлительность("tests/Набор.os", "Считает", 100);
	Карта.ОтметитьДлительность("tests/Набор.os", "Считает", 200);

	// Тогда

	Ожидаем.Что(Карта.ОценкаПрогона(Тесты(Тест("tests/Набор.os", "Считает"))), "Оценка теста")
		.Равно(300);

КонецПроцедуры

&Тест
Процедура БезТестовОценкиНет() Экспорт

	// пустой список означает "всеми тестами" - оценивать нечем

	// Тогда

	Ожидаем.Что(Новый КартаТестов().ОценкаПрогона(Новый Массив()), "Оценка прогона")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ПокрытиеТестаПереноситсяЦеликом() Экспорт

	// Дано

	Покрытие = Новый КартаПокрытия();
	Покрытие.Отметить("src/Калькулятор.os", 3);
	Покрытие.Отметить("src/Калькулятор.os", 4);

	Карта = Новый КартаТестов();

	// Когда

	Карта.ОтметитьПокрытие("tests/Сложение.os", "Складывает", Покрытие);

	// Тогда

	Ожидаем.Что(Карта.КоличествоТестов(), "Тестов в карте")
		.Равно(1);

	Ожидаем.Что(Карта.ТестыСтроки("src/Калькулятор.os", 4).Количество(), "Тестов на строке")
		.Равно(1);

КонецПроцедуры

Функция Тест(Знач Набор, Знач Метод)
	Возврат Новый Структура("Набор, Метод", Набор, Метод);
КонецФункции

Функция Тесты(Знач Первый, Знач Второй = Неопределено)

	Результат = Новый Массив();
	Результат.Добавить(Первый);

	Если Второй <> Неопределено Тогда
		Результат.Добавить(Второй);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция Имена(Знач Тесты)

	Имена = Новый Массив();

	Для Каждого Тест Из Тесты Цикл
		Имена.Добавить(Тест.Набор + "#" + Тест.Метод);
	КонецЦикла;

	Возврат Имена;

КонецФункции
