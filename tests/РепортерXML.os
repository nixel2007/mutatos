#Использовать asserts
#Использовать tempfiles
#Использовать "../src/core"

// Отчёт пишется в разметке pitest: её читают чужие инструменты, поэтому проверяются
// имена элементов и словарь состояний, а не удобство чтения.

Перем _ВременныеФайлы;

// Собственный менеджер временных файлов, а не общий: поднятие поделки стирает всё,
// что создано через общий модуль ВременныеФайлы - autumn-logos делает это при инициализации.
Функция ВременныеФайлы()

	Если _ВременныеФайлы = Неопределено Тогда
		_ВременныеФайлы = Новый МенеджерВременныхФайлов();
	КонецЕсли;

	Возврат _ВременныеФайлы;

КонецФункции

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт

	ВременныеФайлы().Удалить();

КонецПроцедуры

Функция Отчет(Знач Состояние = Неопределено)

	Отчет = Новый ОтчетПрогона();

	Убитый = Новый ОписаниеМутации("Арифметика", "+ заменено на -", 10, 1, "-", 7);
	Убитый.УстановитьИмяМетода("Сложить");
	Отчет.Добавить(Новый РезультатМутанта(Убитый, "/проект/src/Калькулятор.os", СостоянияМутанта.Убит(), 120));

	Выживший = Новый ОписаниеМутации("Условия", "> заменено на >=", 20, 1, ">=", 17);
	Выживший.УстановитьИмяМетода("Максимум");
	Отчет.Добавить(Новый РезультатМутанта(
		Выживший,
		"/проект/src/Калькулятор.os",
		?(Состояние = Неопределено, СостоянияМутанта.Выжил(), Состояние),
		130));

	Возврат Отчет;

КонецФункции

Функция СформироватьОтчет(Знач Состояние = Неопределено)

	Путь = ВременныеФайлы().НовоеИмяФайла("xml");

	Репортер = Новый РепортерXML();
	Репортер.Сформировать(Отчет(Состояние), Путь);

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат Текст;

КонецФункции

&Тест
Процедура ОтчетЭтоСписокМутаций() Экспорт

	// Когда

	Текст = СформироватьОтчет();

	// Тогда

	Ожидаем.Что(СтрНайти(Текст, "<mutations partial=""false"">"), "Корень отчёта")
		.Больше(0);

	Ожидаем.Что(СтрЧислоВхождений(Текст, "<mutation "), "Мутаций в отчёте")
		.Равно(2);

КонецПроцедуры

&Тест
Процедура ОтчетЭтоЦелыйXML() Экспорт

	// Отчёт читают чужие инструменты: объявление, корень и его закрытие обязательны,
	// а разбор докажет, что документ не порвался посередине

	// Когда

	Текст = СформироватьОтчет();

	// Тогда

	Ожидаем.Что(СтрНайти(Текст, "<?xml version=""1.0"" encoding=""UTF-8""?>"), "Объявление XML")
		.Равно(1);

	Ожидаем.Что(СтрНайти(Текст, "</mutations>"), "Закрытие корня")
		.Больше(0);

	Чтение = Новый ЧтениеXML();
	Чтение.УстановитьСтроку(Текст);

	Элементов = 0;

	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Элементов = Элементов + 1;
		КонецЕсли;
	КонецЦикла;

	Чтение.Закрыть();

	// корень, две мутации и по тринадцать полей в каждой
	Ожидаем.Что(Элементов, "Элементов в документе").Равно(27);

КонецПроцедуры

&Тест
Процедура ПутьКФайлуОтносителенОбщегоКаталога() Экспорт

	// Полный путь у каждого разработчика свой, и отчёты двух машин не сличить

	// Когда

	Текст = СформироватьОтчет();

	// Тогда

	Ожидаем.Что(СтрНайти(Текст, "<mutatedClass>Калькулятор.os</mutatedClass>"), "Относительный путь")
		.Больше(0);

	Ожидаем.Что(СтрНайти(Текст, "/проект/src/"), "Полного пути в отчёте нет")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура МутацияОписанаПолямиPitest() Экспорт

	// Когда

	Текст = СформироватьОтчет();

	// Тогда

	Ожидаем.Что(СтрНайти(Текст, "<sourceFile>Калькулятор.os</sourceFile>"), "Имя файла")
		.Больше(0);

	Ожидаем.Что(СтрНайти(Текст, "<mutatedMethod>Максимум</mutatedMethod>"), "Имя метода")
		.Больше(0);

	Ожидаем.Что(СтрНайти(Текст, "<lineNumber>17</lineNumber>"), "Номер строки")
		.Больше(0);

	Ожидаем.Что(СтрНайти(Текст, "<mutator>Условия</mutator>"), "Мутатор")
		.Больше(0);

КонецПроцедуры

&Тест
Процедура УбийствоОтмеченоПризнакомDetected() Экспорт

	// именно по detected инструменты отличают замеченную мутацию от пропущенной

	// Когда

	Текст = СформироватьОтчет();

	// Тогда

	Ожидаем.Что(СтрНайти(Текст, "detected=""true"" status=""KILLED"""), "Убитый мутант")
		.Больше(0);

	Ожидаем.Что(СтрНайти(Текст, "detected=""false"" status=""SURVIVED"""), "Выживший мутант")
		.Больше(0);

КонецПроцедуры

&Тест
Процедура ТаймаутСчитаетсяЗамеченнойМутацией() Экспорт

	// Когда

	Текст = СформироватьОтчет(СостоянияМутанта.Таймаут());

	// Тогда

	Ожидаем.Что(СтрНайти(Текст, "detected=""true"" status=""TIMED_OUT"""), "Мутант по таймауту")
		.Больше(0);

КонецПроцедуры

&Тест
Процедура НепокрытыйМутантНеСчитаетсяЗамеченным() Экспорт

	// Когда

	Текст = СформироватьОтчет(СостоянияМутанта.БезПокрытия());

	// Тогда

	Ожидаем.Что(СтрНайти(Текст, "detected=""false"" status=""NO_COVERAGE"""), "Мутант без покрытия")
		.Больше(0);

КонецПроцедуры

&Тест
Процедура ОписаниеЭкранируется() Экспорт

	// описания мутаций состоят из символов сравнения - без экранирования XML развалился бы

	// Когда

	Текст = СформироватьОтчет();

	// Тогда

	Ожидаем.Что(СтрНайти(Текст, "<description>&gt; заменено на &gt;=</description>"), "Описание мутации")
		.Больше(0);

КонецПроцедуры

&Тест
Процедура БезПутиОтчетНеФормируется() Экспорт

	// Тогда

	Ожидаем.Что(Новый РепортерXML())
		.Метод("Сформировать", ЗначенияПараметров(Отчет(), ""))
		.ВыбрасываетИсключение();

КонецПроцедуры

Функция ЗначенияПараметров(Знач Первый, Знач Второй)

	Параметры = Новый Массив();
	Параметры.Добавить(Первый);
	Параметры.Добавить(Второй);

	Возврат Параметры;

КонецФункции
