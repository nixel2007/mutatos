#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать autumn-logos
#Использовать "../src/core"
#Использовать "./fixtures"

// Сборщик делает один прогон и разбирает то, что оставил после себя агент:
// покрытие всего прогона и покрытие каждого теста по отдельности.
//
// Сам прогон замокан - это чужой процесс, и его поведение проверяется в тестах пула.
// Процесс - заглушка: сборщик читает у него свойства, а мок подменяет только методы.
//
// Роль агента исполняет тест: файл карты сборщик придумывает сам и наружу не отдаёт,
// но передаёт фабрике копий - там его и видно.

Перем _ВременныеФайлы;
Перем _Копия;
// Что «агент» положит в файл карты во время прогона. Неопределено - карты не будет
Перем _КартаПрогона;
// Во что «агенту» обошёлся сам сбор
Перем _Накладные;

&ПередКаждым
Процедура ЗабытьПрошлыйПрогон() Экспорт

	_ВременныеФайлы = Новый МенеджерВременныхФайлов();
	_Копия          = Неопределено;
	_КартаПрогона   = Неопределено;
	_Накладные      = 0;

КонецПроцедуры

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт

	_ВременныеФайлы.Удалить();

КонецПроцедуры

// Копия отвечает за перевод путей: статистика говорит путями копии, а наружу
// всё должно уйти путями оригинала.
Функция Копия()

	Если _Копия = Неопределено Тогда

		_Копия = Мок.Получить(Тип("РабочаяКопия"));
		_Копия.Когда().Каталог().ТогдаВозвращает("/копия");
		_Копия.Когда().ТочкаВхода().ТогдаВозвращает("/копия/.mutatos/точка.os");
		_Копия.Когда().ПутьВОригинале(Матчеры.ЛюбоеЗначение())
			.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ВОригинал"));

	КонецЕсли;

	Возврат _Копия;

КонецФункции

Функция ВОригинал(ИнформацияОВызове) Экспорт

	Возврат СтрЗаменить(ИнформацияОВызове.Параметры()[0], "/копия/", "/проект/");

КонецФункции

// Фабрика отдаёт копию и заодно кладёт карту в файл, который назвал сборщик:
// в жизни это делает агент внутри прогона.
Функция Фабрика()

	Фабрика = Мок.Получить(Тип("ФабрикаКопий"));

	Фабрика.Когда().СоздатьКопии(
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ОтдатьКопиюИПоложитьКарту"));

	Возврат Фабрика;

КонецФункции

Функция ОтдатьКопиюИПоложитьКарту(ИнформацияОВызове) Экспорт

	Если _КартаПрогона <> Неопределено Тогда

		Карта = Новый Соответствие();
		Карта.Вставить("Накладные", _Накладные);
		Карта.Вставить("Тесты", _КартаПрогона);

		Запись = Новый ЗаписьJSON();
		Запись.ОткрытьФайл(ИнформацияОВызове.Параметры()[5]);
		ЗаписатьJSON(Запись, Карта);
		Запись.Закрыть();

	КонецЕсли;

	Копии = Новый Массив();
	Копии.Добавить(Копия());

	Возврат Копии;

КонецФункции

Функция Запускатель(Знач КодВозврата)

	Запускатель = Мок.Получить(Тип("ЗапускательПроцессов"));

	Запускатель.Когда().Запустить(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаВозвращает(Новый ПроцессЗаглушка(КодВозврата));

	Возврат Запускатель;

КонецФункции

// Анализатор разбирает статистику всего прогона: своего разбора у сборщика нет,
// и заводить его он не должен.
Функция Анализатор(Покрытие)

	Анализатор = Мок.Получить(Тип("АнализаторПокрытия"));

	Анализатор.Когда().ПрочитатьСтатистику(Матчеры.ЛюбоеЗначение())
		.ТогдаВозвращает(?(Покрытие = Неопределено, Новый КартаПокрытия(), Покрытие));

	Возврат Анализатор;

КонецФункции

Функция Сборщик(Знач КодВозврата = 0, Покрытие = Неопределено)

	Возврат Новый СборщикКартыТестов(
		Фабрика(),
		Анализатор(Покрытие),
		Запускатель(КодВозврата),
		Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

КонецФункции

Функция Тест(Знач Набор, Знач Метод, Знач Файл, Знач Строки, Знач Длительность = 100)

	Покрытие = Новый Соответствие();
	Покрытие.Вставить(Файл, Строки);

	Запись = Новый Соответствие();
	Запись.Вставить("Набор", Набор);
	Запись.Вставить("Метод", Метод);
	Запись.Вставить("Длительность", Длительность);
	Запись.Вставить("Покрытие", Покрытие);

	Возврат Запись;

КонецФункции

Функция Строки(Знач Первая, Знач Вторая = Неопределено)

	Строки = Новый Массив();
	Строки.Добавить(Первая);

	Если Вторая <> Неопределено Тогда
		Строки.Добавить(Вторая);
	КонецЕсли;

	Возврат Строки;

КонецФункции

Функция ОдинТест(Знач Метод = "Складывает", Знач Длительность = 100)

	Тесты = Новый Массив();
	Тесты.Добавить(Тест("/копия/tests/Набор.os", Метод, "/копия/src/Класс.os", Строки(7), Длительность));

	Возврат Тесты;

КонецФункции

&Тест
Процедура КартаСтроитсяПоТестамПрогона() Экспорт

	// Дано

	_КартаПрогона = Новый Массив();
	_КартаПрогона.Добавить(Тест("/копия/tests/Набор.os", "Складывает", "/копия/src/Класс.os", Строки(7, 8)));
	_КартаПрогона.Добавить(Тест("/копия/tests/Набор.os", "Вычитает", "/копия/src/Класс.os", Строки(12)));

	// Когда

	Результат = Сборщик().Собрать("/проект");

	// Тогда

	Ожидаем.Что(Результат.Карта.КоличествоТестов(), "Тестов в карте").Равно(2);

	Отобранные = Результат.Карта.ТестыСтроки("/проект/src/Класс.os", 7);

	Ожидаем.Что(Отобранные.Количество(), "Тестов на строке").Равно(1);
	Ожидаем.Что(Отобранные[0].Метод, "Метод теста").Равно("Складывает");

КонецПроцедуры

&Тест
Процедура ПутиКартыПереводятсяВПутиПроекта() Экспорт

	// Прогон идёт в копии и рассказывает о ней, а мутанты живут путями проекта:
	// без перевода карта не совпала бы с ними ни одной строкой

	// Дано

	_КартаПрогона = ОдинТест();

	// Когда

	Результат = Сборщик().Собрать("/проект");

	// Тогда

	Ожидаем.Что(Результат.Карта.ТестыСтроки("/проект/src/Класс.os", 7)[0].Набор, "Набор теста")
		.Равно("/проект/tests/Набор.os");

КонецПроцедуры

&Тест
Процедура СтартПрогонаВходитВОценкуМутанта() Экспорт

	// Мутант платит старт движка один раз, сколько бы тестов ему ни досталось.
	// Без этого оценка считалась бы по одному только времени теста, и мутанта
	// обрывали бы, не дав ему даже скомпилироваться.
	//
	// Тест здесь бесплатный, поэтому весь прогон - это и есть старт

	// Дано

	_КартаПрогона = ОдинТест("Складывает", 0);

	// Когда

	Результат = Сборщик().Собрать("/проект");

	// Тогда

	Отобранные = Результат.Карта.ТестыСтроки("/проект/src/Класс.os", 7);

	Ожидаем.Что(Результат.Карта.ОценкаПрогона(Отобранные), "Оценка прогона бесплатного теста")
		.Равно(Результат.Прогон.Длительность());

КонецПроцедуры

&Тест
Процедура СборКартыВОценкуМутантаНеВходит() Экспорт

	// Прогон с агентом дороже обычного: сессия сбора на каждый тест не бесплатна.
	// Мутанты бегут без агента, и если оставить эту цену в оценке, предел времени
	// мутанта раздуется в разы - зациклившийся досидит до чужого срока

	// Дано

	_КартаПрогона = ОдинТест("Складывает", 0);
	_Накладные    = 1000000;

	// Когда

	Результат = Сборщик().Собрать("/проект");

	// Тогда

	Отобранные = Результат.Карта.ТестыСтроки("/проект/src/Класс.os", 7);

	Ожидаем.Что(Результат.Карта.ОценкаПрогона(Отобранные), "Оценка прогона")
		.Равно(0);

	Ожидаем.Что(Результат.Карта.ОценкаПолногоПрогона(), "Оценка полного прогона")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ОценкаПолногоПрогонаЭтоСтартИВсеТесты() Экспорт

	// От неё считается предел времени мутанту, который идёт всеми тестами

	// Дано

	_КартаПрогона = Новый Массив();
	_КартаПрогона.Добавить(Тест("/копия/tests/Набор.os", "Складывает", "/копия/src/Класс.os", Строки(7), 0));
	_КартаПрогона.Добавить(Тест("/копия/tests/Набор.os", "Вычитает", "/копия/src/Класс.os", Строки(8), 0));

	// Когда

	Результат = Сборщик().Собрать("/проект");

	// Тогда

	// тесты бесплатные, значит весь прогон - это старт
	Ожидаем.Что(Результат.Карта.ОценкаПолногоПрогона(), "Оценка полного прогона")
		.Равно(Результат.Прогон.Длительность());

КонецПроцедуры

&Тест
Процедура БезФайлаКартыОтборОтключается() Экспорт

	// Движок без управляемого сбора статистики карту не отдаст. Это не повод падать:
	// пустая карта означает "гнать всё", а покрытие прогона собралось как обычно

	// Дано

	Покрытие = Новый КартаПокрытия();
	Покрытие.Отметить("/копия/src/Класс.os", 7);

	// Когда

	Результат = Сборщик(0, Покрытие).Собрать("/проект");

	// Тогда

	Ожидаем.Что(Результат.Карта.Заполнена(), "Карта заполнена").ЭтоЛожь();
	Ожидаем.Что(Результат.Прогон.Успешно(), "Прогон успешен").ЭтоИстина();
	Ожидаем.Что(Результат.Покрытие.Покрыта("/проект/src/Класс.os", 7), "Покрытая строка").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПослеКрасногоПрогонаКартаНеСтроится() Экспорт

	// Оборванный прогон карту не дописывает, а недописанной верить нельзя:
	// мутанты недошедших тестов оказались бы без проверки

	// Дано

	_КартаПрогона = ОдинТест();

	// Когда

	Результат = Сборщик(1).Собрать("/проект");

	// Тогда

	Ожидаем.Что(Результат.Прогон.Успешно(), "Прогон успешен").ЭтоЛожь();
	Ожидаем.Что(Результат.Карта.Заполнена(), "Карта заполнена").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПокрытиеПрогонаПереводитсяВПутиПроекта() Экспорт

	// Дано

	Покрытие = Новый КартаПокрытия();
	Покрытие.Отметить("/копия/src/Класс.os", 7);
	Покрытие.ОтметитьФайл("/копия/src/Пустой.os");

	// Когда

	Результат = Сборщик(0, Покрытие).Собрать("/проект");

	// Тогда

	Ожидаем.Что(Результат.Покрытие.Покрыта("/проект/src/Класс.os", 7), "Покрытая строка")
		.ЭтоИстина();

	Ожидаем.Что(Результат.Покрытие.ЕстьДанные("/проект/src/Пустой.os"), "Файл без покрытых строк")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КопияУдаляетсяПослеСбора() Экспорт

	// Копия - это копия всего проекта, оставлять её во временном каталоге нельзя

	// Когда

	Сборщик().Собрать("/проект");

	// Тогда

	Копия().ПроверитьЧтоВызывалсяМетод().Удалить();

КонецПроцедуры
