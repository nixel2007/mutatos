#Использовать asserts
#Использовать moskito
#Использовать fs
#Использовать tempfiles
#Использовать autumn-logos
#Использовать "../src/core"

// mutatos везёт OneUnit внутри себя, поэтому важно, чьим ядром пойдёт прогон:
// тесты проекта должна выполнять та версия, на которую проект рассчитан.

// Детальки, которые прогон отдал движку: ловятся ответом мока
Перем _ОтданныеДетальки;

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

Функция Запускатель(Знач КаталогЯдра = "", ЗапускательOneUnit = Неопределено)

	Возврат Новый ЗапускательТестовЯдро(
		?(ЗапускательOneUnit = Неопределено, НастоящийЗапускатель(), ЗапускательOneUnit),
		"tests",
		КаталогЯдра,
		Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

КонецФункции

Функция НастоящийЗапускатель()

	Возврат Новый ЗапускательТестирования(Новый ПостроительТочкиВхода());

КонецФункции

// Мок запускателя OneUnit: настоящий поднимает движок дочерним процессом,
// а здесь проверяется, что именно ему отдали и что вернулось наружу.
Функция ЗапускательOneUnit(Знач КодВозврата = 0, Знач Падать = Ложь)

	Запускатель = Мок.Получить(Тип("ЗапускательТестирования"));

	Запускатель.Когда().ПараметрыЗапуска().ТогдаВозвращает(
		Новый Структура("РабочийКаталог, ПутьКСтатистикеПокрытия, КаталогЯдра", "", "", ""));

	Настройка = Запускатель.Когда().ВыполнитьТестирование(
		Матчеры.ЛюбоеЗначение(),
		Матчеры.ЛюбоеЗначение(),
		Матчеры.ЛюбоеЗначение());

	Если Падать Тогда
		Настройка.ТогдаВыбрасываетИсключение("Движок не запустился");
	Иначе
		// ответом, а не возвратом: заодно запоминаются детальки, которые отдали движку
		Настройка.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗапомнитьДетальки", Массивы(КодВозврата)));
	КонецЕсли;

	Возврат Запускатель;

КонецФункции

Функция Массивы(Знач Значение)

	Результат = Новый Массив();
	Результат.Добавить(Значение);

	Возврат Результат;

КонецФункции

Функция ЗапомнитьДетальки(ИнформацияОВызове, Знач КодВозврата) Экспорт

	_ОтданныеДетальки = ИнформацияОВызове.Параметры()[0];

	Возврат Новый Структура("КодВозврата, Вывод", КодВозврата, "вывод прогона");

КонецФункции

// Проект с OneUnit, установленным через opm. Пустая версия - без метаданных вовсе.
Функция ПроектСЯдром(Знач Версия = "0.5.0")

	Проект = ВременныеФайлы.СоздатьКаталог();
	ФС.ОбеспечитьКаталог(ОбъединитьПути(Проект, "oscript_modules/oneunit/src/core"));

	Если ПустаяСтрока(Версия) Тогда
		Возврат Проект;
	КонецЕсли;

	ЗаписатьФайл(
		ОбъединитьПути(Проект, "oscript_modules/oneunit/opm-metadata.xml"),
		СтрШаблон(
			"<?xml version=""1.0"" encoding=""utf-8""?>
			|<opm-metadata xmlns=""http://oscript.io/schemas/opm-metadata/1.0"">
			|    <name>oneunit</name>
			|    <version>%1</version>
			|    <depends-on name=""asserts"" dev=""false"" version=""1.6.2""/>
			|</opm-metadata>",
			Версия));

	Возврат Проект;

КонецФункции

// Проект с OneUnit, положенным мимо opm: подмодулем или копией каталога.
// Метаданных пакета у такой поставки нет, версию называют только исходники.
Функция ПроектСЯдромБезOPM(Знач Версия)

	Проект = ПроектСЯдром("");

	ЗаписатьФайл(
		ОбъединитьПути(Проект, "oscript_modules/oneunit/src/cli/internal/isolated/Классы",
			"ОписаниеКонсольногоПриложения.os"),
		СтрШаблон(
			"&Желудь
			|&Верховный
			|Процедура ПриСозданииОбъекта()
			|КонецПроцедуры
			|
			|Функция ИмяПриложения() Экспорт
			|	Возврат ""OneUnit"";
			|КонецФункции
			|
			|Функция ВерсияПриложения() Экспорт
			|	Возврат ""%1"";
			|КонецФункции",
			Версия));

	Возврат Проект;

КонецФункции

Процедура ЗаписатьФайл(Знач Путь, Знач Содержимое)

	ФС.ОбеспечитьКаталог(Новый Файл(Путь).Путь);

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Содержимое);
	Запись.Закрыть();

КонецПроцедуры

&Тест
Процедура ЯдроПроектаИспользуетсяЕслиОноЕсть() Экспорт

	// Дано

	Проект = ПроектСЯдром();

	// Когда

	КаталогЯдра = Запускатель().КаталогЯдраПроекта(Проект);

	// Тогда

	Ожидаем.Что(КаталогЯдра, "Каталог ядра")
		.Равно(ФС.НормализоватьПуть(ОбъединитьПути(Проект, "oscript_modules/oneunit/src/core")));

