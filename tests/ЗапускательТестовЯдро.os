&Тест
Процедура ПрогонОтдаетДвижкуКаталогиТестовПроекта() Экспорт

	// Каталоги тестов задаются деталькой относительно проекта, а движку нужны полные

	// Дано

	ЗапускательOneUnit = ЗапускательOneUnit();

	// Когда

	Запускатель("", ЗапускательOneUnit).Прогнать("/проект", 500);

	// Тогда

	Детальки = _ОтданныеДетальки;

	Ожидаем.Что(Детальки.Получить("КаталогиТестов")[0], "Каталог тестов")
		.Равно(ФС.НормализоватьПуть(ОбъединитьПути("/проект", "tests")));

	Ожидаем.Что(Детальки.Получить("Таймаут"), "Таймаут").Равно(500);
	Ожидаем.Что(Детальки.Получить("РежимВыводаЛога"), "Режим лога").Равно("none");

КонецПроцедуры

&Тест
Процедура ФильтрыДоезжаютДоДвижка() Экспорт

	// Один и тот же отбор применяется и к исходному прогону, и к мутантам

	// Дано

	ЗапускательOneUnit = ЗапускательOneUnit();

	Фильтры = Новый ФильтрыТестов();
	Фильтры.ТегиВключаемые.Добавить("быстрые");

	// Когда

	Запускатель("", ЗапускательOneUnit).Прогнать("/проект", 0, "", Фильтры);

	// Тогда

	Детальки = _ОтданныеДетальки;

	Ожидаем.Что(Детальки.Получить("ТегиВключаемые"), "Деталька тегов")
		.РавноМассиву(СтрРазделить("быстрые", ","));

КонецПроцедуры

&Тест
Процедура НулевойКодВозвратаЗначитУспешныйПрогон() Экспорт

	// Когда

	Результат = Запускатель("", ЗапускательOneUnit(0)).Прогнать("/проект");

	// Тогда

	Ожидаем.Что(Результат.Успешно(), "Прогон успешен").ЭтоИстина();
	Ожидаем.Что(Результат.КодВозврата(), "Код возврата").Равно(0);
	Ожидаем.Что(Результат.Вывод(), "Вывод").Равно("вывод прогона");

КонецПроцедуры

&Тест
Процедура НенулевойКодВозвратаЗначитПадение() Экспорт

	// Когда

	Результат = Запускатель("", ЗапускательOneUnit(1)).Прогнать("/проект");

	// Тогда

	Ожидаем.Что(Результат.Успешно(), "Прогон успешен").ЭтоЛожь();
	Ожидаем.Что(Результат.КодВозврата(), "Код возврата").Равно(1);

КонецПроцедуры

&Тест
Процедура СорвавшийсяЗапускДвижкаНеРоняетПрогон() Экспорт

	// Движок может не запуститься вовсе - например, тесты не компилируются.
	// Это результат прогона, а не повод падать всему мутационному прогону

	// Когда

	Результат = Запускатель("", ЗапускательOneUnit(0, Истина)).Прогнать("/проект");

	// Тогда

	Ожидаем.Что(Результат.Успешно(), "Прогон успешен").ЭтоЛожь();
	Ожидаем.Что(Результат.КодВозврата(), "Код возврата").Равно(-1);
	Ожидаем.Что(СтрНайти(Результат.Вывод(), "Движок не запустился"), "Причина в выводе").Больше(0);

КонецПроцедуры

&Тест
&Тег("e2e")
Процедура ПрогонВыполняетТестыПроекта() Экспорт

	// Главный путь класса: собрать детальки, развернуть каталоги тестов
	// относительно проекта и отдать всё ядру OneUnit.
	//
	// Сквозной: поднимает настоящее ядро дочерним процессом. Подменить его нечем -
	// проверяется ровно то, что прогон доезжает до движка и возвращается результатом

	// Дано

	Проект = ПроектСЗеленымТестом();

	// Когда

	Результат = Запускатель().Прогнать(Проект);

	// Тогда

	Ожидаем.Что(Результат.Успешно(), "Прогон успешен").ЭтоИстина();
	Ожидаем.Что(Результат.КодВозврата(), "Код возврата").Равно(0);
	Ожидаем.Что(Результат.Длительность(), "Длительность").Больше(0);

КонецПроцедуры

&Тест
&Тег("e2e")
Процедура ПрогонКрасныхТестовНеУспешен() Экспорт

	// Дано

	Проект = ПроектСЗеленымТестом();

	ЗаписатьФайл(
		ОбъединитьПути(Проект, "tests", "НаборКрасный.os"),
		"#Использовать asserts
		|
		|&Тест
		|Процедура Падает() Экспорт
		|	Ожидаем.Что(Ложь, ""Падение намеренное"").ЭтоИстина();
		|КонецПроцедуры");

	// Когда

	Результат = Запускатель().Прогнать(Проект);

	// Тогда

	Ожидаем.Что(Результат.Успешно(), "Прогон успешен").ЭтоЛожь();

КонецПроцедуры

// Проект с одним зелёным тестом. Библиотеки берутся из oscript_modules самого
// mutatos: ставить их заново в каждый временный проект слишком дорого.
Функция ПроектСЗеленымТестом()

	Проект = ВременныеФайлы.СоздатьКаталог();

	ЗаписатьФайл(
		ОбъединитьПути(Проект, "tests", "НаборЗеленый.os"),
		"#Использовать asserts
		|
		|&Тест
		|Процедура Зеленый() Экспорт
		|	Ожидаем.Что(Истина).ЭтоИстина();
		|КонецПроцедуры");

	ЗаписатьФайл(
		ОбъединитьПути(Проект, "oscript.cfg"),
		"lib.additional=" + ФС.НормализоватьПуть("oscript_modules"));

	Возврат Проект;

КонецФункции
