#Использовать asserts
#Использовать fs
#Использовать tempfiles
#Использовать autumn-logos
#Использовать "../src/core"

// mutatos везёт OneUnit внутри себя, поэтому важно, чьим ядром пойдёт прогон:
// тесты проекта должна выполнять та версия, на которую проект рассчитан.

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

Функция Запускатель(Знач КаталогЯдра = "")

	Возврат Новый ЗапускательТестовЯдро(
		"tests",
		КаталогЯдра,
		Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

КонецФункции

// Проект с OneUnit, установленным через opm. Пустая версия - без метаданных вовсе.
Функция ПроектСЯдром(Знач Версия = "0.5.0")

	Проект = ВременныеФайлы.СоздатьКаталог();
	ФС.ОбеспечитьКаталог(ОбъединитьПути(Проект, "oscript_modules/oneunit/src/core"));

	Если ПустаяСтрока(Версия) Тогда
		Возврат Проект;
	КонецЕсли;

	ЗаписатьФайл(
		ОбъединитьПути(Проект, "oscript_modules/oneunit/opm-metadata.xml"),
		СтрШаблон(
			"<?xml version=""1.0"" encoding=""utf-8""?>
			|<opm-metadata xmlns=""http://oscript.io/schemas/opm-metadata/1.0"">
			|    <name>oneunit</name>
			|    <version>%1</version>
			|    <depends-on name=""asserts"" dev=""false"" version=""1.6.2""/>
			|</opm-metadata>",
			Версия));

	Возврат Проект;

КонецФункции

// Проект с OneUnit, положенным мимо opm: подмодулем или копией каталога.
// Метаданных пакета у такой поставки нет, версию называют только исходники.
Функция ПроектСЯдромБезOPM(Знач Версия)

	Проект = ПроектСЯдром("");

	ЗаписатьФайл(
		ОбъединитьПути(Проект, "oscript_modules/oneunit/src/cli/internal/isolated/Классы",
			"ОписаниеКонсольногоПриложения.os"),
		СтрШаблон(
			"&Желудь
			|&Верховный
			|Процедура ПриСозданииОбъекта()
			|КонецПроцедуры
			|
			|Функция ИмяПриложения() Экспорт
			|	Возврат ""OneUnit"";
			|КонецФункции
			|
			|Функция ВерсияПриложения() Экспорт
			|	Возврат ""%1"";
			|КонецФункции",
			Версия));

	Возврат Проект;

КонецФункции

Процедура ЗаписатьФайл(Знач Путь, Знач Содержимое)

	ФС.ОбеспечитьКаталог(Новый Файл(Путь).Путь);

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Содержимое);
	Запись.Закрыть();

КонецПроцедуры

&Тест
Процедура ЯдроПроектаИспользуетсяЕслиОноЕсть() Экспорт

	// Дано

	Проект = ПроектСЯдром();

	// Когда

	КаталогЯдра = Запускатель().КаталогЯдраПроекта(Проект);

	// Тогда

	Ожидаем.Что(КаталогЯдра, "Каталог ядра")
		.Равно(ФС.НормализоватьПуть(ОбъединитьПути(Проект, "oscript_modules/oneunit/src/core")));

КонецПроцедуры

&Тест
Процедура БезЯдраПроектаБеретсяЯдроИнструмента() Экспорт

	// пустое значение означает "ядро по умолчанию", то есть поставляемое с mutatos

	// Дано

	Проект = ВременныеФайлы.СоздатьКаталог();

	// Когда

	КаталогЯдра = Запускатель().КаталогЯдраПроекта(Проект);

	// Тогда

	Ожидаем.Что(КаталогЯдра, "Каталог ядра")
		.Равно("");

КонецПроцедуры

&Тест
Процедура ЯдроПроектаПопадаетВПараметрыПрогона() Экспорт

	// Дано

	Проект = ПроектСЯдром();
	Параметры = Новый Структура("КаталогЯдра", "");

	// Когда

	Запускатель().ЗадатьКаталогЯдра(Параметры, Проект);

	// Тогда

	Ожидаем.Что(Параметры.КаталогЯдра, "Каталог ядра")
		.Равно(ФС.НормализоватьПуть(ОбъединитьПути(Проект, "oscript_modules/oneunit/src/core")));

КонецПроцедуры

&Тест
Процедура СтароеЯдроПроектаНеИспользуется() Экспорт

	// Старое ядро молча проигнорирует детальку прекращения прогона, и мутанты
	// проверялись бы полными наборами. Лучше пойти своим ядром - но вслух

	// Дано

	Проект = ПроектСЯдром("0.4.1");

	// Когда

	КаталогЯдра = Запускатель().КаталогЯдраПроекта(Проект);

	// Тогда

	Ожидаем.Что(КаталогЯдра, "Каталог ядра")
		.Равно("");

