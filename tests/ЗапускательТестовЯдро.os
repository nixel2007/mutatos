КонецПроцедуры

&Тест
Процедура МетаданныеПеревешиваютИсходники() Экспорт

	// Установка через opm - обычный случай, и её метаданные ближе к правде,
	// чем исходники, которые мог поправить кто угодно

	// Дано

	Проект = ПроектСЯдромБезOPM("0.4.1");

	ЗаписатьФайл(
		ОбъединитьПути(Проект, "oscript_modules/oneunit/opm-metadata.xml"),
		"<opm-metadata><name>oneunit</name><version>0.5.0</version></opm-metadata>");

	// Когда

	Версия = Запускатель().ВерсияOneUnitПроекта(Проект);

	// Тогда

	Ожидаем.Что(Версия, "Версия OneUnit проекта")
		.Равно("0.5.0");

КонецПроцедуры

&Тест
Процедура ВерсияЯдраПроектаЧитаетсяИзМетаданных() Экспорт

	// Версии зависимостей в метаданных лежат атрибутами, и версией пакета
	// не притворяются

	// Дано

	Проект = ПроектСЯдром("0.5.3");

	// Когда

	Версия = Запускатель().ВерсияOneUnitПроекта(Проект);

	// Тогда

	Ожидаем.Что(Версия, "Версия OneUnit проекта")
		.Равно("0.5.3");

КонецПроцедуры

&Тест
Процедура ЯвноУказанноеЯдроПеревешивает() Экспорт

	// Дано

	Проект = ПроектСЯдром();
	ЧужоеЯдро = "/иное/ядро/src/core";

	// Когда

	КаталогЯдра = Запускатель(ЧужоеЯдро).КаталогЯдраПроекта(Проект);

	// Тогда

	Ожидаем.Что(КаталогЯдра, "Каталог ядра")
		.Равно(ЧужоеЯдро);

КонецПроцедуры

&Тест
Процедура ЯдроПоставляетсяСИнструментомИДоступноВсегда() Экспорт

	// OneUnit едет внутри mutatos, поэтому ядро есть всегда - вопрос лишь в том, чьё

	// Тогда

	Ожидаем.Что(Запускатель().Доступен(ВременныеФайлы.СоздатьКаталог()), "Доступность ядра")
		.ЭтоИстина();

КонецПроцедуры

