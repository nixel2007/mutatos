&Тест
Процедура ЯдроБезВерсииВообщеНеИспользуется() Экспорт

	// Ни метаданных, ни исходников с версией: проверить нечем, а значит
	// и подтвердить, что ядро подходит

	// Дано

	Проект = ПроектСЯдром("");

	// Когда

	КаталогЯдра = Запускатель().КаталогЯдраПроекта(Проект);

	// Тогда

	Ожидаем.Что(КаталогЯдра, "Каталог ядра")
		.Равно("");

КонецПроцедуры

&Тест
Процедура ВерсияБезOPMБеретсяИзИсходников() Экспорт

	// OneUnit бывает положен подмодулем или копией каталога - метаданных пакета
	// тогда нет, и версию называет он сам

	// Дано

	Проект = ПроектСЯдромБезOPM("0.5.2");

	// Когда

	Версия = Запускатель().ВерсияOneUnitПроекта(Проект);

	// Тогда

	Ожидаем.Что(Версия, "Версия OneUnit проекта")
		.Равно("0.5.2");

КонецПроцедуры

