Процедура СтароеЯдроБезOPMНеИспользуется() Экспорт

	// Дано

	Проект = ПроектСЯдромБезOPM("0.4.1");

	// Когда

	КаталогЯдра = Запускатель().КаталогЯдраПроекта(Проект);

