#Использовать asserts
#Использовать moskito
#Использовать osparser
#Использовать autumn-logos
#Использовать "../src/core"

// Искатель отвечает за обход дерева и раздачу узлов мутаторам.
// Мутаторы здесь замоканы: так проверяется именно обход, а не логика мутаций.

Перем _ТипыУзлов;

Функция ТипыУзлов()

	Если _ТипыУзлов = Неопределено Тогда
		_ТипыУзлов = Новый ПарсерВстроенногоЯзыка().Типы();
	КонецЕсли;

	Возврат _ТипыУзлов;

КонецФункции

// Мутатор, отдающий по одной мутации на каждый узел своего типа: искателю от него
// нужны только имя, интересующие типы узлов и сами мутации.
Функция МутаторМок(ТипУзла, Знач ИмяМутатора = "Тестовый")

	Типы = Новый Массив();
	Типы.Добавить(ТипУзла);

	Мутации = Новый Массив();
	Мутации.Добавить(Новый ОписаниеМутации(ИмяМутатора, "тестовая мутация", 1, 1, "X", 1));

	Мутатор = Мок.Получить(Тип("МутаторАрифметики"));
	Мутатор.Когда().Имя().ТогдаВозвращает(ИмяМутатора);
	Мутатор.Когда().ТипыУзлов(Матчеры.ЛюбоеЗначение()).ТогдаВозвращает(Типы);
	Мутатор.Когда().Мутации(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение()).ТогдаВозвращает(Мутации);

	Возврат Мутатор;

КонецФункции

Функция ИскательСМутаторами(Мутаторы)

	Возврат Новый ИскательМутаций(Мутаторы, ТипыУзлов(), Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

КонецФункции

Функция СписокИзОдного(Элемент)

	Результат = Новый Массив();
	Результат.Добавить(Элемент);

	Возврат Результат;

КонецФункции

&Тест
Процедура МутаторВызываетсяДляКаждогоУзлаСвоегоТипа() Экспорт

	// Дано

	Мутатор = МутаторМок(ТипыУзлов().ВыражениеБинарное);
	Искатель = ИскательСМутаторами(СписокИзОдного(Мутатор));

	// Когда

	Мутации = Искатель.НайтиМутации("Значение = А + Б * В;");

	// Тогда

	// два бинарных выражения - сложение и умножение
	Ожидаем.Что(Мутации.Количество(), "Количество мутаций")
		.Равно(2);

КонецПроцедуры

&Тест
Процедура МутаторНеВызываетсяДляЧужихУзлов() Экспорт

	// Дано

	Мутатор = МутаторМок(ТипыУзлов().ОператорВозврат);
	Искатель = ИскательСМутаторами(СписокИзОдного(Мутатор));

	// Когда

	Мутации = Искатель.НайтиМутации("Значение = А + Б;");

	// Тогда

	Ожидаем.Что(Мутации.Количество(), "Количество мутаций")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура НесколькоМутаторовНаОдномТипеУзлаСкладываются() Экспорт

	// Дано

	Мутаторы = Новый Массив();
	Мутаторы.Добавить(МутаторМок(ТипыУзлов().ВыражениеБинарное, "Первый"));
	Мутаторы.Добавить(МутаторМок(ТипыУзлов().ВыражениеБинарное, "Второй"));

	Искатель = ИскательСМутаторами(Мутаторы);

	// Когда

	Мутации = Искатель.НайтиМутации("Значение = А + Б;");

	// Тогда

	Ожидаем.Что(Мутации.Количество(), "Количество мутаций")
		.Равно(2);

КонецПроцедуры

&Тест
Процедура ОбходДоходитДоВложенныхУзлов() Экспорт

	// Дано

	Мутатор = МутаторМок(ТипыУзлов().ВыражениеЛитерал);
	Искатель = ИскательСМутаторами(СписокИзОдного(Мутатор));

	// Когда

	Исходник = "
		|Функция Проверить(А)
		|	Если А > 1 Тогда
		|		Возврат 2;
		|	КонецЕсли;
		|	Возврат 3;
		|КонецФункции";

	Мутации = Искатель.НайтиМутации(Исходник);

	// Тогда

	// литералы 1, 2 и 3 лежат на разной глубине дерева
	Ожидаем.Что(Мутации.Количество(), "Количество мутаций")
		.Равно(3);

КонецПроцедуры

&Тест
Процедура НеразбираемыйИсходникНеДоходитДоМутаторов() Экспорт

	// Дано

	Мутатор = МутаторМок(ТипыУзлов().ВыражениеБинарное);
	Искатель = ИскательСМутаторами(СписокИзОдного(Мутатор));

	// Когда

	Мутации = Искатель.НайтиМутации("специальная синтакс-ошибка");

	// Тогда

	Ожидаем.Что(Мутации.Количество(), "Количество мутаций")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура БезМутаторовМутацийНет() Экспорт

	// Дано

	Искатель = ИскательСМутаторами(Новый Массив());

	// Когда

	Мутации = Искатель.НайтиМутации("Значение = А + Б;");

	// Тогда

	Ожидаем.Что(Мутации.Количество(), "Количество мутаций")
		.Равно(0);

КонецПроцедуры
