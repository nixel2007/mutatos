#Использовать asserts
#Использовать fs
#Использовать tempfiles
#Использовать autumn-logos
#Использовать "../src/core"

// Юнит-тесты рабочей копии. Копия - это каталог проекта в стороне от оригинала,
// куда пишется мутант: параллельным прогонам нужна изоляция, а оригинал мутировать
// нельзя вовсе - прерванный прогон оставил бы проект изменённым.

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

Функция Проект()

	Проект = ВременныеФайлы.СоздатьКаталог();

	ЗаписатьФайл(ОбъединитьПути(Проект, "src", "Класс.os"), "Функция Сложить() Экспорт КонецФункции");
	ЗаписатьФайл(ОбъединитьПути(Проект, "src", "Другой.os"), "Функция Вычесть() Экспорт КонецФункции");
	ЗаписатьФайл(ОбъединитьПути(Проект, "tests", "Набор.os"), "&Тест" + Символы.ПС + "Процедура Тест() Экспорт КонецПроцедуры");
	ЗаписатьФайл(ОбъединитьПути(Проект, "oscript_modules", "чужое", "Файл.os"), "// не копируется");

	Возврат Проект;

КонецФункции

Процедура ЗаписатьФайл(Знач Путь, Знач Содержимое)

	ФС.ОбеспечитьКаталог(Новый Файл(Путь).Путь);

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Содержимое);
	Запись.Закрыть();

КонецПроцедуры

Функция ПрочитатьФайл(Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

Функция Копия(Знач Проект)

	Исключения = Новый Массив();
	Исключения.Добавить("oscript_modules");

	КаталогиТестов = Новый Массив();
	КаталогиТестов.Добавить(ОбъединитьПути(Проект, "tests"));

	Возврат Новый РабочаяКопия(
		Проект,
		КаталогиТестов,
		Исключения,
		"",
		Неопределено,
		Истина,
		Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

КонецФункции

&Тест
Процедура ПроектКопируетсяБезИсключенныхКаталогов() Экспорт

	// Зависимости не копируются: каталог библиотек оригинала показывается копии
	// конфигурацией, иначе копирование oscript_modules съело бы весь выигрыш

	// Дано

	Проект = Проект();

	// Когда

	Копия = Копия(Проект);

	// Тогда

	Ожидаем.Что(Новый Файл(ОбъединитьПути(Копия.Каталог(), "src", "Класс.os")).Существует(),
		"Исходник скопирован").ЭтоИстина();

	Ожидаем.Что(Новый Файл(ОбъединитьПути(Копия.Каталог(), "oscript_modules")).Существует(),
		"Библиотеки не скопированы").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура БиблиотекиОригиналаПоказываютсяКонфигурацией() Экспорт

	// Дано

	Проект = Проект();

	// Когда

	Копия = Копия(Проект);

	// Тогда

	Конфигурация = ПрочитатьФайл(ОбъединитьПути(Копия.Каталог(), "oscript.cfg"));

	Ожидаем.Что(СтрНайти(Конфигурация, "lib.additional="), "Настройка библиотек").Больше(0);
	Ожидаем.Что(СтрНайти(Конфигурация, "oscript_modules"), "Каталог библиотек оригинала").Больше(0);

КонецПроцедуры

&Тест
Процедура ПутьВКопииСоответствуетПутиВОригинале() Экспорт

	// Дано

	Проект = Проект();
	Копия = Копия(Проект);

	Оригинал = ОбъединитьПути(Проект, "src", "Класс.os");

	// Когда

	ВКопии = Копия.ПутьВКопии(Оригинал);

	// Тогда

	Ожидаем.Что(ВКопии, "Путь в копии")
		.Равно(ОбъединитьПути(Копия.Каталог(), "src", "Класс.os"));

	Ожидаем.Что(ФС.НормализоватьПуть(Копия.ПутьВОригинале(ВКопии)), "Обратный перевод")
		.Равно(ФС.НормализоватьПуть(Оригинал));

КонецПроцедуры

&Тест
Процедура ЧужойПутьВозвращаетсяКакЕсть() Экспорт

	// Статистика выполнения говорит и о библиотеках: они лежат вне копии,
	// и переводить их некуда

	// Дано

	Копия = Копия(Проект());

	// Когда

	Путь = Копия.ПутьВОригинале("/совсем/другой/файл.os");

	// Тогда

	Ожидаем.Что(Путь, "Чужой путь").Равно("/совсем/другой/файл.os");

КонецПроцедуры

&Тест
Процедура МутантПишетсяВКопиюИНеТрогаетОригинал() Экспорт

	// Дано

	Проект = Проект();
	Копия = Копия(Проект);

	Оригинал = ОбъединитьПути(Проект, "src", "Класс.os");

	// Когда

	Копия.ПоместитьМутанта(Оригинал, "Функция Сложить() Экспорт // мутант КонецФункции");

	// Тогда

	Ожидаем.Что(СтрНайти(ПрочитатьФайл(Копия.ПутьВКопии(Оригинал)), "мутант"), "Мутант в копии")
		.Больше(0);

	Ожидаем.Что(СтрНайти(ПрочитатьФайл(Оригинал), "мутант"), "Оригинал не изменён")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура МутацииРазныхФайловНеНакапливаются() Экспорт

	// Копия переиспользуется под мутантов разных файлов. Без возврата предыдущего
	// она несла бы сразу несколько мутаций, и прогон проверял бы не то, что думает

	// Дано

	Проект = Проект();
	Копия = Копия(Проект);

	Первый = ОбъединитьПути(Проект, "src", "Класс.os");
	Второй = ОбъединитьПути(Проект, "src", "Другой.os");

	// Когда

	Копия.ПоместитьМутанта(Первый, "// мутант первого");
	Копия.ПоместитьМутанта(Второй, "// мутант второго");

	// Тогда

	Ожидаем.Что(СтрНайти(ПрочитатьФайл(Копия.ПутьВКопии(Первый)), "мутант"), "Первый файл вернулся")
		.Равно(0);

	Ожидаем.Что(СтрНайти(ПрочитатьФайл(Копия.ПутьВКопии(Второй)), "мутант"), "Второй файл мутирован")
		.Больше(0);

КонецПроцедуры

&Тест
Процедура ТочкаВходаСобираетсяПриСоздании() Экспорт

	// Дано

	Копия = Копия(Проект());

	// Тогда

	Ожидаем.Что(Новый Файл(Копия.ТочкаВхода()).Существует(), "Точка входа существует")
		.ЭтоИстина();

	Ожидаем.Что(Копия.Наборы(), "Наборы по умолчанию").ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ОтборНаборовПересобираетТочкуВхода() Экспорт

	// Набор тестов зашит в точку входа, а мутанты проверяются разными наборами

	// Дано

	Копия = Копия(Проект());
	Была = Копия.ТочкаВхода();

	Наборы = Новый Массив();
	Наборы.Добавить(ОбъединитьПути(Копия.Каталог(), "tests", "Набор.os"));

	// Когда

	Копия.ПерестроитьТочкуВхода(Наборы);

	// Тогда

	Ожидаем.Что(Копия.ТочкаВхода(), "Точка входа пересобрана").ЭтоНе().Равно(Была);
	Ожидаем.Что(Копия.Наборы(), "Отобранные наборы").ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ПовторныйТотЖеОтборТочкуВходаНеТрогает() Экспорт

	// Пересборка дешевле создания копии, но не бесплатна: на группе мутантов
	// с одним отбором она нужна один раз

	// Дано

	Копия = Копия(Проект());

	Наборы = Новый Массив();
	Наборы.Добавить(ОбъединитьПути(Копия.Каталог(), "tests", "Набор.os"));

	Копия.ПерестроитьТочкуВхода(Наборы);
	Была = Копия.ТочкаВхода();

	// Когда

	Копия.ПерестроитьТочкуВхода(Наборы);

	// Тогда

	Ожидаем.Что(Копия.ТочкаВхода(), "Точка входа та же").Равно(Была);

КонецПроцедуры

&Тест
Процедура ТочкаВходаПолучаетНастройкиПрогонаМутанта() Экспорт

	// Прогон мутанта отличается от обычного: тесты ищутся в подкаталогах, лог молчит,
	// а первое падение прекращает прогон - мутанту большего и не надо

	// Дано

	Проект = Проект();

	// Когда

	Копия = Копия(Проект);

	// Тогда

	Детальки = ДеталькиКопии(Копия);

	Ожидаем.Что(Детальки.Получить("ИскатьВПодкаталогах"), "Поиск в подкаталогах").ЭтоИстина();
	Ожидаем.Что(Детальки.Получить("РежимВыводаЛога"), "Режим лога").Равно("none");
	Ожидаем.Что(Детальки.Получить("ПрерыватьПриПервомПадении"), "Прекращение на падении").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СбореПокрытияПрогонНеПрерывается() Экспорт

	// Сбору покрытия нужен полный прогон: оборванный не расскажет, какие строки
	// выполняет набор

	// Дано

	Проект = Проект();

	Исключения = Новый Массив();
	Исключения.Добавить("oscript_modules");

	КаталогиТестов = Новый Массив();
	КаталогиТестов.Добавить(ОбъединитьПути(Проект, "tests"));

	// Когда

	Копия = Новый РабочаяКопия(
		Проект,
		КаталогиТестов,
		Исключения,
		"",
		Неопределено,
		Ложь,
		Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

	// Тогда

	Ожидаем.Что(ДеталькиКопии(Копия).Получить("ПрерыватьПриПервомПадении"), "Прекращение на падении")
		.ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПутьРядомСКопиейНеСчитаетсяЕеЧастью() Экспорт

	// Каталог-сосед может начинаться с того же имени: проверять надо границу пути,
	// а не начало строки

	// Дано

	Копия = Копия(Проект());
	Сосед = Копия.Каталог() + "-соседний/Класс.os";

	// Когда

	Путь = Копия.ПутьВОригинале(Сосед);

	// Тогда

	Ожидаем.Что(Путь, "Путь соседнего каталога").Равно(Сосед);

КонецПроцедуры

// Детальки, записанные для точки входа копии.
Функция ДеталькиКопии(Копия)

	Путь = ОбъединитьПути(Копия.Каталог(), ".mutatos", "autumn-properties.json");

	Чтение = Новый ЧтениеJSON();
	Чтение.ОткрытьФайл(Путь);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Данные.Получить("OneUnit");

КонецФункции

&Тест
Процедура УдалениеУбираетКаталогКопии() Экспорт

	// Копия - это копия всего проекта, оставлять её во временном каталоге нельзя

	// Дано

	Копия = Копия(Проект());
	Каталог = Копия.Каталог();

	// Когда

	Копия.Удалить();

	// Тогда

	Ожидаем.Что(Новый Файл(Каталог).Существует(), "Каталог копии").ЭтоЛожь();

КонецПроцедуры
