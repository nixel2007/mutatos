#Использовать asserts
#Использовать "../src/core"

// Фильтры отбирают тесты, которыми проверяются мутанты. Они уходят в OneUnit
// двумя путями - детальками поделки и параметрами командной строки, - и оба
// должны называть одни и те же фильтры одинаково.

Функция Фильтры()

	Возврат Новый ФильтрыТестов();

КонецФункции

&Тест
Процедура БезЗаданныхФильтровОниПустые() Экспорт

	// Тогда

	Ожидаем.Что(Фильтры().Пустые(), "Фильтры без значений")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОдногоЗаполненногоФильтраДостаточно() Экспорт

	// Пустые() решает, сужать ли прогон вообще: один фильтр - уже не все тесты

	// Дано

	Фильтры = Фильтры();

	// Когда

	Фильтры.ТегиИсключаемые.Добавить("медленные");

	// Тогда

	Ожидаем.Что(Фильтры.Пустые(), "Фильтры с одним значением")
		.ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ЗаполненныеФильтрыСтановятсяПараметрами() Экспорт

	// Опции те же, что у командной строки OneUnit: свой язык отбора поверх чужого
	// расходился бы с ним при каждом изменении

	// Дано

	Фильтры = Фильтры();
	Фильтры.ТегиВключаемые.Добавить("быстрые");
	Фильтры.НаборыИсключаемые.Добавить("НаборА");
	Фильтры.НаборыИсключаемые.Добавить("НаборБ");

	// Когда

	Параметры = Фильтры.ПараметрыКоманднойСтроки();

	// Тогда

	Ожидаем.Что(Параметры).РавноМассиву(
		СтрРазделить("-t;быстрые;-S;НаборА,НаборБ", ";")
	);

КонецПроцедуры

&Тест
Процедура ПустыеФильтрыВПараметрыНеПопадают() Экспорт

	// Пустой фильтр в командной строке означал бы отбор по пустому значению,
	// то есть прогон вообще без тестов

	// Тогда

	Ожидаем.Что(Фильтры().ПараметрыКоманднойСтроки(), "Параметры без фильтров")
		.ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ФильтрыДополняютДетальки() Экспорт

	// Дано

	Фильтры = Фильтры();
	Фильтры.МетодыВключаемые.Добавить("ТестА");

	Детальки = Новый Соответствие();

	// Когда

	Фильтры.ДополнитьДетальки(Детальки);

	// Тогда

	Ожидаем.Что(Детальки.Получить("ТестовыеМетодыВключаемые"), "Деталька включаемых методов")
		.РавноМассиву(СтрРазделить("ТестА", ","));

	// пустые фильтры тоже уходят: поделка ждёт все детальки, а не только заданные
	Ожидаем.Что(Детальки.Получить("ТегиВключаемые"), "Деталька пустого фильтра")
		.ИмеетДлину(0);

КонецПроцедуры
