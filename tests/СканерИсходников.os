#Использовать asserts
#Использовать fs
#Использовать tempfiles
#Использовать "../src/core"

Перем Проект;

&ПередКаждым
Процедура СоздатьПроект() Экспорт

	Проект = ВременныеФайлы.СоздатьКаталог();

КонецПроцедуры

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

Процедура СоздатьФайл(Знач ОтносительныйПуть)

	ПолныйПуть = ОбъединитьПути(Проект, ОтносительныйПуть);
	ФС.ОбеспечитьКаталог(Новый Файл(ПолныйПуть).Путь);

	Запись = Новый ЗаписьТекста(ПолныйПуть, КодировкаТекста.UTF8);
	Запись.Записать("Функция Ф() Экспорт КонецФункции");
	Запись.Закрыть();

КонецПроцедуры

Функция Сканер()

	Возврат Новый СканерИсходников("oscript_modules,tests,out");

КонецФункции

Функция КаталогПроекта(Знач ОтносительныйПуть = "")

	Каталоги = Новый Массив();
	Каталоги.Добавить(ОбъединитьПути(Проект, ОтносительныйПуть));

	Возврат Каталоги;

КонецФункции

&Тест
Процедура ИсходникиНаходятсяРекурсивно() Экспорт

	// Дано

	СоздатьФайл("src/Класс.os");
	СоздатьФайл("src/Классы/Вложенный.os");

	// Когда

	Исходники = Сканер().НайтиИсходники(КаталогПроекта("src"));

	// Тогда

	Ожидаем.Что(Исходники.Количество(), "Количество исходников")
		.Равно(2);

КонецПроцедуры

&Тест
Процедура ЗависимостиИсключаются() Экспорт

	// мутировать чужой код бессмысленно

	// Дано

	СоздатьФайл("src/Класс.os");
	СоздатьФайл("oscript_modules/чужая/Класс.os");

	// Когда

	Исходники = Сканер().НайтиИсходники(КаталогПроекта());

	// Тогда

	Ожидаем.Что(Исходники.Количество(), "Количество исходников")
		.Равно(1);

КонецПроцедуры

&Тест
Процедура ТестыИсключаются() Экспорт

	// мутация в тестах ломает сам инструмент измерения

	// Дано

	СоздатьФайл("src/Класс.os");
	СоздатьФайл("tests/КлассТест.os");

	// Когда

	Исходники = Сканер().НайтиИсходники(КаталогПроекта());

	// Тогда

	Ожидаем.Что(Исходники.Количество(), "Количество исходников")
		.Равно(1);

КонецПроцедуры

&Тест
Процедура НесуществующийКаталогНеЛоматПоиск() Экспорт

	// Когда

	Исходники = Сканер().НайтиИсходники(КаталогПроекта("несуществующий"));

	// Тогда

	Ожидаем.Что(Исходники.Количество(), "Количество исходников")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ОтдельныеФайлыДобавляютсяКНайденным() Экспорт

	// Дано

	СоздатьФайл("src/Класс.os");
	СоздатьФайл("прочее/Отдельный.os");

	Файлы = Новый Массив();
	Файлы.Добавить(ОбъединитьПути(Проект, "прочее/Отдельный.os"));

	// Когда

	Исходники = Сканер().НайтиИсходники(КаталогПроекта("src"), Файлы);

	// Тогда

	Ожидаем.Что(Исходники.Количество(), "Количество исходников")
		.Равно(2);

КонецПроцедуры

&Тест
Процедура НесуществующийФайлПропускается() Экспорт

	// Дано

	Файлы = Новый Массив();
	Файлы.Добавить(ОбъединитьПути(Проект, "нет-такого.os"));

	// Когда

	Исходники = Сканер().НайтиИсходники(Новый Массив(), Файлы);

	// Тогда

	Ожидаем.Что(Исходники.Количество(), "Количество исходников")
		.Равно(0);

КонецПроцедуры
