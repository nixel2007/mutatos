#Использовать asserts
#Использовать moskito
#Использовать "../src/core"

// Дуб решает, какой будет полоса: в терминале настоящая, в сборке - пишущая в лог.
// Тот, кто показывает прогресс, про окружение не знает вовсе.

Функция Фабрика(Знач ПризнакСборки)

	Возврат Новый ФабрикаПолосы(ПризнакСборки, Мок.Получить(Тип("ПолосаВЛог")));

КонецФункции

&Тест
Процедура ВнеСборкиОтдаетсяНастоящаяПолоса() Экспорт

	// Тогда

	Ожидаем.Что(ТипЗнч(Фабрика("").ПрогрессБар()), "Тип полосы")
		.Равно(Тип("ПрогрессБар"));

КонецПроцедуры

&Тест
Процедура ВСборкеОтдаетсяПолосаВЛог() Экспорт

	// Управляющие последовательности в логе сборки хуже, чем их отсутствие,
	// но прогон от этого не перестаёт быть долгим

	// Дано

	Полоса = Мок.Получить(Тип("ПолосаВЛог"));

	// Когда

	Отданная = Новый ФабрикаПолосы("true", Полоса).ПрогрессБар();

	// Тогда

	Ожидаем.Что(Отданная, "Отданная полоса").Равно(Полоса);

КонецПроцедуры
