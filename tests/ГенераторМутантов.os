#Использовать asserts
#Использовать moskito
#Использовать "../src/core"

// Генератор отвечает только за сборку текста мутанта и делегирование поиска,
// поэтому искатель мутаций здесь подменён моком.

Функция Мутация(Знач Позиция, Знач Длина, Знач Текст)

	Возврат Новый ОписаниеМутации("Мутатор", "описание", Позиция, Длина, Текст, 1);

КонецФункции

Функция ГенераторСМокомИскателя(Мутации = Неопределено)

	МокИскателя = Мок.Получить(Тип("ИскательМутаций"));

	Если Мутации <> Неопределено Тогда
		МокИскателя.Когда().НайтиМутации(Матчеры.ЛюбаяСтрока()).ТогдаВозвращает(Мутации);
	КонецЕсли;

	Возврат Новый ГенераторМутантов(МокИскателя);

КонецФункции

&Тест
Процедура МутантСобираетсяЗаменойФрагмента() Экспорт

	// Дано

	Генератор = ГенераторСМокомИскателя();

	// Когда

	Мутант = Генератор.СоздатьМутанта("Сумма = А + Б;", Мутация(11, 1, "-"));

	// Тогда

	Ожидаем.Что(Мутант, "Мутант")
		.Равно("Сумма = А - Б;");

КонецПроцедуры

&Тест
Процедура МутантСПустымТекстомУдаляетФрагмент() Экспорт

	// Дано

	Генератор = ГенераторСМокомИскателя();

	// Когда

	Мутант = Генератор.СоздатьМутанта("Сохранить(); Продолжить();", Мутация(1, 12, ""));

	// Тогда

	Ожидаем.Что(Мутант, "Мутант")
		.Равно(" Продолжить();");

КонецПроцедуры

&Тест
Процедура МутацияВНачалеИсходникаПрименяется() Экспорт

	// Дано

	Генератор = ГенераторСМокомИскателя();

	// Когда

	Мутант = Генератор.СоздатьМутанта("Истина", Мутация(1, 6, "Ложь"));

	// Тогда

	Ожидаем.Что(Мутант, "Мутант")
		.Равно("Ложь");

КонецПроцедуры

&Тест
Процедура ОригиналНеИзменяетсяМеждуМутантами() Экспорт

	// Каждый мутант собирается из исходного текста, мутации не накапливаются

	// Дано

	Генератор = ГенераторСМокомИскателя();
	Исходник = "А + Б + В";

	// Когда

	ПервыйМутант = Генератор.СоздатьМутанта(Исходник, Мутация(3, 1, "-"));
	ВторойМутант = Генератор.СоздатьМутанта(Исходник, Мутация(7, 1, "-"));

	// Тогда

	Ожидаем.Что(ПервыйМутант, "Первый мутант")
		.Равно("А - Б + В");

	Ожидаем.Что(ВторойМутант, "Второй мутант")
		.Равно("А + Б - В");

КонецПроцедуры

&Тест
Процедура ПоискМутацийДелегируетсяИскателю() Экспорт

	// Дано

	Мутации = Новый Массив();
	Мутации.Добавить(Мутация(1, 1, "-"));

	МокИскателя = Мок.Получить(Тип("ИскательМутаций"));
	МокИскателя.Когда().НайтиМутации("А + Б").ТогдаВозвращает(Мутации);

	Генератор = Новый ГенераторМутантов(МокИскателя);

	// Когда

	Результат = Генератор.НайтиМутации("А + Б");

	// Тогда

	Ожидаем.Что(Результат.Количество(), "Количество мутаций")
		.Равно(1);

	МокИскателя.ПроверитьЧтоВызывалсяМетод().НайтиМутации("А + Б");

КонецПроцедуры
