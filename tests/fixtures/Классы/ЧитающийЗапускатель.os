// Двойник запускателя тестов, который в момент прогона читает мутируемый файл.
//
// Нужен, чтобы проверить: во время прогона на диске лежит именно мутант,
// а не оригинал и не полуприменённая замена.

Перем _Путь;
Перем _ПрочитанныйИсходник;

Функция Прогнать(Знач РабочийКаталог, Знач Таймаут = 0) Экспорт

	Чтение = Новый ЧтениеТекста(_Путь, КодировкаТекста.UTF8);
	_ПрочитанныйИсходник = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат Новый РезультатПрогона(Ложь, 1, 0, "");

КонецФункции

// Содержимое файла, которое видел прогон.
Функция ПрочитанныйИсходник() Экспорт
	Возврат _ПрочитанныйИсходник;
КонецФункции

Процедура ПриСозданииОбъекта(Знач Путь)

	_Путь = Путь;
	_ПрочитанныйИсходник = "";

КонецПроцедуры
