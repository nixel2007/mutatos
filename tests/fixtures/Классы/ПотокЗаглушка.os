// Заглушка потока вывода процесса: отдаёт заготовленные порции по одной.
//
// ЕстьДанные - свойство, а не метод: пул читает его без скобок, как у настоящего потока.

Перем ЕстьДанные Экспорт;

Перем _Порции;
Перем _Прочитано;

Функция Прочитать() Экспорт

	Если Не ЕстьДанные Тогда
		Возврат "";
	КонецЕсли;

	Порция = _Порции[_Прочитано];
	_Прочитано = _Прочитано + 1;

	ЕстьДанные = _Прочитано < _Порции.Количество();

	Возврат Порция;

КонецФункции

Процедура ПриСозданииОбъекта(Знач Вывод = "")

	_Порции    = ?(ПустаяСтрока(Вывод), Новый Массив(), СтрРазделить(Вывод, Символы.ПС));
	_Прочитано = 0;

	ЕстьДанные = _Порции.Количество() > 0;

КонецПроцедуры
