// Двойник запускателя тестов: сообщает, кто выполнил прогон, и доступен ли он.
//
// Мок здесь не используется: moskito портит сигнатуру конструктора с именованными
// параметрами аннотаций, а у настоящих запускателей они есть.

Перем _Имя;
Перем _Доступен;
Перем _Статистика;

Функция Прогнать(Знач РабочийКаталог, Знач Таймаут = 0, Знач ПутьКCodestat = "", Знач Фильтры = Неопределено) Экспорт

	// Настоящий прогон пишет статистику выполнения движка, и без неё анализатору
	// покрытия нечего разбирать
	Если ЗначениеЗаполнено(_Статистика) И ЗначениеЗаполнено(ПутьКCodestat) Тогда
		Запись = Новый ЗаписьТекста(ПутьКCodestat, КодировкаТекста.UTF8);
		Запись.Записать(_Статистика);
		Запись.Закрыть();
	КонецЕсли;

	Возврат Новый РезультатПрогона(Истина, 0, 100, _Имя);

КонецФункции

Функция Доступен(Знач РабочийКаталог) Экспорт
	Возврат _Доступен;
КонецФункции

Функция КаталогЯдраПроекта(Знач РабочийКаталог) Экспорт
	Возврат "";
КонецФункции

Процедура ПриСозданииОбъекта(Знач Имя, Знач Доступен = Истина, Знач Статистика = "")

	_Имя        = Имя;
	_Доступен   = Доступен;
	_Статистика = Статистика;

КонецПроцедуры
