// Двойник исполнителя мутантов: отдаёт заранее заданное состояние на каждое задание
// и запоминает, сколько заданий до него дошло.
//
// Мок не используется: moskito портит сигнатуру конструктора с именованными
// параметрами аннотаций, а у исполнителя они есть.

Перем _Состояние;
Перем _ПринятыеЗадания;
Перем _Задания;

Функция ПроверитьМутантов(Знач РабочийКаталог, Знач Задания, Знач Таймаут = 0,
	Знач КаталогЯдра = "", Знач Параметры = Неопределено) Экспорт

	_ПринятыеЗадания = Задания.Количество();
	_Задания = Задания;

	Результаты = Новый Массив();

	Для Каждого Задание Из Задания Цикл
		Результаты.Добавить(Новый РезультатМутанта(Задание.Мутация, Задание.Файл, _Состояние, 10));
	КонецЦикла;

	Возврат Результаты;

КонецФункции

// Сколько заданий дошло до прогона.
Функция ПринятыеЗадания() Экспорт
	Возврат _ПринятыеЗадания;
КонецФункции

// Наборы, которыми должно проверяться задание с указанным номером.
Функция НаборыЗадания(Знач Номер = 0) Экспорт
	Возврат _Задания[Номер].Наборы;
КонецФункции

// Предел времени, отведённый заданию с указанным номером.
Функция ТаймаутЗадания(Знач Номер = 0) Экспорт
	Возврат _Задания[Номер].Таймаут;
КонецФункции

Процедура ПриСозданииОбъекта(Знач Состояние)

	_Состояние = Состояние;
	_ПринятыеЗадания = 0;
	_Задания = Новый Массив();

КонецПроцедуры
