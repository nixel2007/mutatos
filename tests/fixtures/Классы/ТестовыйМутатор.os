// Тестовый двойник мутатора: отдаёт по одной мутации на каждый узел заданного типа
// и считает обращения, чтобы тесты могли проверить обход дерева.
//
// Мок здесь не используется: moskito падает, когда один мок дважды получает
// разные строки таблицы значений, а узлы АСД - это именно они.

Перем _Имя;
Перем _ТипыУзлов;
Перем _КоличествоВызовов;

Функция Имя() Экспорт
	Возврат _Имя;
КонецФункции

Функция ТипыУзлов(Типы) Экспорт
	Возврат _ТипыУзлов;
КонецФункции

Функция Мутации(Узел, Контекст) Экспорт

	_КоличествоВызовов = _КоличествоВызовов + 1;

	Мутации = Новый Массив();
	Мутации.Добавить(Новый ОписаниеМутации(_Имя, "тестовая мутация", 1, 1, "X", 1));

	Возврат Мутации;

КонецФункции

// Сколько раз мутатор получал узел на обработку.
Функция КоличествоВызовов() Экспорт
	Возврат _КоличествоВызовов;
КонецФункции

Процедура ПриСозданииОбъекта(Знач ТипУзла, Знач Имя = "Тестовый")

	_Имя = Имя;
	_КоличествоВызовов = 0;

	_ТипыУзлов = Новый Массив();
	_ТипыУзлов.Добавить(ТипУзла);

КонецПроцедуры
