// Заглушка процесса: у платформенного Процесса нет конструктора, и мок его не построит.
//
// Свойства и методы - те, что читает пул: признак завершения, код возврата,
// потоки вывода и принудительное завершение.

Перем Завершен Экспорт;
Перем КодВозврата Экспорт;
Перем ПотокВывода Экспорт;
Перем ПотокОшибок Экспорт;
Перем Завершался Экспорт;

Процедура Завершить() Экспорт

	Завершался = Истина;
	Завершен   = Истина;

КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач Код = 0, Знач СразуЗавершен = Истина, Знач Вывод = "")

	Завершен    = СразуЗавершен;
	КодВозврата = Код;
	Завершался  = Ложь;

	ПотокВывода = Новый ПотокЗаглушка(Вывод);
	ПотокОшибок = Новый ПотокЗаглушка("");

КонецПроцедуры
