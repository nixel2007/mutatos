// Заглушка процесса: пул читает у него свойства - признак завершения, код возврата
// и потоки вывода, а мок подменяет только методы. Замоканный Процесс отдавал бы
// на эти свойства пустоту, и пул не увидел бы ни завершения, ни кода возврата.

Перем Завершен Экспорт;
Перем КодВозврата Экспорт;
Перем ПотокВывода Экспорт;
Перем ПотокОшибок Экспорт;
Перем Завершался Экспорт;

// Завершает процесс сам, без вмешательства пула: так проверяется прогон,
// которому не ставили предела времени.
Процедура ЗавершитьсяПослеОпроса() Экспорт

	Завершен = Истина;

КонецПроцедуры

Процедура Завершить() Экспорт

	Завершался = Истина;
	Завершен   = Истина;

КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач Код = 0, Знач СразуЗавершен = Истина, Знач Вывод = "")

	Завершен    = СразуЗавершен;
	КодВозврата = Код;
	Завершался  = Ложь;

	ПотокВывода = Новый ПотокЗаглушка(Вывод);
	ПотокОшибок = Новый ПотокЗаглушка("");

КонецПроцедуры
