// Двойник сборщика карты тестов: отдаёт заранее заданную карту
// и запоминает, спрашивали ли её вообще.

Перем _Карта;
Перем _Собирали;

Функция Собрать(Знач РабочийКаталог, Знач КаталогЯдра = "", Знач Параметры = Неопределено) Экспорт

	_Собирали = Истина;

	Возврат _Карта;

КонецФункции

// Истина, если карту действительно собирали.
Функция Собирали() Экспорт
	Возврат _Собирали;
КонецФункции

Процедура ПриСозданииОбъекта(Знач Карта = Неопределено)

	_Карта    = ?(Карта = Неопределено, Новый КартаТестов(), Карта);
	_Собирали = Ложь;

КонецПроцедуры
