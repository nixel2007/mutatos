#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать autumn-logos
#Использовать "../src/core"

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

Функция Анализатор()

	Запускатель = Мок.Получить(Тип("ЗапускательТестовOneUnit"));

	Возврат Новый АнализаторПокрытия(Запускатель, Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

КонецФункции

Функция ОтчетСПокрытием(Знач Содержимое)

	Путь = ВременныеФайлы.НовоеИмяФайла("xml");

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Содержимое);
	Запись.Закрыть();

	Возврат Путь;

КонецФункции

&Тест
Процедура ПокрытыеСтрокиПопадаютВКарту() Экспорт

	// Дано

	Путь = ОтчетСПокрытием("<?xml version=""1.0"" encoding=""utf-8""?>
		|<coverage version=""1"">
		|	<file path=""/проект/Класс.os"">
		|		<lineToCover lineNumber=""7"" covered=""true""/>
		|		<lineToCover lineNumber=""8"" covered=""false""/>
		|	</file>
		|</coverage>");

	// Когда

	Покрытие = Анализатор().ПрочитатьОтчет(Путь);

	// Тогда

	Ожидаем.Что(Покрытие.Покрыта("/проект/Класс.os", 7), "Выполнявшаяся строка")
		.ЭтоИстина();

	Ожидаем.Что(Покрытие.Покрыта("/проект/Класс.os", 8), "Не выполнявшаяся строка")
		.ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ФайлБезПокрытыхСтрокОстаетсяИзвестным() Экспорт

	// иначе его мутанты проверялись бы вхолостую как файл без данных

	// Дано

	Путь = ОтчетСПокрытием("<?xml version=""1.0"" encoding=""utf-8""?>
		|<coverage version=""1"">
		|	<file path=""/проект/Класс.os"">
		|		<lineToCover lineNumber=""7"" covered=""false""/>
		|	</file>
		|</coverage>");

	// Когда

	Покрытие = Анализатор().ПрочитатьОтчет(Путь);

	// Тогда

	Ожидаем.Что(Покрытие.ЕстьДанные("/проект/Класс.os"), "Данные о файле")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СтрокиНесколькихФайловРазделяются() Экспорт

	// Дано

	Путь = ОтчетСПокрытием("<?xml version=""1.0"" encoding=""utf-8""?>
		|<coverage version=""1"">
		|	<file path=""/проект/Первый.os"">
		|		<lineToCover lineNumber=""3"" covered=""true""/>
		|	</file>
		|	<file path=""/проект/Второй.os"">
		|		<lineToCover lineNumber=""5"" covered=""true""/>
		|	</file>
		|</coverage>");

	// Когда

	Покрытие = Анализатор().ПрочитатьОтчет(Путь);

	// Тогда

	Ожидаем.Что(Покрытие.Покрыта("/проект/Первый.os", 3), "Строка первого файла")
		.ЭтоИстина();

	Ожидаем.Что(Покрытие.Покрыта("/проект/Первый.os", 5), "Строка второго файла в первом")
		.ЭтоЛожь();

	Ожидаем.Что(Покрытие.Покрыта("/проект/Второй.os", 5), "Строка второго файла")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОтсутствующийОтчетДаетПустуюКарту() Экспорт

	// Когда

	Покрытие = Анализатор().ПрочитатьОтчет(ВременныеФайлы.НовоеИмяФайла("xml"));

	// Тогда

	Ожидаем.Что(Покрытие.КоличествоПокрытыхСтрок(), "Количество покрытых строк")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ПустойОтчетДаетПустуюКарту() Экспорт

	// Дано

	Путь = ОтчетСПокрытием("<?xml version=""1.0"" encoding=""utf-8""?>
		|<coverage version=""1""/>");

	// Когда

	Покрытие = Анализатор().ПрочитатьОтчет(Путь);

	// Тогда

	Ожидаем.Что(Покрытие.КоличествоПокрытыхСтрок(), "Количество покрытых строк")
		.Равно(0);

КонецПроцедуры
