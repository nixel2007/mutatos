#Использовать asserts
#Использовать moskito
#Использовать tempfiles
#Использовать autumn-logos
#Использовать "../src/core"

// Покрытие берётся из статистики выполнения движка: файл, метод, строка и счётчик вызовов.

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

Функция Анализатор()

	Запускатель = Мок.Получить(Тип("ЗапускательТестов"));

	Возврат Новый АнализаторПокрытия(Запускатель, Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

КонецФункции

Функция ФайлСтатистики(Знач Содержимое)

	Путь = ВременныеФайлы.НовоеИмяФайла("json");

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Содержимое);
	Запись.Закрыть();

	Возврат Путь;

КонецФункции

&Тест
Процедура ВыполнявшиесяСтрокиПопадаютВКарту() Экспорт

	// Дано

	Путь = ФайлСтатистики("{
		|	""/проект/Класс.os"": {
		|		""#path"": ""/проект/Класс.os"",
		|		""Сложить"": {
		|			""7"": { ""count"": 3, ""time"": 0 },
		|			""8"": { ""count"": 0, ""time"": 0 }
		|		}
		|	}
		|}");

	// Когда

	Покрытие = Анализатор().ПрочитатьСтатистику(Путь);

	// Тогда

	Ожидаем.Что(Покрытие.Покрыта("/проект/Класс.os", 7), "Выполнявшаяся строка")
		.ЭтоИстина();

	Ожидаем.Что(Покрытие.Покрыта("/проект/Класс.os", 8), "Строка со счётчиком ноль")
		.ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СлужебныеКлючиСтатистикиПропускаются() Экспорт

	// в статистике рядом с методами лежит служебный "#path"

	// Дано

	Путь = ФайлСтатистики("{
		|	""/проект/Класс.os"": {
		|		""#path"": ""/проект/Класс.os""
		|	}
		|}");

	// Когда

	Покрытие = Анализатор().ПрочитатьСтатистику(Путь);

	// Тогда

	Ожидаем.Что(Покрытие.КоличествоПокрытыхСтрок(), "Количество покрытых строк")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ФайлБезВыполненныхСтрокОстаетсяИзвестным() Экспорт

	// иначе его мутанты проверялись бы вхолостую как файл без данных

	// Дано

	Путь = ФайлСтатистики("{
		|	""/проект/Класс.os"": {
		|		""Сложить"": {
		|			""7"": { ""count"": 0, ""time"": 0 }
		|		}
		|	}
		|}");

	// Когда

	Покрытие = Анализатор().ПрочитатьСтатистику(Путь);

	// Тогда

	Ожидаем.Что(Покрытие.ЕстьДанные("/проект/Класс.os"), "Данные о файле")
		.ЭтоИстина();

	Ожидаем.Что(Покрытие.Покрыта("/проект/Класс.os", 7), "Не выполнявшаяся строка")
		.ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СтрокиРазныхМетодовИФайловСобираютсяВместе() Экспорт

	// Дано

	Путь = ФайлСтатистики("{
		|	""/проект/Первый.os"": {
		|		""Сложить"": { ""3"": { ""count"": 1, ""time"": 0 } },
		|		""Умножить"": { ""9"": { ""count"": 2, ""time"": 0 } }
		|	},
		|	""/проект/Второй.os"": {
		|		""$entry"": { ""5"": { ""count"": 1, ""time"": 0 } }
		|	}
		|}");

	// Когда

	Покрытие = Анализатор().ПрочитатьСтатистику(Путь);

	// Тогда

	Ожидаем.Что(Покрытие.Покрыта("/проект/Первый.os", 3), "Строка первого метода")
		.ЭтоИстина();

	Ожидаем.Что(Покрытие.Покрыта("/проект/Первый.os", 9), "Строка второго метода")
		.ЭтоИстина();

	Ожидаем.Что(Покрытие.Покрыта("/проект/Второй.os", 5), "Строка другого файла")
		.ЭтоИстина();

	Ожидаем.Что(Покрытие.Покрыта("/проект/Первый.os", 5), "Строка другого файла в первом")
		.ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ОтсутствующаяСтатистикаДаетПустуюКарту() Экспорт

	// Когда

	Покрытие = Анализатор().ПрочитатьСтатистику(ВременныеФайлы.НовоеИмяФайла("json"));

	// Тогда

	Ожидаем.Что(Покрытие.КоличествоПокрытыхСтрок(), "Количество покрытых строк")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ПустаяСтатистикаДаетПустуюКарту() Экспорт

	// Дано

	Путь = ФайлСтатистики("{}");

	// Когда

	Покрытие = Анализатор().ПрочитатьСтатистику(Путь);

	// Тогда

	Ожидаем.Что(Покрытие.КоличествоПокрытыхСтрок(), "Количество покрытых строк")
		.Равно(0);

КонецПроцедуры
