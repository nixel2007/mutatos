#Использовать asserts
#Использовать moskito
#Использовать "../src/core"
#Использовать "./fixtures"

// Юнит-тесты пула прогонов. Проверяется только его работа: раздать задания
// свободным копиям, дождаться завершения и собрать то, что вернёт мастер.
// Что мастер делает с заданием и что там за процесс - забота их собственных тестов.
//
// Процессы - заглушки: у платформенного Процесса нет конструктора, и мок его не построит.

Функция Мастер(Процессы)

	Мастер = Мок.Получить(Тип("ИсполнительМутантов"));

	Мастер.Когда().Таймаут(Матчеры.ЛюбоеЗначение()).ТогдаВозвращает(0);

	Мастер.Когда().Запустить(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(Процессы, "Следующий"));

	Мастер.Когда().Завершено(
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение())
		.ТогдаВозвращает("завершено");

	Мастер.Когда().Прервано(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаВозвращает("прервано");

	Возврат Мастер;

КонецФункции

Функция Копии(Знач Сколько)

	Копии = Новый Массив();

	Для Сч = 1 По Сколько Цикл
		Копии.Добавить("копия" + Сч);
	КонецЦикла;

	Возврат Копии;

КонецФункции

Функция Задания(Знач Сколько)

	Задания = Новый Массив();

	Для Сч = 1 По Сколько Цикл
		Задания.Добавить(Новый Структура("Имя", "задание" + Сч));
	КонецЦикла;

	Возврат Задания;

КонецФункции

&Тест
Процедура КаждоеЗаданиеДаетРезультат() Экспорт

	// Дано

	Процессы = Новый ОчередьПроцессов();
	Процессы.Добавить(Новый ПроцессЗаглушка(0));
	Процессы.Добавить(Новый ПроцессЗаглушка(0));
	Процессы.Добавить(Новый ПроцессЗаглушка(0));

	// Когда

	Результаты = Новый ПулПрогонов().Прогнать(Копии(2), Задания(3), Мастер(Процессы));

	// Тогда

	Ожидаем.Что(Результаты, "Результаты").ИмеетДлину(3);

КонецПроцедуры

&Тест
Процедура БезЗаданийПулНичегоНеЗапускает() Экспорт

	// Дано

	Процессы = Новый ОчередьПроцессов();

	// Когда

	Результаты = Новый ПулПрогонов().Прогнать(Копии(2), Новый Массив(), Мастер(Процессы));

	// Тогда

	Ожидаем.Что(Результаты, "Результаты").ИмеетДлину(0);
	Ожидаем.Что(Процессы.Выдано, "Запущено процессов").Равно(0);

КонецПроцедуры

&Тест
Процедура ОдновременноРаботаетНеБольшеЧемКопий() Экспорт

	// На копию одновременно одно задание: иначе два мутанта писались бы в один каталог.
	// Видно по порядку событий - до первого завершения запусков ровно столько,
	// сколько копий, хотя заданий больше

	// Дано

	Процессы = Новый ОчередьПроцессов();
	Для Сч = 1 По 5 Цикл
		Процессы.Добавить(Новый ПроцессЗаглушка(0));
	КонецЦикла;

	Мастер = Мастер(Процессы);
	Мастер.Когда().Завершено(
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение(),
			Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(Процессы, "ОтметитьЗавершение"));

	// Когда

	Пул = Новый ПулПрогонов();
	Пул.Прогнать(Копии(2), Задания(5), Мастер);

	// Тогда

	Ожидаем.Что(Процессы.ЗапусковДоПервогоЗавершения, "Запусков до первого завершения")
		.Равно(2);

КонецПроцедуры

&Тест
Процедура ПревышенныйТаймаутЗавершаетПроцесс() Экспорт

	// Дано

	Зависший = Новый ПроцессЗаглушка(0, Ложь);

	Процессы = Новый ОчередьПроцессов();
	Процессы.Добавить(Зависший);

	Мастер = Мастер(Процессы);
	Мастер.Когда().Таймаут(Матчеры.ЛюбоеЗначение()).ТогдаВозвращает(1);

	// Когда

	Результаты = Новый ПулПрогонов().Прогнать(Копии(1), Задания(1), Мастер);

	// Тогда

	Ожидаем.Что(Зависший.Завершался, "Процесс завершён принудительно").ЭтоИстина();
	Ожидаем.Что(Результаты[0], "Результат").Равно("прервано");

КонецПроцедуры

&Тест
Процедура ВыводПроцессаПопадаетВРезультат() Экспорт

	// Вывод вычитывается по ходу прогона: иначе буфер движка растёт без предела,
	// а хвост нужен, чтобы показать причину, если прогон не запустился вовсе

	// Дано

	Процессы = Новый ОчередьПроцессов();
	Процессы.Добавить(Новый ПроцессЗаглушка(1, Истина, "первая строка" + Символы.ПС + "вторая строка"));

	Мастер = Мастер(Процессы);

	// Когда

	Пул = Новый ПулПрогонов();
	Пул.Прогнать(Копии(1), Задания(1), Мастер);

	// Тогда

	Мастер.ПроверитьЧтоВызывалсяМетод().Завершено(
		Матчеры.ЛюбоеЗначение(),
		1,
		Матчеры.ЛюбоеЗначение(),
		Матчеры.Содержит("вторая строка"));

КонецПроцедуры
