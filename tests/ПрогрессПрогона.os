#Использовать asserts
#Использовать autumn-logos
#Использовать "../src/core"

// Полосу рисует progbar, поэтому проверяется не отрисовка, а то, что остаётся
// на стороне mutatos: счёт исходов и решение, показывать полосу или писать в лог.

Функция Прогресс()

	Возврат Новый ПрогрессПрогона(Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

КонецФункции

&Тест
Процедура ПодсказкаПоказываетИсходыПроверенных() Экспорт

	// Шаг, проценты и время библиотека посчитает сама, а исход мутанта
	// знает только вызывающий - он и кладёт его в подсказку

	// Дано

	Прогресс = Прогресс();
	Прогресс.Начать(10, Ложь);

	// Когда

	Прогресс.Отметить(СостоянияМутанта.Убит());
	Прогресс.Отметить(СостоянияМутанта.Убит());
	Прогресс.Отметить(СостоянияМутанта.Выжил());

	// Тогда

	Ожидаем.Что(Прогресс.Подсказка(), "Подсказка полосы")
		.Равно("убито 2, выжило 1 ");

КонецПроцедуры

&Тест
Процедура ТаймаутСчитаетсяУбийством() Экспорт

	// Мутант, на котором тесты повисли, тоже убит: живой мутант отработал бы
	// за то же время, что и оригинал

	// Дано

	Прогресс = Прогресс();
	Прогресс.Начать(10, Ложь);

	// Когда

	Прогресс.Отметить(СостоянияМутанта.Таймаут());

	// Тогда

	Ожидаем.Что(Прогресс.Подсказка(), "Подсказка полосы")
		.Равно("убито 1, выжило 0 ");

КонецПроцедуры

&Тест
Процедура ВСборкеПолосаНеРисуется() Экспорт

	// В логе сборки управляющие последовательности хуже, чем их отсутствие.
	// Своя проверка нужна и при живой библиотеке: про сборку она не знает

	// Дано

	БылоCI = ПеременныеСреды().Получить("CI");
	УстановитьПеременнуюСреды("CI", "true");

	// Когда

	ЕстьКонсоль = Прогресс().ЕстьКонсоль();

	// Тогда

	УстановитьПеременнуюСреды("CI", ?(БылоCI = Неопределено, "", БылоCI));

	Ожидаем.Что(ЕстьКонсоль, "Наличие консоли под признаком сборки")
		.ЭтоЛожь();

КонецПроцедуры
