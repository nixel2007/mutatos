#Использовать asserts
#Использовать moskito
#Использовать autumn-logos
#Использовать "../src/core"

// Юнит-тесты показа прогресса. Проверяется его собственная работа: считать исходы,
// решать, рисовать полосу или писать в лог, и не падать, если рисовать перестало
// получаться. Как выглядит сама полоса - забота библиотеки и её тестов.

Функция Прогресс(Знач ЕстьКонсоль = Истина, Полоса = Неопределено)

	Фабрика = Мок.Получить(Тип("ФабрикаПолосы"));
	Фабрика.Когда().ЕстьКонсоль().ТогдаВозвращает(ЕстьКонсоль);
	Фабрика.Когда().СоздатьПолосу().ТогдаВозвращает(
		?(Полоса = Неопределено, Мок.Получить(Тип("ПрогрессБар")), Полоса));

	Возврат Новый ПрогрессПрогона(Фабрика, Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

КонецФункции

&Тест
Процедура ПодсказкаПоказываетИсходыПроверенных() Экспорт

	// Шаг, проценты и время библиотека посчитает сама, а исход мутанта
	// знает только вызывающий - он и кладёт его в подсказку

	// Дано

	Прогресс = Прогресс();
	Прогресс.Начать(10);

	// Когда

	Прогресс.Отметить(СостоянияМутанта.Убит());
	Прогресс.Отметить(СостоянияМутанта.Убит());
	Прогресс.Отметить(СостоянияМутанта.Выжил());

	// Тогда

	Ожидаем.Что(Прогресс.Подсказка(), "Подсказка полосы").Равно("убито 2, выжило 1 ");

КонецПроцедуры

&Тест
Процедура ТаймаутСчитаетсяУбийством() Экспорт

	// Мутант, на котором тесты повисли, тоже убит: живой отработал бы за то же время,
	// что и оригинал

	// Дано

	Прогресс = Прогресс();
	Прогресс.Начать(10);

	// Когда

	Прогресс.Отметить(СостоянияМутанта.Таймаут());

	// Тогда

	Ожидаем.Что(Прогресс.Подсказка(), "Подсказка полосы").Равно("убито 1, выжило 0 ");

КонецПроцедуры

&Тест
Процедура ПолосаШагаетНаКаждогоПроверенного() Экспорт

	// Дано

	Полоса = Мок.Получить(Тип("ПрогрессБар"));
	Прогресс = Прогресс(Истина, Полоса);

	// Когда

	Прогресс.Начать(2);
	Прогресс.Отметить(СостоянияМутанта.Убит());
	Прогресс.Завершить();

	// Тогда

	Полоса.ПроверитьЧтоВызывалсяМетод().Начать(2, Матчеры.ЛюбоеЗначение());
	Полоса.ПроверитьЧтоВызывалсяМетод().СделатьШаг(1, Матчеры.ЛюбоеЗначение(), "убито 1, выжило 0 ");
	Полоса.ПроверитьЧтоВызывалсяМетод().Завершить();

КонецПроцедуры

&Тест
Процедура БезКонсолиПолосаНеСоздается() Экспорт

	// В логе сборки управляющие последовательности хуже, чем их отсутствие

	// Дано

	Фабрика = Мок.Получить(Тип("ФабрикаПолосы"));
	Фабрика.Когда().ЕстьКонсоль().ТогдаВозвращает(Ложь);

	Прогресс = Новый ПрогрессПрогона(Фабрика, Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

	// Когда

	Прогресс.Начать(10);
	Прогресс.Отметить(СостоянияМутанта.Убит());
	Прогресс.Завершить();

	// Тогда

	Ожидаем.Что(Прогресс.Подсказка(), "Счёт ведётся и без полосы").Равно("убито 1, выжило 0 ");

КонецПроцедуры

&Тест
Процедура ВыключенныйПрогрессПолосуНеСоздает() Экспорт

	// Дано

	Полоса = Мок.Получить(Тип("ПрогрессБар"));
	Прогресс = Прогресс(Истина, Полоса);

	// Когда

	Прогресс.Начать(10, Ложь);
	Прогресс.Отметить(СостоянияМутанта.Убит());

	// Тогда

	Ожидаем.Что(Прогресс.Подсказка(), "Счёт ведётся").Равно("убито 1, выжило 0 ");

КонецПроцедуры

&Тест
Процедура БезМутантовПолосаНеНужна() Экспорт

	// Дано

	Прогресс = Прогресс();

	// Когда

	Прогресс.Начать(0);
	Прогресс.Завершить();

	// Тогда

	Ожидаем.Что(Прогресс.Подсказка(), "Подсказка").Равно("убито 0, выжило 0 ");

КонецПроцедуры

&Тест
Процедура ОтвалившаясяПолосаНеРонияетПрогон() Экспорт

	// Полоса - украшение: если консоль отвалилась посреди прогона, проверка мутантов
	// продолжается, а отметки уходят в лог

	// Дано

	Полоса = Мок.Получить(Тип("ПрогрессБар"));
	Полоса.Когда().СделатьШаг(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаВыбрасываетИсключение("Консоль отвалилась");

	Прогресс = Прогресс(Истина, Полоса);

	// Когда

	Прогресс.Начать(3);
	Прогресс.Отметить(СостоянияМутанта.Убит());
	Прогресс.Отметить(СостоянияМутанта.Выжил());
	Прогресс.Завершить();

	// Тогда

	Ожидаем.Что(Прогресс.Подсказка(), "Счёт не сбился").Равно("убито 1, выжило 1 ");

КонецПроцедуры

&Тест
Процедура НеСоздавшаясяПолосаНеРонияетПрогон() Экспорт

	// Дано

	Фабрика = Мок.Получить(Тип("ФабрикаПолосы"));
	Фабрика.Когда().ЕстьКонсоль().ТогдаВозвращает(Истина);
	Фабрика.Когда().СоздатьПолосу().ТогдаВыбрасываетИсключение("Полосу не создать");

	Прогресс = Новый ПрогрессПрогона(Фабрика, Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

	// Когда

	Прогресс.Начать(2);
	Прогресс.Отметить(СостоянияМутанта.Убит());

	// Тогда

	Ожидаем.Что(Прогресс.Подсказка(), "Счёт ведётся").Равно("убито 1, выжило 0 ");

КонецПроцедуры
