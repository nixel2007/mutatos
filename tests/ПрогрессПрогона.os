#Использовать asserts
#Использовать autumn-logos
#Использовать "../src/core"

// Полоса рисуется возвратом каретки поверх самой себя. Если строка шире консоли,
// терминал переносит её, и возврат каретки возвращается уже в начало второй строки -
// хвост предыдущей остаётся на экране, и вместо полосы получается лестница из мусора.

Функция Прогресс()

	Возврат Новый ПрогрессПрогона(Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

КонецФункции

Функция ДлиннейшаяСтрока(Знач Всего)

	Прогресс = Прогресс();
	Прогресс.Начать(Всего, Истина);

	Длиннейшая = 0;

	Для Сч = 1 По Всего Цикл

		Прогресс.Отметить(?(Сч % 3 = 0, СостоянияМутанта.Выжил(), СостоянияМутанта.Убит()));

		Длина = СтрДлина(Прогресс.СтрокаПрогресса());

		Если Длина > Длиннейшая Тогда
			Длиннейшая = Длина;
		КонецЕсли;

	КонецЦикла;

	Возврат Длиннейшая;

КонецФункции

&Тест
Процедура СтрокаПрогрессаНеШиреКонсоли() Экспорт

	// Дано

	Всего = 1680;

	// Когда

	Длиннейшая = ДлиннейшаяСтрока(Всего);

	// Тогда

	Ожидаем.Что(Длиннейшая, "Длина самой длинной строки прогресса")
		.МеньшеИлиРавно(Прогресс().ШиринаКонсоли());

КонецПроцедуры

&Тест
Процедура ПодписьПомещаетсяРядомСПолосой() Экспорт

	// Подпись к концу прогона длиннее, чем в начале: счётчики дорастают до общего
	// числа мутантов, а к ним добавляется прогноз остатка. Место под неё резервируется
	// один раз, и зарезервировать надо под самую длинную - иначе строка перестанет
	// помещаться ровно тогда, когда прогон разойдётся

	// Дано

	Прогресс = Прогресс();
	Прогресс.Начать(1680, Истина);

	// Когда

	ЗанятоСтрокой = Прогресс.ДлинаПолосы() + 2 + Прогресс.ДлинаСамойДлиннойПодписи();

	// Тогда

	Ожидаем.Что(ЗанятоСтрокой, "Полоса со скобками и самой длинной подписью")
		.МеньшеИлиРавно(Прогресс.ШиринаКонсоли());

КонецПроцедуры

&Тест
Процедура СтрокаПрогрессаНеПрыгаетПоШирине() Экспорт

	// Полоса неподвижна: подпись растёт, но место под неё зарезервировано заранее,
	// поэтому строка добивается пробелами до одной и той же ширины

	// Дано

	Прогресс = Прогресс();
	Прогресс.Начать(500, Истина);

	// Когда

	Прогресс.Отметить(СостоянияМутанта.Убит());
	Первая = СтрДлина(Прогресс.СтрокаПрогресса());

	Для Сч = 2 По 500 Цикл
		Прогресс.Отметить(СостоянияМутанта.Убит());
	КонецЦикла;

	Последняя = СтрДлина(Прогресс.СтрокаПрогресса());

	// Тогда

	Ожидаем.Что(Последняя, "Длина строки в конце прогона")
		.Равно(Первая);

КонецПроцедуры
