#Использовать asserts
#Использовать moskito
#Использовать autumn-logos
#Использовать "../src/core"

// Юнит-тесты показа прогресса. Проверяется его собственная работа: считать исходы,
// решать, рисовать полосу или писать в лог, и не падать, если рисовать перестало
// получаться. Как выглядит сама полоса - забота библиотеки и её тестов.

// Сколько раз полоса получила шаг: считается ответом мока
Перем _ШаговПолосы;

&ПередКаждым
Процедура СброситьСчетчик() Экспорт

	_ШаговПолосы = 0;

КонецПроцедуры

Функция СосчитатьШагИУпасть(ИнформацияОВызове) Экспорт

	_ШаговПолосы = _ШаговПолосы + 1;

	ВызватьИсключение "Консоль отвалилась";

КонецФункции

Функция Прогресс(Полоса = Неопределено)

	Возврат Новый ПрогрессПрогона(
		?(Полоса = Неопределено, Мок.Получить(Тип("ПрогрессБар")), Полоса),
		Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

КонецФункции

&Тест
Процедура ПодсказкаПоказываетИсходыПроверенных() Экспорт

	// Шаг, проценты и время библиотека посчитает сама, а исход мутанта
	// знает только вызывающий - он и кладёт его в подсказку

	// Дано

	Прогресс = Прогресс();
	Прогресс.Начать(10);

	// Когда

	Прогресс.Отметить(СостоянияМутанта.Убит());
	Прогресс.Отметить(СостоянияМутанта.Убит());
	Прогресс.Отметить(СостоянияМутанта.Выжил());

	// Тогда

	Ожидаем.Что(Прогресс.Подсказка(), "Подсказка полосы").Равно("убито 2, выжило 1 ");

КонецПроцедуры

&Тест
Процедура ТаймаутСчитаетсяУбийством() Экспорт

	// Мутант, на котором тесты повисли, тоже убит: живой отработал бы за то же время,
	// что и оригинал

	// Дано

	Прогресс = Прогресс();
	Прогресс.Начать(10);

	// Когда

	Прогресс.Отметить(СостоянияМутанта.Таймаут());

	// Тогда

	Ожидаем.Что(Прогресс.Подсказка(), "Подсказка полосы").Равно("убито 1, выжило 0 ");

КонецПроцедуры

&Тест
Процедура ПолосаШагаетНаКаждогоПроверенного() Экспорт

	// Дано

	Полоса = Мок.Получить(Тип("ПрогрессБар"));
	Прогресс = Прогресс(Полоса);

	// Когда

	Прогресс.Начать(2);
	Прогресс.Отметить(СостоянияМутанта.Убит());
	Прогресс.Завершить();

	// Тогда

	Полоса.ПроверитьЧтоВызывалсяМетод().Начать(2, Матчеры.ЛюбоеЗначение());
	Полоса.ПроверитьЧтоВызывалсяМетод().СделатьШаг(1, Матчеры.ЛюбоеЗначение(), "убито 1, выжило 0 ");
	Полоса.ПроверитьЧтоВызывалсяМетод().Завершить();

КонецПроцедуры


&Тест
Процедура ВыключенныйПрогрессПолосуНеСоздает() Экспорт

	// Дано

	Полоса = Мок.Получить(Тип("ПрогрессБар"));
	Прогресс = Прогресс(Полоса);

	// Когда

	Прогресс.Начать(10, Ложь);
	Прогресс.Отметить(СостоянияМутанта.Убит());

	// Тогда

	Ожидаем.Что(Прогресс.Подсказка(), "Счёт ведётся").Равно("убито 1, выжило 0 ");

КонецПроцедуры

&Тест
Процедура БезМутантовПолосаНеНужна() Экспорт

	// Дано

	Прогресс = Прогресс();

	// Когда

	Прогресс.Начать(0);
	Прогресс.Завершить();

	// Тогда

	Ожидаем.Что(Прогресс.Подсказка(), "Подсказка").Равно("убито 0, выжило 0 ");

КонецПроцедуры

&Тест
Процедура ОтвалившаясяПолосаНеРонияетПрогон() Экспорт

	// Полоса - украшение: если консоль отвалилась посреди прогона, проверка мутантов
	// продолжается, а отметки уходят в лог

	// Дано

	Полоса = Мок.Получить(Тип("ПрогрессБар"));
	Полоса.Когда().СделатьШаг(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаВыбрасываетИсключение("Консоль отвалилась");

	Прогресс = Прогресс(Полоса);

	// Когда

	Прогресс.Начать(3);
	Прогресс.Отметить(СостоянияМутанта.Убит());
	Прогресс.Отметить(СостоянияМутанта.Выжил());
	Прогресс.Завершить();

	// Тогда

	Ожидаем.Что(Прогресс.Подсказка(), "Счёт не сбился").Равно("убито 1, выжило 1 ");

КонецПроцедуры

&Тест
Процедура ОтвалившуюсяПолосуБольшеНеТрогают() Экспорт

	// Мало не упасть на отвалившейся консоли: если продолжать в неё писать,
	// каждый следующий мутант будет платить за исключение

	// Дано

	Полоса = Мок.Получить(Тип("ПрогрессБар"));
	Полоса.Когда().СделатьШаг(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "СосчитатьШагИУпасть"));

	Прогресс = Прогресс(Полоса);

	// Когда

	Прогресс.Начать(5);
	Для Сч = 1 По 4 Цикл
		Прогресс.Отметить(СостоянияМутанта.Убит());
	КонецЦикла;

	// Тогда

	Ожидаем.Что(_ШаговПолосы, "Обращений к полосе после отказа").Равно(1);
	Ожидаем.Что(Прогресс.Подсказка(), "Счёт продолжился").Равно("убито 4, выжило 0 ");

КонецПроцедуры

&Тест
Процедура ЗавершениеЗакрываетПолосуОдинРаз() Экспорт

	// После завершения прогресса полосу трогать нечем: прогон кончился

	// Дано

	Полоса = Мок.Получить(Тип("ПрогрессБар"));
	Прогресс = Прогресс(Полоса);

	// Когда

	Прогресс.Начать(2);
	Прогресс.Завершить();
	Прогресс.Отметить(СостоянияМутанта.Убит());

	// Тогда

	Ожидаем.Что(Прогресс.Подсказка(), "Счёт после завершения").Равно("убито 1, выжило 0 ");

	Полоса.ПроверитьЧтоВызывалсяМетод().Завершить();

КонецПроцедуры

&Тест
Процедура ПовторныйЗапускНачинаетСчетЗаново() Экспорт

	// Прогресс показывают дважды за прогон: на сборе карты и на мутантах.
	// Второй показ не должен продолжать счёт первого

	// Дано

	Прогресс = Прогресс();

	Прогресс.Начать(3);
	Прогресс.Отметить(СостоянияМутанта.Убит());
	Прогресс.Отметить(СостоянияМутанта.Выжил());
	Прогресс.Завершить();

	// Когда

	Прогресс.Начать(3);
	Прогресс.Отметить(СостоянияМутанта.Убит());

	// Тогда

	Ожидаем.Что(Прогресс.Подсказка(), "Счёт второго показа").Равно("убито 1, выжило 0 ");

КонецПроцедуры

&Тест
Процедура НеЗапустившаясяПолосаНеРоняетПрогон() Экспорт

	// Полосу может быть некуда рисовать: она скажет об этом на первом же обращении

	// Дано

	Полоса = Мок.Получить(Тип("ПрогрессБар"));
	Полоса.Когда().Начать(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаВыбрасываетИсключение("Рисовать негде");

	Прогресс = Прогресс(Полоса);

	// Когда

	Прогресс.Начать(2);
	Прогресс.Отметить(СостоянияМутанта.Убит());

	// Тогда

	Ожидаем.Что(Прогресс.Подсказка(), "Счёт ведётся").Равно("убито 1, выжило 0 ");

КонецПроцедуры
