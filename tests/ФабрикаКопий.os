#Использовать asserts
#Использовать fs
#Использовать tempfiles
#Использовать autumn-logos
#Использовать "../src/core"

// Фабрика знает, где у проекта лежат тесты: по этому списку строится карта тестов
// и собираются рабочие копии.

&ПослеКаждого
Процедура УдалитьВременныеФайлы() Экспорт

	ВременныеФайлы.Удалить();

КонецПроцедуры

Функция Фабрика(Знач КаталогиТестов = "tests")

	Возврат Новый ФабрикаКопий(
		0,
		КаталогиТестов,
		"oscript_modules,.git,out",
		Логирование.ПолучитьЛог("oscript.lib.mutatos.tests"));

КонецФункции

Функция ПроектСТестами()

	Проект = ВременныеФайлы.СоздатьКаталог();

	ФС.ОбеспечитьКаталог(ОбъединитьПути(Проект, "tests/вложенные"));

	ЗаписатьФайл(ОбъединитьПути(Проект, "tests", "НаборА.os"));
	ЗаписатьФайл(ОбъединитьПути(Проект, "tests", "вложенные", "НаборБ.os"));
	// не набор: у файлов наборов расширение os
	ЗаписатьФайл(ОбъединитьПути(Проект, "tests", "данные.json"));

	Возврат Проект;

КонецФункции

Процедура ЗаписатьФайл(Знач Путь)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать("// фикстура");
	Запись.Закрыть();

КонецПроцедуры

&Тест
Процедура КаталогиТестовРазворачиваютсяОтносительноПроекта() Экспорт

	// Дано

	Проект = ВременныеФайлы.СоздатьКаталог();

	// Когда

	Каталоги = Фабрика("tests,интеграционные").АбсолютныеКаталогиТестов(Проект);

	// Тогда

	Ожидаем.Что(Каталоги).ИмеетДлину(2);

	Ожидаем.Что(Каталоги[0], "Первый каталог")
		.Равно(ФС.НормализоватьПуть(ОбъединитьПути(Проект, "tests")));

	Ожидаем.Что(Каталоги[1], "Второй каталог")
		.Равно(ФС.НормализоватьПуть(ОбъединитьПути(Проект, "интеграционные")));

КонецПроцедуры

&Тест
Процедура НесуществующийКаталогТестовПропускается() Экспорт

	// Каталог тестов задаётся деталькой и может не совпадать с раскладкой проекта.
	// Это не повод падать: копии он просто не достанется

	// Дано

	Проект = ПроектСТестами();

	// Когда

	Каталоги = Фабрика("tests,такого-каталога-нет").АбсолютныеКаталогиТестов(Проект);

	// Тогда

	Ожидаем.Что(Каталоги, "Каталоги тестов").ИмеетДлину(2);

КонецПроцедуры
