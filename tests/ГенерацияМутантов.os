#Использовать asserts
#Использовать autumn
#Использовать "../src/core"

Перем Генератор;

&ПередКаждым
Процедура ПередКаждым() Экспорт

	Поделка = Новый Поделка();
	Поделка.ЗапуститьПриложение();

	Генератор = Поделка.НайтиЖелудь("ГенераторМутантов");

КонецПроцедуры

Функция МутацииПоМутатору(Исходник, ИмяМутатора)

	Результат = Новый Массив();

	Для Каждого Мутация Из Генератор.НайтиМутации(Исходник) Цикл
		Если Мутация.Мутатор() = ИмяМутатора Тогда
			Результат.Добавить(Мутация);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция МутантыПоМутатору(Исходник, ИмяМутатора)

	Результат = Новый Массив();

	Для Каждого Мутация Из МутацииПоМутатору(Исходник, ИмяМутатора) Цикл
		Результат.Добавить(Генератор.СоздатьМутанта(Исходник, Мутация));
	КонецЦикла;

	Возврат Результат;

КонецФункции

#Область Мутаторы

&Тест
Процедура АрифметикаЗаменяетСложениеНаВычитание() Экспорт

	// Когда

	Мутанты = МутантыПоМутатору("Сумма = А + Б;", "Арифметика");

	// Тогда

	Ожидаем.Что(Мутанты.Количество(), "Количество мутантов")
		.Равно(1);

	Ожидаем.Что(Мутанты[0], "Мутант")
		.Равно("Сумма = А - Б;");

КонецПроцедуры

&Тест
Процедура АрифметикаОбрабатываетВсеОперации() Экспорт

	// Когда

	Мутанты = МутантыПоМутатору("Значение = А * Б / В + Г - Д;", "Арифметика");

	// Тогда

	Ожидаем.Что(Мутанты.Количество(), "Количество мутантов")
		.Равно(4);

КонецПроцедуры

&Тест
Процедура УсловияСдвигаютГраницу() Экспорт

	// Когда

	Мутанты = МутантыПоМутатору("Если А > Б Тогда КонецЕсли;", "Условия");

	// Тогда

	Ожидаем.Что(Мутанты.Количество(), "Количество мутантов")
		.Равно(2);

	Ожидаем.Что(Мутанты, "Мутанты")
		.Содержит("Если А >= Б Тогда КонецЕсли;")
		.Содержит("Если А < Б Тогда КонецЕсли;");

КонецПроцедуры

&Тест
Процедура УсловияМеняютРавенство() Экспорт

	// Когда

	Мутанты = МутантыПоМутатору("Если А = Б Тогда КонецЕсли;", "Условия");

	// Тогда

	Ожидаем.Что(Мутанты[0], "Мутант")
		.Равно("Если А <> Б Тогда КонецЕсли;");

КонецПроцедуры

&Тест
Процедура ЛогикаМеняетИНаИли() Экспорт

	// Когда

	Мутанты = МутантыПоМутатору("Если А И Б Тогда КонецЕсли;", "Логика");

	// Тогда

	Ожидаем.Что(Мутанты[0], "Мутант")
		.Равно("Если А Или Б Тогда КонецЕсли;");

КонецПроцедуры

&Тест
Процедура БулевыЛитералыМеняютсяМестами() Экспорт

	// Когда

	Мутанты = МутантыПоМутатору("Флаг = Истина;", "БулевыЛитералы");

	// Тогда

	Ожидаем.Что(Мутанты[0], "Мутант")
		.Равно("Флаг = Ложь;");

КонецПроцедуры

&Тест
Процедура ВозвратОбнуляетЗначение() Экспорт

	// Когда

	Исходник = "
		|Функция Сложить(А, Б)
		|	Возврат А + Б;
		|КонецФункции";

	Мутанты = МутантыПоМутатору(Исходник, "Возврат");

	// Тогда

	Ожидаем.Что(Мутанты.Количество(), "Количество мутантов")
		.Равно(1);

	Ожидаем.Что(СтрНайти(Мутанты[0], "Возврат Неопределено;"), "Позиция обнулённого возврата")
		.Больше(0);

КонецПроцедуры

&Тест
Процедура ВозвратИзПроцедурыНеМутируется() Экспорт

	// Когда

	Исходник = "
		|Процедура Обработать()
		|	Возврат;
		|КонецПроцедуры";

	// Тогда

	Ожидаем.Что(МутацииПоМутатору(Исходник, "Возврат").Количество(), "Количество мутаций")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ВозвратНеопределенногоНеМутируется() Экспорт

	// Мутант был бы неотличим от оригинала

	// Когда

	Исходник = "
		|Функция Получить()
		|	Возврат Неопределено;
		|КонецФункции";

	// Тогда

	Ожидаем.Что(МутацииПоМутатору(Исходник, "Возврат").Количество(), "Количество мутаций")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура УдалениеВызоваУбираетВызовПроцедуры() Экспорт

	// Когда

	Исходник = "
		|Процедура Обработать()
		|	Сохранить();
		|КонецПроцедуры";

	Мутанты = МутантыПоМутатору(Исходник, "УдалениеВызова");

	// Тогда

	Ожидаем.Что(Мутанты.Количество(), "Количество мутантов")
		.Равно(1);

	Ожидаем.Что(СтрНайти(Мутанты[0], "Сохранить()"), "Позиция удалённого вызова")
		.Равно(0);

КонецПроцедуры

#КонецОбласти // Мутаторы

#Область СведенияОМутации

&Тест
Процедура МутацияЗнаетНомерСтроки() Экспорт

	// Когда

	Исходник = "
		|Функция Сложить(А, Б)
		|	Возврат А + Б;
		|КонецФункции";

	Мутации = МутацииПоМутатору(Исходник, "Арифметика");

	// Тогда

	Ожидаем.Что(Мутации[0].НомерСтроки(), "Номер строки")
		.Равно(3);

КонецПроцедуры

&Тест
Процедура МутацияЗнаетИмяМетода() Экспорт

	// Когда

	Исходник = "
		|Функция Сложить(А, Б)
		|	Возврат А + Б;
		|КонецФункции";

	Мутации = МутацииПоМутатору(Исходник, "Арифметика");

	// Тогда

	Ожидаем.Что(Мутации[0].ИмяМетода(), "Имя метода")
		.Равно("Сложить");

КонецПроцедуры

&Тест
Процедура МутацияИмеетПредставление() Экспорт

	// Когда

	Мутации = МутацииПоМутатору("Сумма = А + Б;", "Арифметика");

	// Тогда

	Ожидаем.Что(Мутации[0].Представление(), "Представление мутации")
		.Содержит("+ заменено на -");

КонецПроцедуры

#КонецОбласти // СведенияОМутации

#Область ОбходДерева

&Тест
Процедура МутацииИщутсяВоВложенныхВыражениях() Экспорт

	// Когда

	Исходник = "
		|Функция Вычислить(А, Б, В)
		|	Если А > Б Тогда
		|		Возврат А + В;
		|	КонецЕсли;
		|	Возврат Б - В;
		|КонецФункции";

	Мутации = Генератор.НайтиМутации(Исходник);

	// Тогда

	// два мутанта границы, два арифметических, два обнулённых возврата
	Ожидаем.Что(Мутации.Количество(), "Количество мутаций")
		.Равно(6);

КонецПроцедуры

&Тест
Процедура НеразбираемыйИсходникНеДаетМутаций() Экспорт

	// Когда

	Мутации = Генератор.НайтиМутации("специальная синтакс-ошибка");

	// Тогда

	Ожидаем.Что(Мутации.Количество(), "Количество мутаций")
		.Равно(0);

КонецПроцедуры

#КонецОбласти // ОбходДерева
