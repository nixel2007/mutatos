#Использовать asserts
#Использовать "../src/core"

// Набор сам живёт в поделке прогона, поэтому генератор не создаётся вручную,
// а внедряется: своя поделка на каждый тест стоила бы трети секунды на подъём.
// Имя переменной - имя желудя, по нему поделка его и находит
&Пластилин
Перем ГенераторМутантов;

Функция МутацииПоМутатору(Исходник, ИмяМутатора)

	Результат = Новый Массив();

	Для Каждого Мутация Из ГенераторМутантов.НайтиМутации(Исходник) Цикл
		Если Мутация.Мутатор() = ИмяМутатора Тогда
			Результат.Добавить(Мутация);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция МутантыПоМутатору(Исходник, ИмяМутатора)

	Результат = Новый Массив();

	Для Каждого Мутация Из МутацииПоМутатору(Исходник, ИмяМутатора) Цикл
		Результат.Добавить(ГенераторМутантов.СоздатьМутанта(Исходник, Мутация));
	КонецЦикла;

	Возврат Результат;

КонецФункции

#Область Мутаторы

&Тест
Процедура АрифметикаЗаменяетСложениеНаВычитание() Экспорт

	// Когда

	Мутанты = МутантыПоМутатору("Сумма = А + Б;", "Арифметика");

	// Тогда

	Ожидаем.Что(Мутанты.Количество(), "Количество мутантов")
		.Равно(1);

	Ожидаем.Что(Мутанты[0], "Мутант")
		.Равно("Сумма = А - Б;");

КонецПроцедуры

&Тест
Процедура АрифметикаОбрабатываетВсеОперации() Экспорт

	// Когда

	Мутанты = МутантыПоМутатору("Значение = А * Б / В + Г - Д;", "Арифметика");

	// Тогда

	Ожидаем.Что(Мутанты.Количество(), "Количество мутантов")
		.Равно(4);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("+", "-")
&ИсточникЗначение("-", "+")
&ИсточникЗначение("*", "/")
&ИсточникЗначение("/", "*")
&ИсточникЗначение("%", "*")
Процедура УКаждойОперацииСвояЗамена(Операция, Замена) Экспорт

	// Таблица замен - и есть весь мутатор. Проверять её выборочно значит не знать,
	// во что превращается половина операций

	// Когда

	Мутанты = МутантыПоМутатору(СтрШаблон("Значение = А %1 Б;", Операция), "Арифметика");

	// Тогда

	Ожидаем.Что(Мутанты, "Мутанты операции " + Операция)
		.ИмеетДлину(1)
		.Содержит(СтрШаблон("Значение = А %1 Б;", Замена));

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(">", ">=", "<")
&ИсточникЗначение("<", "<=", ">")
&ИсточникЗначение(">=", ">", "")
&ИсточникЗначение("<=", "<", "")
&ИсточникЗначение("=", "<>", "")
&ИсточникЗначение("<>", "=", "")
Процедура УКаждогоСравненияСвоиЗамены(Операция, Первая, Вторая) Экспорт

	// Сдвиг границы и переворот - разные ошибки, и мутатор обязан пробовать обе
	// там, где обе имеют смысл

	// Когда

	Мутанты = МутантыПоМутатору(СтрШаблон("Если А %1 Б Тогда КонецЕсли;", Операция), "Условия");

	// Тогда

	Ожидаемых = ?(ПустаяСтрока(Вторая), 1, 2);

	Ожидаем.Что(Мутанты, "Мутанты сравнения " + Операция).ИмеетДлину(Ожидаемых);

	Ожидаем.Что(Мутанты, "Первая замена " + Операция)
		.Содержит(СтрШаблон("Если А %1 Б Тогда КонецЕсли;", Первая));

	Если Не ПустаяСтрока(Вторая) Тогда
		Ожидаем.Что(Мутанты, "Вторая замена " + Операция)
			.Содержит(СтрШаблон("Если А %1 Б Тогда КонецЕсли;", Вторая));
	КонецЕсли;

КонецПроцедуры

&Тест
Процедура УсловияСдвигаютГраницу() Экспорт

	// Когда

	Мутанты = МутантыПоМутатору("Если А > Б Тогда КонецЕсли;", "Условия");

	// Тогда

	Ожидаем.Что(Мутанты.Количество(), "Количество мутантов")
		.Равно(2);

	Ожидаем.Что(Мутанты, "Мутанты")
		.Содержит("Если А >= Б Тогда КонецЕсли;")
		.Содержит("Если А < Б Тогда КонецЕсли;");

КонецПроцедуры

&Тест
Процедура УсловияМеняютРавенство() Экспорт

	// Когда

	Мутанты = МутантыПоМутатору("Если А = Б Тогда КонецЕсли;", "Условия");

	// Тогда

	Ожидаем.Что(Мутанты[0], "Мутант")
		.Равно("Если А <> Б Тогда КонецЕсли;");

КонецПроцедуры

