#КонецОбласти // СведенияОМутации

#Область ОбходДерева

&Тест
Процедура МутацииИщутсяВоВложенныхВыражениях() Экспорт

	// Когда

	Исходник = "
		|Функция Вычислить(А, Б, В)
		|	Если А > Б Тогда
		|		Возврат А + В;
		|	КонецЕсли;
		|	Возврат Б - В;
		|КонецФункции";

	Мутации = ГенераторМутантов.НайтиМутации(Исходник);

	// Тогда

	// два мутанта границы, два арифметических, два обнулённых возврата, одно отрицание условия
	Ожидаем.Что(Мутации.Количество(), "Количество мутаций")
		.Равно(7);

КонецПроцедуры

&Тест
Процедура НеразбираемыйИсходникНеДаетМутаций() Экспорт

	// Когда

	Мутации = ГенераторМутантов.НайтиМутации("специальная синтакс-ошибка");

	// Тогда

	Ожидаем.Что(Мутации.Количество(), "Количество мутаций")
		.Равно(0);

КонецПроцедуры

#КонецОбласти // ОбходДерева
