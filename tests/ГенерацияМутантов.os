	Мутанты = МутантыПоМутатору("Флаг = Истина;", "БулевыЛитералы");

	// Тогда

	Ожидаем.Что(Мутанты[0], "Мутант")
		.Равно("Флаг = Ложь;");

КонецПроцедуры

&Тест
Процедура ВозвратОбнуляетЗначение() Экспорт

	// Когда

	Исходник = "
		|Функция Сложить(А, Б)
		|	Возврат А + Б;
		|КонецФункции";

	Мутанты = МутантыПоМутатору(Исходник, "Возврат");

	// Тогда

	Ожидаем.Что(Мутанты.Количество(), "Количество мутантов")
		.Равно(1);

	Ожидаем.Что(СтрНайти(Мутанты[0], "Возврат Неопределено;"), "Позиция обнулённого возврата")
		.Больше(0);

КонецПроцедуры

&Тест
Процедура ВозвратИзПроцедурыНеМутируется() Экспорт

	// Когда

	Исходник = "
		|Процедура Обработать()
		|	Возврат;
		|КонецПроцедуры";

	// Тогда

	Ожидаем.Что(МутацииПоМутатору(Исходник, "Возврат").Количество(), "Количество мутаций")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ВозвратНеопределенногоНеМутируется() Экспорт

	// Мутант был бы неотличим от оригинала

	// Когда

	Исходник = "
		|Функция Получить()
		|	Возврат Неопределено;
		|КонецФункции";

	// Тогда

	Ожидаем.Что(МутацииПоМутатору(Исходник, "Возврат").Количество(), "Количество мутаций")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура УдалениеВызоваУбираетВызовПроцедуры() Экспорт

	// Когда

	Исходник = "
		|Процедура Обработать()
		|	Сохранить();
		|КонецПроцедуры";

	Мутанты = МутантыПоМутатору(Исходник, "УдалениеВызова");

	// Тогда

	Ожидаем.Что(Мутанты.Количество(), "Количество мутантов")
		.Равно(1);

	Ожидаем.Что(СтрНайти(Мутанты[0], "Сохранить()"), "Позиция удалённого вызова")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура ЧисловойЛитералОбнуляетсяИУвеличивается() Экспорт

	// Когда

	Мутанты = МутантыПоМутатору("Порция = 100;", "ЧисловыеЛитералы");

	// Тогда

	Ожидаем.Что(Мутанты.Количество(), "Количество мутантов")
		.Равно(2);

	Ожидаем.Что(Мутанты[0], "Обнулённый литерал")
		.Равно("Порция = 0;");

	Ожидаем.Что(Мутанты[1], "Увеличенный литерал")
		.Равно("Порция = 101;");

КонецПроцедуры

&Тест
Процедура НольМеняетсяТолькоНаЕдиницу() Экспорт

	// обнулять ноль незачем: мутант был бы неотличим от оригинала

	// Когда

	Мутанты = МутантыПоМутатору("Счетчик = 0;", "ЧисловыеЛитералы");

	// Тогда

	Ожидаем.Что(Мутанты.Количество(), "Количество мутантов")
		.Равно(1);

	Ожидаем.Что(Мутанты[0], "Мутант")
		.Равно("Счетчик = 1;");

КонецПроцедуры

