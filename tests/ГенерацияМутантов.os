КонецПроцедуры

&Тест
Процедура УсловиеИнвертируется() Экспорт

	// Когда

	Исходник = "
		|Процедура Обработать(Флаг)
		|	Если Флаг Тогда
		|		Сохранить();
		|	КонецЕсли;
		|КонецПроцедуры";

	Мутанты = МутантыПоМутатору(Исходник, "ОтрицаниеУсловия");

	// Тогда

	Ожидаем.Что(Мутанты.Количество(), "Количество мутантов")
		.Равно(1);

	Ожидаем.Что(СтрНайти(Мутанты[0], "Если Не (Флаг) Тогда"), "Инвертированное условие")
		.Больше(0);

КонецПроцедуры

&Тест
Процедура УсловиеЦиклаПокаТожеИнвертируется() Экспорт

	// Когда

	Исходник = "
		|Процедура Обработать(Осталось)
		|	Пока Осталось > 0 Цикл
		|		Осталось = Осталось - 1;
		|	КонецЦикла;
		|КонецПроцедуры";

	Мутанты = МутантыПоМутатору(Исходник, "ОтрицаниеУсловия");

	// Тогда

	Ожидаем.Что(СтрНайти(Мутанты[0], "Пока Не (Осталось > 0) Цикл"), "Инвертированное условие цикла")
		.Больше(0);

КонецПроцедуры

&Тест
Процедура ГраницаСчетногоЦиклаУменьшается() Экспорт

	// Когда

	Исходник = "
		|Процедура Обработать(Всего)
		|	Для Сч = 1 По Всего Цикл
		|		Сохранить(Сч);
		|	КонецЦикла;
		|КонецПроцедуры";

	Мутанты = МутантыПоМутатору(Исходник, "ГраницыЦикла");

	// Тогда

	Ожидаем.Что(Мутанты.Количество(), "Количество мутантов")
		.Равно(1);

	Ожидаем.Что(СтрНайти(Мутанты[0], "Для Сч = 1 По (Всего) - 1 Цикл"), "Уменьшенная граница")
		.Больше(0);

КонецПроцедуры

&Тест
Процедура ОтключенныйМутаторНеПрименяется() Экспорт

	// Когда

	Отключенные = Новый Массив();
	Отключенные.Добавить("ЧисловыеЛитералы");

	Мутации = ГенераторМутантов.НайтиМутации("Порция = 100;", Отключенные);

	// Тогда

	Ожидаем.Что(Мутации.Количество(), "Количество мутаций")
		.Равно(0);

КонецПроцедуры

#КонецОбласти // Мутаторы

