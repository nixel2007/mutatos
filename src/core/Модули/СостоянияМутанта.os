// Возможные исходы прогона тестов на мутанте.
//
// Терминология мутационного тестирования: мутант "убит", если тесты его заметили,
// и "выжил", если прогон остался зелёным - значит поведение, которое сломала мутация,
// тестами не проверяется.

// Тесты упали - мутация замечена.
Функция Убит() Экспорт
	Возврат "Убит";
КонецФункции

// Тесты остались зелёными - мутация не замечена.
Функция Выжил() Экспорт
	Возврат "Выжил";
КонецФункции

// Мутация в коде, который тесты не выполняют. Прогон не запускался.
Функция БезПокрытия() Экспорт
	Возврат "БезПокрытия";
КонецФункции

// Прогон не уложился в отведённое время - обычно мутация зациклила выполнение.
// Считается убийством: тесты заметили изменение поведения.
Функция Таймаут() Экспорт
	Возврат "Таймаут";
КонецФункции

// Мутант не компилируется или прогон завершился нештатно.
Функция Ошибка() Экспорт
	Возврат "Ошибка";
КонецФункции

// Истина, если исход означает, что тесты заметили мутацию.
Функция ЭтоУбийство(Знач Состояние) Экспорт
	Возврат Состояние = Убит() Или Состояние = Таймаут();
КонецФункции
