#Использовать json
#Использовать fs
#Использовать "../internal"

// Записывает итог прогона в JSON по схеме mutation-testing-elements.
//
// Схему придумали в Stryker, но её понимают все заметные инструменты мутационного
// тестирования - и её же читает готовый веб-просмотрщик отчётов. Свой формат
// пришлось бы учить каждый раз заново, этот открывается чем угодно.
//
// Схема: https://github.com/stryker-mutator/mutation-testing-elements

Перем _Состояния;

Функция Имя() Экспорт
	Возврат "json";
КонецФункции

Процедура Сформировать(Знач Отчет, Знач Назначение = "") Экспорт

	Если ПустаяСтрока(Назначение) Тогда
		ВызватьИсключение "Для отчёта в формате json нужно указать путь к файлу";
	КонецЕсли;

	ФС.ОбеспечитьКаталог(Новый Файл(Назначение).Путь);

	Запись = Новый ЗаписьJSON();
	Запись.ОткрытьФайл(Назначение, "UTF-8", , Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб));

	ЗаписатьJSON(Запись, ДанныеОтчета(Отчет));

	Запись.Закрыть();

КонецПроцедуры

Функция ДанныеОтчета(Отчет)

	Результат = Новый Структура();
	Результат.Вставить("schemaVersion", "1.0");
	Результат.Вставить("thresholds", Пороги());
	Результат.Вставить("files", Файлы(Отчет));

	Возврат Результат;

КонецФункции

// Границы, по которым просмотрщик красит индекс мутаций.
Функция Пороги()

	Пороги = Новый Структура();
	Пороги.Вставить("high", 80);
	Пороги.Вставить("low", 50);

	Возврат Пороги;

КонецФункции

Функция Файлы(Отчет)

	ОбщийКаталог = ИсходникиОтчета.ОбщийКаталог(ПутиФайлов(Отчет));

	Файлы = Новый Соответствие();
	НачалаСтрок = Новый Соответствие();
	Номер = 0;

	Для Каждого Мутант Из Отчет.Результаты() Цикл

		Номер = Номер + 1;
		Ключ = ИсходникиОтчета.ОтносительныйПуть(Мутант.Файл(), ОбщийКаталог);
		ДанныеФайла = Файлы.Получить(Ключ);

		Если ДанныеФайла = Неопределено Тогда
			ИсходныйТекст = ИсходникиОтчета.ПрочитатьИсходник(Мутант.Файл());
			ДанныеФайла = НовыйФайл(ИсходныйТекст);
			Файлы.Вставить(Ключ, ДанныеФайла);
			НачалаСтрок.Вставить(Ключ, ИсходникиОтчета.НачалаСтрок(ДанныеФайла["source"]));
		КонецЕсли;

		ДанныеФайла["mutants"].Добавить(ДанныеМутанта(Мутант, Номер, НачалаСтрок.Получить(Ключ)));

	КонецЦикла;

	Возврат Файлы;

КонецФункции

Функция ПутиФайлов(Отчет)

	Пути = Новый Массив();

	Для Каждого Мутант Из Отчет.Результаты() Цикл
		Пути.Добавить(Мутант.Файл());
	КонецЦикла;

	Возврат Пути;

КонецФункции

Функция НовыйФайл(Знач ИсходныйТекст)

	ДанныеФайла = Новый Соответствие();
	ДанныеФайла.Вставить("language", "bsl");
	ДанныеФайла.Вставить("source", ?(ИсходныйТекст = Неопределено, "", ИсходныйТекст));
	ДанныеФайла.Вставить("mutants", Новый Массив());

	Возврат ДанныеФайла;

КонецФункции

Функция ДанныеМутанта(Мутант, Знач Номер, НачалаСтрок)

	Мутация = Мутант.Мутация();

	Данные = Новый Структура();
	Данные.Вставить("id", Формат(Номер, "ЧГ=0"));
	Данные.Вставить("mutatorName", Мутация.Мутатор());
	Данные.Вставить("replacement", Мутация.Текст());
	Данные.Вставить("description", Мутация.Описание());
	Данные.Вставить("status", Состояние(Мутант.Состояние()));
	Данные.Вставить("location", Расположение(Мутация, НачалаСтрок));
	Данные.Вставить("duration", Мутант.Длительность());

	Возврат Данные;

КонецФункции

// Расположение мутации в исходнике: схеме нужны строка и колонка начала и конца.
//
// Если исходник прочитать не удалось, остаётся только номер строки от парсера -
// колонка тогда первая, а конец совпадает с началом.
Функция Расположение(Мутация, НачалаСтрок)

	Если НачалаСтрок.Количество() = 0 Тогда
		Возврат Новый Структура("start, end",
			Точка(Мутация.НомерСтроки(), 1),
			Точка(Мутация.НомерСтроки(), 1));
	КонецЕсли;

	Начало = ИсходникиОтчета.Координаты(НачалаСтрок, Мутация.Позиция());
	Конец  = ИсходникиОтчета.Координаты(НачалаСтрок, Мутация.Позиция() + Мутация.Длина());

	Возврат Новый Структура("start, end",
		Точка(Начало.Строка, Начало.Колонка),
		Точка(Конец.Строка, Конец.Колонка));

КонецФункции

Функция Точка(Знач НомерСтроки, Знач Колонка)

	Возврат Новый Структура("line, column", НомерСтроки, Колонка);

КонецФункции

Функция Состояние(Знач Состояние)

	Возврат _Состояния.Получить(Состояние);

КонецФункции

&Репортер
Процедура ПриСозданииОбъекта()

	_Состояния = Новый Соответствие();
	_Состояния.Вставить(СостоянияМутанта.Убит(),        "Killed");
	_Состояния.Вставить(СостоянияМутанта.Выжил(),       "Survived");
	_Состояния.Вставить(СостоянияМутанта.БезПокрытия(), "NoCoverage");
	_Состояния.Вставить(СостоянияМутанта.Таймаут(),     "Timeout");
	_Состояния.Вставить(СостоянияМутанта.Ошибка(),      "RuntimeError");

КонецПроцедуры
