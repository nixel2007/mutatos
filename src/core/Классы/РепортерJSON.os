#Использовать json
#Использовать fs
#Использовать "../internal"

// Записывает итог прогона в JSON - для CI, дашбордов и сравнения прогонов между собой.

Функция Имя() Экспорт
	Возврат "json";
КонецФункции

Процедура Сформировать(Знач Отчет, Знач Назначение = "") Экспорт

	Если ПустаяСтрока(Назначение) Тогда
		ВызватьИсключение "Для отчёта в формате json нужно указать путь к файлу";
	КонецЕсли;

	ФС.ОбеспечитьКаталог(Новый Файл(Назначение).Путь);

	Запись = Новый ЗаписьJSON();
	Запись.ОткрытьФайл(Назначение, "UTF-8", , Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб));

	ЗаписатьJSON(Запись, ДанныеОтчета(Отчет));

	Запись.Закрыть();

КонецПроцедуры

Функция ДанныеОтчета(Отчет)

	Статистика = Новый Структура();
	Статистика.Вставить("всего", Отчет.ВсегоМутантов());
	Статистика.Вставить("убито", Отчет.Убито());
	Статистика.Вставить("выжило", Отчет.Выжило());
	Статистика.Вставить("без_покрытия", Отчет.БезПокрытия());
	Статистика.Вставить("ошибок", Отчет.Ошибок());
	Статистика.Вставить("индекс_мутаций", Отчет.ИндексМутаций());

	Мутанты = Новый Массив();
	Для Каждого Мутант Из Отчет.Результаты() Цикл
		Мутанты.Добавить(ДанныеМутанта(Мутант));
	КонецЦикла;

	Результат = Новый Структура();
	Результат.Вставить("статистика", Статистика);
	Результат.Вставить("мутанты", Мутанты);

	Возврат Результат;

КонецФункции

Функция ДанныеМутанта(Мутант)

	Мутация = Мутант.Мутация();

	Данные = Новый Структура();
	Данные.Вставить("файл", Мутант.Файл());
	Данные.Вставить("состояние", Мутант.Состояние());
	Данные.Вставить("длительность_мс", Мутант.Длительность());
	Данные.Вставить("мутатор", Мутация.Мутатор());
	Данные.Вставить("описание", Мутация.Описание());
	Данные.Вставить("строка", Мутация.НомерСтроки());
	Данные.Вставить("метод", Мутация.ИмяМетода());

	Возврат Данные;

КонецФункции

&Репортер
Процедура ПриСозданииОбъекта()
КонецПроцедуры
