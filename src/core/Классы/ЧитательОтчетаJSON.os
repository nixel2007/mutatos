#Использовать json
#Использовать "../internal"

// Восстанавливает отчёт прогона из JSON по схеме mutation-testing-elements.
//
// Мутационный прогон на большом проекте идёт десятки минут, а вид отчёта меняется
// куда чаще. Перерисовать HTML из готового JSON - минута вместо часа, и заодно это
// проверка, что в JSON лежит всё нужное, а не только то, что удобно записать.
//
// Исходники берутся из самого отчёта: схема хранит текст каждого файла целиком,
// поэтому перерисовать можно и на машине, где проекта нет вовсе.

Перем _Состояния;

// Читает отчёт из файла.
//
// Возвращаемое значение:
//   ОтчетПрогона
Функция Прочитать(Знач Путь) Экспорт

	Если Не Новый Файл(Путь).Существует() Тогда
		ВызватьИсключение СтрШаблон("Файл отчёта не найден: %1", Путь);
	КонецЕсли;

	Чтение = Новый ЧтениеJSON();
	Чтение.ОткрытьФайл(Путь);
	// ключи - пути к файлам, свойствами структуры они быть не могут
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Файлы = Данные.Получить("files");

	Если Файлы = Неопределено Тогда
		ВызватьИсключение СтрШаблон("В файле %1 нет раздела files - это не отчёт мутационного прогона", Путь);
	КонецЕсли;

	Отчет = Новый ОтчетПрогона();

	Для Каждого Элемент Из Файлы Цикл
		ПрочитатьФайл(Отчет, Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Возврат Отчет;

КонецФункции

Процедура ПрочитатьФайл(Отчет, Знач Путь, ДанныеФайла)

	Исходник = ДанныеФайла.Получить("source");
	Исходник = ?(Исходник = Неопределено, "", Исходник);

	Отчет.УстановитьИсходник(Путь, Исходник);

	НачалаСтрок = ИсходникиОтчета.НачалаСтрок(Исходник);

	Для Каждого ДанныеМутанта Из ДанныеФайла.Получить("mutants") Цикл
		Отчет.Добавить(Мутант(Путь, ДанныеМутанта, НачалаСтрок));
	КонецЦикла;

КонецПроцедуры

Функция Мутант(Знач Путь, ДанныеМутанта, НачалаСтрок)

	Начало = ДанныеМутанта.Получить("location").Получить("start");
	Конец  = ДанныеМутанта.Получить("location").Получить("end");

	ПозицияНачала = Позиция(НачалаСтрок, Начало);

	Мутация = Новый ОписаниеМутации(
		ДанныеМутанта.Получить("mutatorName"),
		ДанныеМутанта.Получить("description"),
		ПозицияНачала,
		Макс(Позиция(НачалаСтрок, Конец) - ПозицияНачала, 0),
		ДанныеМутанта.Получить("replacement"),
		Начало.Получить("line"));

	ИмяМетода = ДанныеМутанта.Получить("methodName");
	Если ИмяМетода <> Неопределено Тогда
		Мутация.УстановитьИмяМетода(ИмяМетода);
	КонецЕсли;

	Длительность = ДанныеМутанта.Получить("duration");

	Возврат Новый РезультатМутанта(
		Мутация,
		Путь,
		Состояние(ДанныеМутанта.Получить("status")),
		?(Длительность = Неопределено, 0, Длительность));

КонецФункции

// Схема адресует мутацию строкой и колонкой, а мутатору нужно смещение в тексте.
// Без исходника пересчитать нечем - тогда остаётся начало строки.
Функция Позиция(НачалаСтрок, Точка)

	НомерСтроки = Точка.Получить("line");

	Если НачалаСтрок.Количество() = 0 Или НомерСтроки > НачалаСтрок.Количество() Тогда
		Возврат 1;
	КонецЕсли;

	Возврат НачалаСтрок[НомерСтроки - 1] + Точка.Получить("column") - 1;

КонецФункции

Функция Состояние(Знач Имя)

	Состояние = _Состояния.Получить(Имя);

	Возврат ?(Состояние = Неопределено, СостоянияМутанта.Ошибка(), Состояние);

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт

	_Состояния = Новый Соответствие();
	_Состояния.Вставить("Killed",       СостоянияМутанта.Убит());
	_Состояния.Вставить("Survived",     СостоянияМутанта.Выжил());
	_Состояния.Вставить("NoCoverage",   СостоянияМутанта.БезПокрытия());
	_Состояния.Вставить("Timeout",      СостоянияМутанта.Таймаут());
	_Состояния.Вставить("RuntimeError", СостоянияМутанта.Ошибка());
	_Состояния.Вставить("CompileError", СостоянияМутанта.Ошибка());

КонецПроцедуры
