#Использовать "../internal"

// Собирает исходный код мутанта: применяет к оригиналу ровно одну мутацию.
//
// За раз применяется одна мутация - так падение теста однозначно указывает
// на конкретное изменение. Мутации не накапливаются между вызовами.

Перем _Искатель;

// Возвращает массив ОписаниеМутации для исходника.
// Мутаторы из ОтключенныеМутаторы не применяются.
Функция НайтиМутации(Знач Исходник, Знач ОтключенныеМутаторы = Неопределено) Экспорт
	Возврат _Искатель.НайтиМутации(Исходник, ОтключенныеМутаторы);
КонецФункции

// Возвращает исходный код мутанта - оригинал с применённой мутацией.
Функция СоздатьМутанта(Знач Исходник, Знач Мутация) Экспорт

	Возврат Лев(Исходник, Мутация.Позиция() - 1)
		+ Мутация.Текст()
		+ Сред(Исходник, Мутация.Позиция() + Мутация.Длина());

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин ИскательМутаций) Экспорт

	_Искатель = ИскательМутаций;

КонецПроцедуры
