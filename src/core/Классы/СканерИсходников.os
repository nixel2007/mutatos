#Использовать fs

// Находит в проекте файлы, которые имеет смысл мутировать.
//
// Из поиска исключаются каталоги зависимостей и тестов: мутировать чужой код бессмысленно,
// а мутация в тестах ломает сам инструмент измерения.

Перем _ИсключаемыеКаталоги;

// Возвращает массив полных путей к файлам исходников.
//
// Параметры:
//   Каталоги - Массив - каталоги, в которых искать
//   Файлы - Массив - дополнительные файлы, которые нужно взять как есть
Функция НайтиИсходники(Знач Каталоги, Знач Файлы = Неопределено) Экспорт

	Результат = Новый Массив();

	Для Каждого Каталог Из Каталоги Цикл
		ДобавитьИзКаталога(Каталог, Результат);
	КонецЦикла;

	Если Файлы <> Неопределено Тогда
		Для Каждого ПутьКФайлу Из Файлы Цикл
			Файл = Новый Файл(ПутьКФайлу);
			Если Файл.Существует() И Файл.ЭтоФайл() Тогда
				Результат.Добавить(Файл.ПолноеИмя);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Каталоги, которые не просматриваются при поиске исходников.
Процедура УстановитьИсключения(Знач Исключения) Экспорт

	_ИсключаемыеКаталоги = Исключения;

КонецПроцедуры

Процедура ДобавитьИзКаталога(Каталог, Результат)

	Если Не Новый Файл(Каталог).Существует() Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Файл Из НайтиФайлы(Каталог, "*.os", Истина) Цикл

		Если Не Файл.ЭтоФайл() Или ЭтоИсключенныйПуть(Файл.ПолноеИмя) Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Файл.ПолноеИмя);

	КонецЦикла;

КонецПроцедуры

Функция ЭтоИсключенныйПуть(Знач Путь)

	НормализованныйПуть = СтрЗаменить(Путь, "\", "/");

	Для Каждого ИсключаемыйКаталог Из _ИсключаемыеКаталоги Цикл
		Если СтрНайти(НормализованныйПуть, "/" + ИсключаемыйКаталог + "/") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Деталька("mutatos.ИсключаемыеКаталоги", ЗначениеПоУмолчанию = "oscript_modules,tests,out") Исключения) Экспорт

	_ИсключаемыеКаталоги = СтрРазделить(Исключения, ",", Ложь);

КонецПроцедуры
