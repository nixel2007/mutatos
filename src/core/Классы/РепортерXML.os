#Использовать fs
#Использовать "../internal"

// Записывает итог прогона в XML в разметке pitest (mutations.xml).
//
// Разметка чужая намеренно: её уже читают инструменты вокруг мутационного тестирования,
// в том числе плагин Mutation Analysis для SonarQube. Свой формат пришлось бы
// поддерживать в каждом из них отдельно.
//
// У pitest есть поля, которых в OneScript просто нет: сигнатура метода в терминах JVM,
// индексы байткода, имя убившего теста. Они остаются пустыми - подделывать их значило бы
// врать инструменту, который их читает.

Перем _Состояния;

Функция Имя() Экспорт
	Возврат "xml";
КонецФункции

Процедура Сформировать(Знач Отчет, Знач Назначение = "") Экспорт

	Если ПустаяСтрока(Назначение) Тогда
		ВызватьИсключение "Для отчёта в формате xml нужно указать путь к файлу";
	КонецЕсли;

	ФС.ОбеспечитьКаталог(Новый Файл(Назначение).Путь);

	Запись = Новый ЗаписьТекста(Назначение, КодировкаТекста.UTF8БезBOM);
	Запись.Записать(Документ(Отчет));
	Запись.Закрыть();

КонецПроцедуры

Функция Документ(Отчет)

	ОбщийКаталог = ИсходникиОтчета.ОбщийКаталог(ПутиФайлов(Отчет));

	Строки = Новый Массив();
	Строки.Добавить("<?xml version=""1.0"" encoding=""UTF-8""?>");
	Строки.Добавить("<mutations partial=""false"">");

	Для Каждого Мутант Из Отчет.Результаты() Цикл
		Строки.Добавить(Мутация(Мутант, ОбщийКаталог));
	КонецЦикла;

	Строки.Добавить("</mutations>");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ПутиФайлов(Отчет)

	Пути = Новый Массив();

	Для Каждого Мутант Из Отчет.Результаты() Цикл
		Пути.Добавить(Мутант.Файл());
	КонецЦикла;

	Возврат Пути;

КонецФункции

Функция Мутация(Мутант, Знач ОбщийКаталог)

	Мутация = Мутант.Мутация();
	Состояние = Состояние(Мутант.Состояние());

	Строки = Новый Массив();
	Строки.Добавить(СтрШаблон("  <mutation detected=""%1"" status=""%2"">",
		?(СостоянияМутанта.ЭтоУбийство(Мутант.Состояние()), "true", "false"),
		Состояние));

	Строки.Добавить(Элемент("sourceFile", Новый Файл(Мутант.Файл()).Имя));
	Строки.Добавить(Элемент("mutatedClass", ИсходникиОтчета.ОтносительныйПуть(Мутант.Файл(), ОбщийКаталог)));
	Строки.Добавить(Элемент("mutatedMethod", Мутация.ИмяМетода()));
	Строки.Добавить(Элемент("methodDescription", ""));
	Строки.Добавить(Элемент("lineNumber", Формат(Мутация.НомерСтроки(), "ЧГ=0")));
	Строки.Добавить(Элемент("mutator", Мутация.Мутатор()));
	Строки.Добавить(СтрШаблон("    <indexes><index>%1</index></indexes>", Формат(Мутация.Позиция(), "ЧГ=0")));
	Строки.Добавить("    <blocks><block>0</block></blocks>");
	Строки.Добавить(Элемент("killingTest", ""));
	Строки.Добавить(Элемент("description", Мутация.Описание()));
	Строки.Добавить("  </mutation>");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция Элемент(Знач Имя, Знач Значение)

	Возврат СтрШаблон("    <%1>%2</%1>", Имя, Экранировать(Значение));

КонецФункции

Функция Состояние(Знач Состояние)

	Возврат _Состояния.Получить(Состояние);

КонецФункции

Функция Экранировать(Знач Текст)

	Результат = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");

	Возврат Результат;

КонецФункции

&Репортер
Процедура ПриСозданииОбъекта()

	_Состояния = Новый Соответствие();
	_Состояния.Вставить(СостоянияМутанта.Убит(),        "KILLED");
	_Состояния.Вставить(СостоянияМутанта.Выжил(),       "SURVIVED");
	_Состояния.Вставить(СостоянияМутанта.БезПокрытия(), "NO_COVERAGE");
	_Состояния.Вставить(СостоянияМутанта.Таймаут(),     "TIMED_OUT");
	_Состояния.Вставить(СостоянияМутанта.Ошибка(),      "RUN_ERROR");

КонецПроцедуры
