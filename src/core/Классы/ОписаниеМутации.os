// Описание одной мутации: какой фрагмент исходника и на что заменяется.
//
// Мутация не хранит изменённый исходник - только координаты замены,
// поэтому один разбор файла даёт сразу все мутации, а мутант собирается по требованию.

Перем _Мутатор;
Перем _Описание;
Перем _Позиция;
Перем _Длина;
Перем _Текст;
Перем _НомерСтроки;
Перем _ИмяМетода;

// Имя мутатора, породившего мутацию.
Функция Мутатор() Экспорт
	Возврат _Мутатор;
КонецФункции

// Человекочитаемое описание мутации, например "> заменено на >=".
Функция Описание() Экспорт
	Возврат _Описание;
КонецФункции

// Позиция начала заменяемого фрагмента в исходнике, нумерация с единицы.
Функция Позиция() Экспорт
	Возврат _Позиция;
КонецФункции

// Длина заменяемого фрагмента в символах.
Функция Длина() Экспорт
	Возврат _Длина;
КонецФункции

// Текст, на который заменяется фрагмент. Пустая строка означает удаление.
Функция Текст() Экспорт
	Возврат _Текст;
КонецФункции

// Номер строки исходника, в которой находится мутация.
Функция НомерСтроки() Экспорт
	Возврат _НомерСтроки;
КонецФункции

// Имя метода, внутри которого находится мутация. Пустое для кода вне методов.
Функция ИмяМетода() Экспорт
	Возврат _ИмяМетода;
КонецФункции

Процедура УстановитьИмяМетода(Знач ИмяМетода) Экспорт
	_ИмяМетода = ИмяМетода;
КонецПроцедуры

Функция Представление() Экспорт
	Возврат СтрШаблон("строка %1: %2 [%3]", _НомерСтроки, _Описание, _Мутатор);
КонецФункции

Процедура ПриСозданииОбъекта(Знач Мутатор, Знач Описание, Знач Позиция, Знач Длина, Знач Текст, Знач НомерСтроки)

	_Мутатор     = Мутатор;
	_Описание    = Описание;
	_Позиция     = Позиция;
	_Длина       = Длина;
	_Текст       = Текст;
	_НомерСтроки = НомерСтроки;
	_ИмяМетода   = "";

КонецПроцедуры
