#Использовать tempfiles
#Использовать autumn-logos
#Использовать "../internal"

// Собирает данные о том, какие строки исходников выполняются во время тестов.
//
// Прогон с покрытием делается один раз перед проверкой мутантов. Он же служит
// исходным прогоном: тесты должны быть зелёными, а его длительность задаёт таймаут мутантам.

Перем _Запускатель;
Перем _Лог;

// Прогоняет тесты, собирая покрытие.
//
// Возвращаемое значение:
//   Структура - Прогон (РезультатПрогона) и Покрытие (КартаПокрытия)
Функция СобратьПокрытие(Знач РабочийКаталог) Экспорт

	ПутьКОтчету = ВременныеФайлы.НовоеИмяФайла("xml");

	Прогон = _Запускатель.Прогнать(РабочийКаталог, 0, ПутьКОтчету);

	Результат = Новый Структура("Прогон, Покрытие", Прогон, Новый КартаПокрытия());

	Если Не Прогон.Успешно() Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Покрытие = ПрочитатьОтчет(ПутьКОтчету);

	_Лог.Информация("Покрытых строк: %1", Результат.Покрытие.КоличествоПокрытыхСтрок());

	Возврат Результат;

КонецФункции

// Разбирает отчёт GenericCoverage в карту покрытия.
Функция ПрочитатьОтчет(Знач ПутьКОтчету) Экспорт

	Покрытие = Новый КартаПокрытия();

	Если Не Новый Файл(ПутьКОтчету).Существует() Тогда
		_Лог.Предупреждение("Отчёт о покрытии не сформирован: %1", ПутьКОтчету);
		Возврат Покрытие;
	КонецЕсли;

	Чтение = Новый ЧтениеXML();
	Чтение.ОткрытьФайл(ПутьКОтчету);

	ТекущийФайл = "";

	Пока Чтение.Прочитать() Цикл

		Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;

		Если Чтение.Имя = "file" Тогда
			ТекущийФайл = ЗначениеАтрибута(Чтение, "path");
		ИначеЕсли Чтение.Имя = "lineToCover" Тогда
			ОтметитьСтроку(Покрытие, ТекущийФайл, Чтение);
		КонецЕсли;

	КонецЦикла;

	Чтение.Закрыть();

	Возврат Покрытие;

КонецФункции

Процедура ОтметитьСтроку(Покрытие, ТекущийФайл, Чтение)

	Если ПустаяСтрока(ТекущийФайл) Тогда
		Возврат;
	КонецЕсли;

	// строка попадает в карту, только если она действительно выполнялась
	Если НРег(ЗначениеАтрибута(Чтение, "covered")) <> "true" Тогда
		// файл всё равно считается известным: по нему есть данные
		Покрытие.ОтметитьФайл(ТекущийФайл);
		Возврат;
	КонецЕсли;

	НомерСтроки = ЗначениеАтрибута(Чтение, "lineNumber");
	Если ПустаяСтрока(НомерСтроки) Тогда
		Возврат;
	КонецЕсли;

	Покрытие.Отметить(ТекущийФайл, Число(НомерСтроки));

КонецПроцедуры

Функция ЗначениеАтрибута(Чтение, Знач ИмяАтрибута)

	Значение = Чтение.ЗначениеАтрибута(ИмяАтрибута);

	Возврат ?(Значение = Неопределено, "", Значение);

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин("ЗапускательТестовOneUnit") Запускатель,
	&Лог("oscript.lib.mutatos") Лог) Экспорт

	_Запускатель = Запускатель;
	_Лог         = Лог;

КонецПроцедуры
