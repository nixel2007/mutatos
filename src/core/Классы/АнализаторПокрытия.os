#Использовать json
#Использовать tempfiles
#Использовать autumn-logos
#Использовать "../internal"

// Собирает данные о том, какие строки исходников выполняются во время тестов.
//
// Прогон с покрытием делается один раз перед проверкой мутантов. Он же служит
// исходным прогоном: тесты должны быть зелёными, а его длительность задаёт таймаут мутантам.
//
// Данные берутся из статистики выполнения самого движка (-codestat): она не зависит
// от способа запуска тестов и содержит счётчик выполнений каждой инструментированной строки.

Перем _Запускатель;
Перем _Лог;

// Прогоняет тесты, собирая покрытие.
//
// Возвращаемое значение:
//   Структура - Прогон (РезультатПрогона) и Покрытие (КартаПокрытия)
Функция СобратьПокрытие(Знач РабочийКаталог, Знач Фильтры = Неопределено) Экспорт

	// собственный менеджер временных файлов, а не общий: autumn-logos при инициализации
	// поделки вызывает ВременныеФайлы.Удалить() и сносит всё, что создано через общий
	ПутьКСтатистике = Новый МенеджерВременныхФайлов().НовоеИмяФайла("json");

	Прогон = _Запускатель.Прогнать(РабочийКаталог, 0, ПутьКСтатистике, Фильтры);

	Результат = Новый Структура("Прогон, Покрытие", Прогон, Новый КартаПокрытия());

	Если Не Прогон.Успешно() Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Покрытие = ПрочитатьСтатистику(ПутьКСтатистике);

	_Лог.Информация("Покрытых строк: %1", Результат.Покрытие.КоличествоПокрытыхСтрок());

	Возврат Результат;

КонецФункции

// Разбирает статистику выполнения движка в карту покрытия.
Функция ПрочитатьСтатистику(Знач ПутьКСтатистике) Экспорт

	Покрытие = Новый КартаПокрытия();

	Если Не Новый Файл(ПутьКСтатистике).Существует() Тогда
		_Лог.Предупреждение("Статистика выполнения не сформирована: %1", ПутьКСтатистике);
		Возврат Покрытие;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON();
	Чтение.ОткрытьФайл(ПутьКСтатистике);
	// ключи статистики - пути к файлам и служебные имена вроде "#path",
	// свойствами структуры они быть не могут
	Статистика = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Для Каждого ДанныеФайла Из Статистика Цикл
		ОбработатьФайл(Покрытие, ДанныеФайла.Ключ, ДанныеФайла.Значение);
	КонецЦикла;

	Возврат Покрытие;

КонецФункции

Процедура ОбработатьФайл(Покрытие, ПутьКФайлу, МетодыФайла)

	Покрытие.ОтметитьФайл(ПутьКФайлу);

	Для Каждого ДанныеМетода Из МетодыФайла Цикл

		// служебные ключи статистики начинаются с решётки, например "#path"
		Если СтрНачинаетсяС(ДанныеМетода.Ключ, "#") Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ДанныеСтроки Из ДанныеМетода.Значение Цикл

			// строка попадает в карту, только если она действительно выполнялась
			Если ДанныеСтроки.Значение["count"] > 0 Тогда
				Покрытие.Отметить(ПутьКФайлу, Число(ДанныеСтроки.Ключ));
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин ЗапускательТестов,
	&ЛогМутатос Лог) Экспорт

	_Запускатель = ЗапускательТестов;
	_Лог         = Лог;

КонецПроцедуры
