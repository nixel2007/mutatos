#Использовать "../internal"
#Использовать autumn-logos

// Оркестрирует мутационный прогон: находит мутации в исходниках и проверяет каждую.
//
// Перед проверкой мутантов прогоняются исходные тесты: если они красные,
// отличить убитого мутанта от изначально сломанного проекта невозможно.

Перем _Генератор;
Перем _Исполнитель;
Перем _Анализатор;
Перем _СборщикКарты;
Перем _Запускатель;
Перем _Лог;

// Проверяет исходники проекта мутационными тестами.
//
// Параметры:
//   РабочийКаталог - Строка - каталог проекта, в котором запускаются тесты
//   ФайлыИсходников - Массив - полные пути к мутируемым файлам
//   Параметры - ПараметрыПрогона - настройки прогона, Неопределено - умолчания
//
// Возвращаемое значение:
//   ОтчетПрогона
Функция Проверить(Знач РабочийКаталог, Знач ФайлыИсходников, Знач Параметры = Неопределено) Экспорт

	Если Параметры = Неопределено Тогда
		Параметры = Новый ПараметрыПрогона();
	КонецЕсли;

	Отчет = Новый ОтчетПрогона();

	ИсходныйПрогон = _Анализатор.СобратьПокрытие(РабочийКаталог, Параметры.Фильтры);

	Если Не ИсходныйПрогон.Прогон.Успешно() Тогда
		ВызватьИсключение "Тесты проекта не проходят до мутаций - мутационный прогон бессмыслен";
	КонецЕсли;

	Длительность = ИсходныйПрогон.Прогон.Длительность();
	Таймаут = Длительность * Параметры.КоэффициентТаймаута;
	_Лог.Информация("Исходный прогон занял %1 мс, таймаут мутанта: %2 мс", Длительность, Таймаут);

	КартаТестов = КартаТестов(РабочийКаталог, Параметры);

	СверитьКартуСПокрытием(КартаТестов, ИсходныйПрогон.Покрытие, ФайлыИсходников);

	Задания = Новый Массив();

	Для Каждого ПутьКФайлу Из ФайлыИсходников Цикл
		Для Каждого Задание Из ЗаданияФайла(ПутьКФайлу, ИсходныйПрогон.Покрытие, КартаТестов, Отчет, Параметры) Цикл
			Задания.Добавить(Задание);
		КонецЦикла;
	КонецЦикла;

	// Сколько всего работы предстоит - самое нужное перед долгим прогоном: по числу
	// мутантов и длительности исходного прогона видно, минуты это или часы
	_Лог.Информация("Мутантов к проверке: %1, отсеяно без покрытия: %2, ожидаемая длительность: %3",
		Задания.Количество(),
		Отчет.БезПокрытия(),
		ОжидаемаяДлительность(Задания, Длительность, КартаТестов, Параметры));

	Если КартаТестов.Заполнена() Тогда
		_Лог.Информация("Отбор тестов: в среднем %1 набора на мутанта из %2, всеми тестами проверяется %3",
			Формат(СреднееЧислоНаборов(Задания), "ЧДЦ=1; ЧН=0"),
			КартаТестов.КоличествоНаборов(),
			БезОтбора(Задания));
	КонецЕсли;

	ПроверенныеМутанты = _Исполнитель.ПроверитьМутантов(
		РабочийКаталог,
		Задания,
		Таймаут,
		КаталогЯдра(РабочийКаталог),
		Параметры);

	Для Каждого Результат Из ПроверенныеМутанты Цикл
		Отчет.Добавить(Результат);
	КонецЦикла;

	Возврат Отчет;

КонецФункции

// Строка мутируемого файла, покрытая общим прогоном, должна найтись и в карте:
// раз её кто-то выполняет, этот кто-то обязан быть в карте. Если не находится,
// карта неполна, и мутанты таких строк пойдут всеми тестами - медленно, но верно.
// Молчать об этом нельзя: это признак, что отбор чего-то не видит.
Процедура СверитьКартуСПокрытием(КартаТестов, Покрытие, ФайлыИсходников)

	Если Не КартаТестов.Заполнена() Тогда
		Возврат;
	КонецЕсли;

	Мутируемые = Новый Соответствие();
	Для Каждого Файл Из ФайлыИсходников Цикл
		Мутируемые.Вставить(НРег(СтрЗаменить(Файл, "\", "/")), Истина);
	КонецЦикла;

	Потеряно = Новый Массив();
	Покрыто = 0;

	Для Каждого Строка Из Покрытие.ПокрытыеСтроки() Цикл

		Если Мутируемые.Получить(НРег(СтрЗаменить(Строка.Файл, "\", "/"))) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Покрыто = Покрыто + 1;

		Если КартаТестов.НаборыСтроки(Строка.Файл, Строка.НомерСтроки).Количество() = 0 Тогда
			Потеряно.Добавить(СтрШаблон("%1:%2", Новый Файл(Строка.Файл).Имя, Строка.НомерСтроки));
		КонецЕсли;

	КонецЦикла;

	Если Потеряно.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	_Лог.Предупреждение("Строк мутируемых файлов есть в покрытии, но нет в карте тестов: %1 из %2. Первые: %3",
		Потеряно.Количество(),
		Покрыто,
		СтрСоединить(ПервыеНесколько(Потеряно, 15), ", "));

КонецПроцедуры

Функция ПервыеНесколько(Знач Значения, Знач Сколько)

	Результат = Новый Массив();

	Для Каждого Значение Из Значения Цикл

		Если Результат.Количество() >= Сколько Тогда
			Прервать;
		КонецЕсли;

		Результат.Добавить(Значение);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сколько наборов в среднем достаётся мутанту: по этому числу видно, работает отбор
// или почти каждый мутант всё равно тянет за собой весь проект.
Функция СреднееЧислоНаборов(Задания)

	Если Задания.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Всего = 0;

	Для Каждого Задание Из Задания Цикл
		Всего = Всего + Задание.Наборы.Количество();
	КонецЦикла;

	Возврат Всего / Задания.Количество();

КонецФункции

Функция БезОтбора(Задания)

	Количество = 0;

	Для Каждого Задание Из Задания Цикл
		Если Задание.Наборы.Количество() = 0 Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Количество;

КонецФункции

// Грубая оценка: мутанты идут параллельно, а стоит мутант ровно того, чем его проверяют -
// с отбором это его наборы, без отбора весь прогон. Точность тут не нужна: нужен порядок
// величины, чтобы решить, ждать или заняться другим.
Функция ОжидаемаяДлительность(Задания, Знач ДлительностьПрогона, КартаТестов, Параметры)

	Потоков = ?(Параметры.ЧислоПотоков > 0, Параметры.ЧислоПотоков, Новый СистемнаяИнформация().КоличествоПроцессоров);
	Всего = 0;

	Для Каждого Задание Из Задания Цикл

		Оценка = КартаТестов.ОценкаПрогона(Задание.Наборы);
		Всего = Всего + ?(Оценка > 0, Оценка, ДлительностьПрогона);

	КонецЦикла;

	Секунд = Окр(Всего / Мин(Потоков, Макс(Задания.Количество(), 1)) / 1000);

	Если Секунд < 90 Тогда
		Возврат СтрШаблон("около %1 с", Секунд);
	КонецЕсли;

	Возврат СтрШаблон("около %1 мин", Окр(Секунд / 60));

КонецФункции

Функция КаталогЯдра(РабочийКаталог)

	Возврат _Запускатель.КаталогЯдраПроекта(РабочийКаталог);

КонецФункции

// Карта тестов строится только если отбор включён: она стоит прогона на каждый набор,
// и на маленьком проекте это дороже, чем гонять всё подряд.
Функция КартаТестов(РабочийКаталог, Параметры)

	Если Не Параметры.ОтбиратьТесты Тогда
		Возврат Новый КартаТестов();
	КонецЕсли;

	Возврат _СборщикКарты.Собрать(РабочийКаталог, КаталогЯдра(РабочийКаталог), Параметры);

КонецФункции

// Возвращает задания на проверку: мутанты в непокрытых строках сразу попадают в отчёт
// и на прогон не отправляются - тесты не выполняют эту строку и убить их не могут.
Функция ЗаданияФайла(ПутьКФайлу, Покрытие, КартаТестов, Отчет, Параметры)

	Задания = Новый Массив();

	Исходник = ПрочитатьФайл(ПутьКФайлу);
	Мутации = _Генератор.НайтиМутации(Исходник, Параметры.ОтключенныеМутаторы);

	_Лог.Информация("Файл %1: мутаций найдено %2", ПутьКФайлу, Мутации.Количество());

	Для Каждого Мутация Из Мутации Цикл

		Если НеПокрытаТестами(Покрытие, ПутьКФайлу, Мутация) Тогда
			Отчет.Добавить(Новый РезультатМутанта(Мутация, ПутьКФайлу, СостоянияМутанта.БезПокрытия()));
			Продолжить;
		КонецЕсли;

		Задания.Добавить(Новый Структура("Файл, Мутация, Наборы",
			ПутьКФайлу,
			Мутация,
			НаборыСтроки(КартаТестов, ПутьКФайлу, Мутация)));

	КонецЦикла;

	Возврат Задания;

КонецФункции

// Наборы, которыми проверяется мутант. Пустой список означает "всеми тестами проекта":
// так выходит и без карты, и когда строка есть в покрытии, но в карте её не оказалось -
// например, её набор в одиночку не проходит. Гнать всё в таком случае дороже,
// но честнее: пропущенный набор превратил бы убитого мутанта в выжившего.
Функция НаборыСтроки(КартаТестов, ПутьКФайлу, Мутация)

	Если Не КартаТестов.Заполнена() Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Возврат КартаТестов.НаборыСтроки(ПутьКФайлу, Мутация.НомерСтроки());

КонецФункции

// Пока покрытия нет вовсе, судить не о чем: такие мутанты проверяются обычным способом.
//
// Зато файл, которого нет в непустом отчёте, ни один тест даже не загружал - статистика
// выполнения знает все скомпилированные файлы, а не только те, где что-то выполнилось.
// Мутанту в таком файле убиться не обо что, и гонять его смысла нет: на collectionos
// это полтора десятка файлов интерфейсов и десятая часть времени прогона.
Функция НеПокрытаТестами(Покрытие, ПутьКФайлу, Мутация)

	Если Покрытие.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не Покрытие.ЕстьДанные(ПутьКФайлу) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Не Покрытие.Покрыта(ПутьКФайлу, Мутация.НомерСтроки());

КонецФункции

Функция ПрочитатьФайл(Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин ГенераторМутантов,
	&Пластилин ИсполнительМутантов,
	&Пластилин АнализаторПокрытия,
	&Пластилин СборщикКартыТестов,
	&Пластилин("ЗапускательТестовЯдро") Запускатель,
	&Лог("oscript.lib.mutatos") Лог) Экспорт

	_Генератор     = ГенераторМутантов;
	_Исполнитель   = ИсполнительМутантов;
	_Анализатор    = АнализаторПокрытия;
	_СборщикКарты  = СборщикКартыТестов;
	_Запускатель   = Запускатель;
	_Лог           = Лог;

КонецПроцедуры
