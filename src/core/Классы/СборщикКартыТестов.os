#Использовать tempfiles
#Использовать autumn-logos
#Использовать "../internal"

// Строит карту «строка исходника - наборы тестов, которые её выполняют».
//
// Каждый набор прогоняется отдельным процессом со сбором статистики выполнения:
// иначе не понять, чей вклад в покрытие чей. Один прогон движка отдаёт статистику
// целиком, разделить её по тестам он не умеет - поэтому гранулярность карты
// это файл набора, а не отдельный тест.
//
// Прогоны идут параллельно, в тех же рабочих копиях, что и проверка мутантов.
//
// Набор, который в одиночку не проходит, из карты исключается: он зависит от порядка
// выполнения, и отбор по нему дал бы ложные выводы о мутантах.

Перем _Копии;
Перем _Анализатор;
Перем _ВременныеФайлы;
Перем _Лог;

// Собирает карту тестов для проекта.
//
// Параметры:
//   РабочийКаталог - Строка - каталог проекта
//   КаталогЯдра - Строка - каталог ядра OneUnit, пустая строка - ядро по умолчанию
//   Параметры - ПараметрыПрогона - число потоков и отбор тестов
//
// Возвращаемое значение:
//   КартаТестов
Функция Собрать(Знач РабочийКаталог, Знач КаталогЯдра = "", Знач Параметры = Неопределено) Экспорт

	Если Параметры = Неопределено Тогда
		Параметры = Новый ПараметрыПрогона();
	КонецЕсли;

	Карта = Новый КартаТестов();

	Наборы = _Копии.ФайлыНаборов(РабочийКаталог);

	Если Наборы.Количество() = 0 Тогда
		_Лог.Предупреждение("Файлы тестовых наборов не найдены - мутанты будут проверяться всеми тестами");
		Возврат Карта;
	КонецЕсли;

	_Лог.Информация("Наборов тестов: %1, собираю покрытие по каждому", Наборы.Количество());

	Копии = _Копии.СоздатьКопии(
		РабочийКаталог,
		Мин(_Копии.ЧислоПотоков(Параметры.ЧислоПотоков), Наборы.Количество()),
		КаталогЯдра,
		Параметры.Фильтры);

	Попытка
		Результаты = Прогнать(Копии, Наборы);
	Исключение
		_Копии.УдалитьКопии(Копии);
		ВызватьИсключение;
	КонецПопытки;

	_Копии.УдалитьКопии(Копии);

	Возврат ПостроитьКарту(Результаты, Карта);

КонецФункции

Функция Прогнать(Копии, Наборы)

	Задания = Новый Массив();

	Для Каждого Набор Из Наборы Цикл
		Задания.Добавить(Новый Структура("Набор, Статистика", Набор, _ВременныеФайлы.НовоеИмяФайла("json")));
	КонецЦикла;

	Пул = Новый ПулПрогонов();

	Возврат Пул.Прогнать(Копии, Задания, 0, ЭтотОбъект);

КонецФункции

Функция ПостроитьКарту(Результаты, Карта)

	Пропущено = 0;

	Для Каждого Результат Из Результаты Цикл

		Если Не Результат.Успешно Тогда
			// набор красный сам по себе - скорее всего зависит от порядка выполнения.
			// Молчать нельзя: без него мутанты его строк проверялись бы неполно
			_Лог.Предупреждение("Набор %1 в одиночку не проходит и в карту тестов не попал", Результат.Набор);
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;

		Карта.ОтметитьПокрытие(Результат.Набор, _Анализатор.ПрочитатьСтатистику(Результат.Статистика));

	КонецЦикла;

	_Лог.Информация("Карта тестов построена по %1 наборам, пропущено %2",
		Карта.КоличествоНаборов(),
		Пропущено);

	_ВременныеФайлы.Удалить();

	Возврат Карта;

КонецФункции

// Запускает прогон одного набора со сбором статистики. Вызывается пулом прогонов.
Функция Запустить(Копия, Задание) Экспорт

	Наборы = Новый Массив();
	Наборы.Добавить(Копия.ПутьВКопии(Задание.Набор));

	Копия.ПерестроитьТочкуВхода(Наборы);

	Процесс = СоздатьПроцесс(
		СтрШаблон("oscript -codestat=""%1"" ""%2""", Задание.Статистика, Копия.ТочкаВхода()),
		Копия.Каталог(),
		Истина,
		Ложь);

	Процесс.Запустить();

	Возврат Процесс;

КонецФункции

// Прогон набора завершился. Вызывается пулом прогонов.
Функция Завершено(Задание, Знач КодВозврата, Знач Длительность, Знач Вывод) Экспорт

	_Лог.Отладка("Набор %1 прогнан за %2 мс, код возврата %3", Задание.Набор, Длительность, КодВозврата);

	Возврат Новый Структура("Набор, Статистика, Успешно, Длительность",
		Задание.Набор,
		Задание.Статистика,
		КодВозврата = 0,
		Длительность);

КонецФункции

// Прогон набора не уложился в таймаут. Вызывается пулом прогонов.
Функция Прервано(Задание, Знач Длительность, Знач Вывод) Экспорт

	Возврат Новый Структура("Набор, Статистика, Успешно, Длительность",
		Задание.Набор,
		Задание.Статистика,
		Ложь,
		Длительность);

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин ФабрикаКопий,
	&Пластилин АнализаторПокрытия,
	&Лог("oscript.lib.mutatos") Лог) Экспорт

	_Копии      = ФабрикаКопий;
	_Анализатор = АнализаторПокрытия;
	_Лог        = Лог;

	// собственный менеджер временных файлов, а не общий: autumn-logos при инициализации
	// поделки вызывает ВременныеФайлы.Удалить() и сносит всё, что создано через общий
	_ВременныеФайлы = Новый МенеджерВременныхФайлов();

КонецПроцедуры
