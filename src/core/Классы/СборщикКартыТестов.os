#Использовать json
#Использовать tempfiles
#Использовать autumn-logos
#Использовать "../internal"

// Строит карту «строка исходника - тесты, которые её выполняют».
//
// Всё делается одним прогоном. Внутри него агент открывает сессию сбора статистики
// на старте каждого теста и закрывает на его завершении, поэтому движок отдаёт
// покрытие отдельно по каждому тесту, а не одной кучей на весь прогон.
//
// Этот же прогон служит исходным: тесты должны быть зелёными, его покрытие говорит,
// какие строки вообще имеет смысл мутировать, а его длительность задаёт таймаут мутантам.
// Раньше на всё это уходил прогон на каждый набор плюс общий - теперь один на всё.
//
// Управляемый сбор статистики появился в движке не сразу. На движке постарше агент
// не поднимется, карта останется пустой, и мутанты пойдут всеми тестами: медленнее,
// но так же верно. Покрытие и результат прогона при этом собираются как обычно.

Перем _Копии;
Перем _Анализатор;
Перем _Запускатель;
Перем _ВременныеФайлы;
Перем _Лог;

// Прогоняет тесты проекта, собирая покрытие и карту тестов.
//
// Параметры:
//   РабочийКаталог - Строка - каталог проекта
//   КаталогЯдра - Строка - каталог ядра OneUnit, пустая строка - ядро по умолчанию
//   Параметры - ПараметрыПрогона - настройки прогона, Неопределено - умолчания
//
// Возвращаемое значение:
//   Структура - Карта (КартаТестов), Покрытие (КартаПокрытия), Прогон (РезультатПрогона)
Функция Собрать(Знач РабочийКаталог, Знач КаталогЯдра = "", Знач Параметры = Неопределено) Экспорт

	Если Параметры = Неопределено Тогда
		Параметры = Новый ПараметрыПрогона();
	КонецЕсли;

	ФайлКарты      = _ВременныеФайлы.НовоеИмяФайла("json");
	ФайлСтатистики = _ВременныеФайлы.НовоеИмяФайла("json");

	Копия = _Копии.СоздатьКопии(РабочийКаталог, 1, КаталогЯдра, Параметры.Фильтры, Ложь, ФайлКарты)[0];

	Попытка
		Результат = СобратьВКопии(Копия, ФайлКарты, ФайлСтатистики);
	Исключение
		Копия.Удалить();
		_ВременныеФайлы.Удалить();
		ВызватьИсключение;
	КонецПопытки;

	Копия.Удалить();
	_ВременныеФайлы.Удалить();

	Возврат Результат;

КонецФункции

Функция СобратьВКопии(Копия, Знач ФайлКарты, Знач ФайлСтатистики)

	Прогон = Прогнать(Копия, ФайлСтатистики);

	Результат = Новый Структура("Карта, Покрытие, Прогон",
		Новый КартаТестов(),
		Покрытие(Копия, ФайлСтатистики),
		Прогон);

	// Оборванный прогон карту не дописывает, а недописанной верить нельзя: мутанты
	// недошедших тестов остались бы непроверенными
	Если Прогон.Успешно() Тогда
		Результат.Карта = ПостроитьКарту(Копия, ФайлКарты, Прогон.Длительность());
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Прогон копии с включённым сбором статистики: без него агенту нечего собирать,
// а движок не пишет и общий файл покрытия.
//
// Прогон один, но идёт он через пул: ждать процесс, вычитывать его вывод по ходу
// и не дать буферу движка расти без предела - это его работа, и повторять её здесь
// значило бы держать вторую такую же петлю.
Функция Прогнать(Копия, Знач ФайлСтатистики)

	Копии = Новый Массив();
	Копии.Добавить(Копия);

	Задания = Новый Массив();
	Задания.Добавить(Новый Структура("Статистика", ФайлСтатистики));

	Возврат Новый ПулПрогонов().Прогнать(Копии, Задания, ЭтотОбъект)[0];

КонецФункции

// Запускает исходный прогон. Вызывается пулом прогонов.
Функция Запустить(Копия, Задание) Экспорт

	Возврат _Запускатель.Запустить(
		СтрШаблон("oscript -codestat=""%1"" ""%2""", Задание.Статистика, Копия.ТочкаВхода()),
		Копия.Каталог());

КонецФункции

// Исходный прогон идёт без предела времени: он и есть замер того, сколько занимают
// тесты проекта, а обрывать замер по догадке о его длительности нечестно.
Функция Таймаут(Задание) Экспорт
	Возврат 0;
КонецФункции

// Прогон завершился. Вызывается пулом прогонов.
Функция Завершено(Задание, Знач КодВозврата, Знач Длительность, Знач Вывод) Экспорт

	_Лог.Отладка("Исходный прогон занял %1 мс, код возврата %2", Длительность, КодВозврата);

	Возврат Новый РезультатПрогона(КодВозврата = 0, КодВозврата, Длительность, Вывод);

КонецФункции

// Прогон прерван. Вызывается пулом прогонов, но не при нулевом таймауте.
Функция Прервано(Задание, Знач Длительность, Знач Вывод) Экспорт

	Возврат Новый РезультатПрогона(Ложь, -1, Длительность, Вывод);

КонецФункции

// Покрытие всего прогона: статистика говорит путями рабочей копии,
// а мутанты - путями проекта.
Функция Покрытие(Копия, Знач ФайлСтатистики)

	ВКопии = _Анализатор.ПрочитатьСтатистику(ФайлСтатистики);

	Покрытие = Новый КартаПокрытия();

	Для Каждого Файл Из ВКопии.Файлы() Цикл
		Покрытие.ОтметитьФайл(Копия.ПутьВОригинале(Файл));
	КонецЦикла;

	Для Каждого Строка Из ВКопии.ПокрытыеСтроки() Цикл
		Покрытие.Отметить(Копия.ПутьВОригинале(Строка.Файл), Строка.НомерСтроки);
	КонецЦикла;

	_Лог.Информация("Покрытых строк: %1", Покрытие.КоличествоПокрытыхСтрок());

	Возврат Покрытие;

КонецФункции

Функция ПостроитьКарту(Копия, Знач ФайлКарты, Знач ДлительностьПрогона)

	Карта = Новый КартаТестов();

	Если Не Новый Файл(ФайлКарты).Существует() Тогда
		_Лог.Предупреждение("Движок не умеет управляемый сбор статистики - отбор тестов отключён,"
			+ " мутанты будут проверяться всеми тестами");
		Возврат Карта;
	КонецЕсли;

	НачалоРазбора = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Собранное = ПрочитатьКарту(ФайлКарты);

	ВремяТестов = 0;

	// Перевод пути стоит обращения к файловой системе, а файлов в покрытии сотни
	// и повторяются они у каждого теста: без запоминания это сотни тысяч обращений
	Переведенные = Новый Соответствие();

	Для Каждого Тест Из Собранное["Тесты"] Цикл

		Набор = ПутьВОригинале(Копия, Переведенные, Тест["Набор"]);
		Метод = Тест["Метод"];

		Для Каждого ДанныеФайла Из Тест["Покрытие"] Цикл

			Карта.ОтметитьСтрокиФайла(
				Набор,
				Метод,
				ПутьВОригинале(Копия, Переведенные, ДанныеФайла.Ключ),
				ДанныеФайла.Значение);

		КонецЦикла;

		Карта.ОтметитьДлительность(Набор, Метод, Тест["Длительность"]);
		ВремяТестов = ВремяТестов + Тест["Длительность"];

	КонецЦикла;

	// Всё, что прогон потратил не на сами тесты и не на сбор, - это его старт: движок,
	// компиляция проекта, обнаружение тестов. Мутант платит его один раз, сколько бы
	// тестов ему ни досталось, поэтому в оценке он стоит отдельно от них.
	//
	// Сбор вычитается целиком: мутанты бегут без агента, и их прогон за него не платит.
	// Иначе оценка мутанта завышалась бы в разы, а вместе с ней и его предел времени -
	// зациклившийся мутант досиживал бы до чужого срока, ради чего этот предел и заводили
	Накладные = Собранное["Накладные"];
	СтоимостьСтарта = Макс(ДлительностьПрогона - ВремяТестов - Накладные, 0);
	Карта.ОтметитьСтоимостьСтарта(СтоимостьСтарта);

	_Лог.Информация("Разбор карты занял %1 мс",
		ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоРазбора);

	_Лог.Информация(
		"Карта тестов построена по %1 тестам. Прогон: старт %2 мс, сами тесты %3 мс, сбор карты %4 мс",
		Карта.КоличествоТестов(),
		СтоимостьСтарта,
		ВремяТестов,
		Накладные);

	Возврат Карта;

КонецФункции

// Путь копии в путь оригинала, с запоминанием: один и тот же файл приходит
// у каждого теста, а перевод каждый раз нормализует путь через файловую систему.
Функция ПутьВОригинале(Копия, Переведенные, Знач ПутьВКопии)

	Переведенный = Переведенные.Получить(ПутьВКопии);

	Если Переведенный = Неопределено Тогда
		Переведенный = Копия.ПутьВОригинале(ПутьВКопии);
		Переведенные.Вставить(ПутьВКопии, Переведенный);
	КонецЕсли;

	Возврат Переведенный;

КонецФункции

Функция ПрочитатьКарту(Знач ФайлКарты)

	Чтение = Новый ЧтениеJSON();
	Чтение.ОткрытьФайл(ФайлКарты);
	// ключи покрытия - пути к файлам, свойствами структуры они быть не могут
	Тесты = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Тесты;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин ФабрикаКопий,
	&Пластилин АнализаторПокрытия,
	&Пластилин ЗапускательПроцессов,
	&ЛогМутатос Лог) Экспорт

	_Копии       = ФабрикаКопий;
	_Анализатор  = АнализаторПокрытия;
	_Запускатель = ЗапускательПроцессов;
	_Лог         = Лог;

	// собственный менеджер временных файлов, а не общий: autumn-logos при инициализации
	// поделки вызывает ВременныеФайлы.Удалить() и сносит всё, что создано через общий
	_ВременныеФайлы = Новый МенеджерВременныхФайлов();

КонецПроцедуры
