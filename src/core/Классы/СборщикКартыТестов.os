#Использовать tempfiles
#Использовать autumn-logos
#Использовать "../internal"

// Строит карту «строка исходника - наборы тестов, которые её выполняют».
//
// Каждый набор прогоняется отдельным процессом со сбором статистики выполнения:
// иначе не понять, чей вклад в покрытие чей. Один прогон движка отдаёт статистику
// целиком, разделить её по тестам он не умеет - поэтому гранулярность карты
// это файл набора, а не отдельный тест.
//
// Прогоны идут параллельно, в тех же рабочих копиях, что и проверка мутантов.
//
// Если хоть один набор в одиночку не проходит, отбор отключается целиком. Выкинуть
// такой набор из карты нельзя: неизвестно, какие строки он выполняет, и мутант на любой
// из них был бы объявлен выжившим, хотя этот набор его убивает. Прогон всеми тестами
// медленнее, но не врёт.

Перем _Копии;
Перем _Анализатор;
Перем _ВременныеФайлы;
Перем _Лог;

// Собирает карту тестов для проекта.
//
// Параметры:
//   РабочийКаталог - Строка - каталог проекта
//   КаталогЯдра - Строка - каталог ядра OneUnit, пустая строка - ядро по умолчанию
//   Параметры - ПараметрыПрогона - число потоков и отбор тестов
//
// Возвращаемое значение:
//   КартаТестов
Функция Собрать(Знач РабочийКаталог, Знач КаталогЯдра = "", Знач Параметры = Неопределено) Экспорт

	Если Параметры = Неопределено Тогда
		Параметры = Новый ПараметрыПрогона();
	КонецЕсли;

	Карта = Новый КартаТестов();

	Наборы = _Копии.ФайлыНаборов(РабочийКаталог);

	Если Наборы.Количество() = 0 Тогда
		_Лог.Предупреждение("Файлы тестовых наборов не найдены - мутанты будут проверяться всеми тестами");
		Возврат Карта;
	КонецЕсли;

	// Ещё одна долгая тишина: каждый набор прогоняется отдельно, чтобы знать, какие
	// строки он покрывает. Прогонов столько же, сколько наборов
	_Лог.Информация("Наборов тестов: %1. Собираю покрытие по каждому отдельным прогоном,"
		+ " одновременных прогонов: %2",
		Наборы.Количество(),
		Мин(_Копии.ЧислоПотоков(Параметры.ЧислоПотоков), Наборы.Количество()));

	Копии = _Копии.СоздатьКопии(
		РабочийКаталог,
		Мин(_Копии.ЧислоПотоков(Параметры.ЧислоПотоков), Наборы.Количество()),
		КаталогЯдра,
		Параметры.Фильтры);

	Попытка
		Результаты = Прогнать(Копии, Наборы);
		Результаты = Перепрогнать(Копии, Результаты);
	Исключение
		_Копии.УдалитьКопии(Копии);
		ВызватьИсключение;
	КонецПопытки;

	_Копии.УдалитьКопии(Копии);

	Возврат ПостроитьКарту(Результаты, Карта);

КонецФункции

Функция Прогнать(Копии, Наборы)

	Задания = Новый Массив();

	Для Каждого Набор Из Наборы Цикл
		Задания.Добавить(Новый Структура("Набор, Статистика", Набор, _ВременныеФайлы.НовоеИмяФайла("json")));
	КонецЦикла;

	Пул = Новый ПулПрогонов();

	Возврат Пул.Прогнать(Копии, Задания, ЭтотОбъект);

КонецФункции

// Наборы прогоняются параллельно, и упасть набор может не от порядка, а от нагрузки:
// на восьми одновременных прогонах чувствительные к времени тесты иногда не успевают.
// Поэтому упавшим даётся вторая попытка - в одиночку.
Функция Перепрогнать(Копии, Результаты)

	Упавшие = Новый Массив();

	Для Каждого Результат Из Результаты Цикл
		Если Не Результат.Успешно Тогда
			Упавшие.Добавить(Новый Структура("Набор, Статистика", Результат.Набор, Результат.Статистика));
		КонецЕсли;
	КонецЦикла;

	Если Упавшие.Количество() = 0 Тогда
		Возврат Результаты;
	КонецЕсли;

	_Лог.Информация("Наборов не прошло с первого раза: %1, повторяю по одному", Упавшие.Количество());

	Одна = Новый Массив();
	Одна.Добавить(Копии[0]);

	Пул = Новый ПулПрогонов();
	Повторные = Пул.Прогнать(Одна, Упавшие, ЭтотОбъект);

	Успешные = Новый Соответствие();
	Для Каждого Результат Из Повторные Цикл
		Успешные.Вставить(Результат.Набор, Результат);
	КонецЦикла;

	Итог = Новый Массив();

	Для Каждого Результат Из Результаты Цикл
		Повтор = Успешные.Получить(Результат.Набор);
		Итог.Добавить(?(Повтор = Неопределено, Результат, Повтор));
	КонецЦикла;

	Возврат Итог;

КонецФункции

Функция ПостроитьКарту(Результаты, Карта)

	Для Каждого Результат Из Результаты Цикл

		Если Не Результат.Успешно Тогда
			// Набор красный сам по себе - он зависит от порядка выполнения. Что он
			// выполняет, неизвестно, а значит неизвестно и по каким строкам карта врёт:
			// отбирать по ней больше нельзя
			_Лог.Предупреждение("Набор %1 в одиночку не проходит - отбор тестов отключён,"
				+ " мутанты будут проверяться всеми тестами",
				Результат.Набор);

			_ВременныеФайлы.Удалить();

			Возврат Новый КартаТестов();
		КонецЕсли;

		// статистика говорит путями рабочей копии, а мутанты - путями проекта
		ПеренестиПокрытие(Карта, Результат, _Анализатор.ПрочитатьСтатистику(Результат.Статистика));
		Карта.ОтметитьДлительность(Результат.Набор, Результат.Длительность);

	КонецЦикла;

	_Лог.Информация("Карта тестов построена по %1 наборам", Карта.КоличествоНаборов());

	СообщитьОСтоимостиПрогона(Результаты);

	_ВременныеФайлы.Удалить();

	Возврат Карта;

КонецФункции

// Каждый набор прогоняется отдельным процессом, поэтому по ним видно, из чего состоит
// прогон мутанта: самый дешёвый набор - это почти чистый старт движка с компиляцией
// проекта, а разница с остальными и есть время самих тестов. Знать это соотношение
// нужно, чтобы понимать, что вообще имеет смысл ускорять.
Процедура СообщитьОСтоимостиПрогона(Результаты)

	Минимум = 0;
	Максимум = 0;
	Сумма = 0;
	Количество = 0;

	Для Каждого Результат Из Результаты Цикл

		Если Не Результат.Успешно Тогда
			Продолжить;
		КонецЕсли;

		Количество = Количество + 1;
		Сумма = Сумма + Результат.Длительность;
		Максимум = Макс(Максимум, Результат.Длительность);
		Минимум = ?(Минимум = 0, Результат.Длительность, Мин(Минимум, Результат.Длительность));

	КонецЦикла;

	Если Количество = 0 Тогда
		Возврат;
	КонецЕсли;

	_Лог.Информация("Прогон набора: старт около %1 мс, в среднем %2 мс, самый долгий %3 мс",
		Минимум,
		Окр(Сумма / Количество),
		Максимум);

КонецПроцедуры

Процедура ПеренестиПокрытие(Карта, Результат, Покрытие)

	Для Каждого Строка Из Покрытие.ПокрытыеСтроки() Цикл
		Карта.Отметить(Результат.Набор, Результат.Копия.ПутьВОригинале(Строка.Файл), Строка.НомерСтроки);
	КонецЦикла;

КонецПроцедуры

// Запускает прогон одного набора со сбором статистики. Вызывается пулом прогонов.
Функция Запустить(Копия, Задание) Экспорт

	Задание.Вставить("Копия", Копия);

	Наборы = Новый Массив();
	Наборы.Добавить(Копия.ПутьВКопии(Задание.Набор));

	Копия.ПерестроитьТочкуВхода(Наборы);

	Процесс = СоздатьПроцесс(
		СтрШаблон("oscript -codestat=""%1"" ""%2""", Задание.Статистика, Копия.ТочкаВхода()),
		Копия.Каталог(),
		Истина,
		Ложь);

	Процесс.Запустить();

	Возврат Процесс;

КонецФункции

// Наборы для карты гоняются без предела времени: это и есть замер того, сколько
// набор занимает, а обрывать замер по догадке о его длительности нечестно.
Функция Таймаут(Задание) Экспорт
	Возврат 0;
КонецФункции

// Прогон набора завершился. Вызывается пулом прогонов.
Функция Завершено(Задание, Знач КодВозврата, Знач Длительность, Знач Вывод) Экспорт

	_Лог.Отладка("Набор %1 прогнан за %2 мс, код возврата %3", Задание.Набор, Длительность, КодВозврата);

	Возврат Новый Структура("Набор, Статистика, Копия, Успешно, Длительность",
		Задание.Набор,
		Задание.Статистика,
		Задание.Копия,
		КодВозврата = 0,
		Длительность);

КонецФункции

// Прогон набора не уложился в таймаут. Вызывается пулом прогонов.
Функция Прервано(Задание, Знач Длительность, Знач Вывод) Экспорт

	Возврат Новый Структура("Набор, Статистика, Копия, Успешно, Длительность",
		Задание.Набор,
		Задание.Статистика,
		Задание.Копия,
		Ложь,
		Длительность);

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин ФабрикаКопий,
	&Пластилин АнализаторПокрытия,
	&ЛогМутатос Лог) Экспорт

	_Копии      = ФабрикаКопий;
	_Анализатор = АнализаторПокрытия;
	_Лог        = Лог;

	// собственный менеджер временных файлов, а не общий: autumn-logos при инициализации
	// поделки вызывает ВременныеФайлы.Удалить() и сносит всё, что создано через общий
	_ВременныеФайлы = Новый МенеджерВременныхФайлов();

КонецПроцедуры
