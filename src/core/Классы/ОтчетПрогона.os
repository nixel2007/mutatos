#Использовать "../internal"

// Итог мутационного прогона: все проверенные мутанты и сводка по ним.

Перем _Результаты;

// Массив РезультатМутанта, упорядоченный по файлу и строке.
//
// Порядок задаётся здесь, а не в каждом отчёте: мутанты возвращаются из прогона
// в порядке завершения, то есть в разном при каждом запуске, и любой отчёт по ним
// оказался бы нечитаемым и несравнимым с предыдущим.
Функция Результаты() Экспорт
	Возврат ИсходникиОтчета.УпорядоченныеРезультаты(_Результаты);
КонецФункции

Процедура Добавить(Знач Результат) Экспорт
	_Результаты.Добавить(Результат);
КонецПроцедуры

Функция ВсегоМутантов() Экспорт
	Возврат _Результаты.Количество();
КонецФункции

Функция Убито() Экспорт
	Возврат КоличествоПоУсловию(Истина);
КонецФункции

Функция Выжило() Экспорт
	Возврат КоличествоПоСостоянию(СостоянияМутанта.Выжил());
КонецФункции

Функция БезПокрытия() Экспорт
	Возврат КоличествоПоСостоянию(СостоянияМутанта.БезПокрытия());
КонецФункции

Функция Ошибок() Экспорт
	Возврат КоличествоПоСостоянию(СостоянияМутанта.Ошибка());
КонецФункции

// Доля убитых мутантов среди тех, что реально проверялись, в процентах.
// Мутанты без покрытия и ошибочные в расчёт не входят.
Функция ИндексМутаций() Экспорт

	Проверено = Убито() + Выжило();

	Если Проверено = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Окр(Убито() * 100 / Проверено, 1);

КонецФункции

// Мутанты, которых тесты не заметили - самое ценное в отчёте.
Функция Выжившие() Экспорт

	Результат = Новый Массив();

	Для Каждого Мутант Из Результаты() Цикл
		Если Мутант.Состояние() = СостоянияМутанта.Выжил() Тогда
			Результат.Добавить(Мутант);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КоличествоПоСостоянию(Знач Состояние)

	Количество = 0;

	Для Каждого Мутант Из _Результаты Цикл
		Если Мутант.Состояние() = Состояние Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Количество;

КонецФункции

Функция КоличествоПоУсловию(Знач ЭтоУбийство)

	Количество = 0;

	Для Каждого Мутант Из _Результаты Цикл
		Если СостоянияМутанта.ЭтоУбийство(Мутант.Состояние()) = ЭтоУбийство Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Количество;

КонецФункции

Процедура ПриСозданииОбъекта()

	_Результаты = Новый Массив();

КонецПроцедуры
