#Использовать "../internal"

// Заменяет арифметические операции на противоположные по смыслу:
// сложение на вычитание, умножение на деление и обратно.
//
// Убивается тестом, который проверяет результат вычисления, а не только его тип.

Перем _Замены;

Функция Имя() Экспорт
	Возврат "Арифметика";
КонецФункции

Функция ТипыУзлов(Типы) Экспорт
	Результат = Новый Массив();
	Результат.Добавить(Типы.ВыражениеБинарное);
	Возврат Результат;
КонецФункции

Функция Мутации(Узел, Контекст) Экспорт

	Мутации = Новый Массив();

	Замена = _Замены.Получить(Узел.Операция.Токен);
	Если Замена = Неопределено Тогда
		Возврат Мутации;
	КонецЕсли;

	Мутации.Добавить(Контекст.МутацияТокена(
		Имя(),
		Узел.Операция,
		Замена.Символ,
		СтрШаблон("%1 заменено на %2", Замена.ИсходныйСимвол, Замена.Символ)));

	Возврат Мутации;

КонецФункции

&Мутатор
Процедура ПриСозданииОбъекта(&Пластилин Токены)

	_Замены = Новый Соответствие();

	ДобавитьЗамену(Токены.ЗнакСложения,  "+", "-");
	ДобавитьЗамену(Токены.ЗнакВычитания, "-", "+");
	ДобавитьЗамену(Токены.ЗнакУмножения, "*", "/");
	ДобавитьЗамену(Токены.ЗнакДеления,   "/", "*");
	ДобавитьЗамену(Токены.ЗнакОстатка,   "%", "*");

КонецПроцедуры

Процедура ДобавитьЗамену(Токен, ИсходныйСимвол, Символ)

	_Замены.Вставить(Токен, Новый Структура("ИсходныйСимвол, Символ", ИсходныйСимвол, Символ));

КонецПроцедуры
