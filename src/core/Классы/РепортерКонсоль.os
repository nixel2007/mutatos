#Использовать "../internal"

// Выводит итог прогона в консоль.
//
// Главное в отчёте - выжившие мутанты: каждый показывает поведение,
// которое можно сломать, не уронив ни одного теста.

Функция Имя() Экспорт
	Возврат "console";
КонецФункции

Процедура Сформировать(Знач Отчет, Знач Назначение = "") Экспорт

	Сообщить("");
	Сообщить(СтрШаблон("Мутантов проверено: %1", Отчет.ВсегоМутантов()));
	Сообщить(СтрШаблон("  убито:            %1", Отчет.Убито()));
	Сообщить(СтрШаблон("  выжило:           %1", Отчет.Выжило()));

	Если Отчет.БезПокрытия() > 0 Тогда
		Сообщить(СтрШаблон("  без покрытия:     %1", Отчет.БезПокрытия()));
	КонецЕсли;

	Если Отчет.Ошибок() > 0 Тогда
		Сообщить(СтрШаблон("  ошибок:           %1", Отчет.Ошибок()));
	КонецЕсли;

	Сообщить(СтрШаблон("Индекс мутаций:     %1%%", Отчет.ИндексМутаций()));

	Выжившие = Отчет.Выжившие();
	Если Выжившие.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Сообщить("");
	Сообщить("Выжившие мутанты - тесты не заметили эти изменения:");

	ТекущийФайл = "";
	Для Каждого Мутант Из Выжившие Цикл

		Если Мутант.Файл() <> ТекущийФайл Тогда
			ТекущийФайл = Мутант.Файл();
			Сообщить("");
			Сообщить("  " + ТекущийФайл);
		КонецЕсли;

		Мутация = Мутант.Мутация();

		Сообщить(СтрШаблон("    строка %1, %2: %3",
			Формат(Мутация.НомерСтроки(), "ЧГ=0"),
			?(ПустаяСтрока(Мутация.ИмяМетода()), "тело модуля", Мутация.ИмяМетода()),
			Мутация.Описание()));

	КонецЦикла;

КонецПроцедуры

&Репортер
Процедура ПриСозданииОбъекта()
КонецПроцедуры
