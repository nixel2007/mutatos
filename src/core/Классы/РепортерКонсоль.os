#Использовать autumn-logos
#Использовать "../internal"

// Выводит итог прогона в лог.
//
// Главное в отчёте - выжившие мутанты: каждый показывает поведение,
// которое можно сломать, не уронив ни одного теста.
//
// Отчёт пишется одним сообщением, а не построчно: иначе каждая строка получила бы
// префикс уровня и отчёт перестал бы читаться как единое целое.

Перем _Лог;

Функция Имя() Экспорт
	Возврат "console";
КонецФункции

Процедура Сформировать(Знач Отчет, Знач Назначение = "") Экспорт

	_Лог.Информация(Текст(Отчет));

КонецПроцедуры

Функция Текст(Отчет)

	Строки = Новый Массив();
	Строки.Добавить("");
	Строки.Добавить(СтрШаблон("Мутантов проверено: %1", Отчет.ВсегоМутантов()));
	Строки.Добавить(СтрШаблон("  убито:            %1", Отчет.Убито()));
	Строки.Добавить(СтрШаблон("  выжило:           %1", Отчет.Выжило()));

	Если Отчет.БезПокрытия() > 0 Тогда
		Строки.Добавить(СтрШаблон("  без покрытия:     %1", Отчет.БезПокрытия()));
	КонецЕсли;

	Если Отчет.Ошибок() > 0 Тогда
		Строки.Добавить(СтрШаблон("  ошибок:           %1", Отчет.Ошибок()));
	КонецЕсли;

	Строки.Добавить(СтрШаблон("Индекс мутаций:     %1%%", Отчет.ИндексМутаций()));

	ДополнитьВыжившими(Строки, Отчет.Выжившие());

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Процедура ДополнитьВыжившими(Строки, Выжившие)

	Если Выжившие.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Строки.Добавить("");
	Строки.Добавить("Выжившие мутанты - тесты не заметили эти изменения:");

	ТекущийФайл = "";

	Для Каждого Мутант Из Выжившие Цикл

		Если Мутант.Файл() <> ТекущийФайл Тогда
			ТекущийФайл = Мутант.Файл();
			Строки.Добавить("");
			Строки.Добавить("  " + ТекущийФайл);
		КонецЕсли;

		Мутация = Мутант.Мутация();

		Строки.Добавить(СтрШаблон("    строка %1, %2: %3",
			Формат(Мутация.НомерСтроки(), "ЧГ=0"),
			?(ПустаяСтрока(Мутация.ИмяМетода()), "тело модуля", Мутация.ИмяМетода()),
			Мутация.Описание()));

	КонецЦикла;

КонецПроцедуры

&Репортер
Процедура ПриСозданииОбъекта(&Лог("oscript.lib.mutatos.отчет") Лог)

	_Лог = Лог;

КонецПроцедуры
