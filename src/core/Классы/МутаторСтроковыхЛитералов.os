#Использовать "../internal"

// Опустошает строковые константы, а пустые - наполняет.
//
// Строка в коде обычно не украшение: имя типа, ключ структуры, разделитель, признак.
// Выживший мутант означает, что тесты не смотрят на конкретное значение строки.
//
// Мутатор шумный: под него попадают и тексты сообщений, которые проверять никто
// и не собирался. Если шум мешает, мутатор выключается опцией --exclude-mutators.

Перем _Строка;

Функция Имя() Экспорт
	Возврат "СтроковыеЛитералы";
КонецФункции

Функция ТипыУзлов(Типы) Экспорт
	Результат = Новый Массив();
	Результат.Добавить(Типы.ВыражениеЛитерал);
	Возврат Результат;
КонецФункции

Функция Мутации(Узел, Контекст) Экспорт

	Мутации = Новый Массив();

	Если Узел.Вид <> _Строка Тогда
		Возврат Мутации;
	КонецЕсли;

	Если ПустаяСтрока(Узел.Значение) Тогда
		Замена = """mutatos""";
		Описание = "пустая строка заменена на непустую";
	Иначе
		Замена = """""";
		Описание = "строка заменена на пустую";
	КонецЕсли;

	Мутации.Добавить(Контекст.МутацияТокена(Имя(), Узел.Начало, Замена, Описание));

	Возврат Мутации;

КонецФункции

&Мутатор
Процедура ПриСозданииОбъекта(&Пластилин Токены)

	_Строка = Токены.Строка;

КонецПроцедуры
