#Использовать autumn-logos
#Использовать "../internal"

// Выбирает, как запускать тесты проекта.
//
// Прямой запуск ядра OneUnit вдвое быстрее командной строки: та порождает дочерний процесс,
// то есть на каждый прогон приходится два старта движка вместо одного. Мутационный прогон
// повторяет запуск сотни раз, поэтому разница заметна.
//
// Если ядро в проекте не найдено, остаётся запуск через командную строку.

Перем _ЧерезЯдро;
Перем _ЧерезКоманднуюСтроку;
Перем _Способ;
Перем _Лог;

Функция Прогнать(Знач РабочийКаталог, Знач Таймаут = 0, Знач ПутьКCodestat = "", Знач Фильтры = Неопределено) Экспорт

	Возврат Реализация(РабочийКаталог).Прогнать(РабочийКаталог, Таймаут, ПутьКCodestat, Фильтры);

КонецФункции

Функция Реализация(РабочийКаталог)

	Если _Способ = "cli" Тогда
		Возврат _ЧерезКоманднуюСтроку;
	КонецЕсли;

	Если _ЧерезЯдро.Доступен(РабочийКаталог) Тогда
		Возврат _ЧерезЯдро;
	КонецЕсли;

	_Лог.Предупреждение("Ядро OneUnit не найдено в проекте, тесты запускаются через командную строку");

	Возврат _ЧерезКоманднуюСтроку;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин("ЗапускательТестовЯдро") ЧерезЯдро,
	&Пластилин("ЗапускательТестовOneUnit") ЧерезКоманднуюСтроку,
	&Деталька("mutatos.СпособЗапускаТестов", ЗначениеПоУмолчанию = "ядро") Способ,
	&Лог("oscript.lib.mutatos") Лог) Экспорт

	_ЧерезЯдро            = ЧерезЯдро;
	_ЧерезКоманднуюСтроку = ЧерезКоманднуюСтроку;
	_Способ               = НРег(Способ);
	_Лог                  = Лог;

КонецПроцедуры
