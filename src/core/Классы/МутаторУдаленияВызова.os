#Использовать "../internal"

// Удаляет вызов процедуры целиком.
//
// Выживший мутант означает, что побочный эффект вызова тестами не проверяется:
// метод можно было бы не вызывать вовсе, и никто бы не заметил.

Функция Имя() Экспорт
	Возврат "УдалениеВызова";
КонецФункции

Функция ТипыУзлов(Типы) Экспорт
	Результат = Новый Массив();
	Результат.Добавить(Типы.ОператорВызоваПроцедуры);
	Возврат Результат;
КонецФункции

Функция Мутации(Узел, Контекст) Экспорт

	Мутации = Новый Массив();

	ИсходныйТекст = СокрЛП(Контекст.ТекстУзла(Узел));

	Мутации.Добавить(Контекст.МутацияУзла(
		Имя(),
		Узел,
		"",
		СтрШаблон("удалён вызов %1", ИсходныйТекст)));

	Возврат Мутации;

КонецФункции

&Мутатор
Процедура ПриСозданииОбъекта()
КонецПроцедуры
