// Исход проверки одного мутанта: что мутировали, чем закончился прогон и сколько это заняло.

Перем _Мутация;
Перем _Файл;
Перем _Состояние;
Перем _Длительность;
Перем _Подробности;

// ОписаниеМутации, которое проверялось.
Функция Мутация() Экспорт
	Возврат _Мутация;
КонецФункции

// Путь к файлу, в котором была мутация.
Функция Файл() Экспорт
	Возврат _Файл;
КонецФункции

// Одно из состояний модуля СостоянияМутанта.
Функция Состояние() Экспорт
	Возврат _Состояние;
КонецФункции

// Длительность прогона тестов в миллисекундах.
Функция Длительность() Экспорт
	Возврат _Длительность;
КонецФункции

// Дополнительные сведения об исходе: вывод прогона, текст ошибки.
Функция Подробности() Экспорт
	Возврат _Подробности;
КонецФункции

Функция Представление() Экспорт

	Возврат СтрШаблон("[%1] %2:%3 %4",
		_Состояние,
		_Файл,
		_Мутация.НомерСтроки(),
		_Мутация.Описание());

КонецФункции

Процедура ПриСозданииОбъекта(Знач Мутация, Знач Файл, Знач Состояние, Знач Длительность = 0, Знач Подробности = "")

	_Мутация     = Мутация;
	_Файл        = Файл;
	_Состояние   = Состояние;
	_Длительность = Длительность;
	_Подробности = Подробности;

КонецПроцедуры
