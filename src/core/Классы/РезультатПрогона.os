// Итог одного прогона тестов: зелёный он или нет, сколько занял и что вывел.

Перем _Успешно;
Перем _КодВозврата;
Перем _Длительность;
Перем _Вывод;
Перем _Таймаут;

// Истина, если все тесты прошли.
Функция Успешно() Экспорт
	Возврат _Успешно;
КонецФункции

Функция КодВозврата() Экспорт
	Возврат _КодВозврата;
КонецФункции

// Длительность прогона в миллисекундах.
Функция Длительность() Экспорт
	Возврат _Длительность;
КонецФункции

Функция Вывод() Экспорт
	Возврат _Вывод;
КонецФункции

// Истина, если прогон был прерван по времени.
Функция Таймаут() Экспорт
	Возврат _Таймаут;
КонецФункции

Процедура ПриСозданииОбъекта(Знач Успешно, Знач КодВозврата, Знач Длительность, Знач Вывод = "", Знач Таймаут = Ложь)

	_Успешно      = Успешно;
	_КодВозврата  = КодВозврата;
	_Длительность = Длительность;
	_Вывод        = Вывод;
	_Таймаут      = Таймаут;

КонецПроцедуры
