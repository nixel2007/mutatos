// Отбор тестов, которыми проверяются мутанты.
//
// Мутационный прогон повторяет тесты на каждом мутанте, поэтому на большом проекте
// его обычно сужают: гоняют один набор, одну метку или всё, кроме медленных тестов.
// Фильтры здесь те же, что у OneUnit, и передаются ему как есть - придумывать свой
// язык отбора поверх чужого значило бы расходиться с ним при каждом изменении.
//
// Один и тот же фильтр применяется и к исходному прогону, и к мутантам: иначе покрытие
// собиралось бы одними тестами, а мутанты проверялись другими.

Перем ТегиВключаемые Экспорт;
Перем ТегиИсключаемые Экспорт;
Перем НаборыВключаемые Экспорт;
Перем НаборыИсключаемые Экспорт;
Перем МетодыВключаемые Экспорт;
Перем МетодыИсключаемые Экспорт;

// Истина, если ни один фильтр не задан и прогоняются все тесты.
Функция Пустые() Экспорт

	Для Каждого Фильтр Из Значения() Цикл
		Если Фильтр.Значение.Количество() > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Дополняет детальки прогона OneUnit: имена деталек те же, что у его командной строки.
Процедура ДополнитьДетальки(Детальки) Экспорт

	Для Каждого Фильтр Из Значения() Цикл
		Детальки.Вставить(Фильтр.Деталька, Фильтр.Значение);
	КонецЦикла;

КонецПроцедуры

// Параметры командной строки OneUnit для заданных фильтров.
Функция ПараметрыКоманднойСтроки() Экспорт

	Параметры = Новый Массив();

	Для Каждого Фильтр Из Значения() Цикл

		Если Фильтр.Значение.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Параметры.Добавить(Фильтр.Опция);
		Параметры.Добавить(СтрСоединить(Фильтр.Значение, ","));

	КонецЦикла;

	Возврат Параметры;

КонецФункции

Функция Значения()

	Значения = Новый Массив();
	Значения.Добавить(Фильтр("ТегиВключаемые",            "-t", ТегиВключаемые));
	Значения.Добавить(Фильтр("ТегиИсключаемые",           "-T", ТегиИсключаемые));
	Значения.Добавить(Фильтр("ТестовыеНаборыВключаемые",  "-s", НаборыВключаемые));
	Значения.Добавить(Фильтр("ТестовыеНаборыИсключаемые", "-S", НаборыИсключаемые));
	Значения.Добавить(Фильтр("ТестовыеМетодыВключаемые",  "-m", МетодыВключаемые));
	Значения.Добавить(Фильтр("ТестовыеМетодыИсключаемые", "-M", МетодыИсключаемые));

	Возврат Значения;

КонецФункции

Функция Фильтр(Знач Деталька, Знач Опция, Значение)

	Возврат Новый Структура("Деталька, Опция, Значение",
		Деталька,
		Опция,
		?(Значение = Неопределено, Новый Массив(), Значение));

КонецФункции

Процедура ПриСозданииОбъекта()

	ТегиВключаемые    = Новый Массив();
	ТегиИсключаемые   = Новый Массив();
	НаборыВключаемые  = Новый Массив();
	НаборыИсключаемые = Новый Массив();
	МетодыВключаемые  = Новый Массив();
	МетодыИсключаемые = Новый Массив();

КонецПроцедуры
