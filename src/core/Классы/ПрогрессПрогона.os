#Использовать autumn-logos
#Использовать "../internal"

// Показывает ход проверки мутантов: полоса, счётчик убитых и выживших, прогноз остатка.
//
// Мутационный прогон идёт минутами, а на большом проекте - десятками минут, и всё это
// время снаружи ничего не происходит: тесты гоняются в дочерних процессах, их вывод
// перехвачен. Без полосы прогон неотличим от зависания.
//
// Счёт убитых и выживших - забота этого класса, он кладёт его в подсказку; шаги,
// проценты, прошедшее время и прогноз остатка считает полоса.
//
// Какая именно это полоса - настоящая или пишущая в лог - решает дуб, который её
// отдаёт. Здесь про окружение знать незачем.

Перем _Включен;
Перем _Полоса;
Перем _Бар;
Перем _Убито;
Перем _Выжило;
Перем _Лог;

// Начинает показ прогресса для заданного числа мутантов.
Процедура Начать(Знач Всего, Знач Включен = Истина) Экспорт

	_Убито   = 0;
	_Выжило  = 0;
	_Включен = Включен И Всего > 0;
	_Полоса  = _Включен;

	Если Не _Полоса Тогда
		Возврат;
	КонецЕсли;

	Попытка
		_Бар.Начать(Всего, Подсказка());
	Исключение
		ОтключитьПолосу(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Отмечает проверенного мутанта с его исходом.
Процедура Отметить(Знач Состояние) Экспорт

	Если СостоянияМутанта.ЭтоУбийство(Состояние) Тогда
		_Убито = _Убито + 1;
	ИначеЕсли Состояние = СостоянияМутанта.Выжил() Тогда
		_Выжило = _Выжило + 1;
	КонецЕсли;

	Если Не _Полоса Тогда
		Возврат;
	КонецЕсли;

	Попытка
		_Бар.СделатьШаг(1, 0, Подсказка());
	Исключение
		// рисовать перестало получаться посреди прогона - дальше молча считаем
		ОтключитьПолосу(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Процедура Завершить() Экспорт

	Если _Полоса Тогда

		Попытка
			_Бар.Завершить();
		Исключение
			_Лог.Отладка("Не удалось завершить полосу: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЕсли;

	_Включен = Ложь;
	_Полоса  = Ложь;

КонецПроцедуры

// Текст перед полосой. Шаг, проценты и время полоса покажет сама,
// а вот исход проверенных мутантов знает только этот класс.
Функция Подсказка() Экспорт

	Возврат СтрШаблон("убито %1, выжило %2 ", _Убито, _Выжило);

КонецФункции

Процедура ОтключитьПолосу(Знач Ошибка)

	_Лог.Отладка("Полоса отключена: %1", КраткоеПредставлениеОшибки(Ошибка));

	_Полоса = Ложь;

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин ПрогрессБар,
	&ЛогМутатос Лог) Экспорт

	_Бар     = ПрогрессБар;
	_Лог     = Лог;
	_Включен = Ложь;
	_Полоса  = Ложь;
	_Убито   = 0;
	_Выжило  = 0;

КонецПроцедуры
