#Использовать autumn-logos
#Использовать "../internal"

// Показывает ход проверки мутантов: полоса, счётчик убитых и выживших, прогноз остатка.
//
// Мутационный прогон идёт минутами, а на большом проекте - десятками минут, и всё это
// время снаружи ничего не происходит: тесты гоняются в дочерних процессах, их вывод
// перехвачен. Без полосы прогон неотличим от зависания.
//
// Полоса рисуется сама, без библиотеки: progbar на Linux и macOS падает с
// PlatformNotSupportedException, потому что Консоль.ВидимостьКурсора в OneScript
// читает Console.CursorVisible, а этот геттер существует только на Windows.
//
// Там, где консоли нет - прогон в сборке, вывод перенаправлен в файл - полоса
// заменяется редкими отметками в логе: управляющие последовательности в логе сборки
// хуже, чем их отсутствие.

Перем _Включен;
Перем _Полоса;
Перем _ДлинаПолосы;
Перем _Всего;
Перем _Проверено;
Перем _Отмечено;
Перем _Убито;
Перем _Выжило;
Перем _Начало;
Перем _Лог;

// Начинает показ прогресса для заданного числа мутантов.
Процедура Начать(Знач Всего, Знач Включен = Истина) Экспорт

	_Всего     = Всего;
	_Проверено = 0;
	_Отмечено  = 0;
	_Убито     = 0;
	_Выжило    = 0;
	_Начало    = ТекущаяУниверсальнаяДатаВМиллисекундах();
	_Включен   = Включен И Всего > 0;
	_Полоса    = _Включен И ЕстьКонсоль();
	// длина фиксируется на весь прогон: прыгающая полоса читается хуже неподвижной
	_ДлинаПолосы = Макс(10, ШиринаКонсоли() - 46);

КонецПроцедуры

// Отмечает проверенного мутанта с его исходом.
Процедура Отметить(Знач Состояние) Экспорт

	_Проверено = _Проверено + 1;

	Если СостоянияМутанта.ЭтоУбийство(Состояние) Тогда
		_Убито = _Убито + 1;
	ИначеЕсли Состояние = СостоянияМутанта.Выжил() Тогда
		_Выжило = _Выжило + 1;
	КонецЕсли;

	Если Не _Включен Тогда
		Возврат;
	КонецЕсли;

	Если _Полоса Тогда
		Нарисовать();
	Иначе
		ОтметитьВЛоге();
	КонецЕсли;

КонецПроцедуры

Процедура Завершить() Экспорт

	Если _Полоса Тогда

		Попытка
			// перевод строки после полосы: иначе отчёт напишется поверх неё
			Консоль.ВывестиСтроку("");
		Исключение
			_Лог.Отладка("Не удалось завершить полосу: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЕсли;

	_Включен = Ложь;
	_Полоса  = Ложь;

КонецПроцедуры

Процедура Нарисовать()

	Попытка
		Консоль.Вывести(Символы.ВК + Строка(СтрокаПрогресса()));
	Исключение
		// консоль отвалилась посреди прогона - дальше отмечаемся в логе
		_Лог.Отладка("Полоса отключена: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		_Полоса = Ложь;
	КонецПопытки;

КонецПроцедуры

// Длина полосы постоянна на весь прогон, а строка добивается пробелами до ширины консоли:
// иначе от предыдущей, более длинной строки оставался бы хвост на экране.
Функция СтрокаПрогресса()

	Подпись = СтрШаблон(" %1/%2  убито %3, выжило %4%5",
		_Проверено,
		_Всего,
		_Убито,
		_Выжило,
		ОстатокВремени());

	Заполнено = Цел(_ДлинаПолосы * _Проверено / _Всего);

	Строка = "[" + Повторить("=", Заполнено) + Повторить(".", _ДлинаПолосы - Заполнено) + "]" + Подпись;

	Возврат Строка + Повторить(" ", Макс(0, ШиринаКонсоли() - СтрДлина(Строка)));

КонецФункции

// Прогноз по уже проверенным: мутанты примерно одинаковы по стоимости,
// поэтому среднего времени хватает.
Функция ОстатокВремени()

	Если _Проверено = 0 Или _Проверено = _Всего Тогда
		Возврат "";
	КонецЕсли;

	Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - _Начало;
	Осталось = Окр((_Всего - _Проверено) * Прошло / _Проверено / 1000);

	Если Осталось < 60 Тогда
		Возврат СтрШаблон(", осталось ~%1 с", Осталось);
	КонецЕсли;

	Возврат СтрШаблон(", осталось ~%1 мин", Окр(Осталось / 60));

КонецФункции

// Без консоли полоса не рисуется, но прогон от этого не перестаёт быть долгим:
// в лог уходят редкие отметки - десять на весь прогон.
Процедура ОтметитьВЛоге()

	Доля = Цел(_Проверено * 10 / _Всего);

	Если Доля <= _Отмечено Тогда
		Возврат;
	КонецЕсли;

	_Отмечено = Доля;

	_Лог.Информация("Проверено мутантов: %1 из %2 (убито %3, выжило %4)",
		_Проверено,
		_Всего,
		_Убито,
		_Выжило);

КонецПроцедуры

// Консоль считается доступной, если у процесса есть терминал. Признак - работающий
// опрос клавиатуры: при перенаправленном вводе он выбрасывает исключение.
// Отдельно проверяется признак сборки: там терминал бывает, а место управляющим
// последовательностям в логе - нет.
Функция ЕстьКонсоль()

	Если ЗначениеЗаполнено(ПеременныеСреды().Получить("CI")) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Если Консоль.НажатаКлавиша Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

Функция ШиринаКонсоли()

	Попытка
		Ширина = Консоль.Ширина;
	Исключение
		Ширина = 0;
	КонецПопытки;

	Возврат ?(Ширина > 20, Ширина - 1, 80);

КонецФункции

Функция Повторить(Знач Символ, Знач Количество)

	Результат = "";

	Для Сч = 1 По Количество Цикл
		Результат = Результат + Символ;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Лог("oscript.lib.mutatos") Лог) Экспорт

	_Лог       = Лог;
	_Включен   = Ложь;
	_Полоса    = Ложь;
	_Всего     = 0;
	_Проверено = 0;
	_Отмечено  = 0;
	_Убито     = 0;
	_Выжило    = 0;

КонецПроцедуры
