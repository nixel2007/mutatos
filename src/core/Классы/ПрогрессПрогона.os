#Использовать progbar
#Использовать autumn-logos
#Использовать "../internal"

// Показывает ход проверки мутантов: полоса, счётчик убитых и выживших, прогноз остатка.
//
// Мутационный прогон идёт минутами, а на большом проекте - десятками минут, и всё это
// время снаружи ничего не происходит: тесты гоняются в дочерних процессах, их вывод
// перехвачен. Без полосы прогон неотличим от зависания.
//
// Рисует полосу progbar. Счёт убитых и выживших - забота этого класса, он кладёт его
// в подсказку; шаги, проценты, прошедшее время и прогноз остатка библиотека считает сама.
//
// Там, где консоли нет - прогон в сборке, вывод перенаправлен в файл - полоса
// заменяется редкими отметками в логе: управляющие последовательности в логе сборки
// хуже, чем их отсутствие.

Перем _Включен;
Перем _Полоса;
Перем _Бар;
Перем _Всего;
Перем _Проверено;
Перем _Отмечено;
Перем _Убито;
Перем _Выжило;
Перем _Лог;

// Начинает показ прогресса для заданного числа мутантов.
Процедура Начать(Знач Всего, Знач Включен = Истина) Экспорт

	_Всего     = Всего;
	_Проверено = 0;
	_Отмечено  = 0;
	_Убито     = 0;
	_Выжило    = 0;
	_Включен   = Включен И Всего > 0;
	_Полоса    = _Включен И ЕстьКонсоль();

	Если Не _Полоса Тогда
		Возврат;
	КонецЕсли;

	Попытка
		_Бар = Новый ПрогрессБар();
		_Бар.Начать(Всего, Подсказка());
	Исключение
		ОтключитьПолосу(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Отмечает проверенного мутанта с его исходом.
Процедура Отметить(Знач Состояние) Экспорт

	_Проверено = _Проверено + 1;

	Если СостоянияМутанта.ЭтоУбийство(Состояние) Тогда
		_Убито = _Убито + 1;
	ИначеЕсли Состояние = СостоянияМутанта.Выжил() Тогда
		_Выжило = _Выжило + 1;
	КонецЕсли;

	Если Не _Включен Тогда
		Возврат;
	КонецЕсли;

	Если Не _Полоса Тогда
		ОтметитьВЛоге();
		Возврат;
	КонецЕсли;

	Попытка
		_Бар.СделатьШаг(1, 0, Подсказка());
	Исключение
		// консоль отвалилась посреди прогона - дальше отмечаемся в логе
		ОтключитьПолосу(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Процедура Завершить() Экспорт

	Если _Полоса Тогда

		Попытка
			_Бар.Завершить();
		Исключение
			_Лог.Отладка("Не удалось завершить полосу: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЕсли;

	_Включен = Ложь;
	_Полоса  = Ложь;
	_Бар     = Неопределено;

КонецПроцедуры

// Текст перед полосой. Библиотека сама покажет шаг, проценты и время,
// а вот исход проверенных мутантов знает только вызывающий.
Функция Подсказка() Экспорт

	Возврат СтрШаблон("убито %1, выжило %2 ", _Убито, _Выжило);

КонецФункции

Процедура ОтключитьПолосу(Знач Ошибка)

	_Лог.Отладка("Полоса отключена: %1", КраткоеПредставлениеОшибки(Ошибка));

	_Полоса = Ложь;
	_Бар    = Неопределено;

КонецПроцедуры

// Без консоли полоса не рисуется, но прогон от этого не перестаёт быть долгим:
// в лог уходят редкие отметки - десять на весь прогон.
Процедура ОтметитьВЛоге()

	Доля = Цел(_Проверено * 10 / _Всего);

	Если Доля <= _Отмечено Тогда
		Возврат;
	КонецЕсли;

	_Отмечено = Доля;

	_Лог.Информация("Проверено мутантов: %1 из %2 (убито %3, выжило %4)",
		_Проверено,
		_Всего,
		_Убито,
		_Выжило);

КонецПроцедуры

// Консоль считается доступной, если у процесса есть терминал. Признак - работающий
// опрос клавиатуры: при перенаправленном вводе он выбрасывает исключение.
// Отдельно проверяется признак сборки: там терминал бывает, а место управляющим
// последовательностям в логе - нет. Своя проверка нужна и при живой библиотеке:
// она узнаёт о невозможности вывода, только наткнувшись на неё, а про сборку не знает.
Функция ЕстьКонсоль() Экспорт

	Если ЗначениеЗаполнено(ПеременныеСреды().Получить("CI")) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Если Консоль.НажатаКлавиша Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Лог("oscript.lib.mutatos") Лог) Экспорт

	_Лог       = Лог;
	_Включен   = Ложь;
	_Полоса    = Ложь;
	_Всего     = 0;
	_Проверено = 0;
	_Отмечено  = 0;
	_Убито     = 0;
	_Выжило    = 0;

КонецПроцедуры
