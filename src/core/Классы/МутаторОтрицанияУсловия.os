#Использовать "../internal"

// Выворачивает условие наизнанку: Если <условие> становится Если Не (<условие>).
//
// Мутатор условий подменяет знаки сравнения, но условие не обязано быть сравнением:
// Если Флаг Тогда, Если Не Найдено Тогда, Если Метод() Тогда. Отрицание проверяет
// любое из них: выживший мутант означает, что ветка выбирается наугад -
// тесты одинаково довольны обоими исходами.

Перем _ТипыУсловий;

Функция Имя() Экспорт
	Возврат "ОтрицаниеУсловия";
КонецФункции

Функция ТипыУзлов(Типы) Экспорт

	_ТипыУсловий = Новый Массив();
	_ТипыУсловий.Добавить(Типы.ОператорЕсли);
	_ТипыУсловий.Добавить(Типы.ОператорИначеЕсли);
	_ТипыУсловий.Добавить(Типы.ОператорПока);

	Возврат _ТипыУсловий;

КонецФункции

Функция Мутации(Узел, Контекст) Экспорт

	Мутации = Новый Массив();

	Если Узел.Выражение = Неопределено Тогда
		Возврат Мутации;
	КонецЕсли;

	Мутации.Добавить(Контекст.МутацияУзла(
		Имя(),
		Узел.Выражение,
		СтрШаблон("Не (%1)", СокрЛП(Контекст.ТекстУзла(Узел.Выражение))),
		"условие инвертировано"));

	Возврат Мутации;

КонецФункции

&Мутатор
Процедура ПриСозданииОбъекта()
КонецПроцедуры
