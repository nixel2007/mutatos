#Использовать "../internal"

// Меняет логические операции: И на ИЛИ и обратно.
//
// Выживший мутант означает, что одна из веток условия тестами не различается.

Перем _Замены;

Функция Имя() Экспорт
	Возврат "Логика";
КонецФункции

Функция ТипыУзлов(Типы) Экспорт
	Результат = Новый Массив();
	Результат.Добавить(Типы.ВыражениеБинарное);
	Возврат Результат;
КонецФункции

Функция Мутации(Узел, Контекст) Экспорт

	Мутации = Новый Массив();

	Замена = _Замены.Получить(Узел.Операция.Токен);
	Если Замена = Неопределено Тогда
		Возврат Мутации;
	КонецЕсли;

	// регистр ключевого слова сохраняем как в исходнике, иначе мутант выглядит чужеродно
	ИсходныйТекст = Контекст.ТекстТокена(Узел.Операция);

	Мутации.Добавить(Контекст.МутацияТокена(
		Имя(),
		Узел.Операция,
		Замена,
		СтрШаблон("%1 заменено на %2", ИсходныйТекст, Замена)));

	Возврат Мутации;

КонецФункции

&Мутатор
Процедура ПриСозданииОбъекта(&Пластилин Токены)

	_Замены = Новый Соответствие();
	_Замены.Вставить(Токены.И, "Или");
	_Замены.Вставить(Токены.Или, "И");

КонецПроцедуры
