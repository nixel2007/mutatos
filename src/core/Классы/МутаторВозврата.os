#Использовать "../internal"

// Обнуляет возвращаемое значение функции: Возврат <выражение> становится Возврат Неопределено.
//
// Выживший мутант означает, что тесты вызывают функцию, но не проверяют её результат.

Функция Имя() Экспорт
	Возврат "Возврат";
КонецФункции

Функция ТипыУзлов(Типы) Экспорт
	Результат = Новый Массив();
	Результат.Добавить(Типы.ОператорВозврат);
	Возврат Результат;
КонецФункции

Функция Мутации(Узел, Контекст) Экспорт

	Мутации = Новый Массив();

	// возврат из процедуры значения не имеет, мутировать нечего
	Если Узел.Выражение = Неопределено Тогда
		Возврат Мутации;
	КонецЕсли;

	// уже Возврат Неопределено - мутант был бы неотличим от оригинала
	ИсходныйТекст = СокрЛП(Контекст.ТекстУзла(Узел.Выражение));
	Если НРег(ИсходныйТекст) = "неопределено" Тогда
		Возврат Мутации;
	КонецЕсли;

	Мутации.Добавить(Контекст.МутацияУзла(
		Имя(),
		Узел.Выражение,
		"Неопределено",
		"возвращаемое значение заменено на Неопределено"));

	Возврат Мутации;

КонецФункции

&Мутатор
Процедура ПриСозданииОбъекта()
КонецПроцедуры
