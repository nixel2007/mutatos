// Какие строки каких файлов выполнялись во время прогона тестов.
//
// Мутация в строке, которую тесты не выполняют, не может быть убита - её незачем проверять.
// Такой мутант говорит не о качестве тестов, а об их отсутствии, поэтому в индекс мутаций не входит.

Перем _ПокрытыеСтроки;
Перем _ИзвестныеФайлы;

// Отмечает строку файла как выполненную.
Процедура Отметить(Знач Файл, Знач НомерСтроки) Экспорт

	_ПокрытыеСтроки.Вставить(Ключ(Файл, НомерСтроки), Новый Структура("Файл, НомерСтроки", Файл, НомерСтроки));
	ОтметитьФайл(Файл);

КонецПроцедуры

// Все выполненные строки: массив структур с полями Файл и НомерСтроки.
Функция ПокрытыеСтроки() Экспорт

	Результат = Новый Массив();

	Для Каждого Элемент Из _ПокрытыеСтроки Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Отмечает, что по файлу есть данные о покрытии, даже если ни одна строка не выполнялась.
Процедура ОтметитьФайл(Знач Файл) Экспорт

	_ИзвестныеФайлы.Вставить(НормализованныйПуть(Файл), Истина);

КонецПроцедуры

// Истина, если строка выполнялась во время прогона тестов.
Функция Покрыта(Знач Файл, Знач НомерСтроки) Экспорт

	Возврат _ПокрытыеСтроки.Получить(Ключ(Файл, НомерСтроки)) <> Неопределено;

КонецФункции

// Истина, если по файлу есть данные о покрытии.
//
// Для файла, о котором данных нет, судить о покрытии нельзя: он мог не попасть
// в отчёт из-за настроек прогона. Такие мутанты проверяются обычным способом.
Функция ЕстьДанные(Знач Файл) Экспорт

	Возврат _ИзвестныеФайлы.Получить(НормализованныйПуть(Файл)) <> Неопределено;

КонецФункции

Функция КоличествоПокрытыхСтрок() Экспорт
	Возврат _ПокрытыеСтроки.Количество();
КонецФункции

Функция Ключ(Знач Файл, Знач НомерСтроки)
	Возврат НормализованныйПуть(Файл) + ":" + Формат(НомерСтроки, "ЧГ=0");
КонецФункции

// Пути из отчёта о покрытии и пути мутируемых файлов приходят из разных источников,
// поэтому сравниваются в едином виде.
Функция НормализованныйПуть(Знач Путь)
	Возврат НРег(СтрЗаменить(Путь, "\", "/"));
КонецФункции

Процедура ПриСозданииОбъекта()

	_ПокрытыеСтроки = Новый Соответствие();
	_ИзвестныеФайлы = Новый Соответствие();

КонецПроцедуры
