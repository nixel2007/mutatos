#Использовать "../internal"

// Проверяет мутанта: подменяет файл в проекте мутировавшим кодом, прогоняет тесты
// и возвращает вердикт - заметили тесты мутацию или нет.
//
// Файл всегда восстанавливается после прогона, даже если тесты упали с исключением:
// иначе следующий мутант проверялся бы поверх предыдущего.

Перем _Генератор;
Перем _Запускатель;
Перем _Лог;

// Проверяет одного мутанта.
//
// Параметры:
//   РабочийКаталог - Строка - каталог проекта, в котором запускаются тесты
//   ПутьКФайлу - Строка - полный путь к мутируемому файлу
//   Мутация - ОписаниеМутации - проверяемая мутация
//   Таймаут - Число - предельное время прогона в миллисекундах
//
// Возвращаемое значение:
//   РезультатМутанта
Функция ПроверитьМутанта(Знач РабочийКаталог, Знач ПутьКФайлу, Знач Мутация, Знач Таймаут = 0) Экспорт

	Оригинал = ПрочитатьФайл(ПутьКФайлу);
	Мутант = _Генератор.СоздатьМутанта(Оригинал, Мутация);

	ЗаписатьФайл(ПутьКФайлу, Мутант);

	Попытка
		Прогон = _Запускатель.Прогнать(РабочийКаталог, Таймаут);
	Исключение
		ЗаписатьФайл(ПутьКФайлу, Оригинал);
		ВызватьИсключение;
	КонецПопытки;

	ЗаписатьФайл(ПутьКФайлу, Оригинал);

	Возврат Новый РезультатМутанта(
		Мутация,
		ПутьКФайлу,
		СостояниеПоПрогону(Прогон),
		Прогон.Длительность(),
		Прогон.Вывод());

КонецФункции

Функция СостояниеПоПрогону(Прогон)

	Если Прогон.Таймаут() Тогда
		Возврат СостоянияМутанта.Таймаут();
	ИначеЕсли Прогон.КодВозврата() < 0 Тогда
		Возврат СостоянияМутанта.Ошибка();
	ИначеЕсли Прогон.Успешно() Тогда
		Возврат СостоянияМутанта.Выжил();
	Иначе
		Возврат СостоянияМутанта.Убит();
	КонецЕсли;

КонецФункции

Функция ПрочитатьФайл(Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

Процедура ЗаписатьФайл(Знач Путь, Знач Текст)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин ГенераторМутантов,
	&Пластилин ЗапускательТестов,
	&Лог("oscript.lib.mutatos") Лог) Экспорт

	_Генератор   = ГенераторМутантов;
	_Запускатель = ЗапускательТестов;
	_Лог         = Лог;

КонецПроцедуры
