#Использовать 1commands
#Использовать fs
#Использовать autumn-logos
#Использовать "../internal"

// Проверяет мутантов: раскладывает их по рабочим копиям проекта и прогоняет тесты.
//
// Прогоны идут параллельно, по числу копий: каждый мутант - это отдельный процесс,
// который почти всё время тратит на старт движка и компиляцию, поэтому на многоядерной
// машине последовательный прогон простаивает.
//
// Оригинальные исходники не мутируются вовсе: мутант пишется в рабочую копию.
// Прерванный прогон поэтому не оставляет проект в изменённом состоянии.

Перем _Генератор;
Перем _Прогресс;
Перем _Копии;
Перем _Пул;
Перем _Процессы;
// Предел времени для мутантов, у которых нет своего: заданий без отбора тестов
Перем _Таймаут;
Перем _Лог;

// Проверяет мутантов, распределяя их по рабочим копиям проекта.
//
// Параметры:
//   РабочийКаталог - Строка - каталог проекта
//   Задания - Массив - структуры с полями Файл (полный путь), Мутация (ОписаниеМутации)
//             и, необязательно, Наборы (пути к покрывающим строку наборам тестов)
//   Таймаут - Число - предельное время прогона одного мутанта в миллисекундах
//   КаталогЯдра - Строка - каталог ядра OneUnit, пустая строка - ядро по умолчанию
//   Параметры - ПараметрыПрогона - число потоков и отбор тестов, Неопределено - умолчания
//
// Возвращаемое значение:
//   Массив из РезультатМутанта
Функция ПроверитьМутантов(Знач РабочийКаталог, Знач Задания, Знач Таймаут = 0, Знач КаталогЯдра = "",
	Знач Параметры = Неопределено) Экспорт

	Результаты = Новый Массив();

	Если Задания.Количество() = 0 Тогда
		Возврат Результаты;
	КонецЕсли;

	Если Параметры = Неопределено Тогда
		Параметры = Новый ПараметрыПрогона();
	КонецЕсли;

	Копии = _Копии.СоздатьКопии(
		РабочийКаталог,
		Мин(_Копии.ЧислоПотоков(Параметры.ЧислоПотоков), Задания.Количество()),
		КаталогЯдра,
		Параметры.Фильтры,
		Истина);

	_Прогресс.Начать(Задания.Количество(), Параметры.ПоказыватьПрогресс);

	_Таймаут = Таймаут;

	Попытка
		Результаты = _Пул.Прогнать(Копии, ПоГруппамНаборов(Задания), ЭтотОбъект);
	Исключение
		_Прогресс.Завершить();
		_Копии.УдалитьКопии(Копии);
		ВызватьИсключение;
	КонецПопытки;

	_Прогресс.Завершить();
	_Копии.УдалитьКопии(Копии);

	Возврат Результаты;

КонецФункции

// Задания одной группы проверяются одними и теми же тестами. Группировка нужна, чтобы
// точка входа копии пересобиралась раз на группу, а не на каждого мутанта.
Функция ПоГруппамНаборов(Знач Задания)

	Группы = Новый Соответствие();
	Порядок = Новый Массив();

	Для Каждого Задание Из Задания Цикл

		Ключ = КлючГруппы(Задание);
		Группа = Группы.Получить(Ключ);

		Если Группа = Неопределено Тогда
			Группа = Новый Массив();
			Группы.Вставить(Ключ, Группа);
			Порядок.Добавить(Группа);
		КонецЕсли;

		Группа.Добавить(Задание);

	КонецЦикла;

	Результат = Новый Массив();

	Для Каждого Группа Из Порядок Цикл
		Для Каждого Задание Из Группа Цикл
			Результат.Добавить(Задание);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КлючГруппы(Задание)

	Ключи = Новый Массив();

	Для Каждого Тест Из ТестыЗадания(Задание) Цикл
		Ключи.Добавить(Тест.Набор + "#" + Тест.Метод);
	КонецЦикла;

	Возврат СтрСоединить(Ключи, Символы.ПС);

КонецФункции

Функция ТестыЗадания(Задание)

	Если Не Задание.Свойство("Тесты") Или Задание.Тесты = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Возврат Задание.Тесты;

КонецФункции

// Запускает мутанта в копии. Вызывается пулом прогонов.
Функция Запустить(Копия, Задание) Экспорт

	Отбор = ОтборВКопии(Копия, ТестыЗадания(Задание));

	Копия.ПерестроитьТочкуВхода(Отбор.Наборы, Отбор.Методы);

	// Исходник читается из оригинала, а не из копии: копия переиспользуется под следующего
	// мутанта, и чтение из неё накладывало бы мутации друг на друга
	Оригинал = ПрочитатьФайл(Задание.Файл);

	Копия.ПоместитьМутанта(Задание.Файл, _Генератор.СоздатьМутанта(Оригинал, Задание.Мутация));

	Возврат _Процессы.Запустить(
		СтрШаблон("oscript ""%1""", Копия.ТочкаВхода()),
		Копия.Каталог());

КонецФункции

// Переводит отобранные тесты в отбор точки входа копии: файлы наборов и имена методов.
//
// Имя метода отбирает во всех отобранных наборах сразу - OneUnit не умеет привязать
// метод к набору. Отбор получается шире выбранного: если в двух наборах есть тест
// с одинаковым именем, а нужен один, прогонятся оба. Лишний тест только замедляет,
// поэтому расширять отбор можно, а сужать нельзя.
//
// Набор без метода означает «весь набор целиком», и тогда методы не отбираются вовсе:
// иначе имена от соседей по группе обрезали бы его до нескольких тестов.
Функция ОтборВКопии(Копия, Знач Тесты)

	Наборы = Новый Массив();
	Методы = Новый Массив();

	Известные = Новый Соответствие();
	ЦеликомНабор = Ложь;

	Для Каждого Тест Из Тесты Цикл

		НаборВКопии = Копия.ПутьВКопии(Тест.Набор);

		Если Известные.Получить(НаборВКопии) = Неопределено Тогда
			Известные.Вставить(НаборВКопии, Истина);
			Наборы.Добавить(НаборВКопии);
		КонецЕсли;

		Если ПустаяСтрока(Тест.Метод) Тогда
			ЦеликомНабор = Истина;
			Продолжить;
		КонецЕсли;

		Если Известные.Получить("#" + Тест.Метод) = Неопределено Тогда
			Известные.Вставить("#" + Тест.Метод, Истина);
			Методы.Добавить(Тест.Метод);
		КонецЕсли;

	КонецЦикла;

	Возврат Новый Структура("Наборы, Методы",
		Наборы,
		?(ЦеликомНабор, Новый Массив(), Методы));

КонецФункции

// Предел времени для мутанта. Вызывается пулом прогонов.
//
// У каждого мутанта он свой: мутант с отбором гоняет не все тесты проекта, а несколько
// наборов, и мерить его терпение полным прогоном значит ждать впустую. На collectionos
// зациклившиеся мутанты досиживали до общего таймаута и съедали больше трети прогона.
Функция Таймаут(Задание) Экспорт

	Если Задание.Свойство("Таймаут") И Задание.Таймаут > 0 Тогда
		Возврат Задание.Таймаут;
	КонецЕсли;

	Возврат _Таймаут;

КонецФункции

// Прогон мутанта завершился. Вызывается пулом прогонов.
Функция Завершено(Задание, Знач КодВозврата, Знач Длительность, Знач Вывод) Экспорт

	Возврат Результат(Задание, СостояниеПоКоду(КодВозврата), Длительность, Вывод);

КонецФункции

// Прогон мутанта не уложился в таймаут. Вызывается пулом прогонов.
//
// Мутация могла зациклить выполнение - такой мутант считается замеченным.
Функция Прервано(Задание, Знач Длительность, Знач Вывод) Экспорт

	Возврат Результат(Задание, СостоянияМутанта.Таймаут(), Длительность, Вывод);

КонецФункции

Функция Результат(Задание, Состояние, Длительность, Знач Вывод)

	_Лог.Отладка("[%1] %2: %3", Состояние, Задание.Мутация.НомерСтроки(), Задание.Мутация.Описание());

	_Прогресс.Отметить(Состояние);

	Возврат Новый РезультатМутанта(Задание.Мутация, Задание.Файл, Состояние, Длительность, Вывод);

КонецФункции

Функция СостояниеПоКоду(Знач КодВозврата)

	Возврат ?(КодВозврата = 0, СостоянияМутанта.Выжил(), СостоянияМутанта.Убит());

КонецФункции

Функция ПрочитатьФайл(Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

Процедура ЗаписатьФайл(Знач Путь, Знач Текст)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин ГенераторМутантов,
	&Пластилин ПрогрессПрогона,
	&Пластилин ФабрикаКопий,
	&Пластилин ПулПрогонов,
	&Пластилин ЗапускательПроцессов,
	&ЛогМутатос Лог) Экспорт

	_Генератор = ГенераторМутантов;
	_Прогресс  = ПрогрессПрогона;
	_Копии     = ФабрикаКопий;
	_Пул       = ПулПрогонов;
	_Процессы  = ЗапускательПроцессов;
	_Лог       = Лог;

КонецПроцедуры
