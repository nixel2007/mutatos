#Использовать 1commands
#Использовать fs
#Использовать autumn-logos
#Использовать "../internal"

// Проверяет мутантов: раскладывает их по рабочим копиям проекта и прогоняет тесты.
//
// Прогоны идут параллельно, по числу копий: каждый мутант - это отдельный процесс,
// который почти всё время тратит на старт движка и компиляцию, поэтому на многоядерной
// машине последовательный прогон простаивает.
//
// Оригинальные исходники не мутируются вовсе: мутант пишется в рабочую копию.
// Прерванный прогон поэтому не оставляет проект в изменённом состоянии.

Перем _Генератор;
Перем _ЧислоПотоков;
Перем _КаталогиТестов;
Перем _ИсключаемыеКаталоги;
Перем _Лог;

// Проверяет мутантов, распределяя их по рабочим копиям проекта.
//
// Параметры:
//   РабочийКаталог - Строка - каталог проекта
//   Задания - Массив - структуры с полями Файл (полный путь) и Мутация (ОписаниеМутации)
//   Таймаут - Число - предельное время прогона одного мутанта в миллисекундах
//   КаталогЯдра - Строка - каталог ядра OneUnit, пустая строка - ядро по умолчанию
//
// Возвращаемое значение:
//   Массив из РезультатМутанта
Функция ПроверитьМутантов(Знач РабочийКаталог, Знач Задания, Знач Таймаут = 0, Знач КаталогЯдра = "", Знач ЧислоПотоков = 0) Экспорт

	Результаты = Новый Массив();

	Если Задания.Количество() = 0 Тогда
		Возврат Результаты;
	КонецЕсли;

	Копии = СоздатьКопии(РабочийКаталог, Мин(ЧислоПотоков(ЧислоПотоков), Задания.Количество()), КаталогЯдра);

	Попытка
		Результаты = Прогнать(Копии, Задания, Таймаут);
	Исключение
		УдалитьКопии(Копии);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьКопии(Копии);

	Возврат Результаты;

КонецФункции

Функция Прогнать(Копии, Задания, Таймаут)

	Результаты = Новый Массив();
	Активные = Новый Соответствие();

	СледующееЗадание = 0;

	Пока СледующееЗадание < Задания.Количество() Или Активные.Количество() > 0 Цикл

		СледующееЗадание = ЗапуститьСвободные(Копии, Задания, СледующееЗадание, Активные, Таймаут);

		ЧтоТоЗавершилось = СобратьЗавершенные(Активные, Результаты, Таймаут);

		Если Не ЧтоТоЗавершилось И Активные.Количество() > 0 Тогда
			Приостановить(20);
		КонецЕсли;

	КонецЦикла;

	Возврат Результаты;

КонецФункции

Функция ЗапуститьСвободные(Копии, Задания, Знач СледующееЗадание, Активные, Таймаут)

	Для Каждого Копия Из Копии Цикл

		Если СледующееЗадание >= Задания.Количество() Тогда
			Прервать;
		КонецЕсли;

		Если Активные.Получить(Копия) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Активные.Вставить(Копия, ЗапуститьМутанта(Копия, Задания[СледующееЗадание]));
		СледующееЗадание = СледующееЗадание + 1;

	КонецЦикла;

	Возврат СледующееЗадание;

КонецФункции

Функция ЗапуститьМутанта(Копия, Задание)

	// Исходник читается из оригинала, а не из копии: копия переиспользуется под следующего
	// мутанта, и чтение из неё накладывало бы мутации друг на друга
	Оригинал = ПрочитатьФайл(Задание.Файл);

	ЗаписатьФайл(Копия.ПутьВКопии(Задание.Файл), _Генератор.СоздатьМутанта(Оригинал, Задание.Мутация));

	Команда = Новый Команда();
	Команда.УстановитьКоманду("oscript");
	Команда.УстановитьРабочийКаталог(Копия.Каталог());
	Команда.ПерехватыватьПотоки(Истина);
	Команда.ПоказыватьВыводНемедленно(Ложь);
	Команда.ДобавитьПараметр(Копия.ТочкаВхода());

	Возврат Новый Структура("Процесс, Задание, Начало",
		Команда.ЗапуститьПроцесс(),
		Задание,
		ТекущаяУниверсальнаяДатаВМиллисекундах());

КонецФункции

Функция СобратьЗавершенные(Активные, Результаты, Таймаут)

	Завершенные = Новый Массив();

	Для Каждого Элемент Из Активные Цикл

		Прогон = Элемент.Значение;
		Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Прогон.Начало;

		Если Прогон.Процесс.Завершен Тогда
			Результаты.Добавить(Результат(Прогон.Задание, СостояниеПоКоду(Прогон.Процесс.КодВозврата), Длительность));
			Завершенные.Добавить(Элемент.Ключ);
		ИначеЕсли Таймаут > 0 И Длительность > Таймаут Тогда
			// мутация могла зациклить выполнение - такой мутант считается замеченным
			Прогон.Процесс.Завершить();
			Результаты.Добавить(Результат(Прогон.Задание, СостоянияМутанта.Таймаут(), Длительность));
			Завершенные.Добавить(Элемент.Ключ);
		КонецЕсли;

	КонецЦикла;

	Для Каждого Копия Из Завершенные Цикл
		Активные.Удалить(Копия);
	КонецЦикла;

	Возврат Завершенные.Количество() > 0;

КонецФункции

Функция Результат(Задание, Состояние, Длительность)

	_Лог.Отладка("[%1] %2: %3", Состояние, Задание.Мутация.НомерСтроки(), Задание.Мутация.Описание());

	Возврат Новый РезультатМутанта(Задание.Мутация, Задание.Файл, Состояние, Длительность);

КонецФункции

Функция СостояниеПоКоду(Знач КодВозврата)

	Возврат ?(КодВозврата = 0, СостоянияМутанта.Выжил(), СостоянияМутанта.Убит());

КонецФункции

// Явно заданное значение перевешивает настройку, ноль означает "по числу процессоров".
Функция ЧислоПотоков(Знач ЧислоПотоков)

	Если ЧислоПотоков > 0 Тогда
		Возврат ЧислоПотоков;
	КонецЕсли;

	Возврат _ЧислоПотоков;

КонецФункции

Функция СоздатьКопии(РабочийКаталог, Знач Количество, КаталогЯдра)

	_Лог.Информация("Рабочих копий проекта: %1", Количество);

	Копии = Новый Массив();

	Для Сч = 1 По Количество Цикл
		Копии.Добавить(Новый РабочаяКопия(
			РабочийКаталог,
			АбсолютныеКаталогиТестов(РабочийКаталог),
			_ИсключаемыеКаталоги,
			КаталогЯдра,
			_Лог));
	КонецЦикла;

	Возврат Копии;

КонецФункции

Процедура УдалитьКопии(Копии)

	Для Каждого Копия Из Копии Цикл
		Копия.Удалить();
	КонецЦикла;

КонецПроцедуры

Функция АбсолютныеКаталогиТестов(РабочийКаталог)

	Результат = Новый Массив();

	Для Каждого КаталогТестов Из _КаталогиТестов Цикл
		Результат.Добавить(ФС.НормализоватьПуть(ОбъединитьПути(РабочийКаталог, КаталогТестов)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПрочитатьФайл(Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

Процедура ЗаписатьФайл(Знач Путь, Знач Текст)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин ГенераторМутантов,
	&Деталька("mutatos.ЧислоПотоков", ЗначениеПоУмолчанию = 0) ЧислоПотоков,
	&Деталька("mutatos.КаталогиТестов", ЗначениеПоУмолчанию = "tests") КаталогиТестов,
	&Деталька("mutatos.ИсключаемыеКаталоги", ЗначениеПоУмолчанию = "oscript_modules,.git,out") Исключения,
	&Лог("oscript.lib.mutatos") Лог) Экспорт

	_Генератор = ГенераторМутантов;
	_Лог       = Лог;

	_ЧислоПотоков = ?(ЧислоПотоков > 0, ЧислоПотоков, Новый СистемнаяИнформация().КоличествоПроцессоров);
	_КаталогиТестов = СтрРазделить(КаталогиТестов, ",", Ложь);

	_ИсключаемыеКаталоги = Новый Массив();
	Для Каждого ИсключаемыйКаталог Из СтрРазделить(Исключения, ",", Ложь) Цикл
		_ИсключаемыеКаталоги.Добавить(НРег(СокрЛП(ИсключаемыйКаталог)));
	КонецЦикла;

КонецПроцедуры
