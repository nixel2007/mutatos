#Использовать fs
#Использовать "../internal"

// Записывает итог прогона в самодостаточную HTML-страницу.
//
// Смысл отчёта - показать мутанта на его месте в коде: список строк и описаний
// заставляет держать исходник в голове, а страница показывает исходный текст
// с мутациями под теми строками, где они появились.
//
// Стили и разметка встроены в файл: отчёт можно приложить к сборке или отправить
// письмом, ничего не потеряв по дороге.

Перем _Состояния;

Функция Имя() Экспорт
	Возврат "html";
КонецФункции

Процедура Сформировать(Знач Отчет, Знач Назначение = "") Экспорт

	Если ПустаяСтрока(Назначение) Тогда
		ВызватьИсключение "Для отчёта в формате html нужно указать путь к файлу";
	КонецЕсли;

	ФС.ОбеспечитьКаталог(Новый Файл(Назначение).Путь);

	Запись = Новый ЗаписьТекста(Назначение, КодировкаТекста.UTF8БезBOM);
	Запись.Записать(Страница(Отчет));
	Запись.Закрыть();

КонецПроцедуры

Функция Страница(Отчет)

	Файлы = ГруппыПоФайлам(Отчет);

	Строки = Новый Массив();
	Строки.Добавить("<!DOCTYPE html>");
	Строки.Добавить("<html lang=""ru"">");
	Строки.Добавить("<head>");
	Строки.Добавить("<meta charset=""utf-8"">");
	Строки.Добавить("<title>Мутационное тестирование</title>");
	Строки.Добавить(Стили());
	Строки.Добавить("</head>");
	Строки.Добавить("<body>");
	Строки.Добавить("<h1>Мутационное тестирование</h1>");
	Строки.Добавить(Сводка(Отчет));
	Строки.Добавить(ТаблицаФайлов(Файлы));

	Для Каждого Группа Из Файлы Цикл
		Строки.Добавить(РазделФайла(Группа));
	КонецЦикла;

	Строки.Добавить(Подвал());
	Строки.Добавить("</body>");
	Строки.Добавить("</html>");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция Сводка(Отчет)

	Строки = Новый Массив();
	Строки.Добавить("<div class=""summary"">");
	Строки.Добавить(Показатель("Индекс мутаций", СтрШаблон("%1%%", Отчет.ИндексМутаций()), КлассИндекса(Отчет)));
	Строки.Добавить(Показатель("Проверено", Отчет.ВсегоМутантов(), ""));
	Строки.Добавить(Показатель("Убито", Отчет.Убито(), "killed"));
	Строки.Добавить(Показатель("Выжило", Отчет.Выжило(), "survived"));

	Если Отчет.БезПокрытия() > 0 Тогда
		Строки.Добавить(Показатель("Без покрытия", Отчет.БезПокрытия(), "nocover"));
	КонецЕсли;

	Если Отчет.Ошибок() > 0 Тогда
		Строки.Добавить(Показатель("Ошибок", Отчет.Ошибок(), "error"));
	КонецЕсли;

	Строки.Добавить("</div>");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция Показатель(Знач Заголовок, Знач Значение, Знач Класс)

	Возврат СтрШаблон("<div class=""metric %3""><div class=""value"">%2</div><div class=""caption"">%1</div></div>",
		Экранировать(Заголовок),
		Экранировать(Строка(Значение)),
		Класс);

КонецФункции

// Красный индекс мутаций привлекает внимание сильнее любой цифры,
// поэтому цвет сводки задаётся по нему же.
Функция КлассИндекса(Отчет)

	Если Отчет.ИндексМутаций() >= 80 Тогда
		Возврат "killed";
	ИначеЕсли Отчет.ИндексМутаций() >= 50 Тогда
		Возврат "partial";
	КонецЕсли;

	Возврат "survived";

КонецФункции

Функция ТаблицаФайлов(Файлы)

	Строки = Новый Массив();
	Строки.Добавить("<table class=""files"">");
	Строки.Добавить("<tr><th>Файл</th><th>Индекс</th><th>Убито</th><th>Выжило</th><th>Без покрытия</th></tr>");

	Для Каждого Группа Из Файлы Цикл

		Строки.Добавить(СтрШаблон(
			"<tr><td><a href=""#%1"">%2</a></td><td class=""%3"">%4%%</td><td>%5</td><td>%6</td><td>%7</td></tr>",
			Группа.Якорь,
			Экранировать(Группа.Имя),
			КлассДоли(Группа.Индекс),
			Группа.Индекс,
			Группа.Убито,
			Группа.Выжило,
			Группа.БезПокрытия));

	КонецЦикла;

	Строки.Добавить("</table>");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция КлассДоли(Знач Индекс)

	Если Индекс >= 80 Тогда
		Возврат "killed";
	ИначеЕсли Индекс >= 50 Тогда
		Возврат "partial";
	КонецЕсли;

	Возврат "survived";

КонецФункции

Функция РазделФайла(Группа)

	Строки = Новый Массив();
	Строки.Добавить(СтрШаблон("<h2 id=""%1"">%2</h2>", Группа.Якорь, Экранировать(Группа.Имя)));

	ИсходныйТекст = ПрочитатьИсходник(Группа.Файл);

	Если ИсходныйТекст = Неопределено Тогда
		// исходник мог быть удалён или переименован после прогона -
		// тогда остаётся только список мутантов
		Строки.Добавить("<p class=""missing"">Исходный файл недоступен, показаны только мутанты.</p>");
		Строки.Добавить(СписокМутантов(Группа.Мутанты));
	Иначе
		Строки.Добавить(Исходник(ИсходныйТекст, Группа.Мутанты));
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Исходник целиком: строки с мутациями подсвечены, сами мутации показаны под строкой.
Функция Исходник(Знач ИсходныйТекст, Мутанты)

	ПоСтрокам = МутантыПоСтрокам(Мутанты);

	Строки = Новый Массив();
	Строки.Добавить("<table class=""source"">");

	НомерСтроки = 0;

	Для Каждого СтрокаИсходника Из СтрРазделить(ИсходныйТекст, Символы.ПС, Истина) Цикл

		НомерСтроки = НомерСтроки + 1;
		МутантыСтроки = ПоСтрокам.Получить(НомерСтроки);

		Строки.Добавить(СтрШаблон("<tr class=""%1""><td class=""num"">%2</td><td class=""code"">%3</td></tr>",
			?(МутантыСтроки = Неопределено, "", КлассСтроки(МутантыСтроки)),
			НомерСтроки,
			Экранировать(СтрЗаменить(СтрокаИсходника, Символы.Таб, "    "))));

		Если МутантыСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Мутант Из МутантыСтроки Цикл
			Строки.Добавить(СтрШаблон("<tr class=""mutation""><td class=""num""></td><td>%1</td></tr>",
				ОписаниеМутанта(Мутант)));
		КонецЦикла;

	КонецЦикла;

	Строки.Добавить("</table>");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция СписокМутантов(Мутанты)

	Строки = Новый Массив();
	Строки.Добавить("<table class=""source"">");

	Для Каждого Мутант Из Мутанты Цикл
		Строки.Добавить(СтрШаблон("<tr class=""mutation""><td class=""num"">%1</td><td>%2</td></tr>",
			Мутант.Мутация().НомерСтроки(),
			ОписаниеМутанта(Мутант)));
	КонецЦикла;

	Строки.Добавить("</table>");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ОписаниеМутанта(Мутант)

	Мутация = Мутант.Мутация();

	Возврат СтрШаблон("<span class=""badge %1"">%2</span> %3 <span class=""mutator"">%4</span>%5",
		КлассСостояния(Мутант.Состояние()),
		Экранировать(Мутант.Состояние()),
		Экранировать(Мутация.Описание()),
		Экранировать(Мутация.Мутатор()),
		МестоМутации(Мутация));

КонецФункции

Функция МестоМутации(Мутация)

	Если ПустаяСтрока(Мутация.ИмяМетода()) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон(" <span class=""method"">%1</span>", Экранировать(Мутация.ИмяМетода()));

КонецФункции

// Строку красит худший её мутант: одного выжившего достаточно, чтобы строка требовала внимания.
Функция КлассСтроки(Мутанты)

	Худший = "";

	Для Каждого Мутант Из Мутанты Цикл
		Если Худший = "" Или Вес(Мутант.Состояние()) > Вес(Худший) Тогда
			Худший = Мутант.Состояние();
		КонецЕсли;
	КонецЦикла;

	Возврат КлассСостояния(Худший);

КонецФункции

Функция Вес(Знач Состояние)

	Описание = _Состояния.Получить(Состояние);

	Возврат ?(Описание = Неопределено, 0, Описание.Вес);

КонецФункции

Функция КлассСостояния(Знач Состояние)

	Описание = _Состояния.Получить(Состояние);

	Возврат ?(Описание = Неопределено, "", Описание.Класс);

КонецФункции

Функция МутантыПоСтрокам(Мутанты)

	Результат = Новый Соответствие();

	Для Каждого Мутант Из Мутанты Цикл

		Номер = Мутант.Мутация().НомерСтроки();
		СтрокаМутантов = Результат.Получить(Номер);

		Если СтрокаМутантов = Неопределено Тогда
			СтрокаМутантов = Новый Массив();
			Результат.Вставить(Номер, СтрокаМутантов);
		КонецЕсли;

		СтрокаМутантов.Добавить(Мутант);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Мутанты, разложенные по файлам в порядке первого появления, со сводкой по каждому файлу.
Функция ГруппыПоФайлам(Отчет)

	Группы = Новый Массив();
	Индекс = Новый Соответствие();

	Для Каждого Мутант Из Отчет.Результаты() Цикл

		Группа = Индекс.Получить(Мутант.Файл());

		Если Группа = Неопределено Тогда
			Группа = НоваяГруппа(Мутант.Файл(), Группы.Количество() + 1);
			Индекс.Вставить(Мутант.Файл(), Группа);
			Группы.Добавить(Группа);
		КонецЕсли;

		Группа.Мутанты.Добавить(Мутант);
		ПосчитатьМутанта(Группа, Мутант);

	КонецЦикла;

	ОбщийКаталог = ИсходникиОтчета.ОбщийКаталог(ПутиФайлов(Группы));

	Для Каждого Группа Из Группы Цикл
		Группа.Индекс = Доля(Группа);
		Группа.Имя = ИсходникиОтчета.ОтносительныйПуть(Группа.Файл, ОбщийКаталог);
	КонецЦикла;

	Возврат Группы;

КонецФункции

Функция ПутиФайлов(Группы)

	Пути = Новый Массив();

	Для Каждого Группа Из Группы Цикл
		Пути.Добавить(Группа.Файл);
	КонецЦикла;

	Возврат Пути;

КонецФункции

// Якорь строится по номеру, а не по пути: пути в проектах на русском состоят
// из символов, которых в идентификаторе HTML быть не должно.
Функция НоваяГруппа(Знач Файл, Знач Номер)

	Группа = Новый Структура();
	Группа.Вставить("Файл", Файл);
	Группа.Вставить("Имя", Файл);
	Группа.Вставить("Якорь", "f" + Формат(Номер, "ЧГ=0"));
	Группа.Вставить("Мутанты", Новый Массив());
	Группа.Вставить("Убито", 0);
	Группа.Вставить("Выжило", 0);
	Группа.Вставить("БезПокрытия", 0);
	Группа.Вставить("Индекс", 0);

	Возврат Группа;

КонецФункции

Процедура ПосчитатьМутанта(Группа, Мутант)

	Если Мутант.Состояние() = СостоянияМутанта.БезПокрытия() Тогда
		Группа.БезПокрытия = Группа.БезПокрытия + 1;
	ИначеЕсли СостоянияМутанта.ЭтоУбийство(Мутант.Состояние()) Тогда
		Группа.Убито = Группа.Убито + 1;
	ИначеЕсли Мутант.Состояние() = СостоянияМутанта.Выжил() Тогда
		Группа.Выжило = Группа.Выжило + 1;
	КонецЕсли;

КонецПроцедуры

Функция Доля(Группа)

	Проверено = Группа.Убито + Группа.Выжило;

	Возврат ?(Проверено = 0, 0, Окр(Группа.Убито * 100 / Проверено, 1));

КонецФункции

Функция ПрочитатьИсходник(Знач Путь)

	Текст = ИсходникиОтчета.ПрочитатьИсходник(Путь);

	Возврат ?(Текст = Неопределено, Неопределено, СтрЗаменить(Текст, Символы.ВК, ""));

КонецФункции

Функция Экранировать(Знач Текст)

	Результат = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");

	Возврат Результат;

КонецФункции

Функция Подвал()

	Возврат СтрШаблон("<p class=""footer"">mutatos, %1</p>",
		Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm'"));

КонецФункции

Функция Стили()

	Возврат "<style>
	|body { font-family: system-ui, -apple-system, ""Segoe UI"", sans-serif; margin: 0 auto; padding: 24px;
	|	max-width: 1100px; color: #1c1e21; background: #fff; }
	|h1 { font-size: 22px; margin: 0 0 20px; }
	|h2 { font-size: 15px; margin: 32px 0 8px; font-family: ui-monospace, ""Cascadia Code"", Consolas, monospace;
	|	font-weight: 600; word-break: break-all; }
	|.summary { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 24px; }
	|.metric { border: 1px solid #dcdfe3; border-radius: 8px; padding: 10px 16px; min-width: 96px; }
	|.metric .value { font-size: 22px; font-weight: 600; }
	|.metric .caption { font-size: 12px; color: #6a707a; margin-top: 2px; }
	|.metric.killed .value { color: #1a7f37; }
	|.metric.survived .value { color: #c0392b; }
	|.metric.partial .value { color: #b26a00; }
	|.metric.nocover .value { color: #6a707a; }
	|.metric.error .value { color: #b26a00; }
	|table.files { border-collapse: collapse; width: 100%; font-size: 14px; }
	|table.files th, table.files td { border-bottom: 1px solid #e6e8eb; padding: 6px 10px; text-align: right; }
	|table.files th:first-child, table.files td:first-child { text-align: left; word-break: break-all; }
	|table.files th { font-size: 12px; color: #6a707a; font-weight: 600; }
	|table.files td.killed { color: #1a7f37; }
	|table.files td.survived { color: #c0392b; }
	|table.files td.partial { color: #b26a00; }
	|table.source { border-collapse: collapse; width: 100%; font-size: 13px;
	|	font-family: ui-monospace, ""Cascadia Code"", Consolas, monospace; }
	|table.source td { padding: 1px 8px; vertical-align: top; }
	|table.source td.num { text-align: right; color: #9aa0a6; width: 1%; white-space: nowrap;
	|	user-select: none; border-right: 1px solid #e6e8eb; }
	|table.source td.code { white-space: pre-wrap; }
	|table.source tr.killed { background: #e7f5ea; }
	|table.source tr.survived { background: #fdeaea; }
	|table.source tr.nocover { background: #f1f2f4; }
	|table.source tr.error { background: #fdf3e3; }
	|table.source tr.mutation td { font-size: 12px; padding-bottom: 3px; }
	|.badge { display: inline-block; border-radius: 4px; padding: 0 6px; font-size: 11px; font-weight: 600;
	|	color: #fff; }
	|.badge.killed { background: #1a7f37; }
	|.badge.survived { background: #c0392b; }
	|.badge.nocover { background: #6a707a; }
	|.badge.error { background: #b26a00; }
	|.mutator { color: #6a707a; }
	|.method { color: #6a707a; }
	|.missing { color: #6a707a; font-size: 14px; }
	|.footer { color: #9aa0a6; font-size: 12px; margin-top: 32px; }
	|a { color: #0b5cd5; text-decoration: none; }
	|a:hover { text-decoration: underline; }
	|</style>";

КонецФункции

&Репортер
Процедура ПриСозданииОбъекта()

	_Состояния = Новый Соответствие();
	_Состояния.Вставить(СостоянияМутанта.Убит(),        Новый Структура("Класс, Вес", "killed", 1));
	_Состояния.Вставить(СостоянияМутанта.Таймаут(),     Новый Структура("Класс, Вес", "killed", 1));
	_Состояния.Вставить(СостоянияМутанта.Ошибка(),      Новый Структура("Класс, Вес", "error", 2));
	_Состояния.Вставить(СостоянияМутанта.БезПокрытия(), Новый Структура("Класс, Вес", "nocover", 3));
	_Состояния.Вставить(СостоянияМутанта.Выжил(),       Новый Структура("Класс, Вес", "survived", 4));

КонецПроцедуры
