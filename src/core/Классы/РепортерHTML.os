#Использовать fs
#Использовать "../internal"

// Записывает итог прогона в самодостаточную HTML-страницу.
//
// Смысл отчёта - показать мутанта на его месте в коде: список строк и описаний
// заставляет держать исходник в голове, а страница показывает исходный текст
// с мутациями под теми строками, где они появились.
//
// Стили и разметка встроены в файл: отчёт можно приложить к сборке или отправить
// письмом, ничего не потеряв по дороге.

Перем _Состояния;

Функция Имя() Экспорт
	Возврат "html";
КонецФункции

Процедура Сформировать(Знач Отчет, Знач Назначение = "") Экспорт

	Если ПустаяСтрока(Назначение) Тогда
		ВызватьИсключение "Для отчёта в формате html нужно указать путь к файлу";
	КонецЕсли;

	ИсходникиОтчета.ОбеспечитьКаталогФайла(Назначение);

	Запись = Новый ЗаписьТекста(Назначение, КодировкаТекста.UTF8БезBOM);
	Запись.Записать(Страница(Отчет));
	Запись.Закрыть();

КонецПроцедуры

Функция Страница(Отчет)

	Файлы = ГруппыПоФайлам(Отчет);

	Строки = Новый Массив();
	Строки.Добавить("<!DOCTYPE html>");
	Строки.Добавить("<html lang=""ru"">");
	Строки.Добавить("<head>");
	Строки.Добавить("<meta charset=""utf-8"">");
	Строки.Добавить("<title>Мутационное тестирование</title>");
	Строки.Добавить(Стили());
	Строки.Добавить("</head>");
	Строки.Добавить("<body>");
	Строки.Добавить("<h1>Мутационное тестирование</h1>");
	Строки.Добавить(Сводка(Отчет));

	Пакеты = ПакетыПоФайлам(Файлы);

	// Переключатели на радиокнопках, без сценариев: отчёт должен открываться
	// откуда угодно - из письма, из артефактов сборки, с диска.
	//
	// В разметке ни одна кнопка темы не отмечена - тогда тему выбирает система
	// через prefers-color-scheme. Сразу после кнопок сценарий отмечает ту,
	// что системе и соответствует: иначе обе кнопки выглядят ненажатыми
	// и непонятно, какая тема сейчас. Со сценариями сложилось так же, как без них,
	// только теперь это видно
	Строки.Добавить("<input type=""radio"" name=""view"" id=""view-packages"" class=""switch"" checked>");
	Строки.Добавить("<input type=""radio"" name=""view"" id=""view-files"" class=""switch"">");
	Строки.Добавить("<input type=""radio"" name=""theme"" id=""theme-light"" class=""switch"">");
	Строки.Добавить("<input type=""radio"" name=""theme"" id=""theme-dark"" class=""switch"">");
	Строки.Добавить(ОтметитьСистемнуюТему());
	Строки.Добавить("<div class=""tabs"">"
		+ "<label for=""view-packages"">По пакетам</label>"
		+ "<label for=""view-files"">По файлам</label>"
		+ "<label for=""theme-light"" class=""theme"">Светлая</label>"
		+ "<label for=""theme-dark"" class=""theme"">Тёмная</label>"
		+ "</div>");

	Строки.Добавить(ТаблицаПакетов(Пакеты));
	Строки.Добавить(ТаблицаФайлов(Файлы));

	Строки.Добавить("<div class=""sections"">");

	Для Каждого Пакет Из Пакеты Цикл

		Строки.Добавить(СтрШаблон("<h2 class=""package"" id=""%1"">%2</h2>",
			Пакет.Якорь,
			Экранировать(Пакет.Имя)));

		Для Каждого Группа Из Пакет.Файлы Цикл
			Строки.Добавить(РазделФайла(Группа));
		КонецЦикла;

	КонецЦикла;

	Строки.Добавить("</div>");

	Строки.Добавить(Подвал());
	Строки.Добавить(Подсветка());
	Строки.Добавить("</body>");
	Строки.Добавить("</html>");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Отмечает кнопку темы, совпадающую с системной.
//
// Сценарий обычный, а не модуль, и стоит прямо за кнопками: модуль отложенный,
// и кнопка отметилась бы уже после отрисовки - заметным скачком.
//
// Тема от этого не меняется: без сценариев её и так выбирает prefers-color-scheme.
// Меняется только то, что нажатая кнопка теперь видна.
Функция ОтметитьСистемнуюТему()

	Возврат "<script>
	|(() => {
	|	const dark = window.matchMedia && window.matchMedia(""(prefers-color-scheme: dark)"").matches;
	|	const button = document.getElementById(dark ? ""theme-dark"" : ""theme-light"");
	|	if (button) button.checked = true;
	|})();
	|</script>";

КонецФункции

// Подсветка исходников через Shiki.
//
// Shiki берётся с CDN и работает уже в браузере: под рукой нет ни Node, чтобы
// подсветить при сборке отчёта, ни способа уложить движок с грамматикой внутрь
// файла - это мегабайты на каждый отчёт.
//
// Поэтому подсветка необязательная: строки исходника уже лежат в таблице обычным
// текстом, и без сети, без сценариев или со старым браузером отчёт остаётся таким
// же, каким был. Скрипт только перекрашивает уже показанное.
//
// Исходник собирается обратно из ячеек таблицы, а не кладётся в файл вторым
// экземпляром: отчёт большого проекта и так весит немало.
//
// Грамматика bsl - это 1С:Предприятие, у OneScript синтаксис тот же.
//
// Тем две. Shiki кладёт в каждый токен обе переменными --shiki-light и --shiki-dark,
// а какую взять, решает CSS - так подсветка следует за переключателем темы
// и не требует перекрашивать разметку заново.
Функция Подсветка()

	Возврат "<script type=""module"">
	|const CDN = ""https://esm.sh"";
	|
	|const escape = (text) => text
	|	.replace(/&/g, ""&amp;"").replace(/</g, ""&lt;"").replace(/>/g, ""&gt;"");
	|
	|const style = (token) => Object.entries(token.htmlStyle ?? {})
	|	.map(([name, value]) => `${name}:${value}`)
	|	.join("";"");
	|
	|try {
	|
	|	const [{ createHighlighterCore }, { createOnigurumaEngine }, grammar, light, dark] =
	|		await Promise.all([
	|			import(CDN + ""/shiki@3/core""),
	|			import(CDN + ""/shiki@3/engine/oniguruma""),
	|			import(CDN + ""/@shikijs/langs@3/bsl""),
	|			import(CDN + ""/@shikijs/themes@3/github-light""),
	|			import(CDN + ""/@shikijs/themes@3/github-dark"")
	|		]);
	|
	|	const highlighter = await createHighlighterCore({
	|		langs: [grammar.default],
	|		themes: [light.default, dark.default],
	|		engine: createOnigurumaEngine(import(CDN + ""/shiki@3/wasm""))
	|	});
	|
	|	for (const table of document.querySelectorAll(""table.source[data-lang]"")) {
	|
	|		const cells = [...table.querySelectorAll(""td.code"")];
	|		const source = cells.map((cell) => cell.textContent).join(""\n"");
	|
	|		const { tokens } = highlighter.codeToTokens(source, {
	|			lang: ""bsl"",
	|			themes: { light: ""github-light"", dark: ""github-dark"" },
	|			defaultColor: false
	|		});
	|
	|		cells.forEach((cell, index) => {
	|			const line = tokens[index];
	|			if (!line) return;
	|			cell.innerHTML = line
	|				.map((token) => `<span style=""${style(token)}"">${escape(token.content)}</span>`)
	|				.join("""");
	|		});
	|
	|	}
	|
	|} catch (error) {
	|	// подсветка - украшение: без сети отчёт остаётся читаемым как есть
	|	console.warn(""Подсветка не загрузилась:"", error);
	|}
	|</script>";

КонецФункции

Функция Сводка(Отчет)

	Строки = Новый Массив();
	Строки.Добавить("<div class=""summary"">");
	Строки.Добавить(Показатель("Индекс мутаций", СтрШаблон("%1%%", Отчет.ИндексМутаций()), КлассИндекса(Отчет)));
	Строки.Добавить(Показатель("Проверено", Отчет.ВсегоМутантов(), ""));
	Строки.Добавить(Показатель("Убито", Отчет.Убито(), "killed"));
	Строки.Добавить(Показатель("Выжило", Отчет.Выжило(), "survived"));

	Если Отчет.БезПокрытия() > 0 Тогда
		Строки.Добавить(Показатель("Без покрытия", Отчет.БезПокрытия(), "nocover"));
	КонецЕсли;

	Если Отчет.Ошибок() > 0 Тогда
		Строки.Добавить(Показатель("Ошибок", Отчет.Ошибок(), "error"));
	КонецЕсли;

	Строки.Добавить("</div>");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция Показатель(Знач Заголовок, Знач Значение, Знач Класс)

	Возврат СтрШаблон("<div class=""metric %3""><div class=""value"">%2</div><div class=""caption"">%1</div></div>",
		Экранировать(Заголовок),
		Экранировать(Строка(Значение)),
		Класс);

КонецФункции

// Красный индекс мутаций привлекает внимание сильнее любой цифры,
// поэтому цвет сводки задаётся по нему же.
Функция КлассИндекса(Отчет)

	Если Отчет.ИндексМутаций() >= 80 Тогда
		Возврат "killed";
	ИначеЕсли Отчет.ИндексМутаций() >= 50 Тогда
		Возврат "partial";
	КонецЕсли;

	Возврат "survived";

КонецФункции

Функция ТаблицаПакетов(Пакеты)

	Строки = Новый Массив();
	Строки.Добавить("<table class=""packages"">");
	Строки.Добавить("<tr><th>Пакет</th><th>Файлов</th><th>Индекс</th>"
		+ "<th>Убито</th><th>Выжило</th><th>Без покрытия</th></tr>");

	Для Каждого Пакет Из Пакеты Цикл

		Строки.Добавить(СтрШаблон(
			"<tr><td><a href=""#%1"">%2</a></td><td>%3</td>%4"
			+ "<td>%5</td><td>%6</td><td>%7</td></tr>",
			Пакет.Якорь,
			Экранировать(Пакет.Имя),
			Пакет.Файлы.Количество(),
			ЯчейкаИндекса(Пакет),
			Пакет.Убито,
			Пакет.Выжило,
			Пакет.БезПокрытия));

	КонецЦикла;

	Строки.Добавить("</table>");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ТаблицаФайлов(Файлы)

	Строки = Новый Массив();
	Строки.Добавить("<table class=""files"">");
	Строки.Добавить("<tr><th>Файл</th><th>Индекс</th><th>Убито</th><th>Выжило</th><th>Без покрытия</th></tr>");

	Для Каждого Группа Из Файлы Цикл

		Строки.Добавить(СтрШаблон(
			"<tr><td><a href=""#%1"">%2</a></td>%3<td>%4</td><td>%5</td><td>%6</td></tr>",
			Группа.Якорь,
			Экранировать(Группа.Имя),
			ЯчейкаИндекса(Группа),
			Группа.Убито,
			Группа.Выжило,
			Группа.БезПокрытия));

	КонецЦикла;

	Строки.Добавить("</table>");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Там, где не проверено ни одного мутанта, индекса нет вовсе - ноль читался бы
// как "всё плохо", хотя проверять было нечего. Такое бывает у файлов, которых
// не касается ни один тест.
Функция ЯчейкаИндекса(Группа)

	Если Группа.Убито + Группа.Выжило = 0 Тогда
		Возврат "<td class=""nocover"">—</td>";
	КонецЕсли;

	Возврат СтрШаблон("<td class=""%1"">%2%%</td>", КлассДоли(Группа.Индекс), Группа.Индекс);

КонецФункции

Функция КлассДоли(Знач Индекс)

	Если Индекс >= 80 Тогда
		Возврат "killed";
	ИначеЕсли Индекс >= 50 Тогда
		Возврат "partial";
	КонецЕсли;

	Возврат "survived";

КонецФункции

Функция РазделФайла(Группа)

	Строки = Новый Массив();
	Строки.Добавить(СтрШаблон("<h3 id=""%1"">%2</h3>", Группа.Якорь, Экранировать(Группа.Имя)));

	ИсходныйТекст = Группа.Исходник;

	Если ИсходныйТекст = Неопределено Тогда
		// исходник мог быть удалён или переименован после прогона -
		// тогда остаётся только список мутантов
		Строки.Добавить("<p class=""missing"">Исходный файл недоступен, показаны только мутанты.</p>");
		Строки.Добавить(СписокМутантов(Группа.Мутанты));
	Иначе
		Строки.Добавить(Исходник(ИсходныйТекст, Группа.Мутанты));
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Исходник целиком: строки с мутациями подсвечены, сами мутации показаны под строкой.
Функция Исходник(Знач ИсходныйТекст, Мутанты)

	ПоСтрокам = МутантыПоСтрокам(Мутанты);

	Строки = Новый Массив();
	// data-lang помечает таблицы с исходником: список мутантов без исходника
	// подсвечивать нечем
	Строки.Добавить("<table class=""source"" data-lang=""bsl"">");

	НомерСтроки = 0;

	Для Каждого СтрокаИсходника Из СтрРазделить(ИсходныйТекст, Символы.ПС, Истина) Цикл

		НомерСтроки = НомерСтроки + 1;
		МутантыСтроки = ПоСтрокам.Получить(НомерСтроки);

		Строки.Добавить(СтрШаблон("<tr class=""%1""><td class=""num"">%2</td><td class=""code"">%3</td></tr>",
			?(МутантыСтроки = Неопределено, "", КлассСтроки(МутантыСтроки)),
			НомерСтроки,
			Экранировать(СтрЗаменить(СтрокаИсходника, Символы.Таб, "    "))));

		Если МутантыСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Мутант Из МутантыСтроки Цикл
			Строки.Добавить(СтрШаблон("<tr class=""mutation""><td class=""num""></td><td>%1</td></tr>",
				ОписаниеМутанта(Мутант)));
		КонецЦикла;

	КонецЦикла;

	Строки.Добавить("</table>");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция СписокМутантов(Мутанты)

	Строки = Новый Массив();
	Строки.Добавить("<table class=""source"">");

	Для Каждого Мутант Из Мутанты Цикл
		Строки.Добавить(СтрШаблон("<tr class=""mutation""><td class=""num"">%1</td><td>%2</td></tr>",
			Мутант.Мутация().НомерСтроки(),
			ОписаниеМутанта(Мутант)));
	КонецЦикла;

	Строки.Добавить("</table>");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ОписаниеМутанта(Мутант)

	Мутация = Мутант.Мутация();

	Возврат СтрШаблон("<span class=""badge %1"">%2</span> %3 <span class=""mutator"">%4</span>%5",
		КлассСостояния(Мутант.Состояние()),
		Экранировать(Мутант.Состояние()),
		Экранировать(Мутация.Описание()),
		Экранировать(Мутация.Мутатор()),
		МестоМутации(Мутация));

КонецФункции

Функция МестоМутации(Мутация)

	Если ПустаяСтрока(Мутация.ИмяМетода()) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон(" <span class=""method"">%1</span>", Экранировать(Мутация.ИмяМетода()));

КонецФункции

// Строку красит худший её мутант: одного выжившего достаточно, чтобы строка требовала внимания.
Функция КлассСтроки(Мутанты)

	Худший = "";

	Для Каждого Мутант Из Мутанты Цикл
		Если Худший = "" Или Вес(Мутант.Состояние()) > Вес(Худший) Тогда
			Худший = Мутант.Состояние();
		КонецЕсли;
	КонецЦикла;

	Возврат КлассСостояния(Худший);

КонецФункции

Функция Вес(Знач Состояние)

	Описание = _Состояния.Получить(Состояние);

	Возврат ?(Описание = Неопределено, 0, Описание.Вес);

КонецФункции

Функция КлассСостояния(Знач Состояние)

	Описание = _Состояния.Получить(Состояние);

	Возврат ?(Описание = Неопределено, "", Описание.Класс);

КонецФункции

Функция МутантыПоСтрокам(Мутанты)

	Результат = Новый Соответствие();

	Для Каждого Мутант Из Мутанты Цикл

		Номер = Мутант.Мутация().НомерСтроки();
		СтрокаМутантов = Результат.Получить(Номер);

		Если СтрокаМутантов = Неопределено Тогда
			СтрокаМутантов = Новый Массив();
			Результат.Вставить(Номер, СтрокаМутантов);
		КонецЕсли;

		СтрокаМутантов.Добавить(Мутант);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Мутанты, разложенные по файлам в порядке первого появления, со сводкой по каждому файлу.
Функция ГруппыПоФайлам(Отчет)

	Группы = Новый Массив();
	Индекс = Новый Соответствие();

	Для Каждого Мутант Из Отчет.Результаты() Цикл

		Группа = Индекс.Получить(Мутант.Файл());

		Если Группа = Неопределено Тогда
			Группа = НоваяГруппа(Мутант.Файл(), Группы.Количество() + 1);
			Индекс.Вставить(Мутант.Файл(), Группа);
			Группы.Добавить(Группа);
		КонецЕсли;

		Группа.Мутанты.Добавить(Мутант);
		ПосчитатьМутанта(Группа, Мутант);

	КонецЦикла;

	ОбщийКаталог = ИсходникиОтчета.ОбщийКаталог(ПутиФайлов(Группы));

	Для Каждого Группа Из Группы Цикл
		Группа.Индекс    = Доля(Группа);
		Группа.Имя       = ИсходникиОтчета.ОтносительныйПуть(Группа.Файл, ОбщийКаталог);
		Группа.Пакет     = ИсходникиОтчета.Пакет(Группа.Имя);
		Группа.Исходник  = ИсходникФайла(Отчет, Группа.Файл);
	КонецЦикла;

	Возврат Группы;

КонецФункции

// Файлы, собранные в пакеты, со сводкой по каждому.
//
// Файлы уже упорядочены по пути, а пакет - это и есть путь, поэтому файлы одного
// пакета идут подряд и группировка получается одним проходом.
Функция ПакетыПоФайлам(Файлы)

	Пакеты = Новый Массив();
	Индекс = Новый Соответствие();

	Для Каждого Группа Из Файлы Цикл

		Пакет = Индекс.Получить(Группа.Пакет);

		Если Пакет = Неопределено Тогда
			Пакет = НовыйПакет(Группа.Пакет, Пакеты.Количество() + 1);
			Индекс.Вставить(Группа.Пакет, Пакет);
			Пакеты.Добавить(Пакет);
		КонецЕсли;

		Пакет.Файлы.Добавить(Группа);
		Пакет.Убито       = Пакет.Убито + Группа.Убито;
		Пакет.Выжило      = Пакет.Выжило + Группа.Выжило;
		Пакет.БезПокрытия = Пакет.БезПокрытия + Группа.БезПокрытия;

		Группа.Пакет = Пакет;

	КонецЦикла;

	Для Каждого Пакет Из Пакеты Цикл
		Пакет.Индекс = Доля(Пакет);
	КонецЦикла;

	Возврат ПоИмени(Пакеты);

КонецФункции

// Пакеты идут по имени, а не в порядке появления файлов: так их читают глазами
// и так же сравнивают два отчёта подряд.
Функция ПоИмени(Пакеты)

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Имя");
	Таблица.Колонки.Добавить("Пакет");

	Для Каждого Пакет Из Пакеты Цикл
		Строка = Таблица.Добавить();
		Строка.Имя   = НРег(Пакет.Имя);
		Строка.Пакет = Пакет;
	КонецЦикла;

	Таблица.Сортировать("Имя");

	Результат = Новый Массив();

	Для Каждого Строка Из Таблица Цикл
		Результат.Добавить(Строка.Пакет);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НовыйПакет(Знач Имя, Знач Номер)

	Пакет = Новый Структура();
	Пакет.Вставить("Имя", ?(ПустаяСтрока(Имя), "(корень)", Имя));
	Пакет.Вставить("Якорь", "p" + Формат(Номер, "ЧГ=0"));
	Пакет.Вставить("Файлы", Новый Массив());
	Пакет.Вставить("Убито", 0);
	Пакет.Вставить("Выжило", 0);
	Пакет.Вставить("БезПокрытия", 0);
	Пакет.Вставить("Индекс", 0);

	Возврат Пакет;

КонецФункции

Функция ПутиФайлов(Группы)

	Пути = Новый Массив();

	Для Каждого Группа Из Группы Цикл
		Пути.Добавить(Группа.Файл);
	КонецЦикла;

	Возврат Пути;

КонецФункции

// Якорь строится по номеру, а не по пути: пути в проектах на русском состоят
// из символов, которых в идентификаторе HTML быть не должно.
Функция НоваяГруппа(Знач Файл, Знач Номер)

	Группа = Новый Структура();
	Группа.Вставить("Файл", Файл);
	Группа.Вставить("Имя", Файл);
	Группа.Вставить("Пакет", "");
	Группа.Вставить("Исходник", Неопределено);
	Группа.Вставить("Якорь", "f" + Формат(Номер, "ЧГ=0"));
	Группа.Вставить("Мутанты", Новый Массив());
	Группа.Вставить("Убито", 0);
	Группа.Вставить("Выжило", 0);
	Группа.Вставить("БезПокрытия", 0);
	Группа.Вставить("Индекс", 0);

	Возврат Группа;

КонецФункции

Процедура ПосчитатьМутанта(Группа, Мутант)

	Если Мутант.Состояние() = СостоянияМутанта.БезПокрытия() Тогда
		Группа.БезПокрытия = Группа.БезПокрытия + 1;
	ИначеЕсли СостоянияМутанта.ЭтоУбийство(Мутант.Состояние()) Тогда
		Группа.Убито = Группа.Убито + 1;
	ИначеЕсли Мутант.Состояние() = СостоянияМутанта.Выжил() Тогда
		Группа.Выжило = Группа.Выжило + 1;
	КонецЕсли;

КонецПроцедуры

Функция Доля(Группа)

	Проверено = Группа.Убито + Группа.Выжило;

	Возврат ?(Проверено = 0, 0, Окр(Группа.Убито * 100 / Проверено, 1));

КонецФункции

// Отчёт, восстановленный из JSON, несёт исходники в себе - файлов проекта на этой
// машине может не быть. Свежий прогон их не хранит, и текст читается с диска.
Функция ИсходникФайла(Отчет, Знач Путь)

	Текст = Отчет.Исходник(Путь);

	Возврат ?(Текст = Неопределено, ПрочитатьИсходник(Путь), СтрЗаменить(Текст, Символы.ВК, ""));

КонецФункции

Функция ПрочитатьИсходник(Знач Путь)

	Текст = ИсходникиОтчета.ПрочитатьИсходник(Путь);

	Возврат ?(Текст = Неопределено, Неопределено, СтрЗаменить(Текст, Символы.ВК, ""));

КонецФункции

Функция Экранировать(Знач Текст)

	Результат = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");

	Возврат Результат;

КонецФункции

Функция Подвал()

	Возврат СтрШаблон("<p class=""footer"">mutatos, %1</p>",
		Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm'"));

КонецФункции

Функция Стили()

	Возврат "<style>
	|/* Светлая палитра - основная, тёмная переопределяет только цвета.
	|   По умолчанию тема берётся из системы, а переключатель её перебивает:
	|   :has() позволяет обойтись без сценариев, как и переключатель вида */
	|:root {
	|	--bg: #fff; --fg: #1c1e21; --muted: #6a707a; --faint: #9aa0a6;
	|	--line: #e6e8eb; --border: #dcdfe3; --border-hover: #b9bfc7;
	|	--killed: #1a7f37; --survived: #c0392b; --partial: #b26a00; --link: #0b5cd5;
	|	--bg-killed: #e7f5ea; --bg-survived: #fdeaea; --bg-nocover: #f1f2f4; --bg-error: #fdf3e3;
	|	--btn-bg: #1c1e21; --btn-fg: #fff;
	|	/* У бейджей свои фоны: цвета текста для них слишком светлые */
	|	--badge-fg: #fff; --badge-killed: #1a7f37; --badge-survived: #c0392b;
	|	--badge-nocover: #6a707a; --badge-partial: #b26a00;
	|}
	|@media (prefers-color-scheme: dark) {
	|	:root:not(:has(#theme-light:checked)) {
	|		--bg: #16181c; --fg: #e6e8eb; --muted: #9aa0a6; --faint: #6a707a;
	|		--line: #2a2e35; --border: #343a42; --border-hover: #4a515b;
	|		--killed: #4ac26b; --survived: #f27a72; --partial: #e0a44a; --link: #6cb0ff;
	|		--bg-killed: #14301c; --bg-survived: #3a1a1a; --bg-nocover: #21242a; --bg-error: #35291a;
	|		--btn-bg: #e6e8eb; --btn-fg: #16181c;
	|		/* фоны бейджей в тёмной теме светлые, поэтому текст на них тёмный */
	|		--badge-fg: #16181c;
	|	}
	|	/* Цвет кода берётся прямо здесь, а не через промежуточную переменную:
	|	   var() внутри переменной подставляется там, где переменная объявлена,
	|	   а --shiki-light и --shiki-dark живут на самих токенах */
	|	:root:not(:has(#theme-light:checked)) table.source td.code span { color: var(--shiki-dark); }
	|}
	|:root:has(#theme-dark:checked) {
	|	--bg: #16181c; --fg: #e6e8eb; --muted: #9aa0a6; --faint: #6a707a;
	|	--line: #2a2e35; --border: #343a42; --border-hover: #4a515b;
	|	--killed: #4ac26b; --survived: #f27a72; --partial: #e0a44a; --link: #6cb0ff;
	|	--bg-killed: #14301c; --bg-survived: #3a1a1a; --bg-nocover: #21242a; --bg-error: #35291a;
	|	--btn-bg: #e6e8eb; --btn-fg: #16181c;
	|	/* В тёмной теме бейджи не светлеют вслед за текстом, а темнеют:
	|	   чёрным по зелёному и красному читается плохо */
	|	--badge-fg: #f0f2f4; --badge-killed: #24603a; --badge-survived: #8c3b34;
	|	--badge-nocover: #3a4048; --badge-partial: #7a5518;
	|}
	|:root:has(#theme-dark:checked) table.source td.code span { color: var(--shiki-dark); }
	|body { font-family: system-ui, -apple-system, ""Segoe UI"", sans-serif; margin: 0 auto; padding: 24px;
	|	max-width: 1100px; color: var(--fg); background: var(--bg); }
	|h1 { font-size: 22px; margin: 0 0 20px; }
	|h2.package { font-size: 13px; margin: 34px 0 10px; text-transform: uppercase; letter-spacing: 0.08em;
	|	color: var(--muted); border-bottom: 1px solid var(--line); padding-bottom: 6px;
	|	word-break: break-all; }
	|h3 { font-size: 15px; margin: 24px 0 8px; font-family: ui-monospace, ""Cascadia Code"", Consolas, monospace;
	|	font-weight: 600; word-break: break-all; }
	|.switch { position: absolute; opacity: 0; pointer-events: none; }
	|.tabs { display: flex; gap: 4px; margin: 24px 0 12px; }
	|.tabs label.theme { margin-left: auto; }
	|.tabs label.theme ~ label.theme { margin-left: 0; }
	|.tabs label { font-size: 13px; padding: 5px 12px; border: 1px solid var(--border); border-radius: 999px;
	|	cursor: pointer; color: var(--muted); user-select: none; }
	|.tabs label:hover { border-color: var(--border-hover); }
	|#view-packages:checked ~ .tabs label[for=""view-packages""],
	|#view-files:checked ~ .tabs label[for=""view-files""],
	|#theme-light:checked ~ .tabs label[for=""theme-light""],
	|#theme-dark:checked ~ .tabs label[for=""theme-dark""] { background: var(--btn-bg);
	|	border-color: var(--btn-bg); color: var(--btn-fg); }
	|#view-packages:checked ~ table.files { display: none; }
	|#view-files:checked ~ table.packages { display: none; }
	|#view-files:checked ~ .sections h2.package { display: none; }
	|table.packages { border-collapse: collapse; width: 100%; font-size: 14px; }
	|table.packages th, table.packages td { border-bottom: 1px solid var(--line); padding: 6px 10px;
	|	text-align: right; }
	|table.packages th:first-child, table.packages td:first-child { text-align: left; word-break: break-all; }
	|table.packages th { font-size: 12px; color: var(--muted); font-weight: 600; }
	|table.packages td.killed { color: var(--killed); }
	|table.packages td.survived { color: var(--survived); }
	|table.packages td.partial { color: var(--partial); }
	|table.packages td.nocover, table.files td.nocover { color: var(--faint); }
	|.summary { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 24px; }
	|.metric { border: 1px solid var(--border); border-radius: 8px; padding: 10px 16px; min-width: 96px; }
	|.metric .value { font-size: 22px; font-weight: 600; }
	|.metric .caption { font-size: 12px; color: var(--muted); margin-top: 2px; }
	|.metric.killed .value { color: var(--killed); }
	|.metric.survived .value { color: var(--survived); }
	|.metric.partial .value { color: var(--partial); }
	|.metric.nocover .value { color: var(--muted); }
	|.metric.error .value { color: var(--partial); }
	|table.files { border-collapse: collapse; width: 100%; font-size: 14px; }
	|table.files th, table.files td { border-bottom: 1px solid var(--line); padding: 6px 10px; text-align: right; }
	|table.files th:first-child, table.files td:first-child { text-align: left; word-break: break-all; }
	|table.files th { font-size: 12px; color: var(--muted); font-weight: 600; }
	|table.files td.killed { color: var(--killed); }
	|table.files td.survived { color: var(--survived); }
	|table.files td.partial { color: var(--partial); }
	|table.source { border-collapse: collapse; width: 100%; font-size: 14px; line-height: 1.5;
	|	font-family: ui-monospace, ""Cascadia Code"", Consolas, monospace; }
	|table.source td { padding: 1px 8px; vertical-align: top; }
	|table.source td.num { text-align: right; color: var(--faint); width: 1%; white-space: nowrap;
	|	user-select: none; border-right: 1px solid var(--line); }
	|table.source td.code { white-space: pre-wrap; }
	|/* Shiki кладёт в каждый токен обе темы переменными, а какую взять - решают
	|   правила выше: тут светлая, там тёмная */
	|table.source td.code span { color: var(--shiki-light); }
	|table.source tr.killed { background: var(--bg-killed); }
	|table.source tr.survived { background: var(--bg-survived); }
	|table.source tr.nocover { background: var(--bg-nocover); }
	|table.source tr.error { background: var(--bg-error); }
	|table.source tr.mutation td { font-size: 13px; padding-bottom: 4px; }
	|.badge { display: inline-block; border-radius: 4px; padding: 1px 7px; font-size: 12px; font-weight: 600;
	|	color: var(--badge-fg); }
	|.badge.killed { background: var(--badge-killed); }
	|.badge.survived { background: var(--badge-survived); }
	|.badge.nocover { background: var(--badge-nocover); }
	|.badge.error { background: var(--badge-partial); }
	|.mutator { color: var(--muted); }
	|.method { color: var(--muted); }
	|.missing { color: var(--muted); font-size: 14px; }
	|.footer { color: var(--faint); font-size: 12px; margin-top: 32px; }
	|a { color: var(--link); text-decoration: none; }
	|a:hover { text-decoration: underline; }
	|</style>";

КонецФункции

&Репортер
Процедура ПриСозданииОбъекта()

	_Состояния = Новый Соответствие();
	_Состояния.Вставить(СостоянияМутанта.Убит(),        Новый Структура("Класс, Вес", "killed", 1));
	_Состояния.Вставить(СостоянияМутанта.Таймаут(),     Новый Структура("Класс, Вес", "killed", 1));
	_Состояния.Вставить(СостоянияМутанта.Ошибка(),      Новый Структура("Класс, Вес", "error", 2));
	_Состояния.Вставить(СостоянияМутанта.БезПокрытия(), Новый Структура("Класс, Вес", "nocover", 3));
	_Состояния.Вставить(СостоянияМутанта.Выжил(),       Новый Структура("Класс, Вес", "survived", 4));

КонецПроцедуры
