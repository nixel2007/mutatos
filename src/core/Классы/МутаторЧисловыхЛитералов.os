#Использовать "../internal"

// Подменяет числовые константы: ноль становится единицей, любое другое число - нулём
// и собой же, увеличенным на единицу.
//
// Константы в коде почти всегда что-то значат: размер порции, предельная величина,
// индекс. Выживший мутант означает, что конкретное значение тестами не закреплено -
// проверяется что угодно, только не оно.

Перем _Число;

Функция Имя() Экспорт
	Возврат "ЧисловыеЛитералы";
КонецФункции

Функция ТипыУзлов(Типы) Экспорт
	Результат = Новый Массив();
	Результат.Добавить(Типы.ВыражениеЛитерал);
	Возврат Результат;
КонецФункции

Функция Мутации(Узел, Контекст) Экспорт

	Мутации = Новый Массив();

	Если Узел.Вид <> _Число Тогда
		Возврат Мутации;
	КонецЕсли;

	Для Каждого Замена Из Замены(Узел.Значение) Цикл
		Мутации.Добавить(Контекст.МутацияТокена(
			Имя(),
			Узел.Начало,
			Замена,
			СтрШаблон("%1 заменено на %2", Контекст.ТекстТокена(Узел.Начало), Замена)));
	КонецЦикла;

	Возврат Мутации;

КонецФункции

// Ноль меняется только на единицу: обнулять его бессмысленно, мутант был бы
// неотличим от оригинала.
Функция Замены(Знач Значение)

	Замены = Новый Массив();

	Если Значение = 0 Тогда
		Замены.Добавить("1");
	Иначе
		Замены.Добавить("0");
		Замены.Добавить(Представление(Значение + 1));
	КонецЕсли;

	Возврат Замены;

КонецФункции

// Число в исходный код: без разделителей групп и с точкой в дробной части.
Функция Представление(Знач Значение)

	Возврат СокрЛП(Формат(Значение, "ЧГ=0; ЧРД=."));

КонецФункции

&Мутатор
Процедура ПриСозданииОбъекта(&Пластилин Токены)

	_Число = Токены.Число;

КонецПроцедуры
