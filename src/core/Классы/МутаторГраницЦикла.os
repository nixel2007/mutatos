#Использовать "../internal"

// Укорачивает счётный цикл на один шаг: Для Сч = 1 По N становится Для Сч = 1 По (N) - 1.
//
// Последняя итерация - классическое место ошибки на единицу. Выживший мутант означает,
// что тесты не проверяют обработку последнего элемента: границу цикла можно
// сдвинуть, и никто не заметит.

Функция Имя() Экспорт
	Возврат "ГраницыЦикла";
КонецФункции

Функция ТипыУзлов(Типы) Экспорт
	Результат = Новый Массив();
	Результат.Добавить(Типы.ОператорДля);
	Возврат Результат;
КонецФункции

Функция Мутации(Узел, Контекст) Экспорт

	Мутации = Новый Массив();

	Если Узел.Финиш = Неопределено Тогда
		Возврат Мутации;
	КонецЕсли;

	Мутации.Добавить(Контекст.МутацияУзла(
		Имя(),
		Узел.Финиш,
		СтрШаблон("(%1) - 1", СокрЛП(Контекст.ТекстУзла(Узел.Финиш))),
		"верхняя граница цикла уменьшена на единицу"));

	Возврат Мутации;

КонецФункции

&Мутатор
Процедура ПриСозданииОбъекта()
КонецПроцедуры
