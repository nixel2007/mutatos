#Использовать "../internal"

// Сдвигает границы условий и меняет операции сравнения:
// > на >=, < на <=, = на <>. Классический источник ошибок "на единицу",
// который переживает поверхностные тесты.

Перем _Замены;

Функция Имя() Экспорт
	Возврат "Условия";
КонецФункции

Функция ТипыУзлов(Типы) Экспорт
	Результат = Новый Массив();
	Результат.Добавить(Типы.ВыражениеБинарное);
	Возврат Результат;
КонецФункции

Функция Мутации(Узел, Контекст) Экспорт

	Мутации = Новый Массив();

	Варианты = _Замены.Получить(Узел.Операция.Токен);
	Если Варианты = Неопределено Тогда
		Возврат Мутации;
	КонецЕсли;

	Для Каждого Вариант Из Варианты Цикл
		Мутации.Добавить(Контекст.МутацияТокена(
			Имя(),
			Узел.Операция,
			Вариант.Символ,
			СтрШаблон("%1 заменено на %2", Вариант.ИсходныйСимвол, Вариант.Символ)));
	КонецЦикла;

	Возврат Мутации;

КонецФункции

&Мутатор
Процедура ПриСозданииОбъекта(&Пластилин Токены)

	_Замены = Новый Соответствие();

	ДобавитьЗамены(Токены.ЗнакБольше,          ">",  ">=", "<");
	ДобавитьЗамены(Токены.ЗнакМеньше,          "<",  "<=", ">");
	ДобавитьЗамены(Токены.ЗнакБольшеИлиРавно,  ">=", ">");
	ДобавитьЗамены(Токены.ЗнакМеньшеИлиРавно,  "<=", "<");
	ДобавитьЗамены(Токены.ЗнакРавно,           "=",  "<>");
	ДобавитьЗамены(Токены.ЗнакНеРавно,         "<>", "=");

КонецПроцедуры

Процедура ДобавитьЗамены(Токен, ИсходныйСимвол, Знач Первый, Знач Второй = Неопределено)

	Варианты = Новый Массив();
	Варианты.Добавить(Новый Структура("ИсходныйСимвол, Символ", ИсходныйСимвол, Первый));
	Если Второй <> Неопределено Тогда
		Варианты.Добавить(Новый Структура("ИсходныйСимвол, Символ", ИсходныйСимвол, Второй));
	КонецЕсли;

	_Замены.Вставить(Токен, Варианты);

КонецПроцедуры
