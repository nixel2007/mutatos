// Какие наборы тестов выполняют какую строку.
//
// Мутанта незачем проверять всеми тестами проекта: убить его могут только те, что
// выполняют мутированную строку. Остальные пройдут в точности как на оригинале,
// и время их прогона потрачено впустую - а тратится оно на каждом мутанте.
//
// Карта строится прогоном каждого набора по отдельности со сбором покрытия. Точность
// здесь - вопрос правильности, а не скорости: набор, потерянный в карте, не будет
// запущен, и мутант объявят выжившим, хотя тесты его убивают. Поэтому строка без
// данных означает "гнать всё", а не "не гнать ничего".

Перем _НаборыСтрок;
Перем _Наборы;

// Отмечает, что набор выполняет строку файла.
Процедура Отметить(Знач Набор, Знач Файл, Знач НомерСтроки) Экспорт

	Ключ = Ключ(Файл, НомерСтроки);
	Наборы = _НаборыСтрок.Получить(Ключ);

	Если Наборы = Неопределено Тогда
		Наборы = Новый Соответствие();
		_НаборыСтрок.Вставить(Ключ, Наборы);
	КонецЕсли;

	Наборы.Вставить(Набор, Истина);
	_Наборы.Вставить(Набор, Истина);

КонецПроцедуры

// Переносит в карту всё покрытие, собранное прогоном одного набора.
Процедура ОтметитьПокрытие(Знач Набор, Знач Покрытие) Экспорт

	Для Каждого Строка Из Покрытие.ПокрытыеСтроки() Цикл
		Отметить(Набор, Строка.Файл, Строка.НомерСтроки);
	КонецЦикла;

КонецПроцедуры

// Наборы, выполняющие строку. Пустой массив означает, что строку не выполняет никто.
Функция НаборыСтроки(Знач Файл, Знач НомерСтроки) Экспорт

	Результат = Новый Массив();
	Наборы = _НаборыСтрок.Получить(Ключ(Файл, НомерСтроки));

	Если Наборы = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	// порядок важен: по одинаковому списку наборов задания собираются в группы,
	// а группа - это одна пересборка точки входа вместо десятков
	Список = Новый СписокЗначений();

	Для Каждого Элемент Из Наборы Цикл
		Список.Добавить(Элемент.Ключ);
	КонецЦикла;

	Список.СортироватьПоЗначению();

	Для Каждого Элемент Из Список Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Истина, если карта построена и по ней можно отбирать тесты.
Функция Заполнена() Экспорт
	Возврат _Наборы.Количество() > 0;
КонецФункции

// Сколько наборов участвовало в построении карты.
Функция КоличествоНаборов() Экспорт
	Возврат _Наборы.Количество();
КонецФункции

Функция Ключ(Знач Файл, Знач НомерСтроки)
	Возврат НормализованныйПуть(Файл) + ":" + Формат(НомерСтроки, "ЧГ=0");
КонецФункции

// Пути из отчёта о покрытии и пути мутируемых файлов приходят из разных источников,
// поэтому сравниваются в едином виде.
Функция НормализованныйПуть(Знач Путь)
	Возврат НРег(СтрЗаменить(Путь, "\", "/"));
КонецФункции

Процедура ПриСозданииОбъекта()

	_НаборыСтрок = Новый Соответствие();
	_Наборы      = Новый Соответствие();

КонецПроцедуры
