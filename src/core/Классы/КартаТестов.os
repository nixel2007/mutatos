// Какие тесты выполняют какую строку.
//
// Мутанта незачем проверять всеми тестами проекта: убить его могут только те, что
// выполняют мутированную строку. Остальные пройдут в точности как на оригинале,
// и время их прогона потрачено впустую - а тратится оно на каждом мутанте.
//
// Единица отбора - тест, а не набор: движок умеет открывать и закрывать сессию сбора
// статистики вокруг любого куска прогона, поэтому вклад каждого теста виден отдельно.
// Там, где так не получается, тест записывается с пустым методом - это весь набор
// целиком, и отбор работает грубее, но так же верно.
//
// Точность здесь - вопрос правильности, а не скорости: тест, потерянный в карте,
// не будет запущен, и мутант объявят выжившим, хотя тесты его убивают. Поэтому
// строка без данных означает "гнать всё", а не "не гнать ничего".

Перем _ТестыСтрок;
Перем _Тесты;
Перем _Длительности;
// Во что обходится сам запуск прогона: старт движка и компиляция проекта. Платится
// один раз на процесс, поэтому в длительностях тестов её нет, а в оценке есть
Перем _СтоимостьСтарта;

// Отмечает, что тест выполняет строку файла. Пустой метод означает набор целиком.
Процедура Отметить(Знач Набор, Знач Метод, Знач Файл, Знач НомерСтроки) Экспорт

	ОтметитьСтроку(Ид(Набор, Метод), НормализованныйПуть(Файл), НомерСтроки);

КонецПроцедуры

// Отмечает, что тест выполняет перечисленные строки одного файла.
//
// Отдельно от построчного варианта ради цены: имя теста и нормализованный путь
// для всех строк файла одни и те же, а строк на файл сотни. Считать их заново
// на каждую строку - это сотни тысяч склеек строк на прогон средней величины.
Процедура ОтметитьСтрокиФайла(Знач Набор, Знач Метод, Знач Файл, Знач Строки) Экспорт

	Ид = Ид(Набор, Метод);
	Путь = НормализованныйПуть(Файл);

	Для Каждого НомерСтроки Из Строки Цикл
		ОтметитьСтроку(Ид, Путь, НомерСтроки);
	КонецЦикла;

КонецПроцедуры

// Переносит в карту всё покрытие, собранное одним тестом.
Процедура ОтметитьПокрытие(Знач Набор, Знач Метод, Знач Покрытие) Экспорт

	Ид = Ид(Набор, Метод);

	Для Каждого Строка Из Покрытие.ПокрытыеСтроки() Цикл
		ОтметитьСтроку(Ид, НормализованныйПуть(Строка.Файл), Строка.НомерСтроки);
	КонецЦикла;

КонецПроцедуры

Процедура ОтметитьСтроку(Знач Ид, Знач НормализованныйПуть, Знач НомерСтроки)

	Ключ = НормализованныйПуть + ":" + Формат(НомерСтроки, "ЧГ=0");
	Тесты = _ТестыСтрок.Получить(Ключ);

	Если Тесты = Неопределено Тогда
		Тесты = Новый Соответствие();
		_ТестыСтрок.Вставить(Ключ, Тесты);
	КонецЕсли;

	Тесты.Вставить(Ид, Истина);
	_Тесты.Вставить(Ид, Истина);

КонецПроцедуры

// Тесты, выполняющие строку. Пустой массив означает, что строку не выполняет никто.
//
// Возвращаемое значение:
//   Массив из Структура - Набор (путь к файлу набора) и Метод (пустой - набор целиком)
Функция ТестыСтроки(Знач Файл, Знач НомерСтроки) Экспорт

	Результат = Новый Массив();
	Тесты = _ТестыСтрок.Получить(Ключ(Файл, НомерСтроки));

	Если Тесты = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	// порядок важен: по одинаковому списку тестов задания собираются в группы,
	// а группа - это одна пересборка точки входа вместо десятков
	Список = Новый СписокЗначений();

	Для Каждого Элемент Из Тесты Цикл
		Список.Добавить(Элемент.Ключ);
	КонецЦикла;

	Список.СортироватьПоЗначению();

	Для Каждого Элемент Из Список Цикл
		Результат.Добавить(Тест(Элемент.Значение));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Запоминает, сколько занял сам тест, без старта прогона. По этим числам оценивается
// длительность мутационного прогона: с отбором она считается не по полному прогону,
// а по тем тестам, которые мутанту действительно достанутся.
//
// Отметки складываются: параметризованный тест выполняется по разу на каждый набор
// параметров, а отбирается целиком - значит и стоит он столько, сколько все они вместе.
Процедура ОтметитьДлительность(Знач Набор, Знач Метод, Знач Миллисекунд) Экспорт

	Ид = Ид(Набор, Метод);
	Было = _Длительности.Получить(Ид);

	_Длительности.Вставить(Ид, ?(Было = Неопределено, 0, Было) + Миллисекунд);

КонецПроцедуры

// Запоминает, во что обходится сам запуск прогона: старт движка и компиляция проекта.
Процедура ОтметитьСтоимостьСтарта(Знач Миллисекунд) Экспорт

	_СтоимостьСтарта = Миллисекунд;

КонецПроцедуры

// Во сколько обойдётся прогон мутанта заданными тестами, в миллисекундах.
// Ноль означает, что оценить нечем - тесты неизвестны или мутант идёт всеми тестами.
//
// Оценка - это старт прогона плюс сами тесты. Почти всё время уходит на старт движка
// и компиляцию проекта, а платятся они один раз на процесс: на collectionos мутант
// с шестью наборами занимал столько же, сколько один набор в одиночку.
Функция ОценкаПрогона(Знач Тесты) Экспорт

	Если Тесты.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Оценка = 0;

	Для Каждого Тест Из Тесты Цикл

		Длительность = _Длительности.Получить(Ид(Тест.Набор, Тест.Метод));

		Если Длительность = Неопределено Тогда
			Возврат 0;
		КонецЕсли;

		Оценка = Оценка + Длительность;

	КонецЦикла;

	Возврат Оценка + _СтоимостьСтарта;

КонецФункции

// Во что обойдётся прогон всеми тестами проекта, в миллисекундах.
//
// Это не длительность прогона, которым карта построена: тот платил ещё и за сам сбор,
// а мутант бежит без него. Ноль означает, что оценивать нечем - карта пуста.
Функция ОценкаПолногоПрогона() Экспорт

	Если Не Заполнена() Тогда
		Возврат 0;
	КонецЕсли;

	Оценка = _СтоимостьСтарта;

	Для Каждого Длительность Из _Длительности Цикл
		Оценка = Оценка + Длительность.Значение;
	КонецЦикла;

	Возврат Оценка;

КонецФункции

// Истина, если карта построена и по ней можно отбирать тесты.
Функция Заполнена() Экспорт
	Возврат _Тесты.Количество() > 0;
КонецФункции

// Сколько тестов участвовало в построении карты.
Функция КоличествоТестов() Экспорт
	Возврат _Тесты.Количество();
КонецФункции

// Тест кодируется одной строкой: соответствия ключуются значением, а структура
// ключом быть не может. Разделитель - перевод строки: в пути и имени метода его нет
Функция Ид(Знач Набор, Знач Метод)
	Возврат Набор + Символы.ПС + Метод;
КонецФункции

Функция Тест(Знач Ид)

	Части = СтрРазделить(Ид, Символы.ПС, Истина);

	Возврат Новый Структура("Набор, Метод", Части[0], Части[1]);

КонецФункции

Функция Ключ(Знач Файл, Знач НомерСтроки)
	Возврат НормализованныйПуть(Файл) + ":" + Формат(НомерСтроки, "ЧГ=0");
КонецФункции

// Пути из отчёта о покрытии и пути мутируемых файлов приходят из разных источников,
// поэтому сравниваются в едином виде.
Функция НормализованныйПуть(Знач Путь)
	Возврат НРег(СтрЗаменить(Путь, "\", "/"));
КонецФункции

Процедура ПриСозданииОбъекта()

	_ТестыСтрок      = Новый Соответствие();
	_Тесты           = Новый Соответствие();
	_Длительности    = Новый Соответствие();
	_СтоимостьСтарта = 0;

КонецПроцедуры
