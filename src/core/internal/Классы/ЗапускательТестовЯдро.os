#Использовать fs
#Использовать semver
#Использовать autumn-logos
#Использовать oneunit/src/shared

// Прогоняет тесты ядром OneUnit, минуя его командную строку.
//
// OneUnit - двухкомпонентное приложение, и запуск через бинарь oneunit стоит двух стартов
// движка: командная строка поднимается сама и порождает дочерний процесс с ядром.
// Мутационный прогон повторяет запуск на каждого мутанта, поэтому лишний старт заметен.
//
// Сборку точки входа выполняет сам OneUnit: он собирает импорты тестов, сливает
// конфигурацию oscript из проекта и каталогов тестов и добавляет системные настройки
// движка - повторять эту логику у себя значило бы отставать от неё при каждом обновлении.
//
// Тесты прогоняются ядром самого проекта, если оно у него есть: mutatos везёт OneUnit
// внутри себя, и без этого чужие тесты выполнялись бы версией инструмента,
// а не той, на которую проект рассчитан.

Перем _Запускатель;
Перем _КаталогиТестов;
Перем _КаталогЯдра;
// Соответствие: рабочий каталог -> Булево. Ядро проекта проверяется на каждом прогоне,
// а сказать о его версии достаточно один раз
Перем _ПроверенныеЯдра;
Перем _Лог;

// Прогоняет тесты в рабочем каталоге.
//
// Параметры:
//   РабочийКаталог - Строка - каталог проекта, в котором запускаются тесты
//   Таймаут - Число - предельное время прогона каждого теста в миллисекундах, 0 - без ограничения
//   ПутьКCodestat - Строка - если заполнен, движок пишет туда статистику выполнения
//   Фильтры - ФильтрыТестов - отбор тестов, Неопределено - прогоняются все
//
// Возвращаемое значение:
//   РезультатПрогона
Функция Прогнать(Знач РабочийКаталог, Знач Таймаут = 0, Знач ПутьКCodestat = "", Знач Фильтры = Неопределено) Экспорт

	Параметры = _Запускатель.ПараметрыЗапуска();
	Параметры.РабочийКаталог = РабочийКаталог;
	Параметры.ПутьКСтатистикеПокрытия = ПутьКCodestat;
	ЗадатьКаталогЯдра(Параметры, РабочийКаталог);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		Результат = _Запускатель.ВыполнитьТестирование(Детальки(РабочийКаталог, Таймаут, Фильтры), _Лог, Параметры);
	Исключение
		_Лог.Отладка("Прогон тестов завершился нештатно: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый РезультатПрогона(
			Ложь,
			-1,
			ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Возврат Новый РезультатПрогона(
		Результат.КодВозврата = 0,
		Результат.КодВозврата,
		Длительность,
		Результат.Вывод);

КонецФункции

// Истина, если ядро OneUnit доступно и прогон возможен.
//
// OneUnit поставляется вместе с mutatos, поэтому ядро есть всегда - вопрос лишь в том,
// чьё именно будет использовано.
Функция Доступен(Знач РабочийКаталог) Экспорт

	Возврат Истина;

КонецФункции

// Задаёт параметрам прогона ядро тестируемого проекта, если оно у него есть и подходит.
Процедура ЗадатьКаталогЯдра(Параметры, Знач РабочийКаталог) Экспорт

	КаталогЯдра = КаталогЯдраПроекта(РабочийКаталог);

	Если ПустаяСтрока(КаталогЯдра) Тогда
		Возврат;
	КонецЕсли;

	Параметры.КаталогЯдра = КаталогЯдра;

КонецПроцедуры

// Каталог ядра OneUnit тестируемого проекта. Пустая строка означает, что прогон пойдёт
// ядром, поставляемым с mutatos: либо своего ядра у проекта нет, либо оно слишком старое.
Функция КаталогЯдраПроекта(Знач РабочийКаталог) Экспорт

	// Ядро, указанное вручную, берётся как есть: раз его выбрали явно, версию выбирали тоже
	Если Не ПустаяСтрока(_КаталогЯдра) Тогда
		Возврат _КаталогЯдра;
	КонецЕсли;

	Кандидат = ФС.НормализоватьПуть(ОбъединитьПути(РабочийКаталог, "oscript_modules/oneunit/src/core"));

	Если Не Новый Файл(Кандидат).Существует() Тогда
		Возврат "";
	КонецЕсли;

	Если Не ЯдроПроектаПодходит(РабочийКаталог) Тогда
		Возврат "";
	КонецЕсли;

	_Лог.Отладка("Тесты прогоняются ядром проекта: %1", Кандидат);

	Возврат Кандидат;

КонецФункции

// Минимальная версия OneUnit, чьим ядром mutatos готов прогонять тесты.
//
// В 0.5.0 появились выбор ядра прогона и прекращение прогона на первом падении.
// Второе mutatos и просит у ядра: мутанту хватает одного упавшего теста, и без
// этой детальки проверка каждого мутанта доигрывает набор целиком.
Функция ТребуемаяВерсияOneUnit() Экспорт

	Возврат "0.5.0";

КонецФункции

// Версия OneUnit, установленного в проекте. Пустая строка - определить не удалось.
Функция ВерсияOneUnitПроекта(Знач РабочийКаталог) Экспорт

	Метаданные = ФС.НормализоватьПуть(
		ОбъединитьПути(РабочийКаталог, "oscript_modules/oneunit/opm-metadata.xml"));

	Если Не Новый Файл(Метаданные).Существует() Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат ВерсияИзМетаданных(Метаданные);
	Исключение
		_Лог.Отладка(
			"Метаданные OneUnit проекта не прочитались: %1",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат "";
	КонецПопытки;

КонецФункции

// Годится ли ядро проекта для мутационного прогона.
//
// Старое ядро о детальке прекращения прогона не знает и молча её проигнорирует -
// мутанты проверялись бы полными наборами, и об этом никто бы не узнал. Поэтому
// в таком случае прогон идёт ядром mutatos, но вслух.
Функция ЯдроПроектаПодходит(Знач РабочийКаталог)

	Проверенное = _ПроверенныеЯдра.Получить(РабочийКаталог);

	Если Проверенное <> Неопределено Тогда
		Возврат Проверенное;
	КонецЕсли;

	Версия = ВерсияOneUnitПроекта(РабочийКаталог);

	Если ПустаяСтрока(Версия) Тогда

		_Лог.Предупреждение(
			"У проекта своё ядро OneUnit, но его версию определить не удалось:"
			+ " тесты пойдут ядром mutatos. Нужен OneUnit %1 или новее",
			ТребуемаяВерсияOneUnit());

		Подходит = Ложь;

	ИначеЕсли Версии.ВерсияМеньше(Версия, ТребуемаяВерсияOneUnit()) Тогда

		_Лог.Предупреждение(
			"У проекта OneUnit %1, а нужен %2 или новее: тесты пойдут ядром mutatos."
			+ " Прекращение прогона на первом падении появилось в %2, и без него проверка"
			+ " каждого мутанта доигрывает набор целиком",
			Версия,
			ТребуемаяВерсияOneUnit());

		Подходит = Ложь;

	Иначе

		Подходит = Истина;

	КонецЕсли;

	_ПроверенныеЯдра.Вставить(РабочийКаталог, Подходит);

	Возврат Подходит;

КонецФункции

// Версия из элемента version файла метаданных пакета.
//
// Версии зависимостей лежат в атрибутах depends-on, поэтому элемент с таким именем
// в файле ровно один - первый же и есть версия самого пакета.
Функция ВерсияИзМетаданных(Знач Путь)

	Чтение = Новый ЧтениеXML();
	Чтение.ОткрытьФайл(Путь);

	Версия = "";

	Попытка

		Пока Чтение.Прочитать() Цикл

			Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента
				Или Чтение.Имя <> "version" Тогда
				Продолжить;
			КонецЕсли;

			Если Чтение.Прочитать() Тогда
				Версия = СокрЛП(Чтение.Значение);
			КонецЕсли;

			Прервать;

		КонецЦикла;

	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Чтение.Закрыть();

	Возврат Версия;

КонецФункции

Функция Детальки(РабочийКаталог, Таймаут, Фильтры)

	Детальки = Новый Соответствие();
	Детальки.Вставить("КаталогиТестов", АбсолютныеКаталогиТестов(РабочийКаталог));
	Детальки.Вставить("ФайлыТестов", Новый Массив());
	Детальки.Вставить("ИскатьВПодкаталогах", Истина);
	Детальки.Вставить("РежимВыводаЛога", "none");
	Детальки.Вставить("Таймаут", Таймаут);

	Если Фильтры <> Неопределено Тогда
		Фильтры.ДополнитьДетальки(Детальки);
	КонецЕсли;

	Возврат Детальки;

КонецФункции

Функция АбсолютныеКаталогиТестов(РабочийКаталог)

	Результат = Новый Массив();

	Для Каждого КаталогТестов Из _КаталогиТестов Цикл
		Результат.Добавить(ФС.НормализоватьПуть(ОбъединитьПути(РабочийКаталог, КаталогТестов)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Деталька("mutatos.КаталогиТестов", ЗначениеПоУмолчанию = "tests") КаталогиТестов,
	&Деталька("mutatos.КаталогЯдраOneUnit", ЗначениеПоУмолчанию = "") КаталогЯдра,
	&Лог("oscript.lib.mutatos") Лог) Экспорт

	_Запускатель      = Новый ЗапускательТестирования(Новый ПостроительТочкиВхода());
	_КаталогиТестов   = СтрРазделить(КаталогиТестов, ",", Ложь);
	_КаталогЯдра      = КаталогЯдра;
	_ПроверенныеЯдра  = Новый Соответствие();
	_Лог              = Лог;

КонецПроцедуры
