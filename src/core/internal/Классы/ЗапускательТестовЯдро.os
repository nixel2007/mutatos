#Использовать 1commands
#Использовать fs
#Использовать autumn-logos

// Прогоняет тесты, поднимая ядро OneUnit напрямую, без его командной строки.
//
// Точка входа строится один раз и переиспользуется для всех мутантов: меняется только
// исходник на диске, а состав тестов и импортов остаётся прежним.

Перем _Построитель;
Перем _КаталогБиблиотек;
Перем _ТочкаВхода;
Перем _Лог;

Функция Прогнать(Знач РабочийКаталог, Знач Таймаут = 0, Знач ПутьКCodestat = "") Экспорт

	ТочкаВхода = ТочкаВхода(РабочийКаталог);

	Команда = Новый Команда();
	Команда.УстановитьКоманду("oscript");
	Команда.УстановитьРабочийКаталог(РабочийКаталог);
	Команда.ПерехватыватьПотоки(Истина);
	Команда.ПоказыватьВыводНемедленно(Ложь);

	Если Не ПустаяСтрока(ПутьКCodestat) Тогда
		Команда.ДобавитьПараметр("-codestat=" + ПутьКCodestat);
	КонецЕсли;

	Команда.ДобавитьПараметр(ТочкаВхода);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		КодВозврата = Команда.Исполнить();
	Исключение
		_Лог.Отладка("Прогон тестов завершился нештатно: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый РезультатПрогона(
			Ложь,
			-1,
			ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Возврат Новый РезультатПрогона(КодВозврата = 0, КодВозврата, Длительность, Команда.ПолучитьВывод());

КонецФункции

// Истина, если ядро OneUnit найдено и прогон возможен.
Функция Доступен(Знач РабочийКаталог) Экспорт

	Возврат ЕстьЯдро(КаталогиБиблиотек(РабочийКаталог));

КонецФункции

Функция ТочкаВхода(РабочийКаталог)

	Если _ТочкаВхода <> Неопределено Тогда
		Возврат _ТочкаВхода;
	КонецЕсли;

	КаталогиБиблиотек = КаталогиБиблиотек(РабочийКаталог);

	Если Не ЕстьЯдро(КаталогиБиблиотек) Тогда
		ВызватьИсключение "Не найдено ядро OneUnit. Установите его в проект: opm install -l oneunit";
	КонецЕсли;

	_ТочкаВхода = _Построитель.Построить(РабочийКаталог, КаталогиБиблиотек);
	_Лог.Отладка("Точка входа прогона: %1", _ТочкаВхода);

	Возврат _ТочкаВхода;

КонецФункции

// Библиотеки берутся сначала из тестируемого проекта, затем из каталога самого mutatos:
// тесты проекта корректнее запускать его собственным OneUnit, но если своего нет,
// подойдёт установленный вместе с инструментом.
Функция КаталогиБиблиотек(РабочийКаталог)

	Каталоги = Новый Массив();

	Если Не ПустаяСтрока(_КаталогБиблиотек) Тогда
		ДобавитьКаталог(Каталоги, _КаталогБиблиотек);
		Возврат Каталоги;
	КонецЕсли;

	ДобавитьКаталог(Каталоги, ОбъединитьПути(РабочийКаталог, "oscript_modules"));
	ДобавитьКаталог(Каталоги, ОбъединитьПути(КаталогИнструмента(), "oscript_modules"));

	Возврат Каталоги;

КонецФункции

Функция ЕстьЯдро(КаталогиБиблиотек)

	Для Каждого КаталогБиблиотек Из КаталогиБиблиотек Цикл
		Если Новый Файл(ОбъединитьПути(КаталогБиблиотек, "oneunit/src/core")).Существует() Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ДобавитьКаталог(Каталоги, Знач Путь)

	ПолныйПуть = ФС.НормализоватьПуть(Путь);

	Если Новый Файл(ПолныйПуть).Существует() И Каталоги.Найти(ПолныйПуть) = Неопределено Тогда
		Каталоги.Добавить(ПолныйПуть);
	КонецЕсли;

КонецПроцедуры

// Корень mutatos: этот класс лежит в src/core/internal/Классы.
Функция КаталогИнструмента()

	Возврат ФС.НормализоватьПуть(ОбъединитьПути(ТекущийСценарий().Каталог, "../../../.."));

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин ПостроительТочкиВхода,
	&Деталька("mutatos.КаталогБиблиотек", ЗначениеПоУмолчанию = "") КаталогБиблиотек,
	&Лог("oscript.lib.mutatos") Лог) Экспорт

	_Построитель      = ПостроительТочкиВхода;
	_КаталогБиблиотек = КаталогБиблиотек;
	_Лог              = Лог;

КонецПроцедуры
