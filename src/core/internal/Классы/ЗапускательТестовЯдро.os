#Использовать fs
#Использовать autumn-logos
#Использовать oneunit/src/shared

// Прогоняет тесты ядром OneUnit, минуя его командную строку.
//
// OneUnit - двухкомпонентное приложение, и запуск через бинарь oneunit стоит двух стартов
// движка: командная строка поднимается сама и порождает дочерний процесс с ядром.
// Мутационный прогон повторяет запуск на каждого мутанта, поэтому лишний старт заметен.
//
// Сборку точки входа выполняет сам OneUnit: он собирает импорты тестов, сливает
// конфигурацию oscript из проекта и каталогов тестов и добавляет системные настройки
// движка - повторять эту логику у себя значило бы отставать от неё при каждом обновлении.
//
// Тесты прогоняются ядром самого проекта, если оно у него есть: mutatos везёт OneUnit
// внутри себя, и без этого чужие тесты выполнялись бы версией инструмента,
// а не той, на которую проект рассчитан.

Перем _Запускатель;
Перем _КаталогиТестов;
Перем _КаталогЯдра;
Перем _Лог;

// Прогоняет тесты в рабочем каталоге.
//
// Параметры:
//   РабочийКаталог - Строка - каталог проекта, в котором запускаются тесты
//   Таймаут - Число - предельное время прогона каждого теста в миллисекундах, 0 - без ограничения
//   ПутьКCodestat - Строка - если заполнен, движок пишет туда статистику выполнения
//   Фильтры - ФильтрыТестов - отбор тестов, Неопределено - прогоняются все
//
// Возвращаемое значение:
//   РезультатПрогона
Функция Прогнать(Знач РабочийКаталог, Знач Таймаут = 0, Знач ПутьКCodestat = "", Знач Фильтры = Неопределено) Экспорт

	Параметры = _Запускатель.ПараметрыЗапуска();
	Параметры.РабочийКаталог = РабочийКаталог;
	Параметры.ПутьКСтатистикеПокрытия = ПутьКCodestat;
	ЗадатьКаталогЯдра(Параметры, РабочийКаталог);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		Результат = _Запускатель.ВыполнитьТестирование(Детальки(РабочийКаталог, Таймаут, Фильтры), _Лог, Параметры);
	Исключение
		_Лог.Отладка("Прогон тестов завершился нештатно: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый РезультатПрогона(
			Ложь,
			-1,
			ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Возврат Новый РезультатПрогона(
		Результат.КодВозврата = 0,
		Результат.КодВозврата,
		Длительность,
		Результат.Вывод);

КонецФункции

// Истина, если ядро OneUnit доступно и прогон возможен.
//
// OneUnit поставляется вместе с mutatos, поэтому ядро есть всегда - вопрос лишь в том,
// чьё именно будет использовано.
Функция Доступен(Знач РабочийКаталог) Экспорт

	Возврат Истина;

КонецФункции

// Задаёт параметрам прогона ядро тестируемого проекта, если оно у него есть.
//
// Выбор ядра появился в OneUnit 0.5.0. На более старом прогон возможен, но пойдёт ядром
// самого mutatos - о расхождении версий фреймворка тогда предупреждаем вслух.
Процедура ЗадатьКаталогЯдра(Параметры, Знач РабочийКаталог) Экспорт

	КаталогЯдра = КаталогЯдраПроекта(РабочийКаталог);

	Если ПустаяСтрока(КаталогЯдра) Тогда
		Возврат;
	КонецЕсли;

	Если Не Параметры.Свойство("КаталогЯдра") Тогда
		_Лог.Предупреждение("У проекта своё ядро OneUnit, но установленный не умеет его выбирать:"
			+ " тесты пойдут ядром mutatos. Выбор ядра появился в OneUnit 0.5.0");
		Возврат;
	КонецЕсли;

	Параметры.КаталогЯдра = КаталогЯдра;

КонецПроцедуры

// Каталог ядра OneUnit тестируемого проекта. Пустая строка означает, что своего ядра
// у проекта нет и прогон пойдёт тем, что поставляется с mutatos.
Функция КаталогЯдраПроекта(Знач РабочийКаталог) Экспорт

	Если Не ПустаяСтрока(_КаталогЯдра) Тогда
		Возврат _КаталогЯдра;
	КонецЕсли;

	Кандидат = ФС.НормализоватьПуть(ОбъединитьПути(РабочийКаталог, "oscript_modules/oneunit/src/core"));

	Если Не Новый Файл(Кандидат).Существует() Тогда
		Возврат "";
	КонецЕсли;

	_Лог.Отладка("Тесты прогоняются ядром проекта: %1", Кандидат);

	Возврат Кандидат;

КонецФункции

Функция Детальки(РабочийКаталог, Таймаут, Фильтры)

	Детальки = Новый Соответствие();
	Детальки.Вставить("КаталогиТестов", АбсолютныеКаталогиТестов(РабочийКаталог));
	Детальки.Вставить("ФайлыТестов", Новый Массив());
	Детальки.Вставить("ИскатьВПодкаталогах", Истина);
	Детальки.Вставить("РежимВыводаЛога", "none");
	Детальки.Вставить("Таймаут", Таймаут);

	Если Фильтры <> Неопределено Тогда
		Фильтры.ДополнитьДетальки(Детальки);
	КонецЕсли;

	Возврат Детальки;

КонецФункции

Функция АбсолютныеКаталогиТестов(РабочийКаталог)

	Результат = Новый Массив();

	Для Каждого КаталогТестов Из _КаталогиТестов Цикл
		Результат.Добавить(ФС.НормализоватьПуть(ОбъединитьПути(РабочийКаталог, КаталогТестов)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Деталька("mutatos.КаталогиТестов", ЗначениеПоУмолчанию = "tests") КаталогиТестов,
	&Деталька("mutatos.КаталогЯдраOneUnit", ЗначениеПоУмолчанию = "") КаталогЯдра,
	&Лог("oscript.lib.mutatos") Лог) Экспорт

	_Запускатель    = Новый ЗапускательТестирования(Новый ПостроительТочкиВхода());
	_КаталогиТестов = СтрРазделить(КаталогиТестов, ",", Ложь);
	_КаталогЯдра    = КаталогЯдра;
	_Лог            = Лог;

КонецПроцедуры
