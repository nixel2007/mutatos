#Использовать fs
#Использовать autumn-logos

// Заводит рабочие копии проекта - по одной на поток - и знает, где в проекте лежат тесты.
//
// Копии нужны и проверке мутантов, и сбору карты тестов, поэтому живут отдельно
// от того и другого: настройки прогона (число потоков, каталоги тестов, что не копировать)
// одни и те же, и расходиться им незачем.

Перем _ЧислоПотоков;
Перем _КаталогиТестов;
Перем _ИсключаемыеКаталоги;
Перем _Лог;

// Создаёт указанное число копий проекта.
//
// ПрерыватьПриПадении включают проверке мутантов: одного упавшего теста ей достаточно.
// Сбору покрытия он бы всё испортил - там нужен полный прогон.
Функция СоздатьКопии(Знач РабочийКаталог, Знач Количество, Знач КаталогЯдра = "", Знач Фильтры = Неопределено,
	Знач ПрерыватьПриПадении = Ложь) Экспорт

	_Лог.Информация("Рабочих копий проекта: %1", Количество);

	Копии = Новый Массив();

	Для Сч = 1 По Количество Цикл
		Копии.Добавить(Новый РабочаяКопия(
			РабочийКаталог,
			АбсолютныеКаталогиТестов(РабочийКаталог),
			_ИсключаемыеКаталоги,
			КаталогЯдра,
			Фильтры,
			ПрерыватьПриПадении,
			_Лог));
	КонецЦикла;

	Возврат Копии;

КонецФункции

Процедура УдалитьКопии(Копии) Экспорт

	Для Каждого Копия Из Копии Цикл
		Копия.Удалить();
	КонецЦикла;

КонецПроцедуры

// Явно заданное значение перевешивает настройку, ноль означает "по числу процессоров".
Функция ЧислоПотоков(Знач ЧислоПотоков = 0) Экспорт

	Если ЧислоПотоков > 0 Тогда
		Возврат ЧислоПотоков;
	КонецЕсли;

	Возврат _ЧислоПотоков;

КонецФункции

Функция АбсолютныеКаталогиТестов(Знач РабочийКаталог) Экспорт

	Результат = Новый Массив();

	Для Каждого КаталогТестов Из _КаталогиТестов Цикл
		Результат.Добавить(ФС.НормализоватьПуть(ОбъединитьПути(РабочийКаталог, КаталогТестов)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Файлы тестовых наборов проекта. Набор - это файл: OneUnit умеет отбирать тесты
// по файлам, и такой же гранулярностью пользуется карта тестов.
Функция ФайлыНаборов(Знач РабочийКаталог) Экспорт

	Файлы = Новый Массив();

	Для Каждого КаталогТестов Из АбсолютныеКаталогиТестов(РабочийКаталог) Цикл

		Если Не Новый Файл(КаталогТестов).Существует() Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Найденный Из НайтиФайлы(КаталогТестов, "*.os", Истина) Цикл
			Если Не Найденный.ЭтоКаталог() Тогда
				Файлы.Добавить(ФС.НормализоватьПуть(Найденный.ПолноеИмя));
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат Файлы;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Деталька("mutatos.ЧислоПотоков", ЗначениеПоУмолчанию = 0) ЧислоПотоков,
	&Деталька("mutatos.КаталогиТестов", ЗначениеПоУмолчанию = "tests") КаталогиТестов,
	&Деталька("mutatos.ИсключаемыеКаталоги", ЗначениеПоУмолчанию = "oscript_modules,.git,out") Исключения,
	&ЛогМутатос Лог) Экспорт

	_Лог = Лог;

	_ЧислоПотоков   = ?(ЧислоПотоков > 0, ЧислоПотоков, Новый СистемнаяИнформация().КоличествоПроцессоров);
	_КаталогиТестов = СтрРазделить(КаталогиТестов, ",", Ложь);

	_ИсключаемыеКаталоги = Новый Массив();
	Для Каждого ИсключаемыйКаталог Из СтрРазделить(Исключения, ",", Ложь) Цикл
		_ИсключаемыеКаталоги.Добавить(НРег(СокрЛП(ИсключаемыйКаталог)));
	КонецЦикла;

КонецПроцедуры
