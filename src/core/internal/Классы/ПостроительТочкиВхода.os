#Использовать tempfiles
#Использовать fs

// Собирает скрипт, который прогоняет тесты проекта ядром OneUnit.
//
// OneUnit - двухкомпонентное приложение: командная строка и ядро. Командная строка сама
// порождает дочерний процесс с ядром, поэтому запуск через неё стоит двух стартов движка
// вместо одного. Мутационному прогону это дорого: он повторяет запуск на каждого мутанта.

Перем _КаталогиТестов;

// Готовит каталог с точкой входа и настройками.
//
// Параметры:
//   РабочийКаталог - Строка - каталог проекта
//   ПутьКЯдру - Строка - каталог src/core установленного OneUnit
//
// Возвращаемое значение:
//   Строка - путь к сгенерированной точке входа
Функция Построить(Знач РабочийКаталог, Знач ПутьКЯдру) Экспорт

	КаталогЗапуска = ВременныеФайлы.СоздатьКаталог();

	КаталогиТестов = АбсолютныеКаталогиТестов(РабочийКаталог);

	ЗаписатьНастройки(КаталогЗапуска, КаталогиТестов);
	ЗаписатьКонфигурацию(КаталогЗапуска, РабочийКаталог, ПутьКЯдру);

	ПутьКТочкеВхода = ОбъединитьПути(КаталогЗапуска, "прогон.os");
	ЗаписатьФайл(ПутьКТочкеВхода, ТекстТочкиВхода(КаталогиТестов, ПутьКЯдру, КаталогЗапуска));

	Возврат ПутьКТочкеВхода;

КонецФункции

// Точка входа лежит во временном каталоге, поэтому библиотеки проекта нужно показать явно:
// иначе движок возьмёт их из общего каталога, где версии могут не совпадать с проектными.
Процедура ЗаписатьКонфигурацию(КаталогЗапуска, РабочийКаталог, ПутьКЯдру)

	КаталогиБиблиотек = Новый Массив();
	ДобавитьКаталогБиблиотек(КаталогиБиблиотек, ОбъединитьПути(РабочийКаталог, "oscript_modules"));
	// ядро лежит в <каталог библиотек>/oneunit/src/core
	ДобавитьКаталогБиблиотек(КаталогиБиблиотек, ОбъединитьПути(ПутьКЯдру, "../../.."));

	Если КаталогиБиблиотек.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// конфигурация читается построчно, поэтому пишется без метки порядка байтов
	Запись = Новый ЗаписьТекста(ОбъединитьПути(КаталогЗапуска, "oscript.cfg"), КодировкаТекста.UTF8БезBOM);
	Запись.Записать("lib.additional=" + СтрСоединить(КаталогиБиблиотек, ";"));
	Запись.Закрыть();

КонецПроцедуры

Процедура ДобавитьКаталогБиблиотек(Каталоги, Знач Путь)

	ПолныйПуть = ФС.НормализоватьПуть(Путь);

	Если Новый Файл(ПолныйПуть).Существует() И Каталоги.Найти(ПолныйПуть) = Неопределено Тогда
		Каталоги.Добавить(ПолныйПуть);
	КонецЕсли;

КонецПроцедуры

Функция ТекстТочкиВхода(КаталогиТестов, ПутьКЯдру, КаталогЗапуска)

	Строки = Новый Массив();

	Для Каждого Импорт Из ИмпортыТестов(КаталогиТестов) Цикл
		Строки.Добавить(Импорт);
	КонецЦикла;

	Строки.Добавить(СтрШаблон("#Использовать ""%1""", ПутьКЯдру));
	Строки.Добавить("");
	Строки.Добавить(СтрШаблон("Поделка = Новый Поделка(Новый СоветДругогоМастера()"));
	Строки.Добавить(СтрШаблон("	.ДополнительныйКаталогПоискаФайлаСоЗначениямиДеталек(""%1""));", КаталогЗапуска));
	Строки.Добавить("Поделка.ЗапуститьПриложение();");
	Строки.Добавить("");
	Строки.Добавить("МенеджерТестирования = Поделка.НайтиЖелудь(""МенеджерТестирования"");");
	Строки.Добавить("МенеджерТестирования.Тестировать();");
	Строки.Добавить("");
	Строки.Добавить("Статистика = Поделка.НайтиЖелудь(""РепортерСтатистика"").СтатистикаТестПлана();");
	Строки.Добавить("");
	Строки.Добавить("ЕстьОшибки = Статистика.ПолучитьИлиУмолчание(""НаборовОшибка"", 0) > 0");
	Строки.Добавить("	Или Статистика.ПолучитьИлиУмолчание(""НаборовСломано"", 0) > 0");
	Строки.Добавить("	Или Статистика.ПолучитьИлиУмолчание(""ТестовОшибка"", 0) > 0");
	Строки.Добавить("	Или Статистика.ПолучитьИлиУмолчание(""ТестовСломано"", 0) > 0;");
	Строки.Добавить("");
	Строки.Добавить("Если ЕстьОшибки Тогда");
	Строки.Добавить("	ЗавершитьРаботу(1);");
	Строки.Добавить("КонецЕсли;");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Тесты подключают библиотеки и свой проект сами - точка входа повторяет эти импорты,
// иначе тестовые наборы не скомпилируются.
Функция ИмпортыТестов(КаталогиТестов)

	Импорты = Новый Массив();
	Учтенные = Новый Соответствие();

	Для Каждого КаталогТестов Из КаталогиТестов Цикл

		Если Не Новый Файл(КаталогТестов).Существует() Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ФайлТеста Из НайтиФайлы(КаталогТестов, "*.os", Истина) Цикл

			Если Не ФайлТеста.ЭтоФайл() Тогда
				Продолжить;
			КонецЕсли;

			ДобавитьИмпортыФайла(ФайлТеста, Импорты, Учтенные);

		КонецЦикла;

	КонецЦикла;

	Возврат Импорты;

КонецФункции

Процедура ДобавитьИмпортыФайла(ФайлТеста, Импорты, Учтенные)

	Чтение = Новый ЧтениеТекста(ФайлТеста.ПолноеИмя, КодировкаТекста.UTF8);

	Строка = Чтение.ПрочитатьСтроку();
	Пока Строка <> Неопределено Цикл

		Директива = СокрЛП(Строка);

		Если СтрНачинаетсяС(НРег(Директива), "#использовать") Тогда

			Импорт = ПриведенныйИмпорт(Директива, ФайлТеста.Путь);

			Если Учтенные.Получить(НРег(Импорт)) = Неопределено Тогда
				Учтенные.Вставить(НРег(Импорт), Истина);
				Импорты.Добавить(Импорт);
			КонецЕсли;

		КонецЕсли;

		Строка = Чтение.ПрочитатьСтроку();

	КонецЦикла;

	Чтение.Закрыть();

КонецПроцедуры

// Точка входа лежит во временном каталоге, поэтому относительные пути тестов
// превращаются в абсолютные.
Функция ПриведенныйИмпорт(Знач Директива, Знач КаталогТеста)

	Значение = СокрЛП(Сред(Директива, СтрДлина("#Использовать") + 1));

	Если Не СтрНачинаетсяС(Значение, """") Тогда
		Возврат СтрШаблон("#Использовать %1", Значение);
	КонецЕсли;

	ОтносительныйПуть = СтрЗаменить(Значение, """", "");
	ПолныйПуть = ФС.НормализоватьПуть(ОбъединитьПути(КаталогТеста, ОтносительныйПуть));

	Возврат СтрШаблон("#Использовать ""%1""", ПолныйПуть);

КонецФункции

Процедура ЗаписатьНастройки(КаталогЗапуска, КаталогиТестов)

	Настройки = Новый Структура();
	Настройки.Вставить("КаталогиТестов", СтрСоединить(КаталогиТестов, ","));
	Настройки.Вставить("ФайлыТестов", "");
	Настройки.Вставить("ИскатьВПодкаталогах", Истина);
	Настройки.Вставить("РежимВыводаЛога", "none");

	Данные = Новый Структура();
	Данные.Вставить("OneUnit", Настройки);

	Запись = Новый ЗаписьJSON();
	Запись.ОткрытьФайл(ОбъединитьПути(КаталогЗапуска, "autumn-properties.json"), "UTF-8");
	ЗаписатьJSON(Запись, Данные);
	Запись.Закрыть();

КонецПроцедуры

Функция АбсолютныеКаталогиТестов(РабочийКаталог)

	Результат = Новый Массив();

	Для Каждого КаталогТестов Из _КаталогиТестов Цикл
		Результат.Добавить(ФС.НормализоватьПуть(ОбъединитьПути(РабочийКаталог, КаталогТестов)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ЗаписатьФайл(Знач Путь, Знач Текст)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Деталька("mutatos.КаталогиТестов", ЗначениеПоУмолчанию = "tests") КаталогиТестов) Экспорт

	_КаталогиТестов = СтрРазделить(КаталогиТестов, ",", Ложь);

КонецПроцедуры
