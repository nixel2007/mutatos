#Использовать fs
#Использовать tempfiles
#Использовать oneunit/src/shared

// Копия проекта, в которой проверяется мутант.
//
// Параллельным прогонам нужна изоляция: мутант пишется на место оригинала, и два прогона
// в одном каталоге затирали бы мутантов друг друга. Каждая копия - отдельный каталог
// со своей точкой входа, поэтому прогоны не пересекаются ни на файлах, ни на процессах.
//
// Зависимости не копируются: каталог библиотек оригинала показывается копии
// конфигурацией oscript, иначе копирование oscript_modules съело бы весь выигрыш.

Перем _Каталог;
Перем _Оригинал;
Перем _ТочкаВхода;
Перем _ВременныеФайлы;

// Каталог рабочей копии.
Функция Каталог() Экспорт
	Возврат _Каталог;
КонецФункции

// Путь к точке входа прогона тестов в этой копии.
Функция ТочкаВхода() Экспорт
	Возврат _ТочкаВхода;
КонецФункции

// Путь к файлу копии, соответствующему файлу оригинала.
Функция ПутьВКопии(Знач ПутьВОригинале) Экспорт

	Возврат ОбъединитьПути(_Каталог, ФС.ОтносительныйПуть(_Оригинал, ПутьВОригинале));

КонецФункции

Процедура Удалить() Экспорт

	Если Новый Файл(_Каталог).Существует() Тогда
		УдалитьФайлы(_Каталог);
	КонецЕсли;

КонецПроцедуры

Функция НормализованныйПуть(Знач Путь)
	Возврат СтрЗаменить(ФС.НормализоватьПуть(Путь), "\", "/");
КонецФункции

Процедура СкопироватьПроект(ИсключаемыеКаталоги)

	Для Каждого Элемент Из НайтиФайлы(_Оригинал, "*") Цикл

		Если ИсключаемыеКаталоги.Найти(НРег(Элемент.Имя)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Приемник = ОбъединитьПути(_Каталог, Элемент.Имя);

		Если Элемент.ЭтоКаталог() Тогда
			ФС.ОбеспечитьКаталог(Приемник);
			ФС.КопироватьСодержимоеКаталога(Элемент.ПолноеИмя, Приемник);
		Иначе
			КопироватьФайл(Элемент.ПолноеИмя, Приемник);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Копия лежит в стороне от оригинала, поэтому библиотеки проекта показываются ей явно.
Процедура ЗаписатьКонфигурацию(КаталогБиблиотек)

	Если Не Новый Файл(КаталогБиблиотек).Существует() Тогда
		Возврат;
	КонецЕсли;

	Запись = Новый ЗаписьТекста(ОбъединитьПути(_Каталог, "oscript.cfg"), КодировкаТекста.UTF8БезBOM);
	Запись.Записать("lib.additional=" + ФС.НормализоватьПуть(КаталогБиблиотек));
	Запись.Закрыть();

КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач Оригинал, Знач КаталогиТестов, Знач ИсключаемыеКаталоги, Знач КаталогЯдра,
	Знач Фильтры, Лог)

	// собственный менеджер временных файлов, а не общий: autumn-logos при инициализации
	// поделки вызывает ВременныеФайлы.Удалить() и сносит всё, что создано через общий
	_ВременныеФайлы = Новый МенеджерВременныхФайлов();

	_Оригинал = ФС.НормализоватьПуть(Оригинал);
	_Каталог  = _ВременныеФайлы.СоздатьКаталог();

	СкопироватьПроект(ИсключаемыеКаталоги);
	ЗаписатьКонфигурацию(ОбъединитьПути(_Оригинал, "oscript_modules"));

	Детальки = Новый Соответствие();
	Детальки.Вставить("КаталогиТестов", КаталогиТестовКопии(КаталогиТестов));
	Детальки.Вставить("ФайлыТестов", Новый Массив());
	Детальки.Вставить("ИскатьВПодкаталогах", Истина);
	Детальки.Вставить("РежимВыводаЛога", "none");

	Если Фильтры <> Неопределено Тогда
		Фильтры.ДополнитьДетальки(Детальки);
	КонецЕсли;

	Параметры = Новый Структура();
	Параметры.Вставить("КаталогЯдра", КаталогЯдра);

	Менеджер = Новый МенеджерВременныхФайлов();
	Менеджер.БазовыйКаталог = ОбъединитьПути(_Каталог, ".mutatos");
	ФС.ОбеспечитьКаталог(Менеджер.БазовыйКаталог);

	_ТочкаВхода = Новый ПостроительТочкиВхода().СоздатьТочкуВхода(
		Детальки,
		Менеджер,
		Лог,
		"	ТестПлан = МенеджерТестирования.Тестировать();
		|	Статистика = Поделка.НайтиЖелудь(""РепортерСтатистика"").СтатистикаТестПлана();
		|
		|	Если Статистика.ПолучитьИлиУмолчание(""НаборовОшибка"", 0) > 0
		|		Или Статистика.ПолучитьИлиУмолчание(""НаборовСломано"", 0) > 0
		|		Или Статистика.ПолучитьИлиУмолчание(""ТестовОшибка"", 0) > 0
		|		Или Статистика.ПолучитьИлиУмолчание(""ТестовСломано"", 0) > 0 Тогда
		|		ЗавершитьРаботу(1);
		|	КонецЕсли;
		|",
		Параметры);

КонецПроцедуры

Функция КаталогиТестовКопии(КаталогиТестов)

	Результат = Новый Массив();

	Для Каждого КаталогТестов Из КаталогиТестов Цикл
		Результат.Добавить(ПутьВКопии(КаталогТестов));
	КонецЦикла;

	Возврат Результат;

КонецФункции
