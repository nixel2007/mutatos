#Использовать fs
#Использовать tempfiles
#Использовать oneunit/src/shared

// Копия проекта, в которой проверяется мутант.
//
// Параллельным прогонам нужна изоляция: мутант пишется на место оригинала, и два прогона
// в одном каталоге затирали бы мутантов друг друга. Каждая копия - отдельный каталог
// со своей точкой входа, поэтому прогоны не пересекаются ни на файлах, ни на процессах.
//
// Зависимости не копируются: каталог библиотек оригинала показывается копии
// конфигурацией oscript, иначе копирование oscript_modules съело бы весь выигрыш.

Перем _Каталог;
Перем _Оригинал;
Перем _ТочкаВхода;
Перем _ВременныеФайлы;
Перем _КаталогиТестов;
Перем _КаталогЯдра;
Перем _Фильтры;
Перем _Наборы;
Перем _МутированныйФайл;
Перем _Лог;

// Каталог рабочей копии.
Функция Каталог() Экспорт
	Возврат _Каталог;
КонецФункции

// Путь к точке входа прогона тестов в этой копии.
Функция ТочкаВхода() Экспорт
	Возврат _ТочкаВхода;
КонецФункции

// Путь к файлу копии, соответствующему файлу оригинала.
Функция ПутьВКопии(Знач ПутьВОригинале) Экспорт

	Возврат ОбъединитьПути(_Каталог, ФС.ОтносительныйПуть(_Оригинал, ПутьВОригинале));

КонецФункции

// Кладёт в копию мутанта, вернув на место файл предыдущего.
//
// Копия переиспользуется под мутантов разных файлов, и без возврата она несла бы
// сразу несколько мутаций. Тогда прогон проверяет не то, что думает: чужая мутация
// либо убивает мутанта вместо его собственной, либо ломает набор так, что тесты
// до проверяемого места не доходят.
Процедура ПоместитьМутанта(Знач ФайлОригинала, Знач Текст) Экспорт

	Если ЗначениеЗаполнено(_МутированныйФайл) И _МутированныйФайл <> ФайлОригинала Тогда
		КопироватьФайл(_МутированныйФайл, ПутьВКопии(_МутированныйФайл));
	КонецЕсли;

	Запись = Новый ЗаписьТекста(ПутьВКопии(ФайлОригинала), КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();

	_МутированныйФайл = ФайлОригинала;

КонецПроцедуры

// Путь к файлу оригинала, соответствующему файлу копии.
//
// Обратный перевод нужен всему, что прогон копии рассказывает о проекте: статистика
// выполнения говорит путями копии, а знать о них наружу незачем.
// Путь за пределами копии возвращается как есть - это чужой файл, например библиотека.
Функция ПутьВОригинале(Знач ПутьВКопии) Экспорт

	Путь = НормализованныйПуть(ПутьВКопии);
	Каталог = НормализованныйПуть(_Каталог);

	Если Не СтрНачинаетсяС(НРег(Путь), НРег(Каталог) + "/") Тогда
		Возврат ПутьВКопии;
	КонецЕсли;

	Возврат ОбъединитьПути(_Оригинал, Сред(Путь, СтрДлина(Каталог) + 2));

КонецФункции

Процедура Удалить() Экспорт

	Если Новый Файл(_Каталог).Существует() Тогда
		УдалитьФайлы(_Каталог);
	КонецЕсли;

КонецПроцедуры

Функция НормализованныйПуть(Знач Путь)
	Возврат СтрЗаменить(ФС.НормализоватьПуть(Путь), "\", "/");
КонецФункции

Процедура СкопироватьПроект(ИсключаемыеКаталоги)

	Для Каждого Элемент Из НайтиФайлы(_Оригинал, "*") Цикл

		Если ИсключаемыеКаталоги.Найти(НРег(Элемент.Имя)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Приемник = ОбъединитьПути(_Каталог, Элемент.Имя);

		Если Элемент.ЭтоКаталог() Тогда
			ФС.ОбеспечитьКаталог(Приемник);
			ФС.КопироватьСодержимоеКаталога(Элемент.ПолноеИмя, Приемник);
		Иначе
			КопироватьФайл(Элемент.ПолноеИмя, Приемник);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Копия лежит в стороне от оригинала, поэтому библиотеки проекта показываются ей явно.
Процедура ЗаписатьКонфигурацию(КаталогБиблиотек)

	Если Не Новый Файл(КаталогБиблиотек).Существует() Тогда
		Возврат;
	КонецЕсли;

	Запись = Новый ЗаписьТекста(ОбъединитьПути(_Каталог, "oscript.cfg"), КодировкаТекста.UTF8БезBOM);
	Запись.Записать("lib.additional=" + ФС.НормализоватьПуть(КаталогБиблиотек));
	Запись.Закрыть();

КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач Оригинал, Знач КаталогиТестов, Знач ИсключаемыеКаталоги, Знач КаталогЯдра,
	Знач Фильтры, Лог)

	// собственный менеджер временных файлов, а не общий: autumn-logos при инициализации
	// поделки вызывает ВременныеФайлы.Удалить() и сносит всё, что создано через общий
	_ВременныеФайлы = Новый МенеджерВременныхФайлов();

	_Оригинал = ФС.НормализоватьПуть(Оригинал);
	_Каталог  = _ВременныеФайлы.СоздатьКаталог();

	СкопироватьПроект(ИсключаемыеКаталоги);
	ЗаписатьКонфигурацию(ОбъединитьПути(_Оригинал, "oscript_modules"));

	_КаталогиТестов = КаталогиТестовКопии(КаталогиТестов);
	_КаталогЯдра    = КаталогЯдра;
	_Фильтры        = Фильтры;
	_Лог            = Лог;
	_Наборы           = Новый Массив();
	_МутированныйФайл = "";

	ПостроитьТочкуВхода(_Наборы);

КонецПроцедуры

// Пересобирает точку входа под другой отбор наборов тестов.
//
// Набор тестов зашит в точку входа, а мутанты проверяются разными наборами:
// тому, кто мутирует одну строку, нужны только тесты, которые её выполняют.
// Пересборка дешевле создания новой копии - проект не копируется заново.
Процедура ПерестроитьТочкуВхода(Знач ФайлыНаборов) Экспорт

	Если ЭтотЖеОтбор(ФайлыНаборов) Тогда
		Возврат;
	КонецЕсли;

	_Наборы = ?(ФайлыНаборов = Неопределено, Новый Массив(), ФайлыНаборов);

	ПостроитьТочкуВхода(_Наборы);

КонецПроцедуры

// Наборы, под которые собрана текущая точка входа. Пустой массив - все тесты проекта.
Функция Наборы() Экспорт
	Возврат _Наборы;
КонецФункции

Функция ЭтотЖеОтбор(Знач ФайлыНаборов)

	Отбор = ?(ФайлыНаборов = Неопределено, Новый Массив(), ФайлыНаборов);

	Если Отбор.Количество() <> _Наборы.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Сч = 0 По _Наборы.ВГраница() Цикл
		Если _Наборы[Сч] <> Отбор[Сч] Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Пустой список наборов означает прогон всех тестов проекта: тогда OneUnit ищет их
// по каталогам. Заданные наборы, наоборот, вытесняют каталоги - иначе к отобранным
// файлам добавились бы все остальные.
Процедура ПостроитьТочкуВхода(Знач ФайлыНаборов)

	Детальки = Новый Соответствие();
	Детальки.Вставить("КаталогиТестов", ?(ФайлыНаборов.Количество() = 0, _КаталогиТестов, Новый Массив()));
	Детальки.Вставить("ФайлыТестов", ФайлыНаборов);
	Детальки.Вставить("ИскатьВПодкаталогах", Истина);
	Детальки.Вставить("РежимВыводаЛога", "none");

	Если _Фильтры <> Неопределено Тогда
		_Фильтры.ДополнитьДетальки(Детальки);
	КонецЕсли;

	Параметры = Новый Структура();
	Параметры.Вставить("КаталогЯдра", _КаталогЯдра);

	Менеджер = Новый МенеджерВременныхФайлов();
	Менеджер.БазовыйКаталог = ОбъединитьПути(_Каталог, ".mutatos");
	ФС.ОбеспечитьПустойКаталог(Менеджер.БазовыйКаталог);

	_ТочкаВхода = Новый ПостроительТочкиВхода().СоздатьТочкуВхода(
		Детальки,
		Менеджер,
		_Лог,
		"	ТестПлан = МенеджерТестирования.Тестировать();
		|	Статистика = Поделка.НайтиЖелудь(""РепортерСтатистика"").СтатистикаТестПлана();
		|
		|	Если Статистика.ПолучитьИлиУмолчание(""НаборовОшибка"", 0) > 0
		|		Или Статистика.ПолучитьИлиУмолчание(""НаборовСломано"", 0) > 0
		|		Или Статистика.ПолучитьИлиУмолчание(""ТестовОшибка"", 0) > 0
		|		Или Статистика.ПолучитьИлиУмолчание(""ТестовСломано"", 0) > 0 Тогда
		|		ЗавершитьРаботу(1);
		|	КонецЕсли;
		|",
		Параметры);

КонецПроцедуры

Функция КаталогиТестовКопии(КаталогиТестов)

	Результат = Новый Массив();

	Для Каждого КаталогТестов Из КаталогиТестов Цикл
		Результат.Добавить(ПутьВКопии(КаталогТестов));
	КонецЦикла;

	Возврат Результат;

КонецФункции
