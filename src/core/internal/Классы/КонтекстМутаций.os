// Даёт мутаторам доступ к тексту исходника и создаёт описания мутаций по узлам АСД.
//
// Мутаторы не работают с текстом напрямую: узлы АСД ссылаются на токены,
// а токен знает свою позицию и длину в исходнике - этого достаточно для точечной замены.

Перем _Исходник;
Перем _ИмяМетода;

// Текст исходника, соответствующий токену.
Функция ТекстТокена(Токен) Экспорт
	Возврат Сред(_Исходник, Токен.Позиция, Токен.Длина);
КонецФункции

// Текст исходника, соответствующий узлу целиком - от первого токена до последнего.
Функция ТекстУзла(Узел) Экспорт
	Возврат Сред(_Исходник, Узел.Начало.Позиция, ДлинаУзла(Узел));
КонецФункции

// Мутация, заменяющая один токен.
Функция МутацияТокена(Мутатор, Токен, Текст, Описание) Экспорт

	Возврат СоздатьМутацию(Мутатор, Токен.Позиция, Токен.Длина, Текст, Описание, Токен.НомерСтроки);

КонецФункции

// Мутация, заменяющая узел целиком.
Функция МутацияУзла(Мутатор, Узел, Текст, Описание) Экспорт

	Возврат СоздатьМутацию(Мутатор, Узел.Начало.Позиция, ДлинаУзла(Узел), Текст, Описание, Узел.Начало.НомерСтроки);

КонецФункции

// Имя метода, который обходится в данный момент. Пустое для кода вне методов.
Функция ИмяМетода() Экспорт
	Возврат _ИмяМетода;
КонецФункции

Процедура УстановитьИмяМетода(Знач ИмяМетода) Экспорт
	_ИмяМетода = ИмяМетода;
КонецПроцедуры

Функция ДлинаУзла(Узел)
	Возврат Узел.Конец.Позиция + Узел.Конец.Длина - Узел.Начало.Позиция;
КонецФункции

Функция СоздатьМутацию(Мутатор, Позиция, Длина, Текст, Описание, НомерСтроки)

	Мутация = Новый ОписаниеМутации(Мутатор, Описание, Позиция, Длина, Текст, НомерСтроки);
	Мутация.УстановитьИмяМетода(_ИмяМетода);

	Возврат Мутация;

КонецФункции

Процедура ПриСозданииОбъекта(Знач Исходник)

	_Исходник  = Исходник;
	_ИмяМетода = "";

КонецПроцедуры
