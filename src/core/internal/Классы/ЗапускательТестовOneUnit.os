#Использовать 1commands
#Использовать autumn-logos

// Запускает тесты OneUnit в указанном каталоге и сообщает, зелёные они или нет.
//
// Прогон выполняется отдельным процессом: мутант должен компилироваться заново,
// а состояние предыдущего прогона не должно на него влиять.

Перем _КомандаЗапуска;
Перем _КаталогиТестов;
Перем _Лог;

// Прогоняет тесты в рабочем каталоге.
//
// Параметры:
//   РабочийКаталог - Строка - каталог проекта, в котором запускаются тесты
//   Таймаут - Число - предельное время прогона в миллисекундах, 0 - без ограничения
//   ПутьКCodestat - Строка - игнорируется: командная строка OneUnit сама порождает дочерний
//                            процесс и статистику выполнения движка наружу не отдаёт
//   Фильтры - ФильтрыТестов - отбор тестов, Неопределено - прогоняются все
//
// Возвращаемое значение:
//   РезультатПрогона
Функция Прогнать(Знач РабочийКаталог, Знач Таймаут = 0, Знач ПутьКCodestat = "", Знач Фильтры = Неопределено) Экспорт

	Команда = Новый Команда();
	Команда.УстановитьКоманду(_КомандаЗапуска);
	Команда.УстановитьРабочийКаталог(РабочийКаталог);
	Команда.ПерехватыватьПотоки(Истина);
	Команда.ПоказыватьВыводНемедленно(Ложь);

	Команда.ДобавитьПараметр("e");
	Для Каждого КаталогТестов Из _КаталогиТестов Цикл
		Команда.ДобавитьПараметр("-d");
		Команда.ДобавитьПараметр(КаталогТестов);
	КонецЦикла;
	Команда.ДобавитьПараметр("--mode");
	Команда.ДобавитьПараметр("none");

	Если Таймаут > 0 Тогда
		Команда.ДобавитьПараметр("--timeout");
		Команда.ДобавитьПараметр(Формат(Таймаут, "ЧГ=0"));
	КонецЕсли;

	Если Фильтры <> Неопределено Тогда
		Для Каждого Параметр Из Фильтры.ПараметрыКоманднойСтроки() Цикл
			Команда.ДобавитьПараметр(Параметр);
		КонецЦикла;
	КонецЕсли;

	Если Не ПустаяСтрока(ПутьКCodestat) Тогда
		_Лог.Предупреждение("Запуск через командную строку OneUnit не даёт статистику выполнения:
			|мутанты в непокрытом коде будут проверяться наравне с остальными");
	КонецЕсли;

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		КодВозврата = Команда.Исполнить();
	Исключение
		_Лог.Отладка("Прогон тестов завершился нештатно: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый РезультатПрогона(
			Ложь,
			-1,
			ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Возврат Новый РезультатПрогона(КодВозврата = 0, КодВозврата, Длительность, Команда.ПолучитьВывод());

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Деталька("mutatos.КомандаЗапускаТестов", ЗначениеПоУмолчанию = "oneunit") КомандаЗапуска,
	&Деталька("mutatos.КаталогиТестов", ЗначениеПоУмолчанию = "tests") КаталогиТестов,
	&Лог("oscript.lib.mutatos") Лог) Экспорт

	_КомандаЗапуска = КомандаЗапуска;
	_КаталогиТестов = СтрРазделить(КаталогиТестов, ",", Ложь);
	_Лог            = Лог;

КонецПроцедуры
