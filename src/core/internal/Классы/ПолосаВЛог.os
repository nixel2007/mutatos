// Полоса прогресса для сборки: вместо рисования пишет редкие отметки в лог.
//
// Управляющие последовательности в логе сборки хуже, чем их отсутствие, но прогон
// от этого не перестаёт быть долгим. Десять отметок на весь прогон - достаточно,
// чтобы видеть, что он идёт, и мало, чтобы не залить лог.
//
// Интерфейс тот же, что у ПрогрессБар: тот, кто показывает прогресс, не должен
// знать, куда именно тот уходит.

Перем _Всего;
Перем _Шаг;
Перем _Отмечено;
Перем _Лог;

Процедура Начать(Знач КоличествоШагов, Знач Подсказка = "", Знач ВыводитьПроценты = Истина,
	Знач ВыводитьНомерИКоличество = Истина, Знач ВыводитьВремя = Истина) Экспорт

	_Всего    = КоличествоШагов;
	_Шаг      = 0;
	_Отмечено = 0;

КонецПроцедуры

Процедура СделатьШаг(Знач Инкремент = 1, Знач КоличествоШагов = 0, Знач Подсказка = Неопределено) Экспорт

	_Шаг = _Шаг + Инкремент;

	Если _Всего <= 0 Тогда
		Возврат;
	КонецЕсли;

	Доля = Цел(_Шаг * 10 / _Всего);

	Если Доля <= _Отмечено Тогда
		Возврат;
	КонецЕсли;

	_Отмечено = Доля;

	_Лог.Информация("Проверено мутантов: %1 из %2 (%3)", _Шаг, _Всего, СокрЛП(Подсказка));

КонецПроцедуры

Процедура Завершить() Экспорт
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(&ЛогМутатос Лог) Экспорт

	_Лог      = Лог;
	_Всего    = 0;
	_Шаг      = 0;
	_Отмечено = 0;

КонецПроцедуры
