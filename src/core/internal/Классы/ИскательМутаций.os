#Использовать osparser
#Использовать autumn-logos

// Находит в исходнике все места, которые можно мутировать.
//
// Дерево обходится напрямую по колонкам узлов, а не через посетителя парсера:
// так мутатор можно написать для любого типа узла, ничего не добавляя в обход.

Перем _Мутаторы;
Перем _ТипыУзлов;
Перем _МутаторыПоТипуУзла;
Перем _Лог;

// Возвращает массив ОписаниеМутации для переданного исходника.
// Если исходник не разбирается, возвращается пустой массив.
Функция НайтиМутации(Знач Исходник) Экспорт

	Мутации = Новый Массив();

	Парсер = Новый ПарсерВстроенногоЯзыка();

	Попытка
		Модуль = Парсер.Разобрать(Исходник);
	Исключение
		_Лог.Предупреждение("Не удалось разобрать исходник: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Мутации;
	КонецПопытки;

	Если Парсер.ТаблицаОшибок().Количество() > 0 Тогда
		_Лог.Предупреждение("Исходник разобран с ошибками: %1", Парсер.ТаблицаОшибок()[0].Текст);
		Возврат Мутации;
	КонецЕсли;

	Контекст = Новый КонтекстМутаций(Исходник);
	ОбойтиУзел(Модуль, Контекст, Мутации, Новый Соответствие());

	Возврат Мутации;

КонецФункции

Процедура ОбойтиУзел(Узел, Контекст, Мутации, Посещенные)

	Если Посещенные.Получить(Узел) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Посещенные.Вставить(Узел, Истина);

	ПредыдущийМетод = Неопределено;
	Если Узел.Тип = _ТипыУзлов.ОбъявлениеМетода Тогда
		ПредыдущийМетод = Контекст.ИмяМетода();
		Контекст.УстановитьИмяМетода(Узел.Сигнатура.Имя);
	КонецЕсли;

	СобратьМутацииУзла(Узел, Контекст, Мутации);

	Для Каждого Колонка Из Узел.Владелец().Колонки Цикл
		ОбойтиЗначение(Узел[Колонка.Имя], Контекст, Мутации, Посещенные);
	КонецЦикла;

	Если ПредыдущийМетод <> Неопределено Тогда
		Контекст.УстановитьИмяМетода(ПредыдущийМетод);
	КонецЕсли;

КонецПроцедуры

Процедура ОбойтиЗначение(Значение, Контекст, Мутации, Посещенные)

	Если ЭтоУзел(Значение) Тогда
		ОбойтиУзел(Значение, Контекст, Мутации, Посещенные);
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			ОбойтиЗначение(Элемент, Контекст, Мутации, Посещенные);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура СобратьМутацииУзла(Узел, Контекст, Мутации)

	Мутаторы = _МутаторыПоТипуУзла.Получить(Узел.Тип);
	Если Мутаторы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Мутатор Из Мутаторы Цикл
		Для Каждого Мутация Из Мутатор.Мутации(Узел, Контекст) Цикл
			Мутации.Добавить(Мутация);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Узлы АСД - строки таблиц значений с колонкой "Тип".
// Токены тоже строки таблицы значений, но такой колонки не имеют.
Функция ЭтоУзел(Значение)

	Если ТипЗнч(Значение) <> Тип("СтрокаТаблицыЗначений") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Значение.Владелец().Колонки.Найти("Тип") <> Неопределено;

КонецФункции

Процедура ПостроитьИндексМутаторов()

	_МутаторыПоТипуУзла = Новый Соответствие();

	Для Каждого Мутатор Из _Мутаторы Цикл
		Для Каждого ТипУзла Из Мутатор.ТипыУзлов(_ТипыУзлов) Цикл

			Мутаторы = _МутаторыПоТипуУзла.Получить(ТипУзла);
			Если Мутаторы = Неопределено Тогда
				Мутаторы = Новый Массив();
				_МутаторыПоТипуУзла.Вставить(ТипУзла, Мутаторы);
			КонецЕсли;

			Мутаторы.Добавить(Мутатор);

		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин("Мутатор", Тип = "Список") Мутаторы,
	&Пластилин ТипыУзлов,
	&Лог("oscript.lib.mutatos") Лог) Экспорт

	_Мутаторы  = Мутаторы;
	_ТипыУзлов = ТипыУзлов;
	_Лог       = Лог;

	ПостроитьИндексМутаторов();

КонецПроцедуры
