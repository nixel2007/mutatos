// Гоняет задания рабочими копиями: на копию одновременно одно задание.
//
// Прогон - это отдельный процесс, который почти всё время тратит на старт движка
// и компиляцию, поэтому копий столько же, сколько потоков, и они переиспользуются:
// освободилась - берёт следующее задание.
//
// Что именно запускать и что считать результатом, решает мастер - объект с методами:
//   Запустить(Копия, Задание)                        - возвращает запущенный Процесс
//   Таймаут(Задание)                                 - предел в миллисекундах, 0 - без предела
//   Завершено(Задание, КодВозврата, Длительность, Вывод) - возвращает результат
//   Прервано(Задание, Длительность, Вывод)               - возвращает результат по таймауту
//
// Так один и тот же пул гоняет и мутантов, и сбор покрытия по наборам.

// Сколько последних порций вывода прогона хранить: хвоста хватает на причину падения,
// а полный вывод сотни прогонов - это мегабайты в памяти.
Перем _ХранимыхСтрокВывода;

// Прогоняет задания и возвращает массив результатов, собранных мастером.
Функция Прогнать(Копии, Задания, Мастер) Экспорт

	Результаты = Новый Массив();
	Активные = Новый Соответствие();

	СледующееЗадание = 0;

	Пока СледующееЗадание < Задания.Количество() Или Активные.Количество() > 0 Цикл

		СледующееЗадание = ЗапуститьСвободные(Копии, Задания, СледующееЗадание, Активные, Мастер);

		ЧтоТоЗавершилось = СобратьЗавершенные(Активные, Результаты, Мастер);

		Если Не ЧтоТоЗавершилось И Активные.Количество() > 0 Тогда
			Приостановить(20);
		КонецЕсли;

	КонецЦикла;

	Возврат Результаты;

КонецФункции

Функция ЗапуститьСвободные(Копии, Задания, Знач СледующееЗадание, Активные, Мастер)

	Для Каждого Копия Из Копии Цикл

		Если СледующееЗадание >= Задания.Количество() Тогда
			Прервать;
		КонецЕсли;

		Если Активные.Получить(Копия) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Задание = Задания[СледующееЗадание];

		Активные.Вставить(Копия, Новый Структура("Процесс, Задание, Начало, Вывод",
			Мастер.Запустить(Копия, Задание),
			Задание,
			ТекущаяУниверсальнаяДатаВМиллисекундах(),
			Новый Массив()));

		СледующееЗадание = СледующееЗадание + 1;

	КонецЦикла;

	Возврат СледующееЗадание;

КонецФункции

Функция СобратьЗавершенные(Активные, Результаты, Мастер)

	Завершенные = Новый Массив();

	Для Каждого Элемент Из Активные Цикл

		Прогон = Элемент.Значение;
		Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Прогон.Начало;
		Таймаут = Мастер.Таймаут(Прогон.Задание);

		ВычитатьВывод(Прогон);

		Если Прогон.Процесс.Завершен Тогда

			Результаты.Добавить(Мастер.Завершено(
				Прогон.Задание,
				Прогон.Процесс.КодВозврата,
				Длительность,
				Вывод(Прогон)));

			Завершенные.Добавить(Элемент.Ключ);

		ИначеЕсли Таймаут > 0 И Длительность > Таймаут Тогда

			Прогон.Процесс.Завершить();
			Результаты.Добавить(Мастер.Прервано(Прогон.Задание, Длительность, Вывод(Прогон)));
			Завершенные.Добавить(Элемент.Ключ);

		КонецЕсли;

	КонецЦикла;

	Для Каждого Копия Из Завершенные Цикл
		Активные.Удалить(Копия);
	КонецЦикла;

	Возврат Завершенные.Количество() > 0;

КонецФункции

// Вывод вычитывается по ходу прогона: движок складывает его в свой буфер,
// и от нас нужно только не дать буферу расти без предела. Хвост пригодится,
// если прогон не запустился вовсе - тогда это единственная причина, которую можно показать.
Процедура ВычитатьВывод(Прогон)

	Пока Прогон.Процесс.ПотокВывода.ЕстьДанные Цикл
		ДобавитьВВывод(Прогон, Прогон.Процесс.ПотокВывода.Прочитать());
	КонецЦикла;

	Пока Прогон.Процесс.ПотокОшибок.ЕстьДанные Цикл
		ДобавитьВВывод(Прогон, Прогон.Процесс.ПотокОшибок.Прочитать());
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьВВывод(Прогон, Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;

	Прогон.Вывод.Добавить(Текст);

	Пока Прогон.Вывод.Количество() > _ХранимыхСтрокВывода Цикл
		Прогон.Вывод.Удалить(0);
	КонецЦикла;

КонецПроцедуры

Функция Вывод(Прогон)

	Возврат СтрСоединить(Прогон.Вывод, Символы.ПС);

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт

	_ХранимыхСтрокВывода = 40;

КонецПроцедуры
