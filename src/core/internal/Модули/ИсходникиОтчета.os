#Использовать fs

// Общее для отчётов: чтение исходников, короткие пути и координаты мутации в тексте.
//
// Мутация знает только смещение в файле - этого достаточно, чтобы собрать мутанта,
// но мало, чтобы показать его человеку или внешнему инструменту. Пересчёт смещения
// в строку и колонку нужен всем отчётам, поэтому живёт здесь.

// Создаёт каталог, в который ляжет файл отчёта.
//
// У имени без каталога - "out.html" рядом с собой - каталога нет вовсе, и создавать
// нечего: ФС.ОбеспечитьКаталог на пустой строке падает.
Процедура ОбеспечитьКаталогФайла(Знач Путь) Экспорт

	Каталог = Новый Файл(Путь).Путь;

	Если ПустаяСтрока(Каталог) Тогда
		Возврат;
	КонецЕсли;

	ФС.ОбеспечитьКаталог(Каталог);

КонецПроцедуры

// Результаты прогона по файлу, затем по строке.
//
// Мутанты проверяются параллельно и возвращаются в порядке, в котором закончили -
// то есть в разном при каждом прогоне. Отчёт так читать нельзя: глазами по нему ищут
// конкретный файл, а два прогона подряд сравнивают построчным сличением.
Функция УпорядоченныеРезультаты(Знач Результаты) Экспорт

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Файл");
	Таблица.Колонки.Добавить("НомерСтроки");
	Таблица.Колонки.Добавить("Результат");

	Для Каждого Результат Из Результаты Цикл

		Строка = Таблица.Добавить();
		Строка.Файл        = НРег(СтрЗаменить(Результат.Файл(), "\", "/"));
		Строка.НомерСтроки = Результат.Мутация().НомерСтроки();
		Строка.Результат   = Результат;

	КонецЦикла;

	Таблица.Сортировать("Файл, НомерСтроки");

	Упорядоченные = Новый Массив();

	Для Каждого Строка Из Таблица Цикл
		Упорядоченные.Добавить(Строка.Результат);
	КонецЦикла;

	Возврат Упорядоченные;

КонецФункции

// Читает исходник как есть, без нормализации переводов строк: позиции мутаций
// отсчитаны по этому же тексту, и любая правка сдвинула бы их.
//
// Возвращает Неопределено, если файла нет - он мог быть удалён после прогона.
Функция ПрочитатьИсходник(Знач Путь) Экспорт

	Если Не Новый Файл(Путь).Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

// Смещения начал строк: НачалаСтрок[0] - позиция первого символа первой строки.
// Отсчёт позиций с единицы, как в Сред и Лев.
Функция НачалаСтрок(Знач ИсходныйТекст) Экспорт

	Начала = Новый Массив();
	Смещение = 1;

	Для Каждого СтрокаТекста Из СтрРазделить(ИсходныйТекст, Символы.ПС, Истина) Цикл
		Начала.Добавить(Смещение);
		Смещение = Смещение + СтрДлина(СтрокаТекста) + 1;
	КонецЦикла;

	Возврат Начала;

КонецФункции

// Строка и колонка для смещения в тексте, обе с единицы.
Функция Координаты(Знач НачалаСтрок, Знач Позиция) Экспорт

	Номер = 1;

	Пока Номер < НачалаСтрок.Количество() И НачалаСтрок[Номер] <= Позиция Цикл
		Номер = Номер + 1;
	КонецЦикла;

	Возврат Новый Структура("Строка, Колонка", Номер, Позиция - НачалаСтрок[Номер - 1] + 1);

КонецФункции

// Общий каталог всех файлов отчёта: в путях он повторяется от строки к строке
// и только мешает читать, поэтому отчёты показывают пути относительно него.
Функция ОбщийКаталог(Знач Файлы) Экспорт

	Общий = Неопределено;

	Для Каждого Файл Из Файлы Цикл

		Части = СтрРазделить(СтрЗаменить(Файл, "\", "/"), "/", Истина);
		Части.Удалить(Части.ВГраница());

		Если Общий = Неопределено Тогда
			Общий = Части;
			Продолжить;
		КонецЕсли;

		Общий = ОбщееНачало(Общий, Части);

	КонецЦикла;

	Возврат ?(Общий = Неопределено, "", СтрСоединить(Общий, "/"));

КонецФункции

// Пакет файла - каталог, в котором он лежит, без служебных сегментов пути.
//
// Пакетов в OneScript нет как языковой сущности, но раскладка проектов о них говорит:
// каталог с исходниками либо сам содержит "Классы" и "Модули", либо лежит внутри них.
// Обе конвенции сводятся к одному правилу - выбросить из пути эти два имени:
//
//   Классы/Коллекции/Списки/СписокМассив.os -> Коллекции/Списки
//   Ядро/Классы/ОтелРесурс.os               -> Ядро
//   Модули/Массивы.os                       -> корень
//
// Правило проверено на раскладках collectionos, OneUnit, opentelemetry, entity,
// messenger и opm - от компонентных до вовсе не знающих про "Классы".
Функция Пакет(Знач ОтносительныйПуть) Экспорт

	Части = СтрРазделить(СтрЗаменить(ОтносительныйПуть, "\", "/"), "/", Ложь);

	// последний сегмент - имя файла
	Если Части.Количество() > 0 Тогда
		Части.Удалить(Части.ВГраница());
	КонецЕсли;

	Сегменты = Новый Массив();

	Для Каждого Часть Из Части Цикл
		Если Часть <> "Классы" И Часть <> "Модули" Тогда
			Сегменты.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Сегменты, "/");

КонецФункции

// Путь файла относительно общего каталога. Разделители всегда прямые:
// отчёт читают инструменты, которым windows-обратный слеш только мешает.
Функция ОтносительныйПуть(Знач Файл, Знач ОбщийКаталог) Экспорт

	Путь = СтрЗаменить(Файл, "\", "/");

	Если ПустаяСтрока(ОбщийКаталог) Или Не СтрНачинаетсяС(Путь, ОбщийКаталог + "/") Тогда
		Возврат Путь;
	КонецЕсли;

	Возврат Сред(Путь, СтрДлина(ОбщийКаталог) + 2);

КонецФункции

Функция ОбщееНачало(Знач Первый, Знач Второй)

	Результат = Новый Массив();

	Для Сч = 0 По Мин(Первый.ВГраница(), Второй.ВГраница()) Цикл

		Если Первый[Сч] <> Второй[Сч] Тогда
			Прервать;
		КонецЕсли;

		Результат.Добавить(Первый[Сч]);

	КонецЦикла;

	Возврат Результат;

КонецФункции
