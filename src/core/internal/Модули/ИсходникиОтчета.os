// Общее для отчётов: чтение исходников, короткие пути и координаты мутации в тексте.
//
// Мутация знает только смещение в файле - этого достаточно, чтобы собрать мутанта,
// но мало, чтобы показать его человеку или внешнему инструменту. Пересчёт смещения
// в строку и колонку нужен всем отчётам, поэтому живёт здесь.

// Читает исходник как есть, без нормализации переводов строк: позиции мутаций
// отсчитаны по этому же тексту, и любая правка сдвинула бы их.
//
// Возвращает Неопределено, если файла нет - он мог быть удалён после прогона.
Функция ПрочитатьИсходник(Знач Путь) Экспорт

	Если Не Новый Файл(Путь).Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

// Смещения начал строк: НачалаСтрок[0] - позиция первого символа первой строки.
// Отсчёт позиций с единицы, как в Сред и Лев.
Функция НачалаСтрок(Знач ИсходныйТекст) Экспорт

	Начала = Новый Массив();
	Смещение = 1;

	Для Каждого СтрокаТекста Из СтрРазделить(ИсходныйТекст, Символы.ПС, Истина) Цикл
		Начала.Добавить(Смещение);
		Смещение = Смещение + СтрДлина(СтрокаТекста) + 1;
	КонецЦикла;

	Возврат Начала;

КонецФункции

// Строка и колонка для смещения в тексте, обе с единицы.
Функция Координаты(Знач НачалаСтрок, Знач Позиция) Экспорт

	Номер = 1;

	Пока Номер < НачалаСтрок.Количество() И НачалаСтрок[Номер] <= Позиция Цикл
		Номер = Номер + 1;
	КонецЦикла;

	Возврат Новый Структура("Строка, Колонка", Номер, Позиция - НачалаСтрок[Номер - 1] + 1);

КонецФункции

// Общий каталог всех файлов отчёта: в путях он повторяется от строки к строке
// и только мешает читать, поэтому отчёты показывают пути относительно него.
Функция ОбщийКаталог(Знач Файлы) Экспорт

	Общий = Неопределено;

	Для Каждого Файл Из Файлы Цикл

		Части = СтрРазделить(СтрЗаменить(Файл, "\", "/"), "/", Истина);
		Части.Удалить(Части.ВГраница());

		Если Общий = Неопределено Тогда
			Общий = Части;
			Продолжить;
		КонецЕсли;

		Общий = ОбщееНачало(Общий, Части);

	КонецЦикла;

	Возврат ?(Общий = Неопределено, "", СтрСоединить(Общий, "/"));

КонецФункции

// Путь файла относительно общего каталога. Разделители всегда прямые:
// отчёт читают инструменты, которым windows-обратный слеш только мешает.
Функция ОтносительныйПуть(Знач Файл, Знач ОбщийКаталог) Экспорт

	Путь = СтрЗаменить(Файл, "\", "/");

	Если ПустаяСтрока(ОбщийКаталог) Или Не СтрНачинаетсяС(Путь, ОбщийКаталог + "/") Тогда
		Возврат Путь;
	КонецЕсли;

	Возврат Сред(Путь, СтрДлина(ОбщийКаталог) + 2);

КонецФункции

Функция ОбщееНачало(Знач Первый, Знач Второй)

	Результат = Новый Массив();

	Для Сч = 0 По Мин(Первый.ВГраница(), Второй.ВГраница()) Цикл

		Если Первый[Сч] <> Второй[Сч] Тогда
			Прервать;
		КонецЕсли;

		Результат.Добавить(Первый[Сч]);

	КонецЦикла;

	Возврат Результат;

КонецФункции
