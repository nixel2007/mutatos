// Снимает покрытие каждого теста внутри дочернего прогона.
//
// Живёт не в процессе mutatos, а в процессе прогона тестов: там, где выполняются
// сами тесты, и только там можно узнать, какие строки выполнил каждый из них.
// Загружается точкой входа через ЗагрузитьСценарий по абсолютному пути, поэтому
// зависимостей у него нет - в дочернем процессе доступны только библиотеки
// тестируемого проекта, и своих у агента быть не может.
//
// Работает на управляемом сборе статистики - глобальном контексте СборСтатистики.
// Движок без него класс не скомпилирует, точка входа поймает это исключение,
// и прогон пойдёт обычным порядком - просто без карты.
//
// Один прогон вместо прогона на каждый набор: сессия сбора открывается на старте
// теста и закрывается на его завершении, поэтому статистика разделяется по тестам
// без запуска отдельного процесса под каждый.

Перем _Сборщик;
Перем _Ключ;
Перем _Начало;
Перем _Тесты;
// Сколько прогон потратил на сам сбор: завести сессию, забрать её таблицу и разобрать.
// Мутанты бегут без агента, поэтому в их оценку это время входить не должно
Перем _Накладные;

// Начало выполнения теста. Подписка точки входа на ИсполнениеТестНачало.
Процедура ПриНачалеТеста(Тест) Экспорт

	Если Не ЭтоЛистТеста(Тест) Тогда
		Возврат;
	КонецЕсли;

	// Вложенных сессий не бывает: параметризованный тест приходит контейнером,
	// а его случаи - листьями, и лист всегда закрывается до следующего
	Если _Сборщик <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	НачалоНакладных = ТекущаяУниверсальнаяДатаВМиллисекундах();

	_Ключ    = Ключ(Тест);
	_Сборщик = СборСтатистики.НачатьСбор();

	// отсчёт теста идёт с этого места: сессия уже заведена, и её цена - не цена теста
	_Начало    = ТекущаяУниверсальнаяДатаВМиллисекундах();
	_Накладные = _Накладные + (_Начало - НачалоНакладных);

КонецПроцедуры

// Завершение выполнения теста. Подписка точки входа на ИсполнениеТестКонец.
Процедура ПриКонцеТеста(Тест, Результат) Экспорт

	Если _Сборщик = Неопределено Или _Ключ <> Ключ(Тест) Тогда
		Возврат;
	КонецЕсли;

	Конец = ТекущаяУниверсальнаяДатаВМиллисекундах();

	// Истина - не отдавать строки, которых тест не выполнял. Без этого движок
	// возвращает весь свой каталог: на collectionos это 2400 строк вместо 93
	Таблица  = _Сборщик.Завершить(Истина);
	_Сборщик = Неопределено;

	ЗапомнитьТест(Тест, Таблица, Конец - _Начало);

	_Накладные = _Накладные + (ТекущаяУниверсальнаяДатаВМиллисекундах() - Конец);

КонецПроцедуры

// Записывает собранную карту. Вызывается точкой входа после прогона.
//
// Путь передаётся сюда, а не в конструктор: ЗагрузитьСценарий параметров конструктора
// не принимает, а тянуть их через внешний контекст ради одной строки незачем.
Процедура Записать(Знач ФайлКарты) Экспорт

	Карта = Новый Соответствие();
	Карта.Вставить("Накладные", _Накладные);
	Карта.Вставить("Тесты", _Тесты);

	Запись = Новый ЗаписьJSON();
	Запись.ОткрытьФайл(ФайлКарты);
	ЗаписатьJSON(Запись, Карта);
	Запись.Закрыть();

КонецПроцедуры

// Лист плана - это собственно тест: у контейнера собирать нечего, его строки
// достанутся детям, а параметризованный тест иначе посчитался бы дважды.
Функция ЭтоЛистТеста(Тест)

	Если ТипЗнч(Тест) <> Тип("ОпределениеТеста") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Тест.Дети().Количество() = 0;

КонецФункции

Процедура ЗапомнитьТест(Тест, Таблица, Знач Длительность)

	Покрытие = Новый Соответствие();

	// Индексы колонок находятся по именам один раз, до цикла: таблица перебирается
	// целиком на каждый тест, и поиск колонки по имени на каждое обращение стоит
	// столько же, сколько весь остальной разбор. Зашивать порядок колонок нельзя -
	// движок вставит колонку, и агент молча начнёт читать не то поле
	КолонкаПути    = Индекс(Таблица, "Путь");
	КолонкаСтроки  = Индекс(Таблица, "НомерСтроки");
	КолонкаСчетчика = Индекс(Таблица, "Количество");

	Для Каждого Строка Из Таблица Цикл

		// сессия заводится сразу со всеми известными движку строками, но с нулевым
		// счётчиком: этим тестом выполнены только те, где счётчик вырос
		Если Строка[КолонкаСчетчика] = 0 Тогда
			Продолжить;
		КонецЕсли;

		Путь = Строка[КолонкаПути];
		Строки = Покрытие.Получить(Путь);

		Если Строки = Неопределено Тогда
			Строки = Новый Массив();
			Покрытие.Вставить(Путь, Строки);
		КонецЕсли;

		Строки.Добавить(Строка[КолонкаСтроки]);

	КонецЦикла;

	Запись = Новый Соответствие();
	Запись.Вставить("Набор", Тест.Путь());
	Запись.Вставить("Метод", Тест.ИмяМетода());
	Запись.Вставить("Длительность", Длительность);
	Запись.Вставить("Покрытие", Покрытие);

	_Тесты.Добавить(Запись);

КонецПроцедуры

Функция Индекс(Таблица, Знач ИмяКолонки)

	Возврат Таблица.Колонки.Индекс(Таблица.Колонки.Найти(ИмяКолонки));

КонецФункции

Функция Ключ(Тест)
	Возврат Тест.ПолноеИмя();
КонецФункции

Процедура ПриСозданииОбъекта()

	_Тесты     = Новый Массив();
	_Накладные = 0;

КонецПроцедуры
