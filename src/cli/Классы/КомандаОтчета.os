#Использовать autumn-logos
#Использовать "../../core"

// Перерисовывает отчёт из готового JSON, не гоняя мутантов заново.
//
// Прогон на большом проекте идёт десятки минут, а вид отчёта меняется чаще: новый
// разрез, другая группировка, отчёт для другого инструмента. Всё, что для этого нужно,
// в JSON уже лежит - включая исходники файлов, поэтому перерисовать можно и там,
// где самого проекта нет.

&Опция(Имя = "from", Описание = "Путь к файлу отчёта в формате JSON, из которого строить")
&ТСтрока
&ПоУмолчанию("")
Перем ПутьКИсточнику;

&Опция(Имя = "html", Описание = "Путь к файлу отчёта в формате HTML")
&ТСтрока
&ПоУмолчанию("")
Перем ПутьКОтчетуHTML;

&Опция(Имя = "xml", Описание = "Путь к файлу отчёта в разметке pitest (mutations.xml)")
&ТСтрока
&ПоУмолчанию("")
Перем ПутьКОтчетуXML;

&Опция(Имя = "min-score", Описание = "Минимальный индекс мутаций в процентах. Если он не достигнут, команда завершается с ошибкой")
&ТЧисло
&ПоУмолчанию(0)
Перем МинимальныйИндекс;

Перем _Читатель;
Перем _Репортеры;
Перем _Лог;

&ВыполнениеКоманды
Процедура Перерисовать() Экспорт

	Если ПустаяСтрока(ПутьКИсточнику) Тогда
		_Лог.Ошибка("Не указан путь к исходному отчёту: mutatos report --from отчёт.json");
		ЗавершитьРаботу(1);
	КонецЕсли;

	Отчет = _Читатель.Прочитать(ПутьКИсточнику);

	_Лог.Информация("Мутантов в отчёте: %1", Отчет.ВсегоМутантов());

	Репортер("console").Сформировать(Отчет);

	Если Не ПустаяСтрока(ПутьКОтчетуHTML) Тогда
		Репортер("html").Сформировать(Отчет, ПутьКОтчетуHTML);
		_Лог.Информация("Отчёт HTML: %1", ПутьКОтчетуHTML);
	КонецЕсли;

	Если Не ПустаяСтрока(ПутьКОтчетуXML) Тогда
		Репортер("xml").Сформировать(Отчет, ПутьКОтчетуXML);
		_Лог.Информация("Отчёт XML: %1", ПутьКОтчетуXML);
	КонецЕсли;

	Если МинимальныйИндекс > 0 И Отчет.ИндексМутаций() < МинимальныйИндекс Тогда
		_Лог.Ошибка("Индекс мутаций %1%% ниже требуемых %2%%", Отчет.ИндексМутаций(), МинимальныйИндекс);
		ЗавершитьРаботу(1);
	КонецЕсли;

КонецПроцедуры

Функция Репортер(Знач Имя)

	Для Каждого Репортер Из _Репортеры Цикл
		Если Репортер.Имя() = Имя Тогда
			Возврат Репортер;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение СтрШаблон("Неизвестный формат отчёта: %1", Имя);

КонецФункции

&КомандаПриложения(Имя = "report", Описание = "Перерисовывает отчёт из готового JSON, не прогоняя мутантов заново")
Процедура ПриСозданииОбъекта(
	&Пластилин ЧитательОтчетаJSON,
	&Пластилин("Репортер", Тип = "Список") Репортеры,
	&Лог("oscript.lib.mutatos.cli") Лог)

	_Читатель  = ЧитательОтчетаJSON;
	_Репортеры = Репортеры;
	_Лог       = Лог;

КонецПроцедуры
