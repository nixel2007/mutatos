#Использовать autumn-logos
#Использовать "../../core"

// Команда мутационного прогона проекта.

&Опция(Имя = "d directory", Описание = "Каталог с мутируемыми исходниками, повторяемый. По умолчанию ./src")
&ТМассивСтрок(",")
Перем КаталогиИсходников;

&Опция(Имя = "f file", Описание = "Отдельный мутируемый файл, повторяемый")
&ТМассивСтрок(",")
Перем ФайлыИсходников;

&Опция(Имя = "p project", Описание = "Каталог проекта, в котором запускаются тесты. По умолчанию текущий")
&ТСтрока
&ПоУмолчанию("")
Перем КаталогПроекта;

&Опция(Имя = "timeout-factor", Описание = "Во сколько раз мутанту дают больше времени, чем исходному прогону тестов")
&ТЧисло
&ПоУмолчанию(3)
Перем КоэффициентТаймаута;

&Опция(Имя = "json", Описание = "Путь к файлу отчёта в формате JSON")
&ТСтрока
&ПоУмолчанию("")
Перем ПутьКОтчетуJSON;

&Опция(Имя = "html", Описание = "Путь к файлу отчёта в формате HTML")
&ТСтрока
&ПоУмолчанию("")
Перем ПутьКОтчетуHTML;

&Опция(Имя = "xml", Описание = "Путь к файлу отчёта в разметке pitest (mutations.xml)")
&ТСтрока
&ПоУмолчанию("")
Перем ПутьКОтчетуXML;

&Опция(Имя = "min-score", Описание = "Минимальный индекс мутаций в процентах. Если он не достигнут, команда завершается с ошибкой")
&ТЧисло
&ПоУмолчанию(0)
Перем МинимальныйИндекс;

&Опция(Имя = "j threads", Описание = "Сколько мутантов проверять одновременно. По умолчанию по числу процессоров")
&ТЧисло
&ПоУмолчанию(0)
Перем ЧислоПотоков;

&Опция(Имя = "exclude-mutators", Описание = "Мутаторы, не применяемые в прогоне, через запятую")
&ТМассивСтрок(",")
Перем ОтключенныеМутаторы;

&Опция(Имя = "no-progress", Описание = "Не показывать полосу прогресса")
&ТБулево
&ПоУмолчанию(Ложь)
Перем БезПрогресса;

&Опция(Имя = "t tagsInclude", Описание = "Теги тестов, включаемых в прогон")
&ТМассивСтрок(",")
Перем ТегиВключаемые;

&Опция(Имя = "T tagsExclude", Описание = "Теги тестов, исключаемых из прогона")
&ТМассивСтрок(",")
Перем ТегиИсключаемые;

&Опция(Имя = "s testsuiteNameInclude", Описание = "Тестовые наборы, включаемые в прогон")
&ТМассивСтрок(",")
Перем НаборыВключаемые;

&Опция(Имя = "S testsuiteNameExclude", Описание = "Тестовые наборы, исключаемые из прогона")
&ТМассивСтрок(",")
Перем НаборыИсключаемые;

&Опция(Имя = "m testMethodsNameInclude", Описание = "Тестовые методы, включаемые в прогон")
&ТМассивСтрок(",")
Перем МетодыВключаемые;

&Опция(Имя = "M testMethodsNameExclude", Описание = "Тестовые методы, исключаемые из прогона")
&ТМассивСтрок(",")
Перем МетодыИсключаемые;

Перем _Менеджер;
Перем _Сканер;
Перем _Репортеры;
Перем _Лог;

&ВыполнениеКоманды
Процедура ПрогнатьМутации() Экспорт

	РабочийКаталог = ?(ПустаяСтрока(КаталогПроекта), ТекущийКаталог(), КаталогПроекта);

	Каталоги = КаталогиИсходников;
	Если Каталоги.Количество() = 0 И ФайлыИсходников.Количество() = 0 Тогда
		Каталоги = Новый Массив();
		Каталоги.Добавить(ОбъединитьПути(РабочийКаталог, "src"));
	КонецЕсли;

	Исходники = _Сканер.НайтиИсходники(Каталоги, ФайлыИсходников);

	Если Исходники.Количество() = 0 Тогда
		_Лог.Ошибка("Не найдено ни одного файла для мутирования");
		ЗавершитьРаботу(1);
	КонецЕсли;

	_Лог.Информация("Файлов для мутирования: %1", Исходники.Количество());

	Отчет = _Менеджер.Проверить(РабочийКаталог, Исходники, ПараметрыПрогона());

	Репортер("console").Сформировать(Отчет);

	Если Не ПустаяСтрока(ПутьКОтчетуJSON) Тогда
		Репортер("json").Сформировать(Отчет, ПутьКОтчетуJSON);
		_Лог.Информация("Отчёт JSON: %1", ПутьКОтчетуJSON);
	КонецЕсли;

	Если Не ПустаяСтрока(ПутьКОтчетуHTML) Тогда
		Репортер("html").Сформировать(Отчет, ПутьКОтчетуHTML);
		_Лог.Информация("Отчёт HTML: %1", ПутьКОтчетуHTML);
	КонецЕсли;

	Если Не ПустаяСтрока(ПутьКОтчетуXML) Тогда
		Репортер("xml").Сформировать(Отчет, ПутьКОтчетуXML);
		_Лог.Информация("Отчёт XML: %1", ПутьКОтчетуXML);
	КонецЕсли;

	Если МинимальныйИндекс > 0 И Отчет.ИндексМутаций() < МинимальныйИндекс Тогда
		_Лог.Ошибка("Индекс мутаций %1%% ниже требуемых %2%%", Отчет.ИндексМутаций(), МинимальныйИндекс);
		ЗавершитьРаботу(1);
	КонецЕсли;

КонецПроцедуры

// Фильтры уходят и в исходный прогон, и в прогоны мутантов: покрытие должно
// собираться теми же тестами, которыми потом проверяются мутанты.
Функция ПараметрыПрогона()

	Параметры = Новый ПараметрыПрогона();
	Параметры.КоэффициентТаймаута = КоэффициентТаймаута;
	Параметры.ЧислоПотоков        = ЧислоПотоков;
	Параметры.ОтключенныеМутаторы = ОтключенныеМутаторы;
	Параметры.ПоказыватьПрогресс  = Не БезПрогресса;

	Параметры.Фильтры.ТегиВключаемые    = ТегиВключаемые;
	Параметры.Фильтры.ТегиИсключаемые   = ТегиИсключаемые;
	Параметры.Фильтры.НаборыВключаемые  = НаборыВключаемые;
	Параметры.Фильтры.НаборыИсключаемые = НаборыИсключаемые;
	Параметры.Фильтры.МетодыВключаемые  = МетодыВключаемые;
	Параметры.Фильтры.МетодыИсключаемые = МетодыИсключаемые;

	Если Не Параметры.Фильтры.Пустые() Тогда
		_Лог.Информация("Мутанты проверяются не всеми тестами проекта, а отобранными фильтрами");
	КонецЕсли;

	Возврат Параметры;

КонецФункции

Функция Репортер(Знач Имя)

	Для Каждого Репортер Из _Репортеры Цикл
		Если Репортер.Имя() = Имя Тогда
			Возврат Репортер;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение СтрШаблон("Неизвестный формат отчёта: %1", Имя);

КонецФункции

&КомандаПриложения(Имя = "run r", Описание = "Проверяет тесты проекта мутациями исходного кода")
Процедура ПриСозданииОбъекта(
	&Пластилин МенеджерМутационногоТестирования,
	&Пластилин СканерИсходников,
	&Пластилин("Репортер", Тип = "Список") Репортеры,
	&Лог("oscript.lib.mutatos.cli") Лог)

	_Менеджер  = МенеджерМутационногоТестирования;
	_Сканер    = СканерИсходников;
	_Репортеры = Репортеры;
	_Лог       = Лог;

КонецПроцедуры
